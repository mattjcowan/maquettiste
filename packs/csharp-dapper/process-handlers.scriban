{{-
# The guards and actions of a process (the generated half of a pair). Guards written in the expression language that helpers.js
# expr_cs renders, and guards and actions whose JavaScript is in the translatable subset (cs_expression), are implemented here;
# every other one is a partial method the companion
# <P>Handlers.cs implements, so a new stub fails the build until it is written. An action that sets the object's data calls
# Record<Name>, a partial method the companion implements (generated code has no object to write to yet); an action whose expression
# is not translated, or that has only sets, stays the companion's Action<Name> and the dispatch runs Run<Name>, which records, then
# runs it, so a companion that already implements the action still builds. Methods are Guard<Name> and Action<Name>, so a
# guard and an action may share a name. Also the command handler: load the instance
# through the store, run the machine, save, and return the result with the events for the outbox. A process that names actors
# taken from the object answers for them as the runtime's IActorResolver, one partial method per actor (actors-design.md
# decision 27).
include "_csharp.scriban"
include "_process.scriban"
p = process
name = p_name(p)
ctx = name + "Context"
call = "StatechartCall<" + ctx + ">"
relatives = relative_actors(p)
rights = uses_rights()
triggers = uses_triggers()
hooks = rights ? states_hooks(p) : []
conditions = rights ? inline_conditions(p) : []
-}}
{{ header() }}
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using {{ dispatch_ns() }};
using {{ runtime_ns() }};

namespace {{ ns(p) }};

/// <summary>The guards and actions of process {{ p.name }}.</summary>
public sealed partial class {{ name }}Handlers : IStatechartBehaviour<{{ ctx }}>{{ if relatives.size > 0 }}, IActorResolver<{{ ctx }}>{{ end }}{{ if hooks.size > 0 }}, ILifecycleStates<{{ ctx }}>{{ end }}
{
    /// <inheritdoc/>
    public bool Guard(string guard, {{ call }} call) => guard switch
    {
{{- for g in p.guards }}
        {{ json g.name }} => Guard{{ pascal g.name }}(call),
{{- end }}
        _ => throw new ArgumentOutOfRangeException(nameof(guard), guard, "Not a guard of {{ p.name }}."),
    };

    /// <inheritdoc/>
    public {{ ctx }} Action(string action, {{ call }} call) => action switch
    {
{{- for a in p.actions }}
        {{ json a.name }} => {{ a.sets.size > 0 && translate(p, a, "action") == "" ? "Run" : "Action" }}{{ pascal a.name }}(call),
{{- end }}
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Not an action of {{ p.name }}."),
    };

    /// <inheritdoc/>
    public IReadOnlyList<string> Changed({{ ctx }} before, {{ ctx }} after) => {{ ctx }}.Changed(before, after);
{{- for g in p.guards }}
{{- cs = translate(p, g, "guard") }}

    /// <summary>Guard {{ g.name }}{{ if g.expression }}: <c>{{ cs_line g.expression | escape_xml }}</c>{{ else if g.condition }}: <c>{{ cs_line g.condition.text | escape_xml }}</c>{{ end }}{{ if cs == "" }} (implemented in {{ name }}Handlers.cs){{ end }}.</summary>
{{- if cs != "" }}
    private static bool Guard{{ pascal g.name }}({{ call }} call) => {{ cs }};
{{- else }}
    private partial bool Guard{{ pascal g.name }}({{ call }} call);
{{- end }}
{{- end }}
{{- for a in p.actions }}
{{- cs = translate(p, a, "action") }}
{{- if a.sets.size > 0 }}
{{- sets = sets_text(a) }}

    /// <summary>Action {{ a.name }}{{ if a.expression }}: <c>{{ cs_line a.expression | escape_xml }}</c>,{{ end }} setting <c>{{ sets | escape_xml }}</c>{{ if cs == "" }} (implemented in {{ name }}Handlers.cs){{ end }}.</summary>
{{- if cs == "" }}
    private partial {{ ctx }} Action{{ pascal a.name }}({{ call }} call);

    /// <summary>Records what action {{ a.name }} sets on the object, then runs it.</summary>
    private {{ ctx }} Run{{ pascal a.name }}({{ call }} call)
    {
        Record{{ pascal a.name }}(call);
        return Action{{ pascal a.name }}(call);
    }
{{- else }}
    private {{ ctx }} Action{{ pascal a.name }}({{ call }} call)
    {
        Record{{ pascal a.name }}(call);
        return {{ cs }};
    }
{{- end }}

    /// <summary>Records on the object what action {{ a.name }} sets, each value from the object and the context before the action: <c>{{ sets | escape_xml }}</c> (implemented in {{ name }}Handlers.cs).</summary>
    private partial void Record{{ pascal a.name }}({{ call }} call);
{{- else }}

    /// <summary>Action {{ a.name }}{{ if a.expression }}: <c>{{ cs_line a.expression | escape_xml }}</c>{{ end }}{{ if cs == "" }} (implemented in {{ name }}Handlers.cs){{ end }}.</summary>
{{- if cs != "" }}
    private static {{ ctx }} Action{{ pascal a.name }}({{ call }} call) => {{ cs }};
{{- else }}
    private partial {{ ctx }} Action{{ pascal a.name }}({{ call }} call);
{{- end }}
{{- end }}
{{- end }}
{{- if relatives.size > 0 }}

    /// <inheritdoc/>
    public bool IsActor(string actor, ProcessSnapshot<{{ ctx }}> snapshot, ProcessEnvelope envelope) => actor switch
    {
{{- for a in relatives }}
        global::{{ actors_ns() }}.Actors.{{ actor_member a }} => Is{{ pascal a.name }}(snapshot, envelope),
{{- end }}
        _ => false,
    };
{{- for a in relatives }}

    /// <summary>Whether the caller is {{ a.name }}, {{ relative_text(a, subject_words(p)) }}{{ owner_fields(p, a) }} (implemented in {{ name }}Handlers.cs).</summary>
    private partial bool Is{{ pascal a.name }}(ProcessSnapshot<{{ ctx }}> snapshot, ProcessEnvelope envelope);
{{- end }}
{{- end }}
{{- if hooks.size > 0 }}

    /// <inheritdoc/>
    public IReadOnlyDictionary<string, IReadOnlyList<string>> StatesIn({{ call }} call)
    {
        var states = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal);
{{- for l in hooks }}
        if (StatesIn{{ pascal l.name }}(call) is { } in{{ pascal l.name }})
            states[{{ json l.name }}] = in{{ pascal l.name }};
{{- end }}
        return states;
    }
{{- for l in hooks }}

    /// <summary>The object's active state paths in lifecycle {{ l.name }}, which could say no to a verb an event of {{ p.name }} names; none means its initial state, and null that {{ l.name }} doesn't govern the object, so it isn't asked (implemented in {{ name }}Handlers.cs).</summary>
    private partial IReadOnlyList<string>? StatesIn{{ pascal l.name }}({{ call }} call);
{{- end }}
{{- end }}
}
{{- if conditions.size > 0 }}

/// <summary>The conditions of the rights of lifecycle {{ p.name }}: a right holds only when its condition is true (implemented in {{ name }}Handlers.cs).</summary>
public static partial class {{ name }}RightConditions
{
{{- for r in conditions }}
{{- if !for.first }}
{{ end }}
    /// <summary>The condition of right {{ r.name }}: <c>{{ cs_line r.condition_text | escape_xml }}</c>.</summary>
    /// <param name="request">The rights check.</param>
    /// <returns>Whether it holds.</returns>
    public static partial bool {{ pascal r.name }}(global::{{ actors_ns() }}.RightRequest request);
{{- end }}
}
{{- end }}

/// <summary>Handles the commands of process {{ p.name }}: loads the instance through the store, runs the machine and saves.</summary>
/// <param name="machine">The machine.</param>
/// <param name="store">The store.</param>
{{- if rights }}
/// <param name="holdings">What the caller holds besides the actor it acts as; the team's CallerHoldings when null.</param>
{{- if uses_freezing() }}
/// <param name="frozen">Whether an object, or a link of it, is frozen; the team's FrozenState when null.</param>
{{- end }}
public sealed partial class {{ name }}CommandHandler({{ name }}Machine machine, I{{ name }}Store store, ICallerHoldings? holdings = null{{ if uses_freezing() }}, {{ frozen_state_type() }}? frozen = null{{ end }}) :
{{- else }}
{{- if uses_freezing() }}
/// <param name="frozen">Whether an object, or a link of it, is frozen; the team's FrozenState when null.</param>
{{- end }}
public sealed partial class {{ name }}CommandHandler({{ name }}Machine machine, I{{ name }}Store store{{ if uses_freezing() }}, {{ frozen_state_type() }}? frozen = null{{ end }}) :
{{- end }}
    ICommandHandler<{{ name }}StartControl>,
{{- for e in p.events }}
    ICommandHandler<{{ command_type(p, e) }}>,
{{- end }}
    ICommandHandler<{{ name }}InvokeResultControl>,
    ICommandHandler<{{ name }}TimersDueControl>
{
    /// <inheritdoc/>
    public async Task<CommandResult> HandleAsync({{ name }}StartControl command, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(command);
        if (await store.LoadAsync(command.Envelope.Instance, cancellationToken).ConfigureAwait(false) is { } existing)
            return Result(machine.Refused(existing, Refusals.Instance, ":start"), []);
        return await SaveAsync(machine.Start(command.Envelope.Instance, command.Context), cancellationToken).ConfigureAwait(false);
    }
{{- for e in p.events }}

{{- if rights }}

    /// <inheritdoc/>
    public async Task<CommandResult> HandleAsync({{ command_type(p, e) }} command, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(command);
        var held = await Holdings.HeldAsync(command.Envelope, cancellationToken).ConfigureAwait(false);
        return await RunAsync(command.Envelope.Instance, {{ json e.name }}, snapshot => machine.{{ pascal e.name }}(snapshot, command, held{{ if uses_freezing() }}, Frozen{{ end }}), cancellationToken).ConfigureAwait(false);
    }
{{- else }}

    /// <inheritdoc/>
    public Task<CommandResult> HandleAsync({{ command_type(p, e) }} command, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(command);
        return RunAsync(command.Envelope.Instance, {{ json e.name }}, snapshot => machine.{{ pascal e.name }}(snapshot, command{{ if uses_freezing() }}, Frozen{{ end }}), cancellationToken);
    }
{{- end }}
{{- end }}
{{- if rights }}

    /// <inheritdoc/>
    public async Task<CommandResult> HandleAsync({{ name }}InvokeResultControl command, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(command);
        var held = await Holdings.HeldAsync(command.Envelope, cancellationToken).ConfigureAwait(false);
        return await RunAsync(command.Envelope.Instance, command.Invoke, snapshot => machine.Complete(snapshot, command, held{{ if uses_freezing() }}, Frozen{{ end }}), cancellationToken).ConfigureAwait(false);
    }
{{- else }}

    /// <inheritdoc/>
    public Task<CommandResult> HandleAsync({{ name }}InvokeResultControl command, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(command);
        return RunAsync(command.Envelope.Instance, command.Invoke, snapshot => machine.Complete(snapshot, command{{ if uses_freezing() }}, Frozen{{ end }}), cancellationToken);
    }
{{- end }}

    /// <inheritdoc/>
    public Task<CommandResult> HandleAsync({{ name }}TimersDueControl command, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(command);
        return RunAsync(command.Envelope.Instance, ":time", machine.Tick, cancellationToken);
    }

    /// <inheritdoc/>
    public async Task<CommandResult> RefuseAsync(string instance, string input, string refusal, CancellationToken cancellationToken)
    {
        var snapshot = await store.LoadAsync(instance, cancellationToken).ConfigureAwait(false);
        return snapshot is null ? CommandResult.Refused(refusal) : Result(machine.Refused(machine.Restore(snapshot), refusal, input), []);
    }

    private async Task<CommandResult> RunAsync(string instance, string input, Func<ProcessSnapshot<{{ ctx }}>, StepResult<{{ ctx }}>> step, CancellationToken cancellationToken)
    {
        var snapshot = await store.LoadAsync(instance, cancellationToken).ConfigureAwait(false);
        if (snapshot is null)
            return CommandResult.Refused(Refusals.Instance);
        return await SaveAsync(step(machine.Restore(snapshot)), cancellationToken).ConfigureAwait(false);
    }

    private async Task<CommandResult> SaveAsync(StepResult<{{ ctx }}> step, CancellationToken cancellationToken)
    {
        var events = new List<object>();
        if (step.Accepted || step.Audit.Count > 0)
        {
            // The store saves only over the version this command loaded, so two commands on one instance cannot both win.
            var expected = step.Snapshot.Version;
            step.Snapshot.Version = expected + 1;
            await store.SaveAsync(step.Snapshot, expected, cancellationToken).ConfigureAwait(false);
        }

        if (step.Accepted && step.Moved)
        {
            var moved = new {{ name }}Transitioned(step.Snapshot.Instance, step.From, step.States, step.Input, step.At);
            await store.AppendHistoryAsync([moved], cancellationToken).ConfigureAwait(false);
            events.Add(moved);
        }

        if (step.Audit.Count > 0)
        {
            await store.AppendAuditAsync(step.Audit, cancellationToken).ConfigureAwait(false);
            foreach (var record in step.Audit)
                events.Add(Typed(record));
        }
{{- if triggers }}

        // After-commit work joins the result's events, so the outbox stores it only if the command commits (trigger-points-design.md
        // decision 31). Its id is stable: the instance, the version this command saved, the trigger point and its place in the command.
        if (step.Accepted)
        {
            for (var i = 0; i < step.AfterCommit.Count; i++)
            {
                var message = step.AfterCommit[i];
                events.Add(message with { MessageId = string.Join('/', step.Snapshot.Instance, step.Snapshot.Version.ToString(global::System.Globalization.CultureInfo.InvariantCulture), message.TriggerPoint, i.ToString(global::System.Globalization.CultureInfo.InvariantCulture)) });
            }
        }
{{- end }}

        machine.Publish(step);
        return Result(step, events);
    }

{{- if rights }}

    // Asked once per command: what the caller holds comes from the host, never from the command (rights-design.md decision 29).
    private ICallerHoldings Holdings { get; } = holdings ?? new CallerHoldings();
{{- end }}
{{- if uses_freezing() }}

    // Whether the object, or a link of it, is frozen: the host's answer (rights-design.md decision 19), asked by the run when a check needs it.
    private {{ frozen_state_type() }} Frozen { get; } = frozen ?? new {{ frozen_state_stub() }}();
{{- end }}

    private static CommandResult Result(StepResult<{{ ctx }}> step, IReadOnlyList<object> events) =>
        new(step.Accepted, step.Refusal, step.States, step.Changed, step.Final, step.Context, events) { Audit = step.Audit, Failure = step.Failure{{ if rights || triggers }}, RefusedBy = step.RefusedBy{{ end }}{{ if triggers }}, CheckWarnings = step.CheckWarnings, TriggerPoints = step.TriggerPoints{{ end }} };

    private static object Typed(GateAuditRecord record) => record.Gate switch
    {
{{- for g in p.gates }}
        {{ json g.id }} => {{ name }}{{ pascal g.name }}AuditRecord.From(record),
{{- end }}
        _ => record,
    };
}
