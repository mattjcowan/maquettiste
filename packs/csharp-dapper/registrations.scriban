{{-
# One registration file per package (file blocks): the package's repository interfaces and implementations, for any
# dependency-injection container; and one for the query classes (Queries/QueryRegistrations.g.cs) when the model has queries.
include "_csharp.scriban"
include "_dapper.scriban"
for p in model.packages
  entities = []
  for e in p.entities
    if has_repository(e)
      entities[entities.size] = e
    end
  end
  if entities.size == 0
    continue
  end
  class_name = (pascal p.name) + "Repositories"
-}}
{{- capture content -}}
{{ header() }}
using System;
using System.Collections.Generic;

namespace {{ ns(entities[0]) }};

/// <summary>The Dapper repositories of package {{ p.qualified_name }}.</summary>
/// <example><code>{{ class_name }}.Register((service, implementation) => services.AddScoped(service, implementation));</code></example>
public static partial class {{ class_name }}
{
    /// <summary>Every repository of the package: the interface to register and the class that implements it.</summary>
    public static IReadOnlyList<(Type Service, Type Implementation)> All { get; } =
    [
{{- for e in entities }}
        (typeof(I{{ type_name(e) }}Repository), typeof({{ type_name(e) }}Repository)),
{{- end }}
    ];

    /// <summary>Calls <paramref name="register"/> once per repository.</summary>
    public static void Register(Action<Type, Type> register)
    {
        ArgumentNullException.ThrowIfNull(register);
        foreach (var (service, implementation) in All)
            register(service, implementation);
    }
}
{{ end -}}
{{- file (join_path pack.params.generatedFolder (package_folder entities[0]) (class_name + ".g.cs")) content -}}
{{- end -}}
{{-
queries = []
for db in model.databases
  for q in db.queries
    queries[queries.size] = q
  end
end
if queries.size > 0
-}}
{{- capture content -}}
{{ header() }}
using System;
using System.Collections.Generic;

namespace {{ pack.params.namespace }}.Queries;

/// <summary>The Dapper query classes of the model.</summary>
/// <example><code>QueryRegistrations.Register((service, implementation) => services.AddScoped(service, implementation));</code></example>
public static partial class QueryRegistrations
{
    /// <summary>Every query class: the interface to register and the class that implements it.</summary>
    public static IReadOnlyList<(Type Service, Type Implementation)> All { get; } =
    [
{{- for q in queries }}
        (typeof(I{{ cs_class (pascal q.name) }}Query), typeof({{ cs_class (pascal q.name) }}Query)),
{{- end }}
    ];

    /// <summary>Calls <paramref name="register"/> once per query class.</summary>
    public static void Register(Action<Type, Type> register)
    {
        ArgumentNullException.ThrowIfNull(register);
        foreach (var (service, implementation) in All)
            register(service, implementation);
    }
}
{{ end -}}
{{- file (join_path pack.params.generatedFolder "Queries" "QueryRegistrations.g.cs") content -}}
{{- end -}}
