{{-
include "_csharp.scriban"
include "_dapper.scriban"
name = type_name(entity)
m = dapper_mapping(entity)
own = []
for a in entity.attributes
  if !a.is_inherited
    own[own.size] = a
  end
end
usings = namespaces_used(entity, own)
if entity.base && ns(entity.base) != ns(entity) && !(usings | array.contains ns(entity.base))
  usings[usings.size] = ns(entity.base)
  usings = usings | array.sort
end
inherited = inherited_storage(entity)
storage = []
for c in storage_columns(entity, m)
  if !(inherited | array.contains row_prop(c))
    storage[storage.size] = c
  end
end
binding_keys = bind_key_fields(entity)
# The entity's checks in the expression language (next-phase-3-design.md section 3.1) become Validate(); a derived entity whose checks
# are all its base's keeps the base's.
own_checks = []
for c in entity.checks
  if !c.is_inherited
    own_checks[own_checks.size] = c
  end
end

# What the checks read, for expr_cs: each attribute by its property.
func check_spec(e, owner)
  $out = ""
  for a in e.attributes
    if !a.collection
      $out = $out + ($out == "" ? "" : ";") + expr_entry(a.name, prop_name(a, owner), prop_type(a), a)
    end
  end
  ret $out
end
-}}
{{ header() }}
using System;
using System.Collections.Generic;
using System.Text.Json;
{{- for u in usings }}
using {{ u }};
{{- end }}

namespace {{ ns(entity) }};

{{ doc(entity.description, "") }}public {{ if entity.is_abstract }}abstract {{ end }}partial class {{ name }}{{ if entity.base }} : {{ type_name(entity.base) }}{{ end }}
{
{{- for a in own }}
{{ doc(a.description, "    ") }}    public {{ prop_type(a) }} {{ prop_name(a, name) }} { get; set; }{{ initializer(a) }}
{{- end }}
{{- if storage.size > 0 }}

    // Columns of table {{ m.table.name }} (database {{ m.database.name }}) that no attribute maps, such as foreign keys.
{{- for c in storage }}
    public {{ row_type(c) }} {{ row_prop(c) }} { get; set; }{{ if !c.nullable && !(cs_value_type row_type(c)) }} = default!;{{ end }}
{{- end }}
{{- end }}
{{- if binding_keys.size > 0 }}

    // Keys of the relations the entity's binding maps (they lead to the related entities' keys).
{{- for f in binding_keys }}
    public {{ bind_row_type(f) }} {{ cs_ident (pascal f.name) }} { get; set; }{{ if !bind_nullable(f) && !(cs_value_type bind_row_type(f)) }} = default!;{{ end }}
{{- end }}
{{- end }}
{{- if own_checks.size > 0 }}
{{- spec = check_spec(entity, name) }}

    /// <summary>
    /// The checks of {{ entity.name | escape_xml }} this record fails, one error each: the JSON pointer of the attribute it points at, the
    /// check's name as its code, and its message. A check whose answer is unknown (a value it reads is null) passes, as a CHECK does.
    /// </summary>
    /// <returns>The errors; empty when every check passes.</returns>
    public {{ entity.base && entity.base.checks.size > 0 ? "override" : "virtual" }} IReadOnlyList<(string Pointer, string Code, string Message)> Validate()
    {
        var errors = new List<(string Pointer, string Code, string Message)>();
{{- for c in entity.checks }}
{{- cs = c.condition ? (expr_cs c.condition spec) : "" }}
{{- if cs != "" }}
        if ({{ cs }} == false)
            errors.Add(({{ json (c.attribute ? "/" + c.attribute.name : "") }}, {{ json c.name }}, {{ json (c.message ?? c.condition.text) }}));
{{- else }}
        // Check {{ c.name }}{{ if c.condition }} ({{ cs_line c.condition.text }}){{ end }} is outside what expr_cs renders: validate it in {{ name }}.cs.
{{- end }}
{{- end }}
        return errors;
    }
{{- end }}
}
