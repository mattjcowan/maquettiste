{{-
# One xunit test per scenario: every step sent through the dispatcher to the generated interpreter on a manual clock, then
# acceptance (with the engine's refusal reason for a refused step), the gate audit outcomes the engine's replay wrote, the
# active states and the changed context asserted after each step, and the outcome after the last. The test
# project supplies ScenarioHost (StartAsync(ManualClock, CancellationToken) and Dispatcher), which wires the stores. Written
# only when the testsFolder parameter names a folder. A failing test is fixed in the model or in a handler, never here.
include "_csharp.scriban"
include "_process.scriban"
s = scenario
p = s.process
name = p_name(p)
ctx = name + "Context"
test = (pascal s.name) + "Tests"
rights = uses_rights()
# The refusal a refused step asserts: the one the file expects, else the engine's replay's.
func refusal_of(step)
  if step.expect && step.expect.refusal
    ret step.expect.refusal
  end
  ret step.trace ? step.trace.refusal : null
end
# The actor a verb step acts as: the replay's, else the step's, else the participant's actor or first holding with no context.
func verb_actor(step)
  if step.acts_as
    ret step.acts_as
  end
  if step.actor
    ret step.actor
  end
  if step.participant
    if step.participant.actor
      ret step.participant.actor
    end
    for h in step.participant.holds
      if !h.within
        ret h.actor
      end
    end
  end
  ret null
end
# What a step's participant holds with no context (rights-design.md decision 24): its actor and its holdings without a within.
func held(step)
  $out = []
  if step.participant
    if step.participant.actor
      $out[$out.size] = "Actors." + actor_member(step.participant.actor)
    end
    for h in step.participant.holds
      if !h.within
        $out[$out.size] = "Actors." + actor_member(h.actor)
      end
    end
  end
  ret "[" + ($out | array.join ", ") + "]"
end
# Whether a step depends on a held actor (rights-design.md decision 24): its participant holds, with no context, an actor besides the one
# the step acts as, which only ScenarioHoldings hands to the command handlers. Only such a step asserts that they asked.
func depends_on_holdings(step)
  $acting = step.acts_as
  if step.participant.actor && (!$acting || step.participant.actor.id != $acting.id)
    ret true
  end
  for h in step.participant.holds
    if !h.within && (!$acting || h.actor.id != $acting.id)
      ret true
    end
  end
  ret false
end
# The actors from the object a verb step's participant satisfied in the engine's replay: the request's resolver answers yes for these.
func object_actors(step)
  ret step.trace ? step.trace.object_actors : []
end
# The scenario subject's states in the other lifecycles that could say no (process.may_refuse), by lifecycle name, for verb steps.
other_states = {}
other_names = []
if rights && s.subject
  for m in p.may_refuse
    $ids = {}
    for x in m.lifecycle.all_states
      $ids[x.id] = true
    end
    $l = []
    for st in s.subject.states
      if $ids[st.id]
        $l[$l.size] = st.path
      end
    end
    if $l.size > 0
      other_states[m.lifecycle.name] = $l
      other_names[other_names.size] = m.lifecycle.name
    end
  end
end
func has(map, key)
  ret map | object.has_key key
end
# The signer a step sends: its own, else for an event step by a participant the participant's identity, as the engine's replay
# does (actors-design.md decision 15).
func signer(step)
  if step.signer
    ret step.signer
  end
  ret step.participant && step.input == "event" ? ("" + step.participant.identity) : null
end
# The step's actor is the one it acts as (RStep.ActsAs): the step's own actor, or the one the engine worked out for its participant.
func envelope(step)
  $parts = "Instance"
  if step.acts_as
    $parts = $parts + ", Actor: Actors." + actor_member(step.acts_as)
  end
  if signer(step)
    $parts = $parts + ", Signer: " + (json signer(step))
  end
  if step.meaning
    $parts = $parts + ", Meaning: " + (json step.meaning.name)
  end
  if step.reason
    $parts = $parts + ", Reason: " + (json step.reason)
  end
  ret "new ProcessEnvelope(" + $parts + ")"
end
func command(step)
  if step.input == "time"
    ret "new " + name + "TimersDueControl(" + envelope(step) + ")"
  else if step.input == "invoke-done" || step.input == "invoke-error"
    ret "new " + name + "InvokeResultControl(" + envelope(step) + ", " + (json step.invoke.name) + (step.input == "invoke-error" ? ", Failed: true" : "") + ")"
  end
  $cmd = command_type(p, step.event)
  $init = ""
  for a in step.event.payload
    if has(step.payload, a.name)
      $init = $init + ($init == "" ? "" : ", ") + prop_name(a, $cmd) + " = " + cs_literal(step.payload[a.name], a)
    else if a.required
      $init = $init + ($init == "" ? "" : ", ") + prop_name(a, $cmd) + " = default!"
    end
  end
  for a in audit_attributes(step.event)
    if has(step.payload, a.name) && !by_name(step.event.payload, a.name)
      $init = $init + ($init == "" ? "" : ", ") + prop_name(a, $cmd) + " = " + cs_literal(step.payload[a.name], a)
    end
  end
  ret "new " + $cmd + "(" + envelope(step) + ")" + ($init == "" ? "" : " { " + $init + " }")
end
func step_text(step)
  $by = step.participant ? (" by " + step.participant.name + (step.acts_as ? " as " + step.acts_as.name : "")) : (step.actor ? " by " + step.actor.name : "")
  if step.input == "verb"
    ret (step.verb ? step.verb.key : "a verb") + (step.end ? " through " + step.end.name : "") + $by
  else if step.input == "time"
    ret "time +" + step.after
  else if step.input == "invoke-done" || step.input == "invoke-error"
    ret step.input + " " + step.invoke.name + $by
  end
  ret step.event.name + $by + (signer(step) ? ", signed by " + signer(step) : "")
end
start = ""
for a in p.context
  if has(s.start.context, a.name)
    start = start + (start == "" ? "" : ", ") + prop_name(a, ctx) + " = " + cs_literal(s.start.context[a.name], a)
  end
end
if pack.params.testsFolder != ""
-}}
{{- capture content -}}
{{ header() }}
using System;
{{- if rights }}
using System.Collections.Generic;
{{- end }}
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;
using {{ actors_ns() }};
using {{ runtime_ns() }};
using Xunit;

namespace {{ ns(p) }}.Tests;

/// <summary>Scenario {{ s.name }} of process {{ p.name }}{{ if s.description }}: {{ cs_line s.description | string.strip | escape_xml }}{{ end }}</summary>
public sealed class {{ test }}
{
    private const string Instance = {{ json (ulid_uuid s.id) }};

    /// <summary>Runs the {{ s.steps.size }} steps of {{ s.name }} and checks each one and the outcome ({{ s.outcome }}).</summary>
    /// <returns>The task.</returns>
    [Fact]
    public async Task {{ pascal s.name }}()
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        var clock = new ManualClock(DateTimeOffset.Parse({{ json s.start.at }}, CultureInfo.InvariantCulture));
        await using var host = await ScenarioHost.StartAsync(clock, cancellationToken);
        var result = await host.Dispatcher.SendAsync(new {{ name }}StartControl(new ProcessEnvelope(Instance)) { Context = new {{ ctx }}{{ if start != "" }} { {{ start }} }{{ else }}(){{ end }} }, cancellationToken);
        Assert.True(result.Accepted, result.Refusal);
{{- for step in s.steps }}

        // Step {{ step.index + 1 }}: {{ cs_line step_text(step) }}.{{ if step.description }} {{ cs_line step.description | string.strip }}{{ end }}
{{- if step.input == "verb" }}
{{- if rights }}
{{- $actor = verb_actor(step) }}
        var decision{{ step.index + 1 }} = Rights.Check(new RightRequest
        {
            Verb = {{ step.verb ? ("global::" + base_ns + ".Verb." + (pascal step.verb.key)) : "null" }},
{{- if p.use == "lifecycle" }}
            Lifecycle = {{ json p.name }},
{{- end }}
{{- if s.subject }}
            Subject = typeof(global::{{ ns(s.subject.entity) }}.{{ type_name(s.subject.entity) }}),
{{- end }}
{{- if $actor }}
            Actor = Actors.{{ actor_member $actor }},
{{- end }}
            Held = {{ held(step) }},
            States = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal)
            {
                [{{ json p.name }}] = result.States ?? [],
{{- for n in other_names }}
                [{{ json n }}] = [{{ for x in other_states[n] }}{{ for.first ? "" : ", " }}{{ json x }}{{ end }}],
{{- end }}
            },
{{- if step.end }}
            End = {{ json step.end.name }},
{{- end }}
{{- $from = object_actors(step) }}
{{- if $from.size > 0 }}
            Resolves = actor => actor is {{ for a in $from }}{{ for.first ? "" : " or " }}Actors.{{ actor_member a }}{{ end }},
{{- end }}
        });
{{- if step.expect }}
{{- if step.expect.accepted }}
        Assert.True(decision{{ step.index + 1 }}.Allowed, decision{{ step.index + 1 }}.Refusal);
{{- else }}
        Assert.False(decision{{ step.index + 1 }}.Allowed);
{{- if refusal_of(step) }}
        Assert.Equal({{ json refusal_of(step) }}, decision{{ step.index + 1 }}.Refusal);
{{- end }}
{{- if step.expect.refused_by }}
        Assert.Equal({{ json step.expect.refused_by }}, decision{{ step.index + 1 }}.RefusedBy);
{{- end }}
{{- end }}
{{- end }}
{{- else }}
        // Nothing in the model can refuse this verb: no lifecycle states rights or a default.
{{- end }}
{{- else }}
{{- if step.input == "time" }}
        clock.Advance(TimeSpan.FromTicks({{ step.after_ticks }}));
{{- end }}
{{- $holds = rights && step.participant && step.input != "time" }}
{{- if $holds }}
        ScenarioHoldings.Current = {{ held(step) }};
{{- end }}
        result = await host.Dispatcher.SendAsync({{ command(step) }}, cancellationToken);
{{- if $holds }}
{{- if depends_on_holdings(step) && refusal_of(step) != "actor" && refusal_of(step) != "validation" && refusal_of(step) != "instance" }}
        var asked{{ step.index + 1 }} = ScenarioHoldings.Asked;
        ScenarioHoldings.Current = null;
        Assert.True(asked{{ step.index + 1 }}, "The command handlers did not ask ScenarioHoldings for the participant's held actors: register it in ScenarioHost in place of the CallerHoldings stub.");
{{- else }}
        ScenarioHoldings.Current = null;
{{- end }}
{{- end }}
{{- if step.expect }}
{{- if step.expect.accepted }}
        Assert.True(result.Accepted, result.Refusal);
{{- else }}
        Assert.False(result.Accepted);
{{- if refusal_of(step) }}
        Assert.Equal({{ json refusal_of(step) }}, result.Refusal);
{{- end }}
{{- if rights && step.expect.refused_by }}
        Assert.Equal({{ json step.expect.refused_by }}, result.RefusedBy);
{{- end }}
{{- end }}
{{- if step.trace && step.trace.audit.size > 0 }}
        Assert.Equal<string>([{{ for x in step.trace.audit }}{{ if !for.first }}, {{ end }}{{ json x }}{{ end }}], [.. result.Audit.Select(a => a.OutcomeText)]);
{{- end }}
{{- if step.expect.state_paths.size > 0 }}
        Assert.Equal<string>([{{ for x in step.expect.state_paths }}{{ if !for.first }}, {{ end }}{{ json x }}{{ end }}], result.States);
{{- end }}
{{- changed = [] }}
{{- for a in p.context }}{{ if has(step.expect.context, a.name) }}{{ changed[changed.size] = a }}{{ end }}{{ end }}
        Assert.Equal<string>([{{ for a in changed }}{{ if !for.first }}, {{ end }}{{ json a.name }}{{ end }}], result.Changed);
{{- for a in changed }}
        Assert.Equal({{ cs_literal(step.expect.context[a.name], a) }}, (({{ ctx }})result.Context!).{{ prop_name(a, ctx) }});
{{- end }}
{{- end }}
{{- end }}
{{- end }}

        Assert.{{ s.outcome == "final" ? "True" : "False" }}(result.Final);
    }
}
{{ end -}}
{{- file (join_path pack.params.testsFolder (p_name(p)) (test + ".cs")) content -}}
{{- end -}}
