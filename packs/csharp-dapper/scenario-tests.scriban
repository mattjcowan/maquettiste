{{-
# One xunit test per scenario: every step sent through the dispatcher to the generated interpreter on a manual clock, then
# acceptance (with the engine's refusal reason for a refused step), the gate audit outcomes the engine's replay wrote, the
# active states and the changed context asserted after each step, and the outcome after the last. The test
# project supplies ScenarioHost (StartAsync(ManualClock, CancellationToken) and Dispatcher), which wires the stores. Written
# only when the testsFolder parameter names a folder. A failing test is fixed in the model or in a handler, never here.
include "_csharp.scriban"
include "_process.scriban"
s = scenario
p = s.process
name = p_name(p)
ctx = name + "Context"
test = (pascal s.name) + "Tests"
rights = uses_rights()
triggers = uses_triggers()
# The per-type runner a verb step goes through (trigger-points-design.md decision 30): the subject's entity's, when its governing
# lifecycles have trigger points and the verb is an object, link or own verb; else null, and the step is checked as before.
func runner_of(step)
  if !triggers || !s.subject || step.input != "verb" || !step.verb
    ret null
  end
  if step.verb.group == "move" || step.verb.group == "signature" || step.verb.group == "task"
    ret null
  end
  ret has_runner(s.subject.entity) ? s.subject.entity : null
end
# The trigger point a step's assume word names (decision 26): this lifecycle's by name, another's by "Lifecycle.Name" or "LifecycleId.Name";
# a named one by its qualified name ("Package.Name", or the name in the root package), or by its id where that would clash.
func assumed_point(key)
  for $l in model.trigger_lifecycles
    for $tp in $l.trigger_points
      if ($l.id == p.id && $tp.name == key) || ($l.name + "." + $tp.name) == key || ($l.id + "." + $tp.name) == key
        ret $tp
      end
    end
  end
  for $tp in model.trigger_points
    if $tp.id == key || ($tp.package ? ($tp.package.qualified_name + "." + $tp.name) : $tp.name) == key
      ret $tp
    end
  end
  ret null
end
# Whether some trigger point reaches outside systems in the command (not after commit), so each step sets ScenarioTriggers (decision 22).
stands_in = false
if triggers
  for $l in model.trigger_lifecycles
    for $tp in $l.trigger_points
      if $tp.outside && $tp.timing != "after-commit"
        stands_in = true
      end
    end
  end
  for $tp in model.trigger_points
    if $tp.outside && $tp.timing != "after-commit"
      stands_in = true
    end
  end
end

# The words a step assumes for outside team-code checks, as a dictionary initializer, which ScenarioTriggers answers.
func outside_words(step)
  $out = []
  for $kv in step.assume
    if ($kv.value | object.typeof) == "string"
      $tp = assumed_point($kv.key)
      if $tp && $tp.outside
        $out[$out.size] = "[" + (json $tp.id) + "] = " + (json $kv.value)
      end
    end
  end
  ret $out | array.join ", "
end
# A verb step's values as the runner's proposed values (decision 25), as a dictionary initializer: the subject's attribute by name.
func proposed(step)
  $out = []
  for kv in step.values
    for $a in s.subject.entity.attributes
      if $a.name == kv.key
        $out[$out.size] = "[" + (json kv.key) + "] = " + cs_literal(kv.value, $a)
      end
    end
  end
  ret $out | array.join ", "
end
# The scenario subject's state paths in another lifecycle, else that lifecycle's initial state.
func states_in(l)
  $ids = {}
  for x in l.all_states
    $ids[x.id] = true
  end
  $out = []
  for st in s.subject.states
    if $ids[st.id]
      $out[$out.size] = st.path
    end
  end
  if $out.size == 0
    $out[0] = initial_path(l)
  end
  ret $out
end
# The refusal a refused step asserts: the one the file expects, else the engine's replay's.
func refusal_of(step)
  if step.expect && step.expect.refusal
    ret step.expect.refusal
  end
  ret step.trace ? step.trace.refusal : null
end
# The actor a verb step acts as: the replay's, else the step's, else the participant's actor or first holding with no context.
func verb_actor(step)
  if step.acts_as
    ret step.acts_as
  end
  if step.actor
    ret step.actor
  end
  if step.participant
    if step.participant.actor
      ret step.participant.actor
    end
    for h in step.participant.holds
      if !h.within
        ret h.actor
      end
    end
  end
  ret null
end
# What a step's participant holds with no context (rights-design.md decision 24): its actor and its holdings without a within.
func held(step)
  $out = []
  if step.participant
    if step.participant.actor
      $out[$out.size] = "Actors." + actor_member(step.participant.actor)
    end
    for h in step.participant.holds
      if !h.within
        $out[$out.size] = "Actors." + actor_member(h.actor)
      end
    end
  end
  ret "[" + ($out | array.join ", ") + "]"
end
# Whether a step depends on a held actor (rights-design.md decision 24): its participant holds, with no context, an actor besides the one
# the step acts as, which only ScenarioHoldings hands to the command handlers. Only such a step asserts that they asked.
func depends_on_holdings(step)
  $acting = step.acts_as
  if step.participant.actor && (!$acting || step.participant.actor.id != $acting.id)
    ret true
  end
  for h in step.participant.holds
    if !h.within && (!$acting || h.actor.id != $acting.id)
      ret true
    end
  end
  ret false
end
# The actors from the object a verb step's participant satisfied in the engine's replay: the request's resolver answers yes for these.
func object_actors(step)
  ret step.trace ? step.trace.object_actors : []
end
# The scenario subject's states in the other lifecycles that could say no (process.may_refuse), by lifecycle name, for verb steps.
other_states = {}
other_names = []
if rights && s.subject
  for m in p.may_refuse
    $ids = {}
    for x in m.lifecycle.all_states
      $ids[x.id] = true
    end
    $l = []
    for st in s.subject.states
      if $ids[st.id]
        $l[$l.size] = st.path
      end
    end
    if $l.size > 0
      other_states[m.lifecycle.name] = $l
      other_names[other_names.size] = m.lifecycle.name
    end
  end
end
func has(map, key)
  ret map | object.has_key key
end
# The signer a step sends: its own, else for an event step by a participant the participant's identity, as the engine's replay
# does (actors-design.md decision 15).
func signer(step)
  if step.signer
    ret step.signer
  end
  ret step.participant && step.input == "event" ? ("" + step.participant.identity) : null
end
# The step's actor is the one it acts as (RStep.ActsAs): the step's own actor, or the one the engine worked out for its participant.
func envelope(step)
  $parts = "Instance"
  if step.acts_as
    $parts = $parts + ", Actor: Actors." + actor_member(step.acts_as)
  end
  if signer(step)
    $parts = $parts + ", Signer: " + (json signer(step))
  end
  if step.meaning
    $parts = $parts + ", Meaning: " + (json step.meaning.name)
  end
  if step.reason
    $parts = $parts + ", Reason: " + (json step.reason)
  end
  ret "new ProcessEnvelope(" + $parts + ")"
end
func command(step)
  if step.input == "time"
    ret "new " + name + "TimersDueControl(" + envelope(step) + ")"
  else if step.input == "invoke-done" || step.input == "invoke-error"
    ret "new " + name + "InvokeResultControl(" + envelope(step) + ", " + (json step.invoke.name) + (step.input == "invoke-error" ? ", Failed: true" : "") + ")"
  end
  $cmd = command_type(p, step.event)
  $init = ""
  for a in step.event.payload
    if has(step.payload, a.name)
      $init = $init + ($init == "" ? "" : ", ") + prop_name(a, $cmd) + " = " + cs_literal(step.payload[a.name], a)
    else if a.required
      $init = $init + ($init == "" ? "" : ", ") + prop_name(a, $cmd) + " = default!"
    end
  end
  for a in audit_attributes(step.event)
    if has(step.payload, a.name) && !by_name(step.event.payload, a.name)
      $init = $init + ($init == "" ? "" : ", ") + prop_name(a, $cmd) + " = " + cs_literal(step.payload[a.name], a)
    end
  end
  ret "new " + $cmd + "(" + envelope(step) + ")" + ($init == "" ? "" : " { " + $init + " }")
end
func step_text(step)
  $by = step.participant ? (" by " + step.participant.name + (step.acts_as ? " as " + step.acts_as.name : "")) : (step.actor ? " by " + step.actor.name : "")
  if step.input == "verb"
    ret (step.verb ? step.verb.key : "a verb") + (step.end ? " through " + step.end.name : "") + $by
  else if step.input == "time"
    ret "time +" + step.after
  else if step.input == "invoke-done" || step.input == "invoke-error"
    ret step.input + " " + step.invoke.name + $by
  end
  ret step.event.name + $by + (signer(step) ? ", signed by " + signer(step) : "")
end
# Freezing (rights-design.md decisions 16 to 19 and 28). A scenario's frozen keys reach only its own test. Whether the subject, and
# each link of it, is frozen before a step is worked out from the file: the start, then each accepted freeze or thaw, from a verb
# step (with end and object, of that link) or an event that names the verb (of the subject).
func verb_key_of(step)
  if step.input == "verb"
    ret step.verb ? step.verb.key : null
  end
  ret step.event && step.event.verb ? step.event.verb.key : null
end
func link_key(step)
  ret step.end && step.object ? step.end.id + "/" + step.object.id : null
end
freezes = false
link_frozen = {}
frozen_now = false
if s.subject
  frozen_now = s.subject.frozen
  for l in s.subject.links
    link_frozen[l.end.id + "/" + l.object.id] = l.frozen
    if l.frozen
      freezes = true
    end
  end
end
if frozen_now
  freezes = true
end
frozen_before = []
link_before = []
any_link_before = []
for step in s.steps
  fz_key = verb_key_of(step)
  if fz_key == "freeze" || fz_key == "thaw" || refusal_of(step) == "frozen"
    freezes = true
  end
  frozen_before[step.index] = frozen_now
  fz_any = false
  for kv in link_frozen
    if kv.value
      fz_any = true
    end
  end
  any_link_before[step.index] = fz_any
  fz_link = link_key(step)
  link_before[step.index] = fz_link ? link_frozen[fz_link] == true : fz_any
  fz_accepted = step.expect ? step.expect.accepted : (step.trace ? step.trace.accepted : false)
  if fz_accepted && (fz_key == "freeze" || fz_key == "thaw")
    if step.input == "verb" && fz_link
      link_frozen[fz_link] = fz_key == "freeze"
    else
      frozen_now = fz_key == "freeze"
    end
  end
end
# Whether generated code holds freezing (Freezing.cs): asked only when the test calls the rights check or the scenario freezes.
freezing = (rights || freezes) && uses_freezing()
# Whether each send sets ScenarioFrozen from the replay: only when the scenario freezes, so other tests are left as they were.
frozen_sends = freezes && freezing
attribute_rights = rights && uses_attribute_rights()
# The names of the attributes a verb step reads or modifies, for a request's Attributes.
func step_attributes(step)
  $names = []
  for a in step.attributes
    $names[$names.size] = a.name
  end
  for kv in step.values
    $names[$names.size] = kv.key
  end
  ret $names
end
# The frozen query of a step, for FrozenFlags.
func frozen_query(step)
  ret "new FrozenQuery { Process = " + (json p.name) + ", Envelope = new ProcessEnvelope(Instance)" + (step.end ? ", End = " + (json step.end.name) : "") + " }"
end
start = ""
for a in p.context
  if has(s.start.context, a.name)
    start = start + (start == "" ? "" : ", ") + prop_name(a, ctx) + " = " + cs_literal(s.start.context[a.name], a)
  end
end
if pack.params.testsFolder != ""
-}}
{{- capture content -}}
{{ header() }}
using System;
{{- if rights || triggers }}
using System.Collections.Generic;
{{- end }}
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;
using {{ actors_ns() }};
using {{ runtime_ns() }};
using Xunit;

namespace {{ ns(p) }}.Tests;

/// <summary>Scenario {{ s.name }} of process {{ p.name }}{{ if s.description }}: {{ cs_line s.description | string.strip | escape_xml }}{{ end }}</summary>
public sealed class {{ test }}
{
    private const string Instance = {{ json (ulid_uuid s.id) }};

    /// <summary>Runs the {{ s.steps.size }} steps of {{ s.name }} and checks each one and the outcome ({{ s.outcome }}).</summary>
    /// <returns>The task.</returns>
    [Fact]
    public async Task {{ pascal s.name }}()
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        var clock = new ManualClock(DateTimeOffset.Parse({{ json s.start.at }}, CultureInfo.InvariantCulture));
        await using var host = await ScenarioHost.StartAsync(clock, cancellationToken);
        var result = await host.Dispatcher.SendAsync(new {{ name }}StartControl(new ProcessEnvelope(Instance)) { Context = new {{ ctx }}{{ if start != "" }} { {{ start }} }{{ else }}(){{ end }} }, cancellationToken);
        Assert.True(result.Accepted, result.Refusal);
{{- for step in s.steps }}

        // Step {{ step.index + 1 }}: {{ cs_line step_text(step) }}.{{ if step.description }} {{ cs_line step.description | string.strip }}{{ end }}
{{- if triggers }}
{{- for kv in step.assume }}
{{- if (kv.value | object.typeof) == "string" }}
{{- $tp = assumed_point(kv.key) }}
{{- if $tp && $tp.outside }}
        // Assumed: check {{ kv.key }} gives {{ kv.value }}; it reaches outside systems, so ScenarioTriggers answers it.
{{- else }}
        // Assumed: check {{ kv.key }} gives {{ kv.value }}; the team's code must give it.
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- if stands_in }}
        ScenarioTriggers.Assumed = new Dictionary<string, string>(StringComparer.Ordinal){{ $words = outside_words(step) }}{{ if $words != "" }} { {{ $words }} }{{ end }};
{{- end }}
{{- $runner = runner_of(step) }}
{{- if $runner }}
{{- $n = step.index + 1 }}
{{- $actor = verb_actor(step) }}
{{- if frozen_sends }}
        ScenarioFrozen.Current = ({{ frozen_before[step.index] ? "true" : "false" }}, {{ link_before[step.index] ? "true" : "false" }});
{{- end }}
        var outcome{{ $n }} = await new global::{{ ns($runner) }}.{{ type_name($runner) }}Verbs(new global::{{ dispatch_ns() }}.InMemoryProcessOutbox(), clock{{ if frozen_sends }}, new ScenarioFrozen(){{ end }}).RunAsync(global::{{ base_ns }}.Verb.{{ pascal step.verb.key }}, new TriggerPointCall
        {
            Key = {{ json s.subject.name }},
            Envelope = new ProcessEnvelope(Instance{{ if $actor }}, Actor: Actors.{{ actor_member $actor }}{{ end }}),
            Held = {{ held(step) }},
            States = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal)
            {
                [{{ json p.name }}] = result.States ?? [],
{{- $listed = {} }}
{{- $listed[p.name] = true }}
{{- for l in $runner.trigger_lifecycles }}
{{- if !$listed[l.name] }}
{{- $listed[l.name] = true }}
                [{{ json l.name }}] = [{{ for x in states_in(l) }}{{ for.first ? "" : ", " }}{{ json x }}{{ end }}],
{{- end }}
{{- end }}
{{- for x in other_names }}
{{- if !$listed[x] }}
                [{{ json x }}] = [{{ for y in other_states[x] }}{{ for.first ? "" : ", " }}{{ json y }}{{ end }}],
{{- end }}
{{- end }}
            },
{{- if step.end }}
            End = {{ json step.end.name }},
{{- end }}
{{- if step_attributes(step).size > 0 }}
            Attributes = [{{ for x in step_attributes(step) }}{{ for.first ? "" : ", " }}{{ json x }}{{ end }}],
{{- end }}
{{- $values = proposed(step) }}
{{- if $values != "" }}
            Proposed = new Dictionary<string, object?>(StringComparer.Ordinal) { {{ $values }} },
{{- end }}
            CommandId = "{{ s.name }}-{{ $n }}",
{{- $from = rights ? object_actors(step) : [] }}
{{- if $from.size > 0 }}
            Resolves = actor => actor is {{ for a in $from }}{{ for.first ? "" : " or " }}Actors.{{ actor_member a }}{{ end }},
{{- end }}
        }, (_, _) => Task.CompletedTask, cancellationToken);
{{- if frozen_sends }}
        ScenarioFrozen.Current = null;
{{- end }}

{{- if step.expect }}
{{- if step.expect.accepted }}
        Assert.True(outcome{{ $n }}.Passed, outcome{{ $n }}.Message);
{{- else }}
        Assert.False(outcome{{ $n }}.Passed);
{{- if refusal_of(step) }}
        Assert.Equal({{ json refusal_of(step) }}, outcome{{ $n }}.Refusal);
{{- end }}
{{- if step.expect.refused_by }}
        Assert.Equal({{ json step.expect.refused_by }}, outcome{{ $n }}.RefusedBy);
{{- end }}
{{- end }}
{{- if step.expect.check_warnings.size > 0 }}
        Assert.Equal<string>([{{ for x in step.expect.check_warnings }}{{ if !for.first }}, {{ end }}{{ json x.id }}{{ end }}], [.. outcome{{ $n }}.Warnings.Select(w => w.Id)]);
{{- end }}
{{- if step.expect.trigger_points.size > 0 }}
        Assert.Equal<string>([{{ for x in step.expect.trigger_points }}{{ if !for.first }}, {{ end }}{{ json x.id }}{{ end }}], outcome{{ $n }}.Ran);
{{- end }}
{{- end }}
{{- else if step.input == "verb" }}
{{- if rights }}
{{- $actor = verb_actor(step) }}
        var decision{{ step.index + 1 }} = Rights.Check(new RightRequest
        {
            Verb = {{ step.verb ? ("global::" + base_ns + ".Verb." + (pascal step.verb.key)) : "null" }},
{{- if p.use == "lifecycle" }}
            Lifecycle = {{ json p.name }},
{{- end }}
{{- if s.subject }}
            Subject = typeof(global::{{ ns(s.subject.entity) }}.{{ type_name(s.subject.entity) }}),
{{- end }}
{{- if $actor }}
            Actor = Actors.{{ actor_member $actor }},
{{- end }}
            Held = {{ held(step) }},
            States = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal)
            {
                [{{ json p.name }}] = result.States ?? [],
{{- for n in other_names }}
                [{{ json n }}] = [{{ for x in other_states[n] }}{{ for.first ? "" : ", " }}{{ json x }}{{ end }}],
{{- end }}
            },
{{- if step.end }}
            End = {{ json step.end.name }},
{{- end }}
{{- if freezing }}
            Frozen = {{ frozen_before[step.index] ? "true" : "false" }},
            LinkFrozen = {{ link_before[step.index] ? "true" : "false" }},
{{- end }}
{{- if attribute_rights && step_attributes(step).size > 0 }}
            Attributes = [{{ for n in step_attributes(step) }}{{ for.first ? "" : ", " }}{{ json n }}{{ end }}],
{{- end }}
{{- $from = object_actors(step) }}
{{- if $from.size > 0 }}
            Resolves = actor => actor is {{ for a in $from }}{{ for.first ? "" : " or " }}Actors.{{ actor_member a }}{{ end }},
{{- end }}
        });
{{- if step.expect }}
{{- if step.expect.accepted }}
        Assert.True(decision{{ step.index + 1 }}.Allowed, decision{{ step.index + 1 }}.Refusal);
{{- else }}
        Assert.False(decision{{ step.index + 1 }}.Allowed);
{{- if refusal_of(step) }}
        Assert.Equal({{ json refusal_of(step) }}, decision{{ step.index + 1 }}.Refusal);
{{- end }}
{{- if step.expect.refused_by }}
        Assert.Equal({{ json step.expect.refused_by }}, decision{{ step.index + 1 }}.RefusedBy);
{{- end }}
{{- end }}
{{- end }}
{{- else if freezing && step.verb && step.expect }}
        // No lifecycle states rights or a default, so only freezing can refuse this verb; the subject's and the link's frozen flags are the replay's.
        Assert.{{ !step.expect.accepted && refusal_of(step) == "frozen" ? "True" : "False" }}(new FrozenFlags({{ frozen_query(step) }}, {{ frozen_before[step.index] ? "true" : "false" }}, {{ link_before[step.index] ? "true" : "false" }}).Refuses(global::{{ base_ns }}.Verb.{{ pascal step.verb.key }}));
{{- else }}
        // Nothing in the model can refuse this verb: no lifecycle states rights or a default.
{{- end }}
{{- else if refusal_of(step) == "frozen" && step.event && !(freezing && step.event.verb) }}
        // Refused as frozen in the replay. Nothing in generated code holds freezing until the project uses it (an event, a transition or a
        // right that names freeze or thaw, or a right with whileFrozen), so the step is not sent, and a refused step changes nothing.
{{- else }}
{{- if step.input == "time" }}
        clock.Advance(TimeSpan.FromTicks({{ step.after_ticks }}));
{{- end }}
{{- $holds = rights && step.participant && step.input != "time" }}
{{- if $holds }}
        ScenarioHoldings.Current = {{ held(step) }};
{{- end }}
{{- if frozen_sends }}
        ScenarioFrozen.Current = ({{ frozen_before[step.index] ? "true" : "false" }}, {{ any_link_before[step.index] ? "true" : "false" }});
{{- end }}
        result = await host.Dispatcher.SendAsync({{ command(step) }}, cancellationToken);
{{- if frozen_sends }}
{{- if refusal_of(step) == "frozen" }}
        var frozenAsked{{ step.index + 1 }} = ScenarioFrozen.Asked;
        ScenarioFrozen.Current = null;
        Assert.True(frozenAsked{{ step.index + 1 }}, "The command handlers did not ask ScenarioFrozen whether the object is frozen: register it in ScenarioHost in place of the FrozenState stub.");
{{- else }}
        ScenarioFrozen.Current = null;
{{- end }}
{{- end }}
{{- if $holds }}
{{- if depends_on_holdings(step) && refusal_of(step) != "actor" && refusal_of(step) != "validation" && refusal_of(step) != "instance" }}
        var asked{{ step.index + 1 }} = ScenarioHoldings.Asked;
        ScenarioHoldings.Current = null;
        Assert.True(asked{{ step.index + 1 }}, "The command handlers did not ask ScenarioHoldings for the participant's held actors: register it in ScenarioHost in place of the CallerHoldings stub.");
{{- else }}
        ScenarioHoldings.Current = null;
{{- end }}
{{- end }}
{{- if step.expect }}
{{- if step.expect.accepted }}
        Assert.True(result.Accepted, result.Refusal);
{{- else }}
        Assert.False(result.Accepted);
{{- if refusal_of(step) }}
        Assert.Equal({{ json refusal_of(step) }}, result.Refusal);
{{- end }}
{{- if (rights || triggers) && step.expect.refused_by }}
        Assert.Equal({{ json step.expect.refused_by }}, result.RefusedBy);
{{- end }}
{{- end }}
{{- if triggers && step.expect.check_warnings.size > 0 }}
        Assert.Equal<string>([{{ for x in step.expect.check_warnings }}{{ if !for.first }}, {{ end }}{{ json x.id }}{{ end }}], [.. result.CheckWarnings.Select(w => w.Id)]);
{{- end }}
{{- if triggers && step.expect.trigger_points.size > 0 }}
        Assert.Equal<string>([{{ for x in step.expect.trigger_points }}{{ if !for.first }}, {{ end }}{{ json x.id }}{{ end }}], result.TriggerPoints);
{{- end }}
{{- if step.trace && step.trace.audit.size > 0 }}
        Assert.Equal<string>([{{ for x in step.trace.audit }}{{ if !for.first }}, {{ end }}{{ json x }}{{ end }}], [.. result.Audit.Select(a => a.OutcomeText)]);
{{- end }}
{{- if step.expect.state_paths.size > 0 }}
        Assert.Equal<string>([{{ for x in step.expect.state_paths }}{{ if !for.first }}, {{ end }}{{ json x }}{{ end }}], result.States);
{{- end }}
{{- changed = [] }}
{{- for a in p.context }}{{ if has(step.expect.context, a.name) }}{{ changed[changed.size] = a }}{{ end }}{{ end }}
        Assert.Equal<string>([{{ for a in changed }}{{ if !for.first }}, {{ end }}{{ json a.name }}{{ end }}], result.Changed);
{{- for a in changed }}
        Assert.Equal({{ cs_literal(step.expect.context[a.name], a) }}, (({{ ctx }})result.Context!).{{ prop_name(a, ctx) }});
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- if stands_in }}

        ScenarioTriggers.Assumed = null;
{{- end }}

        Assert.{{ s.outcome == "final" ? "True" : "False" }}(result.Final);
    }
}
{{ end -}}
{{- file (join_path pack.params.testsFolder (p_name(p)) (test + ".cs")) content -}}
{{- end -}}
