{{-
# A Dapper query class per query: an interface and a class with one ExecuteAsync that runs the query's SQL (query_sql) and
# returns its rows as the query's entity, or as a generated <Name>Row record for an ad hoc row. Each collection runs as a
# second statement (query_collection_sql) for the parent rows, at most MaxKeysPerStatement parent keys at a time, matched to
# its parent by the correlation keys; a query with collections returns <Name>Result records (the row and one list per
# collection). The template's own names start with mq_, which the engine reserves (MQ4040), so no parameter, field or
# collection name collides with them; entity, enum and value object types are written global::-qualified.
include "_csharp.scriban"
include "_dapper.scriban"
name = cs_class (pascal query.name)
db = query.database
numeric = ["int16", "int32", "int64", "decimal", "double", "float"]

# The global::-qualified C# name of an entity, enum or value object.
func qualified(element)
  ret "global::" + ns(element) + "." + type_name(element)
end

# The C# type of an attribute (nullable when optional), enums and value objects qualified.
func attr_type(a)
  if a.type.kind == "enum"
    ret qualified(a.type.enum) + (a.required ? "" : "?")
  end
  if a.type.kind == "value-object"
    ret qualified(a.type.value_object) + (a.required ? "" : "?")
  end
  ret type_of a "csharp"
end

# The C# type of a field's value in the private row class Dapper fills.
func field_type(f)
  $t = f.code_type ? (type_of f.code_type "csharp") : "object"
  ret f.nullable ? $t + "?" : $t
end

# The C# expression that reads an entity attribute (or a value object member) from a row's field; null when the attribute
# cannot be read from one field. A number of another type than the attribute's is cast to it.
func read_field(a, f, src)
  if a.type.kind == "value-object"
    ret null
  end
  $full = attr_type(a)
  if a.type.kind == "enum"
    $en = qualified(a.type.enum)
    if f.code_type == "string" || f.code_type == "text"
      if f.nullable && !a.required
        ret src + " is null ? null : " + $en + "Codes.Parse(" + src + ")"
      end
      ret $en + "Codes.Parse(" + src + (f.nullable ? "!" : "") + ")"
    end
    if f.nullable && !a.required
      ret "(" + $en + "?)" + src
    end
    ret "(" + $en + ")" + src
  end
  if f.nullable && a.required
    ret "(" + $full + ")" + src + "!"
  end
  if f.code_type && a.type.builtin && f.code_type != a.type.builtin && (numeric | array.contains f.code_type) && (numeric | array.contains a.type.builtin)
    ret "(" + $full + ")" + src
  end
  ret src
end

# The C# expression that reads a foreign key property (a storage column of the entity's table) from a row's field.
func read_foreign_key(f, src)
  if f.nullable && !f.foreign_key_column.nullable
    ret "(" + (row_type f.foreign_key_column) + ")" + src + "!"
  end
  ret src
end

# "Name = expression" for each field that fills an attribute, a value object member or a foreign key of the entity (read
# inside the row class, so a field is a member). Members of one value object attribute build it together; an optional one is
# null when all of its member fields are.
func entity_assignments(e, fields)
  $result = []
  $objects = []
  for f in fields
    if f.member
      if !($objects | array.contains f.attribute)
        $objects[$objects.size] = f.attribute
      end
    else if f.foreign_key_column
      $result[$result.size] = (row_prop(f.foreign_key_column) + " = " + read_foreign_key(f, cs_ident f.name))
    else if f.attribute
      $read = read_field(f.attribute, f, cs_ident f.name)
      if $read
        $result[$result.size] = (prop_name(f.attribute, type_name(e)) + " = " + $read)
      end
    end
  end
  for vo in $objects
    $parts = []
    $tests = []
    for f in fields
      if f.member && f.attribute == vo
        $parts[$parts.size] = (prop_name(f.member, type_name(vo.type.value_object)) + " = " + read_field(f.member, f, cs_ident f.name))
        if f.nullable
          $tests[$tests.size] = ((cs_ident f.name) + " is null")
        end
      end
    end
    $created = "new " + qualified(vo.type.value_object) + " { " + ($parts | array.join ", ") + " }"
    if !vo.required && $tests.size == $parts.size
      $created = "(" + ($tests | array.join " && ") + " ? null : " + $created + ")"
    end
    $result[$result.size] = (prop_name(vo, type_name(e)) + " = " + $created)
  end
  ret $result
end

# The C# literal of a parameter default, or null when the type has no constant form.
func default_literal(p)
  if p.default == null || p.collection
    ret null
  end
  if p.code_type == "string" || p.code_type == "text"
    ret json p.default
  end
  if p.code_type == "bool"
    ret p.default ? "true" : "false"
  end
  if p.code_type == "int16" || p.code_type == "int32" || p.code_type == "int64" || p.code_type == "double"
    ret json p.default
  end
  if p.code_type == "decimal"
    ret (json p.default) + "m"
  end
  if p.code_type == "float"
    ret (json p.default) + "f"
  end
  ret null
end

func param_type(p)
  $t = type_of p.code_type "csharp"
  ret p.collection ? "IEnumerable<" + $t + ">" : $t
end

# Method parameters: required ones first, then those with a default, then the cancellation token.
required_params = []
optional_params = []
for p in query.parameters
  $literal = default_literal(p)
  if $literal
    optional_params[optional_params.size] = (param_type(p) + " " + (cs_ident p.name) + " = " + $literal)
  else
    required_params[required_params.size] = (param_type(p) + " " + (cs_ident p.name))
  end
end
signature = (required_params | array.concat optional_params | array.add "CancellationToken mq_cancellationToken = default") | array.join ", "
args = []
for p in query.parameters
  args[args.size] = ((cs_ident p.name) + " = " + (cs_ident p.name))
end

entity = query.entity
item_type = entity ? qualified(entity) : name + "Row"
has_collections = query.collections.size > 0
result_type = has_collections ? name + "Result" : item_type

# A JSON field is a JsonElement.
uses_json = false
for f in query.select
  if f.code_type == "json"
    uses_json = true
  end
end
for c in query.collections
  for f in c.query.select
    if f.code_type == "json"
      uses_json = true
    end
  end
end

# The parent row's hidden key fields (correlation columns no select field carries), once each.
hidden_keys = []
hidden_names = []
for c in query.collections
  for k in c.keys
    if k.hidden && !(hidden_names | array.contains k.parent_field)
      hidden_names[hidden_names.size] = k.parent_field
      hidden_keys[hidden_keys.size] = k
    end
  end
end

# The C# type of the parent's value of a key: the select field's, or the hidden field's.
func key_type(k)
  for f in query.select
    if f.name == k.parent_field
      ret field_type(f)
    end
  end
  $t = k.code_type ? (type_of k.code_type "csharp") : "object"
  ret k.outer.nullable ? $t + "?" : $t
end

func element_type(c)
  ret c.entity ? qualified(c.entity) : name + (pascal c.name) + "Item"
end

# A collection's key of a row variable: one value, or a tuple of the key values.
func parent_key(c, row)
  if c.keys.size == 1
    ret row + "." + (cs_ident c.keys[0].parent_field)
  end
  $parts = []
  for k in c.keys
    $parts[$parts.size] = (row + "." + (cs_ident k.parent_field))
  end
  ret "(" + ($parts | array.join ", ") + ")"
end

func child_key(c, row)
  if c.keys.size == 1
    ret row + "." + c.keys[0].child_field
  end
  $parts = []
  for k in c.keys
    $parts[$parts.size] = (row + "." + k.child_field)
  end
  ret "(" + ($parts | array.join ", ") + ")"
end
-}}
{{ header() }}
using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
{{- if uses_json }}
using System.Text.Json;
{{- end }}
using System.Threading;
using System.Threading.Tasks;
using Dapper;

namespace {{ base_ns }}.Queries;

{{ doc(query.description, "") }}public partial interface I{{ name }}Query
{
    /// <summary>Runs the query{{ if has_collections }} and fills its collections{{ end }}.</summary>
    Task<IReadOnlyList<{{ result_type }}>> ExecuteAsync({{ signature }});
}
{{- if !entity }}

/// <summary>One row of query {{ query.name }}.</summary>
public sealed partial record {{ name }}Row({{ for f in query.select }}{{ field_type(f) }} {{ cs_ident (pascal f.name) }}{{ if !for.last }}, {{ end }}{{ end }});
{{- end }}
{{- for c in query.collections }}
{{- if !c.entity }}

/// <summary>One element of collection {{ c.name }} of query {{ query.name }}.</summary>
public sealed partial record {{ element_type(c) }}({{ for f in c.query.select }}{{ field_type(f) }} {{ cs_ident (pascal f.name) }}{{ if !for.last }}, {{ end }}{{ end }});
{{- end }}
{{- end }}
{{- if has_collections }}

/// <summary>One row of query {{ query.name }} with its collections.</summary>
public sealed partial record {{ result_type }}({{ item_type }} Item{{ for c in query.collections }}, IReadOnlyList<{{ element_type(c) }}> {{ cs_ident (pascal c.name) }}{{ end }});
{{- end }}

/// <summary>The Dapper implementation of <see cref="I{{ name }}Query"/> (database {{ db.name }}, {{ db.dialect }}).</summary>
/// <remarks>
/// The results are read-only projections: {{ if entity }}each {{ type_name(entity) }} holds what the query selects and leaves its other
/// properties at their defaults, so it is not a row to save back through a repository{{ else }}rows of the query's own shape{{ end }}.
/// </remarks>
public partial class {{ name }}Query(IDbConnection mq_connection, IDbTransaction? mq_transaction = null) : I{{ name }}Query
{
    private const string Sql = """
{{ indent (query_sql query) 8 }}
        """;
{{- for c in query.collections }}

    private const string {{ pascal c.name }}Sql = """
{{ indent (query_collection_sql c) 8 }}
        """;
{{- end }}
{{- if has_collections }}

    /// <summary>The most parent keys one collection statement takes: more parent rows run it once per this many keys.</summary>
    private const int MaxKeysPerStatement = 1000;
{{- end }}

    /// <inheritdoc/>
    public async Task<IReadOnlyList<{{ result_type }}>> ExecuteAsync({{ signature }})
    {
        var mq_rows = (await mq_connection.QueryAsync<Row>(new CommandDefinition(Sql, new { {{ args | array.join ", " }} }, mq_transaction, cancellationToken: mq_cancellationToken)).ConfigureAwait(false)).ToList();
{{- if has_collections }}
{{- for c in query.collections }}
{{- cname = pascal c.name }}
{{- v = "mq_c" + for.index }}

        var {{ v }}Keys = mq_rows.Select(mq_r => {{ parent_key(c, "mq_r") }}).Distinct().ToArray();
        var {{ v }}Found = new List<{{ cname }}Row>();
        for (var mq_at = 0; mq_at < {{ v }}Keys.Length; mq_at += MaxKeysPerStatement)
        {
            var mq_chunk = {{ v }}Keys[mq_at..Math.Min(mq_at + MaxKeysPerStatement, {{ v }}Keys.Length)];
{{- if c.keys.size > 1 }}
            var mq_set = mq_chunk.ToHashSet();
{{- end }}
            var mq_found = await mq_connection.QueryAsync<{{ cname }}Row>(new CommandDefinition({{ cname }}Sql, new
            {
{{- if c.keys.size == 1 }}
                {{ c.keys[0].parameter }} = mq_chunk,
{{- else }}
{{- for k in c.keys }}
                {{ k.parameter }} = mq_chunk.Select(mq_k => mq_k.Item{{ for.index + 1 }}).Distinct().ToArray(),
{{- end }}
{{- end }}
{{- for a in args }}
                {{ a }},
{{- end }}
            }, mq_transaction, cancellationToken: mq_cancellationToken)).ConfigureAwait(false);
{{- if c.keys.size == 1 }}
            {{ v }}Found.AddRange(mq_found);
{{- else }}
            // Each key's list over-fetches: keep the rows whose whole key is one of this chunk's.
            {{ v }}Found.AddRange(mq_found.Where(mq_x => mq_set.Contains({{ child_key(c, "mq_x") }})));
{{- end }}
        }

        var {{ v }} = {{ v }}Found.ToLookup(mq_x => {{ child_key(c, "mq_x") }});
{{- end }}

        return mq_rows.Select(mq_r => new {{ result_type }}(mq_r.ToItem(){{ for c in query.collections }}, [.. mq_c{{ for.index }}[{{ parent_key(c, "mq_r") }}].Select(mq_x => mq_x.ToItem())]{{ end }})).ToList();
{{- else }}
        return mq_rows.Select(mq_r => mq_r.ToItem()).ToList();
{{- end }}
    }

    /// <summary>One row as Dapper reads it, field by field.</summary>
    private sealed class Row
    {
{{- for f in query.select }}
        public {{ field_type(f) }} {{ cs_ident f.name }} { get; set; }{{ if !f.nullable && f.code_type && !(cs_value_type (type_of f.code_type "csharp")) }} = default!;{{ end }}
{{- end }}
{{- for k in hidden_keys }}
        public {{ key_type(k) }} {{ cs_ident k.parent_field }} { get; set; }{{ if !k.outer.nullable && k.code_type && !(cs_value_type (type_of k.code_type "csharp")) }} = default!;{{ end }}
{{- end }}

{{- if entity }}

        public {{ item_type }} ToItem() => new()
        {
{{- for line in entity_assignments(entity, query.select) }}
            {{ line }},
{{- end }}
        };
{{- else }}

        public {{ item_type }} ToItem() => new({{ for f in query.select }}{{ cs_ident f.name }}{{ if !for.last }}, {{ end }}{{ end }});
{{- end }}
    }
{{- for c in query.collections }}

    /// <summary>One element of collection {{ c.name }} with its parent's key, as Dapper reads it.</summary>
    private sealed class {{ pascal c.name }}Row
    {
{{- for f in c.query.select }}
        public {{ field_type(f) }} {{ cs_ident f.name }} { get; set; }{{ if !f.nullable && f.code_type && !(cs_value_type (type_of f.code_type "csharp")) }} = default!;{{ end }}
{{- end }}
{{- for k in c.keys }}
        public {{ key_type(k) }} {{ k.child_field }} { get; set; }{{ if !(cs_value_type (key_type(k))) && !(key_type(k) | string.ends_with "?") }} = default!;{{ end }}
{{- end }}

{{- if c.entity }}

        public {{ element_type(c) }} ToItem() => new()
        {
{{- for line in entity_assignments(c.entity, c.query.select) }}
            {{ line }},
{{- end }}
        };
{{- else }}

        public {{ element_type(c) }} ToItem() => new({{ for f in c.query.select }}{{ cs_ident f.name }}{{ if !for.last }}, {{ end }}{{ end }});
{{- end }}
    }
{{- end }}
}
