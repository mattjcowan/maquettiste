{{-
# One file per reference type (reference-types-seeds-localization.md section 1.6): a sealed record with the code, the label, the
# row description when a seed lists one and the single-valued and collection user fields, then a static class with one field
# per row, All (seed order) and Find (by code). Attributes typed by a reference type hold its code (type_of: string, or the
# code's integer type, or Guid for a uuid code), so the record is for reading reference data in code, not for mapping columns.
# A Guid is no constant, so a uuid code is written new Guid("...") and Find compares the rows in turn. Each former code of the type
# (next-phase-2-design.md section 3.5) gets an [Obsolete] field named as its row was, holding the row that replaced it, so code that
# names the old constant still compiles and reads the new row; Find keeps finding live codes only.
include "_csharp.scriban"
rt = reference_type
name = type_name(rt)
rows_class = pascal (pluralize rt.name)
if rows_class == name
  rows_class = name + "Rows"
end
code_type = type_of rt.code.type "csharp"
uuid_code = rt.code.type == "uuid"
has_description = false
for r in rt.rows
  if r.description
    has_description = true
  end
end

# The C# member name of a row: its code in PascalCase, "Code" first when that does not start with a letter.
func row_member(r)
  $n = pascal ("" + r.code)
  if $n == "" || ($n | string.slice 0 1 | regex.match "[A-Za-z]").size == 0
    ret "Code" + $n
  end
  ret cs_ident $n
end

# A C# literal of a row's code.
func code_literal(code)
  ret uuid_code ? "new Guid(" + (json code) + ")" : (json code)
end

# A C# literal of a cell for a field.
func cs_literal(v, f)
  if v == null
    ret "null"
  end
  if f.collection
    $items = ""
    for item in v
      $items = $items + (for.first ? "" : ", ") + json item
    end
    ret "[" + $items + "]"
  end
  $kind = f.type.kind == "reference" ? f.type.reference_type.code.type : (f.type.builtin ?? "")
  if f.type.kind == "enum"
    ret type_name(f.type.enum) + "." + (cs_ident (pascal v.name))
  end
  case $kind
    when "decimal"
      ret (json v) + "m"
    when "double"
      ret (json v) + "d"
    when "float"
      ret (json v) + "f"
    when "int64"
      ret (json v) + "L"
    when "int16", "int32", "bool", "string", "text", "ulid"
      ret json v
    when "uuid"
      ret "new Guid(" + (json v) + ")"
  end
  ret "default /* " + (json v | string.replace "*/" "* /") + " */"
end

# The former codes that get an alias field, in code order: one whose member name a live row's member, or an earlier alias, already
# has is left out (net30 and net-30 both give Net30).
aliases = []
taken = {}
for r in rt.rows
  taken[row_member(r)] = true
end
for fc in rt.former_codes
  if !taken[row_member(fc)]
    taken[row_member(fc)] = true
    aliases[aliases.size] = fc
  end
end
-}}
{{ header() }}
using System;
using System.Collections.Generic;

namespace {{ base_ns }};

{{ doc(rt.description, "") }}public sealed record {{ name }}({{ code_type }} Code, string Label
{{- if has_description }}, string? Description{{ end }}
{{- for f in rt.attributes }}, {{ prop_type(f) }} {{ prop_name(f, name) }}{{ end }});

/// <summary>The rows of <see cref="{{ name }}"/> in seed order, one field per row.</summary>
public static partial class {{ rows_class }}
{
{{- for r in rt.rows }}
{{ doc(r.description, "    ") }}    public static readonly {{ name }} {{ row_member(r) }} = new({{ code_literal(r.code) }}, {{ json r.label }}
{{- if has_description }}, {{ r.description ? (json r.description) : "null" }}{{ end }}
{{- for f in rt.attributes }}, {{ cs_literal(r.values[f.name], f) }}{{ end }});
{{- end }}
{{- for fc in aliases }}

{{ doc("The former code " + fc.code + ", now the row " + fc.replaced_by.code + ".", "    ") }}    [Obsolete({{ json ("" + fc.code + " is a former code of " + rt.name + "; use " + row_member(fc.replaced_by) + ".") }})]
    public static readonly {{ name }} {{ row_member(fc) }} = {{ row_member(fc.replaced_by) }};
{{- end }}

    /// <summary>Every row, in seed order.</summary>
    public static IReadOnlyList<{{ name }}> All { get; } = [{{ for r in rt.rows }}{{ for.first ? "" : ", " }}{{ row_member(r) }}{{ end }}];

    /// <summary>The row with a code, or null.</summary>
{{- if uuid_code }}
    public static {{ name }}? Find({{ code_type }} code)
    {
        foreach (var row in All)
        {
            if (row.Code == code)
                return row;
        }

        return null;
    }
{{- else }}
    public static {{ name }}? Find({{ code_type }} code) => code switch
    {
{{- for r in rt.rows }}
        {{ json r.code }} => {{ row_member(r) }},
{{- end }}
        _ => null,
    };
{{- end }}
}
