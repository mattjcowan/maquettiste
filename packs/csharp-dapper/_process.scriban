{{-
# Shared functions of the process units. Include after _csharp.scriban; it prints nothing.

# An action's sets in text form, "attribute = value" each, joined by ", " (object-effects-design.md section 9).
func sets_text(a)
  $parts = []
  for $s in a.sets
    $parts[$parts.size] = $s.attribute.name + " = " + $s.value.text
  end
  ret $parts | array.join ", "
end

# Whether the project uses rights (rights-design.md decision 28): a lifecycle states rights or a default. model.rights_lifecycles keys
# only on the rights naming key, so a unit that asks pays nothing in a project without rights.
func uses_rights()
  ret model.rights_lifecycles.size > 0
end

# Whether the project uses trigger points (trigger-points-design.md decision 29): a lifecycle has triggerPoints. Only then are the step
# methods, the per-type runners, Refusals.Check, CheckWarnings and the refusal members written. model.trigger_lifecycles keys only on
# the trigger points naming key, so a unit that asks pays nothing in a project without trigger points.
func uses_triggers()
  ret model.trigger_lifecycles.size > 0 || model.trigger_points.size > 0
end

# Whether the pack writes the bulk-load bypass (trigger-points-design.md decisions 20 and 35): the bulkLoadBypass parameter, off by default,
# in a project that uses trigger points. Only then are ITriggerBypass, the team's TriggerBypass, SkipOptional and the skip tests written;
# without it noBypass changes nothing in this pack. A pack parameter keys every unit, so turning it on or off renders the files it touches.
func uses_bulk_bypass()
  ret pack.params.bulkLoadBypass == true && uses_triggers()
end

# Whether the pack writes the dry run (decision 35): the dryRun parameter, off by default, in a project that uses trigger points. Only then
# are DryRun and Recorded written.
func uses_dry_run()
  ret pack.params.dryRun == true && uses_triggers()
end

# Whether an entity gets a per-type runner (trigger-points-design.md decisions 30 and 33): a lifecycle that governs it has points on
# object, link or own verbs, or a named trigger point that covers it names one.
func has_runner(e)
  if e.trigger_lifecycles.size > 0
    ret true
  end
  for $tp in e.trigger_points
    for $v in $tp.verbs
      if $v.group == "object" || $v.group == "link" || $v.group == "project"
        ret true
      end
    end
  end
  ret false
end

# Whether an entity derives from another, through its bases.
func derives_from(e, base)
  $x = e.base
  while $x
    if $x.id == base.id
      ret true
    end
    $x = $x.base
  end
  ret false
end

# The entities of a process's subjects: each subject's entity, then each stereotype subject's carriers.
func subject_entities(p)
  $out = []
  for $sub in p.subjects
    $out[$out.size] = $sub.entity
  end
  for $sub in p.stereotype_subjects
    for $x in $sub.entities
      $out[$out.size] = $x
    end
  end
  ret $out
end

# The object, link and own verbs that an event or a transition of a process names, as a set of verb keys.
func object_verbs_of(p)
  $verbs = {}
  for $x in p.events
    if $x.verb && ($x.verb.group == "object" || $x.verb.group == "link" || $x.verb.group == "project")
      $verbs[$x.verb.key] = true
    end
  end
  for $x in p.transitions
    if $x.verb && ($x.verb.group == "object" || $x.verb.group == "link" || $x.verb.group == "project")
      $verbs[$x.verb.key] = true
    end
  end
  ret $verbs
end

# The named trigger points a process runs (trigger-points-design.md decisions 33 and 34), in run order: with one entity subject, those
# that cover it; otherwise those that cover every subject's entity (a stereotype subject's carriers too), in the order of the first. A
# point that covers only an entity derived from a subject isn't asked. A move, signature or task verb happens in one lifecycle, so an
# orchestration runs only the points on an object, link or own verb that an event or a transition of it names, as it runs other
# lifecycles' points (trigger_others), and only for those verbs, as the engine (owner's answer A5).
func named_points_of(p)
  if model.trigger_points.size == 0
    ret []
  end
  $entities = subject_entities(p)
  $out = []
  if $entities.size == 0
    ret $out
  end
  $lifecycle = p.use == "lifecycle"
  $verbs = $lifecycle ? {} : object_verbs_of(p)
  for $tp in $entities[0].trigger_points
    if !$lifecycle
      $named = false
      for $v in $tp.verbs
        if $verbs[$v.key]
          $named = true
        end
      end
      if !$named
        continue
      end
    end
    $all = true
    for $x in $entities
      $found = false
      for $y in $x.trigger_points
        if $y.id == $tp.id
          $found = true
        end
      end
      if !$found
        $all = false
      end
    end
    if $all
      $out[$out.size] = $tp
    end
  end
  ret $out
end

# Whether a process's handlers give the object's own entity (IObjectEntity, decision 33): a named point it runs names, in entities or
# exceptEntities, an entity derived from a subject's, which only the object's own type can answer at run time.
func entity_hook(p)
  $subjects = subject_entities(p)
  for $tp in named_points_of(p)
    for $e in array.concat $tp.entities $tp.except_entities
      for $s in $subjects
        if derives_from($e, $s)
          ret true
        end
      end
    end
  end
  ret false
end

# The namespace-qualified classes of a named trigger point's team methods: TriggerPoints (the body), TriggerConditions (the when) and
# TriggerRecords (a before action's records), in its package's namespace.
func named_class(tp, suffix)
  ret "global::" + ns(tp) + ".Trigger" + suffix
end

# The folder of a named trigger point's package under a base folder: <base>/TriggerPoints/<package path>.
func named_folder(base, tp)
  ret join_path base "TriggerPoints" (tp.package ? (tp.package.qualified_name | string.replace "." "/") : "")
end

# The other lifecycles whose trigger points a process's moves run (trigger-points-design.md decision 11): those that govern an entity the
# process governs and have points on an object, link or own verb that an event or a transition of the process names, by name then id.
# Each is a StatesIn<Lifecycle> hook in the team's half of the handlers, and its step methods go to the chart after the process's own.
func trigger_others(p)
  $out = []
  if model.trigger_lifecycles.size == 0
    ret $out
  end
  $verbs = object_verbs_of(p)
  $governs = {}
  $entities = []
  for $sub in p.subjects
    $entities[$entities.size] = $sub.entity
  end
  for $sub in p.stereotype_subjects
    for $x in $sub.entities
      $entities[$entities.size] = $x
    end
  end
  for $x in $entities
    for $l in $x.trigger_lifecycles
      $governs[$l.id] = true
    end
  end
  for $l in model.trigger_lifecycles
    if $l.id != p.id && $governs[$l.id]
      $speaks = false
      for $tv in $l.trigger_verbs
        if $verbs[$tv.verb.key]
          $speaks = true
        end
      end
      if $speaks
        $out[$out.size] = $l
      end
    end
  end
  ret $out
end

# The StatesIn<Lifecycle> hooks of a process's handlers (ILifecycleStates): the lifecycles whose rights could say no to a verb an event
# names, then those whose trigger points its moves run (trigger_others), each once.
func lifecycle_hooks(p)
  $out = uses_rights() ? states_hooks(p) : []
  for $l in trigger_others(p)
    $seen = false
    for $h in $out
      if $h.id == $l.id
        $seen = true
      end
    end
    if !$seen
      $out[$out.size] = $l
    end
  end
  ret $out
end

# The initial leaf state path of a lifecycle: its initial state, then each compound state's initial, down to a leaf.
func initial_path(l)
  $s = l.initial
  while $s && $s.initial
    $s = $s.initial
  end
  ret $s ? $s.path : ""
end

# Whether the project uses freezing (rights-design.md decision 28): an event, a transition or a right names freeze or thaw, or a right
# has whileFrozen. Only then are the interpreter's frozen check, Freezing.cs (IFrozenState), the FrozenState stub, Refusals.Frozen and
# the request's frozen flags written. model.freezing keys only on the freezing naming key, so asking renders a unit again on nothing else.
func uses_freezing()
  ret model.freezing.used
end

# The host interface of the frozen state (Freezing.cs) and the team's stub of it (Dispatch/FrozenState.cs), qualified.
func frozen_state_type()
  ret "global::" + actors_ns() + ".IFrozenState"
end
func frozen_state_stub()
  ret "global::" + dispatch_ns() + ".FrozenState"
end

# Whether the project uses attribute rights (rights-design.md decision 28): a right names attributes. Only then do the request and the
# rights table carry them.
func uses_attribute_rights()
  for $r in model.rights
    if $r.attributes.size > 0
      ret true
    end
  end
  for $l in model.rights_lifecycles
    for $u in $l.rights
      if $u.right.attributes.size > 0
        ret true
      end
    end
  end
  ret false
end

# Whether any right of the project has whileFrozen: only then does RightDefinition carry it.
func uses_while_frozen()
  for $r in model.rights
    if $r.while_frozen
      ret true
    end
  end
  for $l in model.rights_lifecycles
    for $u in $l.rights
      if $u.right.while_frozen
        ret true
      end
    end
  end
  ret false
end

# The other lifecycles whose states a process's event checks need (rights-design.md decision 29): the entries of process.may_refuse
# that an event's verb reaches, each a StatesIn<Lifecycle> hook in the team's half of the handlers.
func states_hooks(p)
  $out = []
  for m in p.may_refuse
    if m.by_events
      $out[$out.size] = m.lifecycle
    end
  end
  ret $out
end

# A process's inline rights that have a condition: one static partial method each in <Process>RightConditions.
func inline_conditions(p)
  $out = []
  for u in p.rights
    if !u.right.named && u.right.condition_text != null
      $out[$out.size] = u.right
    end
  end
  ret $out
end

# Whether a process's gates hold an approval (signoff-design.md decision 29): one of them has stages. Only then do its handlers set the
# result's Approvals, and its definition the gates' stages.
func uses_approvals(p)
  for g in p.gates
    if g.uses_stages
      ret true
    end
  end
  ret false
end

# The named signatures of a process's approvals that have a condition (their when), in gate then file order: one method each in
# <Process>ApprovalConditions.
func approval_conditions(p)
  $out = []
  for g in p.gates
    for sig in g.all_signatures
      if sig.when
        $out[$out.size] = sig
      end
    end
  end
  ret $out
end

# The stages of a process's approvals that have a condition (their when), in gate then file order (signoff-design.md decision 6): one
# method each in <Process>ApprovalConditions, which the handlers reach as IApprovalConditions.StageNeeded.
func stage_conditions(p)
  $out = []
  for g in p.gates
    for st in g.stages
      if st.when
        $out[$out.size] = st
      end
    end
  end
  ret $out
end

# The actors a process's named signatures may be delegated to (signoff-design.md decision 34) that aren't taken from the object, each
# once, in gate then file order: the handlers answer for each, as IActorResolver, whether the person a signature goes to is that actor.
func delegate_actors(p)
  $seen = {}
  for a in relative_actors(p)
    $seen[a.id] = true
  end
  $out = []
  for g in p.gates
    for sig in g.all_signatures
      for a in sig.delegate_to
        if !$seen[a.id]
          $seen[a.id] = true
          $out[$out.size] = a
        end
      end
    end
  end
  ret $out
end

# Whether a gate has a named signature that may be delegated (signoff-design.md decision 34): only then does its typed audit record
# name whom an answer is on behalf of and where a delegation went.
func gate_delegates(g)
  for sig in g.all_signatures
    if sig.delegate_to.size > 0
      ret true
    end
  end
  ret false
end

# The method names of <Process>ApprovalConditions by signature or stage id (signoff-design.md section 10): <Gate><Signature>, and
# <Gate><Stage>Stage for a stage, by member_name, so one named like its class gets Value; when two would share a name, each after the
# first in id order gets the last eight characters of its id appended (the random end of a ULID: its first characters are a timestamp,
# the same for ids minted close together), and its whole id in the unlikely case that name is taken too.
func approval_methods(p)
  $class = p_name(p) + "ApprovalConditions"
  $all = approval_conditions(p)
  for st in stage_conditions(p)
    $all[$all.size] = st
  end
  $sorted = array.sort $all "id"
  $taken = {}
  $out = {}
  for sig in $sorted
    $n = member_name((pascal sig.gate.name) + (pascal sig.name) + (sig.kind == "gate-stage" ? "Stage" : ""), $class)
    if $taken[$n]
      $base = $n
      $n = $base + (sig.id | string.slice (sig.id.size > 8 ? sig.id.size - 8 : 0))
      if $taken[$n]
        $n = $base + sig.id
      end
    end
    $taken[$n] = true
    $out[sig.id] = $n
  end
  ret $out
end

# The C# name of a process (and the prefix of its types).
func p_name(p)
  ret pascal p.name
end

# The folder of a process's files under a base folder: <base>/Processes/<Process>.
func p_folder(base, p)
  ret join_path base "Processes" (p_name(p))
end

# The namespaces of the runtime, the dispatcher and the actors.
func runtime_ns()
  ret base_ns + ".Runtime"
end

func dispatch_ns()
  ret base_ns + ".Dispatch"
end

func actors_ns()
  ret base_ns + ".Processes"
end

# The C# constant name of an actor in the Actors class: its name in PascalCase, with "Actor" appended only when that name is
# taken by the class itself or one of its other members (Actors, All, TypeOf, Events, and MemberOf, Accepts and Allows when an
# actor is a member of another), so other names stay as they were.
func actor_member(a)
  $n = pascal a.name
  if $n == "Actors" || $n == "All" || $n == "TypeOf" || $n == "Events"
    ret $n + "Actor"
  end
  if $n == "MemberOf" || $n == "Accepts" || $n == "Allows"
    for x in model.actors
      if x.member_of.size > 0
        ret $n + "Actor"
      end
    end
  end
  ret $n
end

# The C# constant name of a state: its path parts in PascalCase, joined ("Fulfilment.Processing" -> FulfilmentProcessing).
func state_member(s)
  $out = ""
  for part in (s.path | string.split ".")
    $out = $out + (pascal part)
  end
  ret $out
end

# The C# type of a context, payload or audit attribute: the type map's type, nullable when the value may be absent (not
# required and no default).
func attr_type(a)
  if a.collection
    ret type_of a "csharp"
  end
  $t = type_of a.type "csharp"
  if a.required || a.default != null
    ret $t
  end
  ret $t + "?"
end

# A C# literal of a model value for an attribute's type ("2500m", "SalesOrderStatus.Draft", "\"text\"").
func cs_literal(value, a)
  if value == null
    ret "null"
  end
  if a.type.kind == "enum"
    ret (type_of a.type "csharp") + "." + (cs_ident (pascal value))
  end
  $b = a.type.builtin
  if $b == "decimal"
    ret value + "m"
  else if $b == "double"
    ret value + "d"
  else if $b == "float"
    ret value + "f"
  else if $b == "int64"
    ret value + "L"
  else if $b == "int16" || $b == "int32"
    ret "" + value
  else if $b == "bool"
    ret value ? "true" : "false"
  else if $b == "uuid"
    ret "Guid.Parse(" + (json value) + ")"
  else if $b == "datetimeoffset"
    ret "DateTimeOffset.Parse(" + (json value) + ", CultureInfo.InvariantCulture)"
  else if $b == "datetime"
    ret "DateTime.Parse(" + (json value) + ", CultureInfo.InvariantCulture)"
  else if $b == "date"
    ret "DateOnly.Parse(" + (json value) + ", CultureInfo.InvariantCulture)"
  end
  ret json value
end

# The C# type of a field of a gate's audit record (gate.audit).
func audit_type(f)
  if f.attribute
    ret attr_type(f.attribute)
  end
  $t = "string"
  if f.type == "int64"
    $t = "long"
  else if f.type == "datetimeoffset"
    $t = "DateTimeOffset"
  end
  ret f.required ? $t : $t + "?"
end

# The attribute of a list with a name, or null.
func by_name(list, name)
  for x in list
    if x.name == name
      ret x
    end
  end
  ret null
end

# The type-and-members spec of a process's context for the expression translator (helpers.js): one entry per attribute,
# "name|C# name|C# type|kind|member=C# member,...", joined with ";".
func member_spec(attributes, owner)
  $out = ""
  for a in attributes
    $kind = "value"
    $members = ""
    if a.type.kind == "enum"
      $kind = "enum"
      for m in a.type.enum.members
        $members = $members + (for.first ? "" : ",") + m.name + "=" + (cs_ident (pascal m.name))
      end
    else if a.type.builtin == "string" || a.type.builtin == "text" || a.type.builtin == "ulid"
      $kind = "string"
    else if a.type.builtin == "bool"
      $kind = "bool"
    else if a.type.builtin == "decimal" || a.type.builtin == "double" || a.type.builtin == "float"
      $kind = a.type.builtin
    else if a.type.builtin == "int16" || a.type.builtin == "int32" || a.type.builtin == "int64"
      $kind = "int"
    end
    $out = $out + (for.first ? "" : ";") + a.name + "|" + (prop_name(a, owner)) + "|" + (attr_type(a)) + "|" + $kind + "|" + $members
  end
  ret $out
end

# Every payload attribute of a process's events, first declaration of each name (for event.payload.x in expressions).
func payload_spec(p)
  $seen = []
  $list = []
  for e in p.events
    for a in e.payload
      if !($seen | array.contains a.name)
        $seen[$seen.size] = a.name
        $list[$list.size] = a
      end
    end
  end
  ret member_spec($list, "")
end

# What a guard written in the expression language reads, for expr_cs (helpers.js): each context attribute as call.Context.<Member>, and
# each payload attribute of the events as event.<name>, read with call.Event.Get<T?> so a missing one is null; and how strings order.
func condition_spec(p)
  $owner = p_name(p) + "Context"
  $out = expr_functions()
  for a in p.context
    $out = $out + ";" + expr_entry(a.name, "call.Context." + prop_name(a, $owner), attr_type(a), a)
  end
  $seen = []
  for e in p.events
    for a in e.payload
      if !($seen | array.contains a.name) && !a.collection
        $seen[$seen.size] = a.name
        $t = (type_of a.type "csharp") + "?"
        $out = $out + ";" + expr_entry("event." + a.name, "call.Event.Get<" + $t + ">(" + (json a.name) + ")", $t, a)
      end
    end
  end
  ret $out
end

# The C# translation of a guard or action, or "" when it is outside what the pack translates (a stub): a guard written in the
# expression language through expr_cs_holds (it holds only when true), else a JavaScript guard or action in the 7.1 subset
# (cs_expression).
func translate(p, node, kind)
  if kind == "guard"
    if node.condition
      ret expr_cs_holds node.condition (condition_spec(p))
    end
  end
  if !node.expression
    ret ""
  end
  ret cs_expression node.expression kind (member_spec(p.context, (p_name(p)) + "Context")) (payload_spec(p))
end

# The C# name of a process event's command type. The built-in commands are <P>StartControl, <P>InvokeResultControl and
# <P>TimersDueControl: a name ending in Control is never an event command's, so no event name collides with them.
func command_type(p, e)
  ret p_name(p) + (pascal e.name) + "Command"
end

# The C# name of a member for a model name inside a class: PascalCase, with "Value" appended when it equals the class's own name
# (C# forbids a member named like its enclosing type, so an event named "events" stays legal).
func member_name(n, owner)
  $c = pascal n
  if $c == owner
    ret $c + "Value"
  end
  ret cs_ident $c
end

# The audit attributes of the gates on an event's transitions (the gated event's command carries them), first of each name.
func audit_attributes(e)
  $seen = []
  $list = []
  for t in e.transitions
    if t.gate
      for a in t.gate.audit_attributes
        if !($seen | array.contains a.name)
          $seen[$seen.size] = a.name
          $list[$list.size] = a
        end
      end
    end
  end
  ret $list
end

# Whether an event is gated (one of its transitions has a gate).
func is_gated(e)
  for t in e.transitions
    if t.gate
      ret true
    end
  end
  ret false
end

# The C# string array literal of actor names ("[Actors.Approver, Actors.FinanceController]"), or "[]".
func actor_list(actors)
  $out = ""
  for a in actors
    $out = $out + (for.first ? "" : ", ") + "Actors." + actor_member(a)
  end
  ret "[" + $out + "]"
end

# Whether the model has an actor taken from the object (actors-design.md decision 27): only then does the runtime ask a
# process's Handlers whether the caller is such an actor.
func has_relative()
  for a in model.actors
    if a.relative
      ret true
    end
  end
  ret false
end

# The actors taken from the object that a process names (in its events, human tasks and gates), by name.
func relative_actors(p)
  $out = []
  for a in p.actors
    if a.relative
      $out[$out.size] = a
    end
  end
  # In a project that uses rights, the process's resolver also answers for the actors taken from the object that its rights name, and
  # those that the rights of another lifecycle that could say no name (rights-design.md decision 29), each once, by name.
  if uses_rights()
    $rights = []
    for u in p.rights
      $rights[$rights.size] = u.right
    end
    for m in p.may_refuse
      for u in m.lifecycle.rights
        $rights[$rights.size] = u.right
      end
    end
    $extra = []
    for r in $rights
      for a in r.actors | array.concat r.except
        if a.relative && !($out | array.contains a) && !($extra | array.contains a)
          $extra[$extra.size] = a
        end
      end
    end
    for a in $extra | array.sort "name"
      $out[$out.size] = a
    end
  end
  ret $out
end

# A name in plain lower-case words: "accountManager" -> "account manager".
func words(name)
  ret (regex.replace name "([a-z0-9])([A-Z])" "$1 $2") | string.downcase
end

# How an actor taken from the object is worked out, in plain words, for an object called `subject` ("order", or "object"): "the
# order's owner", "the order's account manager", "members of Approver within the order's project".
func relative_text(a, subject)
  $r = a.relative
  $steps = ""
  for $s in $r.path
    $steps = $steps + "'s " + words($s.kind == "end" ? $s.role : $s.name)
  end
  if $r.form == "owner"
    ret "the " + subject + "'s owner"
  else if $r.form == "members-of"
    ret "members of " + ($r.members_of ? $r.members_of.name : "?") + " within the " + subject + $steps
  end
  ret "the " + subject + $steps
end

# The subject of a process in plain words for relative_text: its entity when it has one subject, else "object".
func subject_words(p)
  ret p.subjects.size == 1 ? words(p.subjects[0].entity.name) : "object"
end

# For an owner actor, where each subject of a process holds the owner (", held in Order.ownerLogin"); "" for other actors, or when no
# subject names an owner field and the team's system holds it.
func owner_fields(p, a)
  if a.relative.form != "owner"
    ret ""
  end
  $out = ""
  for $sj in p.subjects
    $f = $sj.owner_attribute ? $sj.owner_attribute.name : ($sj.owner_end ? ($sj.owner_end.navigation ?? $sj.owner_end.role) : null)
    if $f
      $out = $out + ($out == "" ? "" : ", ") + $sj.entity.name + "." + $f
    end
  end
  ret $out == "" ? "" : ", held in " + $out
end

# The C# string array literal of ids.
func id_list(items)
  $out = ""
  for x in items
    $out = $out + (for.first ? "" : ", ") + (json x.id)
  end
  ret "[" + $out + "]"
end

# The C# string array literal of names.
func name_list(items)
  $out = ""
  for x in items
    $out = $out + (for.first ? "" : ", ") + (json x.name)
  end
  ret "[" + $out + "]"
end
-}}
