{{-
# A process's chart as static data for the generated interpreter: the states (the root first, document order), the transitions
# (priority order), events, actions, invokes, gates and meanings.
include "_csharp.scriban"
include "_process.scriban"
p = process
name = p_name(p)
# State indexes: 0 is the root, then document order.
index = {}
for s in p.all_states
  index[s.id] = for.index + 1
end
gate_index = {}
for g in p.gates
  gate_index[g.id] = for.index
end
func state_kind(s)
  ret "StateKind." + (s.type == "human-task" ? "HumanTask" : (pascal s.type))
end
func trigger_kind(t)
  ret "TriggerKind." + (pascal t.trigger)
end
func index_of(s)
  ret s ? index[s.id] : -1
end
func action_names(actions)
  ret name_list(actions)
end
rights = uses_rights()
verb_type = "global::" + base_ns + ".Verb"
func type_of_entity(e)
  ret "typeof(global::" + ns(e) + "." + type_name(e) + ")"
end
governs = []
governed = {}
for sub in p.subjects
  if !governed[sub.entity.id]
    governed[sub.entity.id] = true
    governs[governs.size] = type_of_entity(sub.entity)
  end
end
for sub in p.stereotype_subjects
  for e in sub.entities
    if !governed[e.id]
      governed[e.id] = true
      governs[governs.size] = type_of_entity(e)
    end
  end
end
-}}
{{- capture rights_arg }}
        new ProcessRights({{ p.use == "lifecycle" ? "true" : "false" }}, RightAccess.{{ p.rights_default == "deny" ? "Deny" : "Allow" }},
            [
{{- for u in p.rights }}
{{- r = u.right }}
                new(new({{ json r.id }}, {{ json r.name }}, RightAccess.{{ r.access == "deny" ? "Deny" : "Allow" }}, {{ actor_list(r.actors) }}, {{ actor_list(r.except) }},
                    [{{ for v in r.verbs }}{{ for.first ? "" : ", " }}{{ verb_type }}.{{ pascal v.key }}{{ end }}], [{{ for e in r.ends }}{{ for.first ? "" : ", " }}{{ json e.name }}{{ end }}]
{{- if r.condition_text != null }}, Condition: global::{{ r.named ? (ns(r) + ".RightConditions") : (ns(p) + "." + name + "RightConditions") }}.{{ pascal r.name }}{{ end }}
{{- if r.description }}, Description: {{ json (r.description | string.strip) }}{{ end }})
{{- if r.while_frozen || r.attributes.size > 0 }} { {{ if r.while_frozen }}WhileFrozen = true{{ end }}{{ if r.while_frozen && r.attributes.size > 0 }}, {{ end }}{{ if r.attributes.size > 0 }}Attributes = [{{ for a in r.attributes }}{{ for.first ? "" : ", " }}{{ json a.name }}{{ end }}]{{ end }} }{{ end }},
                    [{{ for s in u.states }}{{ for.first ? "" : ", " }}{{ json s.path }}{{ end }}]),
{{- end }}
            ],
            [{{ governs | array.join ", " }}],
            {{ p.subjects.size == 1 && p.stereotype_subjects.size == 0 ? type_of_entity(p.subjects[0].entity) : "null" }},
            new Dictionary<string, string>(StringComparer.Ordinal)
            {
{{- for e in p.events }}
                [{{ json ("event:" + e.name) }}] = {{ json e.id }},
{{- end }}
{{- for i in p.invokes }}
                [{{ json ("invoke:" + i.name) }}] = {{ json i.id }},
{{- end }}
{{- for g in p.guards }}
                [{{ json ("guard:" + g.name) }}] = {{ json g.id }},
{{- end }}
            })
{{- end -}}
{{- capture trigger_args }}
{{- if uses_triggers() && !rights }},
        ids: new Dictionary<string, string>(StringComparer.Ordinal)
        {
{{- for e in p.events }}
            [{{ json ("event:" + e.name) }}] = {{ json e.id }},
{{- end }}
{{- for i in p.invokes }}
            [{{ json ("invoke:" + i.name) }}] = {{ json i.id }},
{{- end }}
{{- for g in p.guards }}
            [{{ json ("guard:" + g.name) }}] = {{ json g.id }},
{{- end }}
        }
{{- end }}
{{- trigger_steps = [] }}
{{- if p.trigger_points.size > 0 }}{{ trigger_steps[0] = "new " + name + "TriggerSteps()" }}{{ end }}
{{- for l in trigger_others(p) }}{{ trigger_steps[trigger_steps.size] = "new global::" + ns(l) + "." + p_name(l) + "TriggerSteps()" }}{{ end }}
{{- if trigger_steps.size > 0 }},
        triggerSteps: [{{ trigger_steps | array.join ", " }}]
{{- end }}
{{- end -}}
{{ header() }}
using System;
using System.Collections.Generic;
using {{ runtime_ns() }};
using {{ actors_ns() }};

namespace {{ ns(p) }};

{{ doc(p.description, "") }}/// <remarks>The chart of process {{ p.name }} ({{ p.use }}) as the interpreter reads it.</remarks>
public static partial class {{ name }}Definition
{
    /// <summary>The process id.</summary>
    public const string ProcessId = {{ json p.id }};

    /// <summary>The process name.</summary>
    public const string ProcessName = {{ json p.name }};

    /// <summary>The chart.</summary>
    public static ChartDefinition Chart { get; } = new(
        ProcessId,
        ProcessName,
        [
            new({{ json p.id }}, {{ json p.name }}, StateKind.Compound, -1, initial: {{ index_of(p.initial) }}),
{{- for s in p.all_states }}
            new({{ json s.id }}, {{ json s.name }}, {{ state_kind(s) }}, {{ s.parent ? index_of(s.parent) : 0 }}
{{- if s.type == "compound" && s.initial }}, initial: {{ index_of(s.initial) }}{{ end }}
{{- if s.type == "history" }}, deepHistory: {{ s.history == "deep" ? "true" : "false" }}{{ if s.default_target }}, defaultTarget: {{ index_of(s.default_target) }}{{ end }}{{ end }}
{{- if s.entry.size > 0 }}, entry: {{ action_names(s.entry) }}{{ end }}
{{- if s.exit.size > 0 }}, exit: {{ action_names(s.exit) }}{{ end }}), // {{ index_of(s) }} {{ s.path }}
{{- end }}
        ],
        [
{{- for t in p.transitions }}
{{- key = t.event ? t.event.name : (t.invoke ? t.invoke.name : "") }}
{{- targets = [] }}
{{- for x in t.targets }}{{ targets[targets.size] = index_of(x) }}{{ end }}
            new({{ json t.id }}, {{ index_of(t.source) }}, {{ trigger_kind(t) }}, {{ json key }}, [{{ targets | array.join ", " }}]
{{- if t.guard }}, guard: {{ json t.guard.name }}{{ end }}
{{- if t.actions.size > 0 }}, actions: {{ action_names(t.actions) }}{{ end }}
{{- if t.after_ticks != null }}, afterTicks: {{ t.after_ticks }}{{ end }}
{{- if t.external }}, external: true{{ end }}
{{- if t.gate }}, gate: {{ gate_index[t.gate.id] }}{{ end }}
{{- if t.guard_missing }}, guardMissing: true{{ end }}
{{- if t.trigger != "event" && t.verb }}, verb: global::{{ base_ns }}.Verb.{{ pascal t.verb.key }}{{ end }}), // {{ cs_line t.label }}
{{- end }}
        ],
{{- if p.events.size == 0 }}
        []
{{- else }}
        [
{{- for e in p.events }}
            new({{ json e.name }}, {{ actor_list(e.actors) }}{{ if e.verb }}, global::{{ base_ns }}.Verb.{{ pascal e.verb.key }}{{ end }}),
{{- end }}
        ]
{{- end }},
{{- if p.actions.size == 0 }}
        []
{{- else }}
        [
{{- for a in p.actions }}
            new({{ json a.name }}, {{ name_list(a.raises) }}),
{{- end }}
        ]
{{- end }},
{{- if p.invokes.size == 0 }}
        []
{{- else }}
        [
{{- for i in p.invokes }}
            new({{ json i.name }}, InvokeKind.{{ i.type == "human-task" ? "HumanTask" : (pascal i.type) }}, {{ index_of(i.state) }}, {{ actor_list(i.actors) }}{{ if i.process }}, {{ json i.process.name }}{{ end }}),
{{- end }}
        ]
{{- end }},
{{- if p.gates.size == 0 }}
        []
{{- else }}
        [
{{- for g in p.gates }}
            new({{ json g.id }}, {{ json g.name }}, {{ g.required }}, {{ actor_list(g.signers) }}, {{ actor_list(g.required_actors) }}, {{ g.allow_repeat_signer ? "true" : "false" }}, {{ g.reason_required ? "true" : "false" }}, {{ name_list(g.meanings) }}, {{ id_list(g.meanings) }}),
{{- end }}
        ]
{{- end }},
{{- if p.actors.size == 0 }}
        null{{ if rights }},{{ rights_arg }}{{ end }}{{ trigger_args }});
{{- else }}
        new Dictionary<string, string>(StringComparer.Ordinal)
        {
{{- for a in p.actors }}
            [Actors.{{ actor_member a }}] = {{ json a.id }},
{{- end }}
        }{{ if rights }},{{ rights_arg }}{{ end }}{{ trigger_args }});
{{- end }}

    /// <summary>The event names.</summary>
    public static class Events
    {
{{- for e in p.events }}
        /// <summary>{{ cs_line e.display_name | escape_xml }}{{ if e.description }}: {{ cs_line e.description | string.strip | escape_xml }}{{ end }}</summary>
        public const string {{ member_name(e.name, "Events") }} = {{ json e.name }};
{{- if !for.last }}
{{ end }}
{{- end }}
    }

    /// <summary>The invoke names.</summary>
    public static class Invokes
    {
{{- for i in p.invokes }}
        /// <summary>{{ cs_line i.display_name | escape_xml }} ({{ i.type }}, started by {{ i.state.path }}).</summary>
        public const string {{ member_name(i.name, "Invokes") }} = {{ json i.name }};
{{- if !for.last }}
{{ end }}
{{- end }}
    }

    /// <summary>The gates and the meanings of their signatures.</summary>
    public static class Gates
    {
{{- for g in p.gates }}
{{- if !for.first }}
{{ end }}
        /// <summary>{{ cs_line g.display_name | escape_xml }}: {{ g.required }} signature(s){{ if g.transition }} on transition {{ cs_line g.transition.label | escape_xml }}{{ end }}.</summary>
        public const string {{ member_name(g.name, "Gates") }} = {{ json g.name }};
{{- for m in g.meanings }}

        /// <summary>Meaning of a {{ g.name }} signature: {{ cs_line m.display_name | escape_xml }}.</summary>
        public const string {{ pascal g.name }}{{ pascal m.name }} = {{ json m.name }};
{{- end }}
{{- end }}
    }
}
