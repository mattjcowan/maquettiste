{{-
# The state enum and path constants of a process. A lifecycle's state enum is its bound enum (the enum unit writes it), so
# this file adds the mapping from active states to it; an orchestration gets an enum with one member per state path.
# A lifecycle with several subjects gets the per-state enum too, with one To<Entity>Status per enum binding. States with a
# code get a constants class, and when the codes form a map (lifecycle-design.md decision 4) ToCode, FromCode and the moves.
include "_csharp.scriban"
include "_process.scriban"
p = process
name = p_name(p)

# Whether a state can hold a code: history and choice states can't, since nothing rests in them.
func can_rest(s)
  ret s.type != "history" && s.type != "choice"
end

# The states that have a code, in document order.
coded = []
for s in p.all_states
  if s.code != null && can_rest(s)
    coded[coded.size] = s
  end
end
code_type = coded.size > 0 && (object.typeof coded[0].code) == "number" ? "long" : "string"

# The coded state that gives a state its code: itself or its nearest coded ancestor; null when no state on its path has one.
func coded_of(s)
  $c = s
  while $c != null
    if $c.code != null && can_rest($c)
      ret $c
    end
    $c = $c.parent
  end
  ret null
end

# The coded state a move into a state rests in: the state's own, else the one its compound states' defaults enter.
func entered_of(s)
  $c = coded_of(s)
  $d = s
  while $c == null && $d != null && $d.type == "compound"
    $d = $d.initial
    if $d != null
      $c = coded_of($d)
    end
  end
  ret $c
end

# Whether a state is the other state or sits inside it.
func within(s, outer)
  $c = s
  while $c != null
    if $c.id == outer.id
      ret true
    end
    $c = $c.parent
  end
  ret false
end

# The coded states a move leaves from: the one on the source's path; for a source without one, each coded state inside it, and null
# where a state without a code rests inside it (or the source is a choice state, which a move only passes through).
func sources_of(s)
  $c = coded_of(s)
  if $c != null
    ret [$c]
  end
  $out = []
  $uncoded = !can_rest(s)
  for $d in p.all_states
    if within($d, s) && can_rest($d)
      if $d.code != null
        $out[$out.size] = $d
      else if $d.children.size == 0 && coded_of($d) == null
        $uncoded = true
      end
    end
  end
  if $uncoded
    $out[$out.size] = null
  end
  ret $out
end

# The coded state a move rests in: its first target's (a history state's nearest coded state, since every state it restores sits
# inside that one); null for a move into a choice state, which the move decides when it runs.
func target_of(t)
  for $target in t.targets
    if $target.type == "choice"
      ret null
    end
  end
  ret t.targets.size == 0 ? null : entered_of(t.targets[0])
end

# The leaves a default entry of a state rests in, added to the list: a compound state enters its initial state, a parallel state
# each region, a history state its default target and the other regions of any parallel state on the way. A choice state is
# added as it is, since the chart picks its branch when it runs.
func enter_default(s, depth, entered)
  if depth > 64
    ret
  end
  if s.type == "history"
    if s.default_target
      enter_default(s.default_target, depth + 1, entered)
      $c = s.default_target
      while $c.parent != null && (s.parent == null || $c.parent.id != s.parent.id)
        if $c.parent.type == "parallel"
          for $r in $c.parent.children
            if $r.id != $c.id && $r.type != "history"
              enter_default($r, depth + 1, entered)
            end
          end
        end
        $c = $c.parent
      end
    end
  else if s.type == "parallel"
    for $r in s.children
      if $r.type != "history"
        enter_default($r, depth + 1, entered)
      end
    end
  else if s.type == "compound" && s.initial
    enter_default(s.initial, depth + 1, entered)
  else
    entered[entered.size] = s
  end
end

# The configuration a coded state restores: the leaves its default entry rests in, in document order; null when the entry meets a
# choice state, so no configuration is fixed.
func default_leaves(s)
  $entered = []
  enter_default(s, 0, $entered)
  $out = []
  for $a in p.all_states
    for $e in $entered
      if $e.id == $a.id
        if $a.type == "choice"
          ret null
        end
        $out[$out.size] = $a
        break
      end
    end
  end
  ret $out
end

# The constant of a coded state: its name in PascalCase, or its path's where two coded states share a name ("Value" appended
# when that would meet a member of the class).
func code_member(s)
  $n = pascal s.name
  for $o in coded
    if $o.id != s.id && (pascal $o.name) == $n
      $n = state_member(s)
      break
    end
  end
  if $n == "ToCode" || $n == "FromCode" || $n == "Moves" || $n == name + "StateCodes"
    $n = $n + "Value"
  end
  ret $n
end

# The code of a move's end: a coded state's constant, or null.
func code_ref(s)
  ret s == null ? "null" : code_member(s)
end

# The method name part of a subject: its entity's name in PascalCase, qualified by package where two subjects share a name.
func subject_name(sub)
  $n = pascal sub.entity.name
  for $o in p.subjects
    if $o.id != sub.id && (pascal $o.entity.name) == $n
      $q = ""
      if sub.entity.package
        for $part in (sub.entity.package.qualified_name | string.split ".")
          $q = $q + (pascal $part)
        end
      end
      ret $q + $n
    end
  end
  ret $n
end

# A lifecycle with several subjects gets one To<Entity>Status per enum binding, each naming its enum in full (global::), since two
# bound enums may share a name, or share one with a type of the process's namespace.
several = p.use == "lifecycle" && p.subjects.size > 1
-}}
{{ header() }}
using System;
using System.Collections.Generic;

namespace {{ ns(p) }};

/// <summary>The state paths of process {{ p.name }}, as constants.</summary>
public static partial class {{ name }}States
{
{{- for s in p.all_states }}
    /// <summary>State {{ s.path }} ({{ s.type }}).</summary>
    public const string {{ state_member(s) }} = {{ json s.path }};
{{ end }}
    /// <summary>Every state path, in document order.</summary>
    public static IReadOnlyList<string> All { get; } =
    [
{{- for s in p.all_states }}
        {{ state_member(s) }},
{{- end }}
    ];
{{- if p.bound_enum }}

    /// <summary>The {{ p.bound_enum.name }} value of a configuration: the root-level state of its first active state.</summary>
    /// <param name="states">The active leaf states' paths.</param>
    /// <returns>The value.</returns>
    public static {{ type_of p.bound_attribute.type "csharp" }} ToStatus(IReadOnlyList<string> states)
    {
        ArgumentNullException.ThrowIfNull(states);
        var root = states.Count == 0 ? "" : states[0].Split('.')[0];
        return root switch
        {
{{- for s in p.bound_states }}
{{- if s.bound_member }}
            {{ json s.name }} => {{ type_of p.bound_attribute.type "csharp" }}.{{ cs_ident (pascal s.bound_member.name) }},
{{- end }}
{{- end }}
            _ => throw new ArgumentOutOfRangeException(nameof(states), root, "No {{ p.bound_enum.name }} member for this state."),
        };
    }
{{- else }}

    /// <summary>The state of a path.</summary>
    /// <param name="path">The dotted path.</param>
    /// <returns>The state.</returns>
    public static {{ name }}State Parse(string path) => path switch
    {
{{- for s in p.all_states }}
        {{ state_member(s) }} => {{ name }}State.{{ state_member(s) }},
{{- end }}
        _ => throw new ArgumentOutOfRangeException(nameof(path), path, "Not a state of {{ p.name }}."),
    };
{{- if several }}
{{- for sub in p.subjects }}
{{- if sub.bound_enum }}
{{- status = "global::" + ns(sub.bound_enum) + "." + type_name(sub.bound_enum) }}

    /// <summary>The {{ sub.bound_enum.name }} value of {{ sub.entity.name }}.{{ sub.bound_attribute.name }} for a configuration: the root-level state of its first active state.</summary>
    /// <param name="states">The active leaf states' paths.</param>
    /// <returns>The value.</returns>
    public static {{ status }} To{{ subject_name(sub) }}Status(IReadOnlyList<string> states)
    {
        ArgumentNullException.ThrowIfNull(states);
        var root = states.Count == 0 ? "" : states[0].Split('.')[0];
        return root switch
        {
{{- for s in p.bound_states }}
{{- member = by_name(sub.bound_enum.members, s.name) }}
{{- if member }}
            {{ json s.name }} => {{ status }}.{{ cs_ident (pascal member.name) }},
{{- end }}
{{- end }}
            _ => throw new ArgumentOutOfRangeException(nameof(states), root, "No {{ sub.bound_enum.name }} member for this state."),
        };
    }
{{- end }}
{{- end }}
{{- end }}
{{- end }}
}
{{- if !p.bound_enum }}

/// <summary>The states of process {{ p.name }}, one member per state path.</summary>
public enum {{ name }}State
{
{{- for s in p.all_states }}
    /// <summary>{{ s.path }}</summary>
    {{ state_member(s) }},
{{- end }}
}
{{- end }}
{{- if coded.size > 0 }}

/// <summary>The state codes of process {{ p.name }}: one constant per state that has a code.</summary>
public static partial class {{ name }}StateCodes
{
{{- for s in coded }}
{{ if !for.first }}
{{ end }}    /// <summary>The code of state {{ s.path }}.</summary>
    public const {{ code_type }} {{ code_member(s) }} = {{ json s.code }};
{{- end }}
{{- if p.codes_map }}

    /// <summary>
    /// The code of a configuration: the code of the coded state that holds its active states, its own or its nearest coded ancestor's;
    /// null when no state on their paths has a code.
    /// </summary>
    /// <param name="states">The active leaf states' paths.</param>
    /// <returns>The code, or null.</returns>
    public static {{ code_type }}? ToCode(IReadOnlyList<string> states)
    {
        ArgumentNullException.ThrowIfNull(states);
        foreach (var state in states)
        {
            {{ code_type }}? code = state switch
            {
{{- for s in p.all_states }}
{{- if can_rest(s) }}
{{- c = coded_of(s) }}
{{- if c }}
                {{ name }}States.{{ state_member(s) }} => {{ code_member(c) }},
{{- end }}
{{- end }}
{{- end }}
                _ => null,
            };
            if (code is not null)
                return code;
        }

        return null;
    }

    /// <summary>
    /// The configuration a code restores: the active leaf states' paths, in document order, that entering the coded state rests in. A
    /// compound state enters its initial state and a parallel state each of its regions, as the chart does, so the paths suit a snapshot.
    /// </summary>
    /// <param name="code">The code.</param>
    /// <returns>The active leaf states' paths.</returns>
    public static IReadOnlyList<string> FromCode({{ code_type }} code) => code switch
    {
{{- for s in coded }}
{{- leaves = default_leaves(s) }}
{{- if leaves == null }}
        {{ code_member(s) }} => throw new InvalidOperationException({{ json ("State " + s.path + " enters a choice state by default, so the chart picks its states when it runs.") }}),
{{- else }}
        {{ code_member(s) }} => [{{ for l in leaves }}{{ if !for.first }}, {{ end }}{{ name }}States.{{ state_member(l) }}{{ end }}],
{{- end }}
{{- end }}
        _ => throw new ArgumentOutOfRangeException(nameof(code), code, "No state of {{ p.name }} has this code."),
    };

    /// <summary>
    /// Every transition as a move, in document order: the source's code, the code the target rests in, the trigger and the event. A
    /// source without a code on its path gives one move per coded state inside it, plus one with a null code where a state without a
    /// code rests inside it. A move without a target keeps its code. The target's code is null for a state without one, for a history
    /// state outside every coded state and for a choice state, since the move decides it when it runs. The event is null for timers,
    /// completions and eventless moves.
    /// </summary>
    public static IReadOnlyList<({{ code_type }}? From, {{ code_type }}? To, string Trigger, string? Event)> Moves { get; } =
    [
{{- for t in p.transitions }}
{{- to = target_of(t) }}
{{- for from in sources_of(t.source) }}
        ({{ code_ref(from) }}, {{ code_ref(t.is_targetless ? from : to) }}, {{ json t.trigger }}, {{ t.event ? (json t.event.name) : "null" }}),
{{- end }}
{{- end }}
    ];
{{- end }}
}
{{- end }}
