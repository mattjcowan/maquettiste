{{-
# Shared SQL functions for the sql-ddl pack. Include this file once at the top of a template; it prints nothing.
# Supported dialects: postgresql, sqlserver, sqlite. Other dialects get portable ANSI SQL.

# Quotes one identifier for a database, honouring the pack's "quoting" parameter ("" = the database's own setting).
func q(name, db)
  if pack.params.quoting != ""
    ret sql_quote name db pack.params.quoting
  end
  ret sql_quote name db
end

# Schema-qualified name of a table, view or sequence ("billing.invoices"; SQLite has no schemas).
func qn(schema, name, db)
  if schema && db.dialect != "sqlite"
    ret q(schema, db) + "." + q(name, db)
  end
  ret q(name, db)
end

func qt(t)
  ret qn(t.schema, t.name, t.database)
end

# Comma-separated quoted column names.
func cols(list, db)
  $text = ""
  for c in list
    $text = $text + (for.first ? "" : ", ") + q(c.name, db)
  end
  ret $text
end

# SQL text of a string literal for the database's dialect.
func lit(value, db)
  ret sql_literal value db
end

# ON DELETE / ON UPDATE action, or "" for the default (no action). SQL Server has no RESTRICT; NO ACTION behaves the same there.
func fk_action(action, db)
  case action
    when "cascade"
      ret "CASCADE"
    when "set-null"
      ret "SET NULL"
    when "set-default"
      ret "SET DEFAULT"
    when "restrict"
      if db.dialect == "sqlserver"
        ret ""
      end
      ret "RESTRICT"
  end
  ret ""
end

# Whether a table's primary key is a single SQLite rowid alias (an identity integer column), written inline as
# "INTEGER PRIMARY KEY" because SQLite only auto-assigns values to that exact form.
func sqlite_rowid(t)
  if t.database.dialect != "sqlite" || !t.primary_key || t.primary_key.columns.size != 1
    ret false
  end
  ret t.primary_key.columns[0].identity
end

# The SQL expression for a named attribute default expression (now, today, new-uuid), or "" when the dialect has none.
func default_expression(expr, c, db)
  $d = db.dialect
  if expr == "now"
    if $d == "sqlserver"
      ret c.type == "datetimeoffset" ? "SYSDATETIMEOFFSET()" : "SYSUTCDATETIME()"
    end
    ret "CURRENT_TIMESTAMP"
  else if expr == "today"
    if $d == "sqlserver"
      ret "CAST(SYSUTCDATETIME() AS date)"
    end
    ret "CURRENT_DATE"
  else if expr == "new-uuid"
    if $d == "postgresql"
      ret "gen_random_uuid()"
    else if $d == "sqlserver"
      ret "NEWID()"
    end
  end
  ret ""
end

# The default clause of a column without the DEFAULT keyword, or "": per-dialect SQL, then a literal, then a sequence, then a
# named default expression of the attribute.
func default_sql(c, db)
  if c.default_sql
    ret c.default_sql
  end
  if c.default != null
    ret lit(c.default, db)
  end
  if c.sequence && !c.identity
    if db.dialect == "postgresql"
      ret "nextval(" + lit(qn(c.sequence.schema, c.sequence.name, db), db) + ")"
    else if db.dialect == "sqlserver"
      ret "(NEXT VALUE FOR " + qn(c.sequence.schema, c.sequence.name, db) + ")"
    end
    ret ""
  end
  if c.attribute && c.attribute.default_expression
    ret default_expression(c.attribute.default_expression, c, db)
  end
  ret ""
end

# FOREIGN KEY ... REFERENCES ... with its actions, without the CONSTRAINT name.
func foreign_key_body(f, db)
  $s = "FOREIGN KEY (" + cols(f.columns, db) + ") REFERENCES " + qt(f.referenced_table) + " (" + cols(f.referenced_columns, db) + ")"
  if fk_action(f.on_delete, db) != ""
    $s = $s + " ON DELETE " + fk_action(f.on_delete, db)
  end
  if fk_action(f.on_update, db) != ""
    $s = $s + " ON UPDATE " + fk_action(f.on_update, db)
  end
  ret $s
end

# One column definition, without indentation or trailing comma.
func column_def(c)
  $t = c.table
  $db = $t.database
  $d = $db.dialect
  $s = q(c.name, $db)
  if c.computed
    if $d == "sqlserver"
      ret $s + " AS (" + c.computed + ")" + (c.computed_stored ? " PERSISTED" : "")
    end
    $s = $s + " " + (type_of c $d)
    if $d == "postgresql"
      ret $s + " GENERATED ALWAYS AS (" + c.computed + ") STORED"
    end
    ret $s + " GENERATED ALWAYS AS (" + c.computed + ")" + (c.computed_stored ? " STORED" : " VIRTUAL")
  end
  if c.is_primary_key && sqlite_rowid($t)
    ret $s + " INTEGER NOT NULL CONSTRAINT " + q($t.primary_key.name, $db) + " PRIMARY KEY"
  end
  $s = $s + " " + (type_of c $d)
  if c.collation
    $s = $s + " COLLATE " + ($d == "postgresql" ? q(c.collation, $db) : c.collation)
  end
  if c.identity
    if $d == "postgresql"
      $s = $s + " GENERATED BY DEFAULT AS IDENTITY"
    else if $d == "sqlserver"
      $s = $s + " IDENTITY(1,1)"
    end
  end
  $s = $s + (c.nullable ? " NULL" : " NOT NULL")
  $dflt = default_sql(c, $db)
  if $dflt != ""
    if $d == "sqlserver"
      $s = $s + " CONSTRAINT " + q("df_" + $t.name + "_" + c.name, $db)
    end
    $s = $s + " DEFAULT " + $dflt
  end
  ret $s
end

# The CREATE INDEX statement of an index (with its terminating semicolon).
func index_sql(ix, t)
  $db = t.database
  $d = $db.dialect
  $parts = ""
  for ic in ix.columns
    $parts = $parts + (for.first ? "" : ", ") + q(ic.column.name, $db) + (ic.descending ? " DESC" : "")
  end
  $s = "CREATE " + (ix.unique ? "UNIQUE " : "")
  if $d == "sqlserver" && ix.method == "clustered"
    $s = $s + "CLUSTERED "
  end
  $s = $s + "INDEX " + q(ix.name, $db) + " ON " + qt(t)
  if $d == "postgresql" && (ix.method == "btree" || ix.method == "hash" || ix.method == "gin" || ix.method == "gist")
    $s = $s + " USING " + ix.method
  end
  $s = $s + " (" + $parts + ")"
  if ix.include.size > 0 && ($d == "postgresql" || $d == "sqlserver")
    $s = $s + " INCLUDE (" + cols(ix.include, $db) + ")"
  end
  if ix.where
    $s = $s + " WHERE " + ix.where
  end
  $s = $s + ";"
  if $d == "postgresql" && ix.method == "clustered"
    $s = $s + "\nCLUSTER " + qt(t) + " USING " + q(ix.name, $db) + ";"
  end
  ret $s
end

# A table comment or column comment statement for PostgreSQL or SQL Server; "" elsewhere (SQLite keeps comments in the text).
func comment_sql(t, c, text)
  $db = t.database
  if $db.dialect == "postgresql"
    if c
      ret "COMMENT ON COLUMN " + qt(t) + "." + q(c.name, $db) + " IS " + lit(text, $db) + ";"
    end
    ret "COMMENT ON TABLE " + qt(t) + " IS " + lit(text, $db) + ";"
  else if $db.dialect == "sqlserver"
    $s = "EXEC sys.sp_addextendedproperty @name = N'MS_Description', @value = " + lit(text, $db) + ", @level0type = N'SCHEMA', @level0name = " + lit(t.schema ?? "dbo", $db) + ", @level1type = N'TABLE', @level1name = " + lit(t.name, $db)
    if c
      $s = $s + ", @level2type = N'COLUMN', @level2name = " + lit(c.name, $db)
    end
    ret $s + ";"
  end
  ret ""
end

# An idempotent statement that inserts or updates the rows of a lookup table (an enum stored as "lookup"): INSERT ... ON
# CONFLICT DO UPDATE on PostgreSQL and SQLite, MERGE on SQL Server, plain INSERTs elsewhere. Rows of removed members are kept.
func lookup_upsert(t)
  $db = t.database
  $d = $db.dialect
  $id = q(t.columns[0].name, $db)
  $code = q(t.columns[1].name, $db)
  $name = q(t.columns[2].name, $db)
  $values = ""
  for r in t.lookup_rows
    $values = $values + (for.first ? "" : ",\n    ") + "(" + r.id + ", " + lit(r.code, $db) + ", " + lit(r.name, $db) + ")"
  end
  if $d == "postgresql" || $d == "sqlite"
    ret "INSERT INTO " + qt(t) + " (" + $id + ", " + $code + ", " + $name + ") VALUES\n    " + $values + "\nON CONFLICT (" + $id + ") DO UPDATE SET " + $code + " = excluded." + $code + ", " + $name + " = excluded." + $name + ";"
  else if $d == "sqlserver"
    ret "MERGE INTO " + qt(t) + " AS target\nUSING (VALUES\n    " + $values + ") AS source (" + $id + ", " + $code + ", " + $name + ")\nON target." + $id + " = source." + $id + "\nWHEN MATCHED THEN UPDATE SET " + $code + " = source." + $code + ", " + $name + " = source." + $name + "\nWHEN NOT MATCHED THEN INSERT (" + $id + ", " + $code + ", " + $name + ") VALUES (source." + $id + ", source." + $code + ", source." + $name + ");"
  end
  $s = ""
  for r in t.lookup_rows
    $s = $s + (for.first ? "" : "\n") + "INSERT INTO " + qt(t) + " (" + $id + ", " + $code + ", " + $name + ") VALUES (" + r.id + ", " + lit(r.code, $db) + ", " + lit(r.name, $db) + ");"
  end
  ret $s
end

# Human-readable dialect name for headers.
func dialect_title(db)
  case db.dialect
    when "postgresql"
      $title = "PostgreSQL"
    when "sqlserver"
      $title = "SQL Server"
    when "sqlite"
      $title = "SQLite"
    when "mysql"
      $title = "MySQL"
    when "oracle"
      $title = "Oracle"
    else
      $title = db.dialect
  end
  ret db.version ? $title + " " + db.version : $title
end
-}}
