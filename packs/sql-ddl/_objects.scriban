{{-
# CREATE statements for sequences, views, routines, database types and SQL objects, the foreign-key graph for ddl_order, and the
# dependency order of routines, database types and SQL objects (their dependsOn). Needs _sql.scriban.

# The foreign-key graph of a table list as text for the ddl_order and ddl_cycle_breaks helpers (see helpers.js).
func dependency_spec(tables)
  $index = {}
  for t in tables
    $index[t.key] = for.index
  end
  capture $spec
    for t in tables
      if !for.first
        ";"
      end
      for f in t.foreign_keys
        if !for.first
          ","
        end
        $target = $index[f.referenced_table.key]
        ($target == null || f.referenced_table.key == t.key) ? "x" : $target
      end
    end
  end
  ret "" + $spec
end

# Whether foreign keys that close a cycle are added after the CREATE TABLEs: every dialect but SQLite, which accepts forward
# references inline.
func defers_cycle_breaks(db)
  ret db.dialect != "sqlite"
end

# The foreign keys ddl_cycle_breaks returned for a table list, as an object keyed by constraint name (value true) for
# _table.scriban's second argument (the constraints it leaves out); null when the dialect keeps them inline. A lookup per foreign
# key keeps a schema script linear in its tables: the earlier ",name,name," string grew with every break and was scanned for every
# foreign key (4,414 breaks among 25,305 foreign keys in the benchmark's main database).
func cycle_skip(tables, breaks, db)
  if !defers_cycle_breaks(db)
    ret null
  end
  $skip = {}
  for b in breaks
    $pair = b | string.split ":"
    $skip[tables[$pair[0] | string.to_int].foreign_keys[$pair[1] | string.to_int].name] = true
  end
  ret $skip
end

# Whether a table has a foreign key in a cycle_skip set.
func has_skipped_fk(t, skip)
  if !skip
    ret false
  end
  for f in t.foreign_keys
    if skip[f.name]
      ret true
    end
  end
  ret false
end

# ALTER TABLE ... ADD CONSTRAINT for every foreign key in a cycle_skip set, appended to out, in table order.
func cycle_fk_statements(tables, breaks, db, out)
  if !defers_cycle_breaks(db)
    ret
  end
  for b in breaks
    $pair = b | string.split ":"
    $t = tables[$pair[0] | string.to_int]
    $f = $t.foreign_keys[$pair[1] | string.to_int]
    out[out.size] = add_constraint_sql($t, $f.name, foreign_key_body($f, db))
  end
end

# CREATE SEQUENCE, or a comment where the dialect has none (SQLite, MySQL; MariaDB has sequences, write them as SQL objects).
# Oracle sequences have no type.
func sequence_sql(s, db)
  if db.dialect == "sqlite" || db.dialect == "mysql"
    ret "-- " + dialect_title(db) + " has no sequences; " + s.name + " (start " + s.start + ") is not created."
  end
  $r = "CREATE SEQUENCE " + (idem() && (db.dialect == "postgresql") ? "IF NOT EXISTS " : "") + qn(s.schema, s.name, db) + (db.dialect == "oracle" ? "" : " AS " + s.native_type) + " START WITH " + s.start + " INCREMENT BY " + s.increment
  if s.min != null
    $r = $r + " MINVALUE " + s.min
  end
  if s.max != null
    $r = $r + " MAXVALUE " + s.max
  end
  if s.cycle
    $r = $r + " CYCLE"
  end
  if s.cache != null
    $r = $r + " CACHE " + s.cache
  end
  $r = $r + ";"
  if idem() && db.dialect == "sqlserver"
    $r = "IF OBJECT_ID(" + ms_object(s.schema, s.name, db) + ", N'SO') IS NULL " + $r
  end
  ret $r
end

# Whether the DDL creates a view as a materialized view: one that asks for it, on PostgreSQL or Oracle (MQ4056 elsewhere, where it is
# a plain view).
func materialized(v, db)
  ret v.materialized && (db.dialect == "postgresql" || db.dialect == "oracle")
end

# CREATE VIEW with its column list (columnList), WITH CHECK OPTION (not on SQLite or a materialized view, MQ4056) and its comment
# (comments parameter). Idempotent: CREATE OR REPLACE VIEW (PostgreSQL, MySQL, Oracle), CREATE OR ALTER VIEW (SQL Server), CREATE
# VIEW IF NOT EXISTS (SQLite); a materialized view is CREATE MATERIALIZED VIEW [IF NOT EXISTS] (PostgreSQL, Oracle), which the
# application refreshes. On SQL Server the comment follows in a batch of its own.
func view_sql(v, db)
  $d = db.dialect
  $body = v.body | string.rstrip
  if $body | string.ends_with ";"
    $body = $body | string.slice 0 ($body.size - 1)
  end
  $mat = materialized(v, db)
  $create = $mat ? "CREATE MATERIALIZED VIEW " : "CREATE VIEW "
  if idem()
    if $mat
      $create = $d == "postgresql" ? "CREATE MATERIALIZED VIEW IF NOT EXISTS " : $create
    else if $d == "sqlserver"
      $create = "CREATE OR ALTER VIEW "
    else if $d == "sqlite"
      $create = "CREATE VIEW IF NOT EXISTS "
    else
      $create = "CREATE OR REPLACE VIEW "
    end
  end
  $names = ""
  if v.column_list && v.columns.size > 0
    $names = " (" + cols(v.columns, db) + ")"
  end
  $check = v.with_check_option && !$mat && $d != "sqlite" ? "\nWITH CHECK OPTION" : ""
  $s = $create + qn(v.schema, v.name, db) + $names + " AS\n" + $body + $check + ";"
  if pack.params.comments && v.comment && view_comment_sql(v, db, v.comment) != ""
    $comment = ($d == "sqlserver" && !idem()) ? ms_add_description(db, "VIEW", v.schema, v.name, null, v.comment) : view_comment_sql(v, db, v.comment)
    $s = $s + ($d == "sqlserver" ? "\nGO\n" : "\n") + $comment
  end
  ret $s
end

# ---- routines, database types and SQL objects -------------------------------------------------------------------------------
#
# DDL order in schema.sql and in a first migration: SQL objects with phase "before" (an extension), database types, sequences,
# tables, then routines and views together (every routine before the views unless its dependsOn names a view, which then comes
# first), then SQL objects with phase "after" (a trigger, a grant). Within each group an object follows what its dependsOn names
# (a composite type follows the types of its fields); ddl_order walks the list in the resolver's (schema, name) order.

# The dependency graph of a list of routines, views, database types or SQL objects as text for ddl_order: one entry per item,
# each the list indexes of what its depends_on names inside the list ("x" for anything outside it, such as a table).
func object_dependency_spec(items)
  $index = {}
  for o in items
    $index[o.id] = for.index
  end
  capture $spec
    for o in items
      if !for.first
        ";"
      end
      for dep in o.depends_on
        if !for.first
          ","
        end
        $target = $index[dep.id]
        ($target == null || dep.id == o.id) ? "x" : $target
      end
    end
  end
  ret "" + $spec
end

# A list in dependency order (see object_dependency_spec). A single item needs no walk: its spec is the empty string, which
# ddl_order reads as no items at all.
func in_dependency_order(items)
  $result = []
  if items.size < 2
    for o in items
      $result[$result.size] = o
    end
    ret $result
  end
  for i in (ddl_order object_dependency_spec(items))
    $result[$result.size] = items[i]
  end
  ret $result
end

# The routines of a database followed by its views, in creation order: a routine whose dependsOn names a view comes after it, and a
# view after the views it reads (its dependsOn, which the resolver completes from the body).
func routines_and_views(db)
  if db.routines.size == 0
    ret in_dependency_order(db.views)
  end
  $items = []
  for r in db.routines
    $items[$items.size] = r
  end
  for v in db.views
    $items[$items.size] = v
  end
  ret in_dependency_order($items)
end

# The SQL objects of a database with the given phase ("before" or "after"), in dependency order.
func objects_in_phase(db, phase)
  $items = []
  for o in db.objects
    if o.phase == phase
      $items[$items.size] = o
    end
  end
  ret in_dependency_order($items)
end

# ", routines N, database types N, SQL objects N" for the schema script's header, or "" when the database has none of them.
func object_counts(db)
  if db.routines.size + db.types.size + db.objects.size == 0
    ret ""
  end
  ret ", routines " + db.routines.size + ", database types " + db.types.size + ", SQL objects " + db.objects.size
end

# Text without trailing whitespace and without a trailing semicolon.
func trim_statement(text)
  $t = text | string.rstrip
  if $t | string.ends_with ";"
    $t = $t | string.slice 0 ($t.size - 1) | string.rstrip
  end
  ret $t
end

# One parameter of a routine for the dialect: PostgreSQL "[OUT |INOUT ]name type [DEFAULT x]", SQL Server "@name type [= x][ OUTPUT]".
func routine_parameter_sql(p, db)
  if db.dialect == "sqlserver"
    $name = (p.name | string.starts_with "@") ? p.name : "@" + p.name
    $s = $name + " " + p.native_type
    if p.default != null
      $s = $s + " = " + p.default
    end
    if p.mode != "in"
      $s = $s + " OUTPUT"
    end
    ret $s
  end
  $s = (p.mode == "out" ? "OUT " : (p.mode == "inout" ? "INOUT " : "")) + q(p.name, db) + " " + p.native_type
  if p.default != null
    $s = $s + " DEFAULT " + p.default
  end
  ret $s
end

# The CREATE FUNCTION or CREATE PROCEDURE of a routine, or a comment where the dialect has none (SQLite) or the routine has no
# body for the dialect. PostgreSQL: the body between dollar quotes, with LANGUAGE, IMMUTABLE for a deterministic function and
# SECURITY DEFINER. SQL Server: the body after AS as written; a table result is an inline table-valued function (RETURNS TABLE,
# the body is its RETURN), and definer rights are WITH EXECUTE AS OWNER.
func routine_sql(r, db)
  $d = db.dialect
  $what = r.routine_kind
  if $d == "sqlite"
    ret "-- SQLite has no stored routines; " + $what + " " + r.name + " is not created."
  end
  if $d != "postgresql" && $d != "sqlserver"
    ret "-- The sql-ddl pack writes routines for PostgreSQL and SQL Server only; " + $what + " " + r.name + " is not created."
  end
  if !r.has_body
    ret "-- " + $what + " " + r.name + " has no body for " + $d + "; it is not created."
  end
  $params = ""
  for p in r.parameters
    $params = $params + (for.first ? "" : ", ") + routine_parameter_sql(p, db)
  end
  $body = r.body | string.rstrip
  if $d == "sqlserver"
    $s = "CREATE " + ($what == "procedure" ? "PROCEDURE " : "FUNCTION ") + qn(r.schema, r.name, db)
    if $what == "procedure"
      $s = $s + ($params == "" ? "" : " " + $params)
    else
      $s = $s + "(" + $params + ")"
      if r.returns && r.returns.table
        $s = $s + "\nRETURNS TABLE"
      else if r.returns
        $s = $s + "\nRETURNS " + r.returns.native_type
      end
    end
    if r.security == "definer"
      $s = $s + "\nWITH EXECUTE AS OWNER"
    end
    ret $s + "\nAS\n" + $body
  end
  $s = "CREATE " + ($what == "procedure" ? "PROCEDURE " : "FUNCTION ") + qn(r.schema, r.name, db) + "(" + $params + ")"
  if $what != "procedure"
    if r.returns && r.returns.table
      $cols = ""
      for c in r.returns.table
        $cols = $cols + (for.first ? "" : ", ") + q(c.name, db) + " " + c.native_type
      end
      $s = $s + "\nRETURNS TABLE (" + $cols + ")"
    else if r.returns
      $s = $s + "\nRETURNS " + r.returns.native_type
    else
      $s = $s + "\nRETURNS void"
    end
  end
  $s = $s + "\nLANGUAGE " + r.language
  if r.deterministic && $what != "procedure"
    $s = $s + "\nIMMUTABLE"
  end
  if r.security == "definer"
    $s = $s + "\nSECURITY DEFINER"
  end
  $tag = ($body | string.contains "$$") ? "$body$" : "$$"
  $s = $s + "\nAS " + $tag + "\n" + $body + "\n" + $tag + ";"
  if pack.params.comments && r.comment
    $s = $s + "\nCOMMENT ON " + ($what == "procedure" ? "PROCEDURE " : "FUNCTION ") + qn(r.schema, r.name, db) + " IS " + lit(r.comment, db) + ";"
  end
  ret $s
end

# The CREATE DOMAIN or CREATE TYPE of a database type, or a comment where the dialect cannot create it. A definition for the dialect
# is written after the name as it is; otherwise the structured form gives PostgreSQL's DOMAIN, ENUM, composite and RANGE and SQL
# Server's alias type (CREATE TYPE ... FROM, without the domain's CHECK).
func type_sql(t, db)
  $d = db.dialect
  if !t.is_created || ($d != "postgresql" && $d != "sqlserver")
    $s = "-- " + dialect_title(db) + " has no " + t.type_kind + " types; " + t.name + " is not created"
    ret $s + (t.native_name != "" ? " (columns of this type are " + t.native_name + ")." : ".")
  end
  $name = qn(t.schema, t.name, db)
  if t.definition
    $keyword = ($d == "postgresql" && t.type_kind == "domain") ? "CREATE DOMAIN " : "CREATE TYPE "
    ret $keyword + $name + " " + trim_statement(t.definition) + ";"
  end
  if $d == "sqlserver"
    $s = ""
    if t.check
      $s = "-- SQL Server alias types have no CHECK; " + t.name + " does not enforce: " + t.check + "\n"
    end
    ret $s + "CREATE TYPE " + $name + " FROM " + t.base_native_type + ";"
  end
  case t.type_kind
    when "domain"
      $s = "CREATE DOMAIN " + $name + " AS " + t.base_native_type
      if t.check
        $s = $s + " CHECK (" + t.check + ")"
      end
      $s = $s + ";"
    when "enum"
      $labels = ""
      for m in t.members
        $labels = $labels + (for.first ? "" : ", ") + lit(m, db)
      end
      $s = "CREATE TYPE " + $name + " AS ENUM (" + $labels + ");"
    when "composite"
      $fields = ""
      for f in t.fields
        $fields = $fields + (for.first ? "" : ", ") + q(f.name, db) + " " + f.native_type
      end
      $s = "CREATE TYPE " + $name + " AS (" + $fields + ");"
    else
      $s = "CREATE TYPE " + $name + " AS RANGE (SUBTYPE = " + t.subtype_native_type + ");"
  end
  if pack.params.comments && t.comment
    $s = $s + "\nCOMMENT ON " + (t.type_kind == "domain" ? "DOMAIN " : "TYPE ") + $name + " IS " + lit(t.comment, db) + ";"
  end
  ret $s
end

# The statements of a SQL object as written, or a comment when it has none for the dialect.
func object_sql(o, db)
  if !o.has_body
    ret "-- " + o.object_kind + " " + o.name + " has no statements for " + db.dialect + "; it is not created."
  end
  ret o.body | string.rstrip
end

# Whether the dialect creates schemas (MySQL's schemas are its databases; SQLite has none; Oracle's are users, created by hand).
func creates_schemas(db)
  ret db.dialect == "postgresql" || db.dialect == "sqlserver" || db.dialect == "mysql"
end

# Whether a schema name is the dialect's built-in schema, which is never created or dropped.
func builtin_schema(name, db)
  ret (db.dialect == "postgresql" && name == "public") || (db.dialect == "sqlserver" && name == "dbo")
end

# Schemas the script must create: every named schema of the database except the dialect's built-in one.
func schemas_to_create(db)
  $result = []
  if creates_schemas(db)
    for s in db.schemas
      if !builtin_schema(s.name, db)
        $result[$result.size] = s.name
      end
    end
  end
  ret $result
end

func schema_sql(name, db)
  if db.dialect == "sqlserver"
    ret "IF SCHEMA_ID(" + lit(name, db) + ") IS NULL EXEC(" + lit("CREATE SCHEMA " + q(name, db), db) + ");"
  end
  ret "CREATE SCHEMA IF NOT EXISTS " + q(name, db) + ";"
end

# The path of a table script relative to the database folder, as the table unit writes it.
func table_path(t)
  ret (t.schema ? t.schema + "/" : "") + "tables/" + t.name + ".sql"
end

# A client directive that runs another script: psql \ir, sqlcmd :r, sqlite3 .read (relative to the working directory for
# sqlcmd and sqlite3, so run those from the database folder). Paths keep "/": sqlcmd accepts it on every OS, while "\" fails on
# Linux and macOS.
func include_directive(path, db)
  case db.dialect
    when "postgresql"
      ret "\\ir " + path
    when "sqlserver"
      ret ":r " + path
    when "sqlite"
      ret ".read " + path
  end
  ret "-- run " + path
end
-}}
