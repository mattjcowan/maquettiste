{{-
# One seed script per environment the environments parameter names (2026-10-07): the rows of the table seeds, and of the seeds of
# entities bound to a table, whose environments include it; run it after seed.sql, which holds the rows of every environment. No
# file for an environment none of the database's seeds names.
include "_sql.scriban"
include "_objects.scriban"
include "_reference.scriban"
include "_data.scriban"
db = database
go = db.dialect == "sqlserver" ? "\nGO" : ""
for env in pack.params.environments
  rows = []
  data_statements(db, env, rows)
  if rows.size == 0
    continue
  end
  capture content
-}}
-- Generated by Maquettiste (sql-ddl/seed-environments). Do not edit; changes are overwritten.
-- Seed data of database {{ db.name }} ({{ dialect_title(db) }}) for the {{ env }} environment. Run it after seed.sql; it can run again.
{{- for s in rows }}

{{ s }}{{ go }}
{{- end }}
{{ end -}}
{{- file ((kebab db.name) + "/seed." + (kebab env) + ".sql") content -}}
{{- end -}}
