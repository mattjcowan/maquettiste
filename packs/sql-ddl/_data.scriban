{{-
# Table seeds, the entity seeds that reach a table through a binding and the seeds of reference types bound to a table (their rows
# first in it; database.seed_tables, referenced tables first): seed.sql
# writes the rows for every environment, seed.<env>.sql an environment's own. A seed applied once inserts the rows whose key is
# missing; a converging seed also updates the rows whose other columns changed (an upsert on the row key), and with delete it
# removes the table's rows it does not hold. Entity seeds of a database that projects the entity are written by seed_statements.
# A table seed's foreign-key entry names its row by that row's key; where the database fills the referenced value (identity,
# sequence, a default), the column is written as a lookup of that row on PostgreSQL, and rows of one table that look up rows of the
# same table go in one INSERT per dependency level, so each lookup sees the rows before it. Elsewhere such a cell is NULL with a
# TODO comment (MQ4056).

# Whether a row is written here: a table seed's, an entity seed's that reaches the table through a binding, or a bound reference
# type's (source list; such a type gets no lookup table, check or enum type in this database, _reference.scriban), for this
# environment ("" for the rows of every environment).
func data_row_here(r, env, db)
  if r.source == "relation" || (r.source == "entity" && !r.seed.target.bindings[db.name])
    ret false
  end
  if env == ""
    ret r.environments.size == 0
  end
  ret array.contains r.environments env
end

# The columns a seed's rows give values for, in table order.
func data_columns(st, rows)
  $out = []
  for c in st.columns
    $given = false
    for r in rows
      if object.has_key r.values c.name
        $given = true
        break
      end
    end
    if $given
      $out[$out.size] = c
    end
  end
  ret $out
end

# The ref of a row whose foreign-key column c the database fills in the referenced row (listed in the ref's unknown), or null.
func data_ref_of(r, c, t)
  for fk in t.foreign_keys
    if !(object.has_key r.refs fk.name)
      continue
    end
    $ref = r.refs[fk.name]
    for u in $ref.unknown
      if u.name == c.name
        ret $ref
      end
    end
  end
  ret null
end

# The referenced column a foreign key's column c points at.
func data_referenced_column(fk, c)
  for k in fk.columns
    if k.name == c.name
      ret fk.referenced_columns[for.index]
    end
  end
  ret null
end

# The SQL of a row's cell in table t: its literal; for a column whose referenced value the database fills, a lookup of the referenced
# row by its key on PostgreSQL (a key part that is a lookup itself nests), else NULL with a TODO comment naming the row and key.
func data_cell(r, c, t, db)
  $v = r.values[c.name]
  if $v != null
    ret cell_sql($v, db)
  end
  $ref = data_ref_of(r, c, t)
  if $ref == null
    ret "NULL"
  end
  $target = data_referenced_column($ref.foreign_key, c)
  $where = ""
  for k in $ref.key_columns
    $part = data_cell($ref.row, k, $ref.table, db)
    $where = $where + (for.first ? "" : " AND ") + q(k.name, db) + " = " + $part
  end
  if db.dialect == "postgresql"
    ret "(SELECT " + q($target.name, db) + " FROM " + qt($ref.table) + " WHERE " + $where + ")"
  end
  ret "NULL /* TODO: " + (string.replace ("row " + r.id + " names " + qt($ref.table) + "." + $target.name + " WHERE " + $where) "*/" "* /") + " */"
end

func data_values(rows, columns, t, db)
  $out = []
  for r in rows
    $v = ""
    for c in columns
      $v = $v + (for.first ? "" : ", ") + data_cell(r, c, t, db)
    end
    $out[$out.size] = "(" + $v + ")"
  end
  ret $out
end

# The rows of one statement split by dependency level (PostgreSQL): a row that looks up a row of the same table among them comes one
# level after it, so each INSERT's lookups see the rows inserted before; rows come parents first, so one pass sets every level.
func data_levels(rows, t, db)
  if db.dialect != "postgresql"
    ret [rows]
  end
  $level = {}
  $ids = {}
  for r in rows
    $ids[r.id] = true
  end
  $max = 0
  for r in rows
    $n = 0
    for fk in t.foreign_keys
      if !(object.has_key r.refs fk.name)
        continue
      end
      $ref = r.refs[fk.name]
      if $ref.unknown.size > 0 && $ref.row && $ref.table.key == t.key && (object.has_key $ids $ref.row.id) && (object.has_key $level $ref.row.id)
        if $level[$ref.row.id] + 1 > $n
          $n = $level[$ref.row.id] + 1
        end
      end
    end
    $level[r.id] = $n
    if $n > $max
      $max = $n
    end
  end
  if $max == 0
    ret [rows]
  end
  $out = []
  for i in 0..$max
    $part = []
    for r in rows
      if $level[r.id] == i
        $part[$part.size] = r
      end
    end
    $out[$out.size] = $part
  end
  ret $out
end

func data_key_match(keys, left, right, db)
  $s = ""
  for k in keys
    $s = $s + (for.first ? "" : " AND ") + left + "." + q(k.name, db) + " = " + right + "." + q(k.name, db)
  end
  ret $s
end

# INSERT the rows whose key is missing (update false), or upsert them (update true), in the database's dialect.
func data_write_sql(t, keys, columns, rows, update, db)
  $list = cols(columns, db)
  $values = data_values(rows, columns, t, db)
  $rest = []
  for c in columns
    $is_key = false
    for k in keys
      if k.name == c.name
        $is_key = true
      end
    end
    if !$is_key
      $rest[$rest.size] = c
    end
  end
  $identity = false
  for c in columns
    if c.identity
      $identity = true
    end
  end
  $d = db.dialect
  if $d == "postgresql" || $d == "sqlite"
    $conflict = keys.size == 0 ? "" : "\nON CONFLICT (" + cols(keys, db) + ")"
    if keys.size > 0
      if update && $rest.size > 0
        $set = ""
        for c in $rest
          $set = $set + (for.first ? "" : ", ") + q(c.name, db) + " = EXCLUDED." + q(c.name, db)
        end
        $conflict = $conflict + " DO UPDATE SET " + $set
      else
        $conflict = $conflict + " DO NOTHING"
      end
    end
    ret "INSERT INTO " + qt(t) + " (" + $list + ") VALUES\n    " + ($values | array.join ",\n    ") + $conflict + ";"
  end
  if $d == "mysql" || $d == "mariadb"
    if !update || $rest.size == 0
      ret "INSERT IGNORE INTO " + qt(t) + " (" + $list + ") VALUES\n    " + ($values | array.join ",\n    ") + ";"
    end
    $set = ""
    for c in $rest
      $set = $set + (for.first ? "" : ", ") + q(c.name, db) + " = VALUES(" + q(c.name, db) + ")"
    end
    ret "INSERT INTO " + qt(t) + " (" + $list + ") VALUES\n    " + ($values | array.join ",\n    ") + "\nON DUPLICATE KEY UPDATE " + $set + ";"
  end
  # SQL Server and Oracle: MERGE on the row key.
  if $d == "oracle"
    $selects = []
    for r in rows
      $v = ""
      for c in columns
        $v = $v + (for.first ? "" : ", ") + data_cell(r, c, t, db) + " AS " + q(c.name, db)
      end
      $selects[$selects.size] = "SELECT " + $v + " FROM dual"
    end
    $source = "(\n    " + ($selects | array.join "\n    UNION ALL ") + ") v"
    $target = qt(t) + " x"
  else
    $source = "(VALUES\n    " + ($values | array.join ",\n    ") + ") AS v (" + $list + ")"
    $target = qt(t) + " AS x"
  end
  $s = "MERGE INTO " + $target + "\nUSING " + $source + "\nON " + ($d == "oracle" ? "(" : "") + data_key_match(keys, "x", "v", db) + ($d == "oracle" ? ")" : "")
  if update && $rest.size > 0
    $set = ""
    for c in $rest
      $set = $set + (for.first ? "" : ", ") + "x." + q(c.name, db) + " = v." + q(c.name, db)
    end
    $s = $s + "\nWHEN MATCHED THEN UPDATE SET " + $set
  end
  $inserted = ""
  for c in columns
    $inserted = $inserted + (for.first ? "" : ", ") + "v." + q(c.name, db)
  end
  $s = $s + "\nWHEN NOT MATCHED THEN INSERT (" + $list + ") VALUES (" + $inserted + ");"
  if $d == "sqlserver" && $identity
    $s = "SET IDENTITY_INSERT " + qt(t) + " ON;\n" + $s + "\nSET IDENTITY_INSERT " + qt(t) + " OFF;"
  end
  ret $s
end

# DELETE the table's rows a converging seed with delete does not hold (by the row key).
func data_delete_sql(t, keys, rows, db)
  if keys.size == 0
    ret null
  end
  if rows.size == 0
    ret "DELETE FROM " + qt(t) + ";"
  end
  if keys.size == 1
    $in = ""
    for r in rows
      $in = $in + (for.first ? "" : ", ") + data_cell(r, keys[0], t, db)
    end
    ret "DELETE FROM " + qt(t) + "\nWHERE " + q(keys[0].name, db) + " NOT IN (" + $in + ");"
  end
  $any = ""
  for r in rows
    $one = ""
    for k in keys
      $one = $one + (for.first ? "" : " AND ") + q(k.name, db) + " = " + data_cell(r, k, t, db)
    end
    $any = $any + (for.first ? "" : "\n    OR ") + "(" + $one + ")"
  end
  ret "DELETE FROM " + qt(t) + "\nWHERE NOT (" + $any + ");"
end

# The statements of the rows written here for an environment ("" for every environment), seed by seed, tables in foreign key order.
func data_statements(db, env, out)
  for st in db.seed_tables
    for seed in st.seeds
      $rows = []
      for r in st.rows
        if r.seed.id == seed.id && data_row_here(r, env, db)
          $rows[$rows.size] = r
        end
      end
      if $rows.size == 0
        continue
      end
      $cols = data_columns(st, $rows)
      if $cols.size == 0
        continue
      end
      $converge = seed.apply == "converge"
      $s = "-- " + $rows.size + ($rows.size == 1 ? " row" : " rows") + " into " + st.table.name + ($converge ? ", kept as the model has them." : ", inserted when missing.")
      for part in data_levels($rows, st.table, db)
        $s = $s + "\n" + data_write_sql(st.table, st.key_columns, $cols, part, $converge, db)
      end
      if $converge && seed.delete
        $s = $s + "\n" + data_delete_sql(st.table, st.key_columns, $rows, db)
      end
      out[out.size] = $s
    end
  end
end
-}}
