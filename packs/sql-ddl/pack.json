{
  "name": "sql-ddl",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "description": "SQL DDL for PostgreSQL, SQL Server, MySQL and MariaDB, SQLite and Oracle: one script per table (and, on request, per view, sequence, routine, database type and SQL object), one schema script per database, once-mode migrations from the schema diff, a seed script with protected regions that reconciles reference data (lookup tables, check constraints or native types) and writes seed rows (table seeds and bound entities' seeds inserted once or upserted), and one seed script per environment named in the environments parameter.",
  "parameters": {
    "comments": true,
    "environments": [],
    "idempotent": false,
    "objectScripts": false,
    "processTables": false,
    "quoting": "",
    "referenceStrategy": "lookup-table",
    "schemaScript": "inline",
    "sqliteBail": false,
    "strategyMap": {
      "check": "check",
      "lookup-table": "lookup-table",
      "native": "native"
    }
  },
  "usesSchemaDiff": true,
  "units": [
    {
      "id": "table",
      "template": "table.scriban",
      "for": "each table",
      "output": "{{ kebab table.database.name }}/{{ if table.schema }}{{ table.schema }}/{{ end }}tables/{{ table.name }}.sql"
    },
    {
      "id": "schema",
      "template": "schema.scriban",
      "for": "select databases",
      "output": "{{ kebab database.name }}/schema.sql"
    },
    {
      "id": "migration",
      "template": "migration.scriban",
      "for": "select databases",
      "mode": "once"
    },
    {
      "id": "seed",
      "template": "seed.scriban",
      "for": "select databases",
      "output": "{{ kebab database.name }}/seed.sql",
      "mode": "regions"
    },
    {
      "id": "seed-environments",
      "template": "seed-environments.scriban",
      "for": "select databases"
    },
    {
      "id": "process-tables",
      "template": "process-tables.scriban",
      "for": "each process"
    },
    {
      "id": "view",
      "template": "view.scriban",
      "for": "each view"
    },
    {
      "id": "sequence",
      "template": "sequence.scriban",
      "for": "each sequence"
    },
    {
      "id": "routine",
      "template": "routine.scriban",
      "for": "each routine"
    },
    {
      "id": "database-type",
      "template": "database-type.scriban",
      "for": "each database type"
    },
    {
      "id": "sql-object",
      "template": "sql-object.scriban",
      "for": "each sql object"
    }
  ]
}
