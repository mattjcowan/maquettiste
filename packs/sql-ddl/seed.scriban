{{-
# One seed script per database in "regions" mode, regenerated on every run and safe to run again: the reference data of reference types (lookup tables, check constraints and native types reconciled
# with the current rows, _reference.scriban), and the rows of entity and relation seeds (inserts that skip existing keys); then the
# protected region keeps the team's own seed data. Everything between the maquettiste:keep and maquettiste:end-keep lines
# survives regeneration; edits anywhere else are reported as hand edits.
include "_sql.scriban"
include "_objects.scriban"
include "_reference.scriban"
include "_data.scriban"
db = database
go = db.dialect == "sqlserver" ? "\nGO" : ""
references = []
reference_statements(db, references)
seeds = []
seed_statements(db, seeds)
rows = []
data_statements(db, "", rows)
-}}
-- Generated by Maquettiste (sql-ddl/seed). Edit only inside the protected region below; the rest is regenerated.
-- Seed data of database {{ db.name }} ({{ dialect_title(db) }}). Run it after the schema script or the migrations; it can run again.
{{- if references.size > 0 }}

-- Reference data, reconciled on every run: these tables, constraints and types are not in the schema snapshot.
{{- for s in references }}

{{ s }}{{ go }}
{{- end }}
{{- end }}
{{- if rows.size > 0 }}

-- Table seeds and the seeds of entities bound to a table, referenced tables first.
{{- for s in rows }}

{{ s }}{{ go }}
{{- end }}
{{- end }}
{{- if seeds.size > 0 }}

-- Seed rows, targets of referenced rows first; rows whose key is already there are skipped.
{{- for s in seeds }}

{{ s }}{{ go }}
{{- end }}
{{- end }}

-- maquettiste:keep id=seed-data
-- Hand-written seed data for {{ db.name }} goes here, for example:
-- INSERT INTO ... VALUES (...);
-- maquettiste:end-keep
