{{-
# One seed script per database in "regions" mode, regenerated on every run and safe to run again: the reference data of reference types (lookup tables and native types reconciled
# with the current rows, _reference.scriban; a type bound to a table of the database writes its rows with the table seeds), and the rows of table, entity and relation seeds; then the
# protected region keeps the team's own seed data. Everything between the maquettiste:keep and maquettiste:end-keep lines
# survives regeneration; edits anywhere else are reported as hand edits.
include "_sql.scriban"
include "_objects.scriban"
include "_reference.scriban"
include "_data.scriban"
db = database
go = db.dialect == "sqlserver" ? "\nGO" : ""
references = []
reference_statements(db, references)
rows = []
data_statements(db, "", rows)
# The checks of columns holding lifecycle states (_lifecycle.scriban), only with the lifecycleChecks parameter.
states = []
if pack.params.lifecycleChecks
  include "_lifecycle.scriban"
  lifecycle_check_statements(db, states)
end
-}}
-- Generated by Maquettiste (sql-ddl/seed). Edit only inside the protected region below; the rest is regenerated.
-- Seed data of database {{ db.name }} ({{ dialect_title(db) }}). Run it after the schema script or the migrations; it can run again.
{{- if references.size > 0 }}

-- Reference data, reconciled on every run: these tables, constraints and types are not in the schema snapshot.
{{- for s in references }}

{{ s }}{{ go }}
{{- end }}
{{- end }}
{{- if states.size > 0 }}

-- Lifecycle states, reconciled on every run: these checks list the states' codes and are not in the schema snapshot.
{{- for s in states }}

{{ s }}{{ go }}
{{- end }}
{{- end }}
{{- if rows.size > 0 }}

-- Table seeds, the seeds of entities bound to a table and the rows of reference types stored in one, referenced tables first.
{{- for s in rows }}

{{ s }}{{ go }}
{{- end }}
{{- end }}

-- maquettiste:keep id=seed-data
-- Hand-written seed data for {{ db.name }} goes here, for example:
-- INSERT INTO ... VALUES (...);
-- maquettiste:end-keep
