{{- for p in a.processes }}{{ for sj in p.subjects }}{{ subject = (subject == null || subject == sj.entity.name) ? sj.entity.name : "" }}{{ end }}{{ end }}
| Taken from the object | {{ relative_text(a, (subject && subject != "") ? words(subject) : "object") }} |
{{- end }}
