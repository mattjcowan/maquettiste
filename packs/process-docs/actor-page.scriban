| Category | {{ md_cell a.category.name }} |
{{- end }}
{{- keys = object.keys a.properties | array.sort }}
{{- if keys.size > 0 }}

## Properties
{{- for key in keys }}
{{- value = a.properties[key] }}

### {{ md_cell key }}

{{ if object.typeof value == "array" -}}
{{ for item in value }}{{ for.first ? "" : "\n" }}- {{ object.typeof item == "string" ? (md_cell item) : (md_code (json item)) }}{{ end }}
{{- else if object.typeof value == "string" -}}
{{ md_cell value }}
{{- else -}}
{{ md_code (json value) }}
{{- end }}
