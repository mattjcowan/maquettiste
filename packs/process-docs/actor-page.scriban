{{- if a.processes.size > 0 }}

## Processes
{{ for p in a.processes }}
- {{ process_link(p, "../") }}
{{- end }}
{{- end }}
{{- events = [] }}
{{- gates = [] }}
{{- signatures = [] }}
{{- tasks = [] }}
{{- for p in a.processes }}
{{- for e in p.events }}{{ if has_actor(e.actors, a) }}{{ events[events.size] = { process: p, event: e } }}{{ end }}{{ end }}
{{- for g in p.gates }}{{ if has_actor(g.signers, a) }}{{ gates[gates.size] = { process: p, gate: g } }}{{ end }}{{ end }}
{{- for g in p.gates }}{{ for s in g.all_signatures }}{{ if has_actor(s.signers, a) || has_actor(s.required_actors, a) }}{{ signatures[signatures.size] = { process: p, gate: g, signature: s } }}{{ end }}{{ end }}{{ end }}
{{- for i in p.invokes }}{{ if has_actor(i.actors, a) }}{{ tasks[tasks.size] = { process: p, invoke: i } }}{{ end }}{{ end }}
{{- end }}
{{- if events.size > 0 }}

## Events it raises

| Event | Process | Transitions | Payload |
| --- | --- | --- | --- |
{{- for x in events }}
| {{ md_code x.event.name }} | {{ process_link(x.process, "../") }} | {{ for t in x.event.transitions }}{{ for.first ? "" : ", " }}{{ md_code t.source.path }} to {{ t.is_targetless ? "itself (stays)" : code_paths(t.targets) }}{{ end }} | {{ attr_list(x.event.payload) }} |
{{- end }}
{{- end }}
{{- if a.rights.size > 0 }}

## Rights that name it

| Right | Allows or denies | As | Does | Where |
| --- | --- | --- | --- | --- |
{{- for r in a.rights }}
{{- where = [] }}{{ for u in r.uses }}{{ where[where.size] = process_link(u.process, "../") + (u.states.size == 0 ? "" : " in " + code_paths(u.states)) }}{{ end }}
| {{ md_code r.name }} | {{ r.access == "deny" ? "denies" : "allows" }} | {{ has_actor(r.except, a) ? "an exception" : "one it applies to" }} | {{ right_does(r) }} | {{ where | array.join ", " }} |
{{- end }}
{{- end }}
{{- if gates.size > 0 }}

## Gates it signs

| Gate | Process | Transition | Signatures | Its signature |
| --- | --- | --- | --- | --- |
{{- for x in gates }}
| {{ md_cell x.gate.display_name }} ({{ md_code x.gate.name }}) | {{ process_link(x.process, "../") }} | {{ if x.gate.transition }}{{ md_code x.gate.transition.label }} from {{ md_code x.gate.transition.source.path }}{{ else }}a gate from a library{{ end }} | {{ x.gate.required }} of {{ actor_links(x.gate.signers, "../") }} | {{ has_actor(x.gate.required_actors, a) ? "required" : "counts toward the total" }} |
{{- end }}
{{- end }}
{{- if signatures.size > 0 }}

## Signatures it gives

The named signatures of approvals that name it, beside the gates it signs.

| Signature | Approval | Process | Transition | Signatures | Its signature |
| --- | --- | --- | --- | --- | --- |
{{- for x in signatures }}
| {{ md_code x.signature.name }}{{ if x.signature.display_name != x.signature.name }} ({{ md_cell x.signature.display_name }}){{ end }} | {{ md_cell x.gate.display_name }} ({{ md_code x.gate.name }}) | {{ process_link(x.process, "../") }} | {{ if x.gate.transition }}{{ md_code x.gate.transition.label }} from {{ md_code x.gate.transition.source.path }}{{ else }}a gate from a library{{ end }} | {{ x.signature.required }} of {{ actor_links(x.signature.signers, "../") }} | {{ has_actor(x.signature.required_actors, a) ? "required" : "counts toward the total" }} |
{{- end }}
{{- end }}
{{- if tasks.size > 0 }}

## Tasks

| Task | Type | Process | State |
| --- | --- | --- | --- |
{{- for x in tasks }}
| {{ md_code x.invoke.name }} | {{ x.invoke.type }} | {{ process_link(x.process, "../") }} | {{ md_code x.invoke.state.path }} |
{{- end }}
{{- end }}
{{- # What it acts in through its memberships at any depth (actors-design.md decision 5): a list that names a role, group or
    # organization it is a member of, and not the actor itself. One row per event, gate or task, with the actors it comes through.
    through = []
    seen = {}
    for m in a.all_member_of
      for p in m.processes
        for e in p.events
          if has_actor(e.actors, m) && !has_actor(e.actors, a)
            key = "event:" + e.id
            if seen[key] == null
              seen[key] = through.size
              through[through.size] = { what: "Event " + (md_code e.name), process: p, via: [] }
            end
            row = through[seen[key]]
            row.via[row.via.size] = m
          end
        end
        for g in p.gates
          if has_actor(g.signers, m) && !has_actor(g.signers, a)
            key = "gate:" + g.id
            if seen[key] == null
              seen[key] = through.size
              through[through.size] = { what: "Gate " + (md_cell g.display_name) + " (" + (md_code g.name) + ")", process: p, via: [] }
            end
            row = through[seen[key]]
            row.via[row.via.size] = m
          end
          for s in g.all_signatures
            if has_actor(s.signers, m) && !has_actor(s.signers, a)
              key = "signature:" + s.id
              if seen[key] == null
                seen[key] = through.size
                through[through.size] = { what: "Signature " + (md_code s.name) + " of " + (md_code g.name), process: p, via: [] }
              end
              row = through[seen[key]]
              row.via[row.via.size] = m
            end
          end
        end
        for i in p.invokes
          if has_actor(i.actors, m) && !has_actor(i.actors, a)
            key = "task:" + i.id
            if seen[key] == null
              seen[key] = through.size
              through[through.size] = { what: "Task " + (md_code i.name), process: p, via: [] }
            end
            row = through[seen[key]]
            row.via[row.via.size] = m
          end
        end
      end
    end
}}
{{- if through.size > 0 }}

## Through membership

| What | Process | Through |
| --- | --- | --- |
{{- for x in through }}
| {{ x.what }} | {{ process_link(x.process, "../") }} | {{ actor_links(x.via, "../") }} |
{{- end }}
{{- end }}
