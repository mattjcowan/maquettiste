{{ diagram(p) -}}
```
{{- end }}

## States

| State | Type | Details |
| --- | --- | --- |
{{- for s in p.all_states }}
{{- details = [] }}
{{- if s.initial }}{{ details[details.size] = "initial " + (md_code s.initial.name) }}{{ end }}
{{- if s.type == "history" }}{{ details[details.size] = s.history + " history" + (s.default_target ? ", default " + (md_code s.default_target.path) : "") }}{{ end }}
{{- if s.region_index != null }}{{ details[details.size] = "region " + (s.region_index + 1) + " of " + (md_code s.parent.path) }}{{ end }}
{{- if s.entry.size > 0 }}{{ details[details.size] = "entry " + code_names(s.entry) }}{{ end }}
{{- if s.exit.size > 0 }}{{ details[details.size] = "exit " + code_names(s.exit) }}{{ end }}
{{- for i in s.invoke }}{{ details[details.size] = "invokes " + (md_code i.name) + " (" + i.type + ")" }}{{ end }}
{{- if s.description }}{{ details[details.size] = md_inline(s.description) }}{{ end }}
| {{ md_code s.path }} | {{ s.type }} | {{ details | array.join "; " }} |
{{- end }}
{{- if p.transitions.size > 0 }}{{ move_verbs = false }}{{ for t in p.transitions }}{{ if t.verb }}{{ move_verbs = true }}{{ end }}{{ end }}

## Transitions

In priority order: among the transitions of one source and one trigger, the first whose guard holds is taken.

| # | Source | Trigger | Guard | Targets | Actions | Gate |{{ if move_verbs }} Verb |{{ end }}
| --- | --- | --- | --- | --- | --- | --- |{{ if move_verbs }} --- |{{ end }}
{{- for t in p.transitions }}
| {{ for.index + 1 }} | {{ md_code t.source.path }} | {{ trigger_text(t) }} | {{ t.guard ? (md_code t.guard.name) : "" }} | {{ t.is_targetless ? "none (stays in the source)" : code_paths(t.targets) }}{{ t.external ? " (external)" : "" }} | {{ code_names(t.actions) }} | {{ t.gate ? (md_code t.gate.name) + " (" + t.gate.required + " of " + t.gate.signers.size + ")" : "" }} |{{ if move_verbs }} {{ t.verb ? (md_code t.verb.key) : "" }} |{{ end }}
{{- end }}
{{- end }}
{{- if p.gates.size > 0 }}

## Gates

A gated transition fires on the occurrence of its event that completes the gate; each earlier occurrence records one signature
and changes no state. Leaving the source state discards the signatures.
{{- for g in p.gates }}

### {{ md_cell g.display_name }}

- Name: {{ md_code g.name }}
{{ if g.transition }}- On: transition {{ numbers[g.transition.id] }}, {{ trigger_text(g.transition) }} from {{ md_code g.transition.source.path }}{{ if !g.transition.is_targetless }} to {{ code_paths(g.transition.targets) }}{{ end }}{{ else }}- On: {{ for t in p.transitions }}{{ if t.gate == g }}transition {{ numbers[t.id] }}, {{ end }}{{ end }}a gate from a library{{ end }}
- Signatures required: {{ g.required }}, from {{ actor_links(g.signers, "../") }}
{{- if g.required_actors.size > 0 }}
- Required actors: at least one signature from each of {{ actor_links(g.required_actors, "../") }}
{{- end }}
- Repeat signer: {{ g.allow_repeat_signer ? "allowed (one person may count more than once)" : "not allowed (each signature from a different person)" }}
- Reason: {{ g.reason_required ? "required with each signature" : "optional" }}
- Meanings: {{ for m in g.meanings }}{{ for.first ? "" : ", " }}{{ md_code m.name }}{{ if m.display_name != m.name }} ({{ md_cell m.display_name }}){{ end }}{{ end }}
{{- if g.description }}

{{ g.description }}
{{- end }}

The audit record, one per signature attempt and per outcome of the gate:

| Field | Type | Required | Values | Description |
| --- | --- | --- | --- | --- |
{{- for f in g.audit }}
| {{ md_code f.name }} | {{ md_code f.type }} | {{ f.required ? "yes" : "no" }} | {{ for v in f.values }}{{ for.first ? "" : ", " }}{{ md_code v }}{{ end }} | {{ md_inline(f.description) }} |
{{- end }}
{{- end }}
{{- end }}
{{- if p.events.size > 0 }}{{ event_verbs = false }}{{ for e in p.events }}{{ if e.verb }}{{ event_verbs = true }}{{ end }}{{ end }}

## Events

| Event |{{ if event_verbs }} Verb |{{ end }} Raised by | Payload | Transitions | Description |
| --- |{{ if event_verbs }} --- |{{ end }} --- | --- | --- | --- |
{{- for e in p.events }}
| {{ md_code e.name }} |{{ if event_verbs }} {{ e.verb ? (md_code e.verb.key) : "" }} |{{ end }} {{ e.actors.size > 0 ? actor_links(e.actors, "../") : "any actor" }} | {{ attr_list(e.payload) }} | {{ for t in e.transitions }}{{ for.first ? "" : ", " }}{{ numbers[t.id] }}{{ end }} | {{ md_inline(e.description) }} |
{{- end }}
{{- end }}
{{- if p.rights.size > 0 || p.rights_default == "deny" }}

## Rights

{{ p.rights_default == "deny" ? "Anything not stated here is denied." : "Anything not stated here is allowed." }} Each lifecycle that governs an
object answers on its own, and any no wins.
{{- if p.rights.size > 0 }}
{{- with_attributes = false }}{{ with_frozen = false }}
{{- for u in p.rights }}{{ if u.right.attributes.size > 0 }}{{ with_attributes = true }}{{ end }}{{ if u.right.while_frozen }}{{ with_frozen = true }}{{ end }}{{ end }}

| Right | Allows or denies | Who | Except | Does |{{ if with_attributes }} Attributes |{{ end }} In states |{{ if with_frozen }} While frozen |{{ end }} When | Why |
| --- | --- | --- | --- | --- |{{ if with_attributes }} --- |{{ end }} --- |{{ if with_frozen }} --- |{{ end }} --- | --- |
{{- for u in p.rights }}{{ r = u.right }}
| {{ md_code r.name }}{{ if r.named }} ([named](../rights.md)){{ end }} | {{ r.access == "deny" ? "denies" : "allows" }} | {{ right_who(r, "../") }} | {{ actor_links(r.except, "../") }} | {{ right_does(r) }} |{{ if with_attributes }} {{ right_attributes(r) }} |{{ end }} {{ u.states.size == 0 ? "all states" : code_paths(u.states) }} |{{ if with_frozen }} {{ r.while_frozen ? "yes" : "" }} |{{ end }} {{ r.condition_text ? (md_code r.condition_text) : "" }} | {{ md_inline(r.description) }} |
{{- end }}
{{- end }}
{{- if p.access_grid.size > 0 }}

### Who can do what

One table per state: each actor the rights, events, tasks and gates name, then everyone else, and each verb.
{{- for s in p.all_states }}{{ cells = [] }}{{ for c in p.access_grid }}{{ if c.state.id == s.id }}{{ cells[cells.size] = c }}{{ end }}{{ end }}
{{- if cells.size > 0 }}

#### {{ md_code s.path }}

| Who | Does | Answer | Decided by |
| --- | --- | --- | --- |
{{- for c in cells }}
| {{ c.actor ? actor_link(c.actor, "../") : "everyone else" }}{{ c.entity ? " (" + (md_code c.entity.name) + ")" : "" }} | {{ md_code c.verb.key }} | {{ cell_answer(c) }} | {{ cell_by(c) }} |
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- if p.trigger_points.size > 0 }}

## Trigger points

What runs when a verb happens: checks refuse or warn, actions run before the checks, with the change or after commit, and a replace
takes the place of a verb's built-in effect. At each moment they run in the order listed.

| Trigger point | Type | Does | Where | When | What it does | Severity | Outside | Why |
| --- | --- | --- | --- | --- | --- | --- | --- | --- |
{{- for tp in p.trigger_points }}
| {{ md_code tp.name }} | {{ tp.type == "action" ? tp_type(tp) : tp.type }} | {{ for v in tp.verbs }}{{ for.first ? "" : ", " }}{{ md_code v.key }}{{ end }} | {{ tp_where(tp, numbers) }} | {{ tp.when ? (md_code tp.when.text) : "always" }} | {{ tp_what(tp) }} | {{ tp.severity ?? "" }} | {{ tp.outside ? "yes" : "" }} | {{ md_inline(tp.description) }} |
{{- end }}
{{- for tv in p.trigger_verbs }}{{ g = tv.verb.group }}

### What happens when someone {{ someone_does(tv.verb, p) }}

{{ if g == "move" }}1. Rights, the move's guard and, on a gated move, who may sign are checked.
{{- else if g == "signature" }}1. Rights and who may sign are checked.
{{- else if tv.verb.key == "modify" || tv.verb.key == "delete" || tv.verb.key == "connect" || tv.verb.key == "disconnect" }}1. Freezing and rights are checked.
{{- else }}1. Rights are checked.
{{- end }}
{{- for tp in tv.before }}
1. Before the checks, {{ tp_sentence(tp, numbers) }}.
{{- end }}
{{- for tp in tv.checks }}
1. {{ tp_sentence(tp, numbers) }}.
{{- end }}
{{- if tv.replace.size > 0 }}{{ for tp in tv.replace }}
1. In place of the built-in effect, {{ tp_sentence(tp, numbers) }}.
{{- end }}
{{- else if g == "move" }}
1. The move: its exit, transition and entry actions.
{{- else if g != "project" }}
1. The verb's built-in effect.
{{- end }}
{{- for tp in tv.with_change }}
1. With the change, {{ tp_sentence(tp, numbers) }}.
{{- end }}
{{- for tp in tv.after_commit }}
1. After commit, {{ tp_sentence(tp, numbers) }}. It may run late, or more than once.
{{- end }}
{{- if g == "object" || g == "link" || g == "project" }}

Other lifecycles that govern the object run their own trigger points at each moment too, after these.
{{- end }}
{{- end }}
{{- end }}
{{- if p.context.size > 0 }}

## Context

The data a running instance carries.

| Attribute | Type | Required | Default | Description |
| --- | --- | --- | --- | --- |
{{- for a in p.context }}
| {{ md_code a.name }} | {{ md_code attr_type(a) }} | {{ a.required ? "yes" : "no" }} | {{ a.default != null ? (md_code (json a.default)) : "" }} | {{ md_inline(a.description) }} |
{{- end }}
{{- end }}
{{- if p.guards.size > 0 }}

## Guards

| Guard | Expression | Used by transitions | Description |
| --- | --- | --- | --- |
{{- for g in p.guards }}
| {{ md_code g.name }} | {{ g.is_stub ? "none: a named stub the host answers" : (!g.expression && reads_effects(g.condition) ? (md_code g.condition.text) : (md_code g.expression)) }} | {{ sep = "" }}{{ for t in g.used_by }}{{ if numbers[t.id] }}{{ sep }}{{ numbers[t.id] }}{{ sep = ", " }}{{ end }}{{ end }} | {{ md_inline(g.description) }} |
{{- end }}
{{- end }}
{{- if p.actions.size > 0 }}
{{- with_sets = false }}{{ for a in p.actions }}{{ if a.sets.size > 0 }}{{ with_sets = true }}{{ end }}{{ end }}

## Actions

| Action | Expression |{{ if with_sets }} Sets |{{ end }} Raises | Used by | Description |
| --- | --- |{{ if with_sets }} --- |{{ end }} --- | --- | --- |
{{- for a in p.actions }}
{{- uses = [] }}
{{- for u in a.used_by }}
{{- if u.kind == "transition" }}{{ if numbers[u.id] }}{{ uses[uses.size] = "transition " + numbers[u.id] }}{{ end }}{{ else if own_states[u.id] }}{{ uses[uses.size] = "state " + (md_code u.path) }}{{ end }}
{{- end }}
| {{ md_code a.name }} | {{ a.is_stub ? "none: a named stub the host implements" : (a.expression || a.sets.size == 0 ? (md_code a.expression) : sets_cell(a)) }} |{{ if with_sets }} {{ sets_cell(a) }} |{{ end }} {{ code_names(a.raises) }} | {{ uses | array.join ", " }} | {{ md_inline(a.description) }} |
{{- end }}
{{- end }}
{{- if p.invokes.size > 0 }}

## Invokes

Started when their state is entered and cancelled when it is left.

| Invoke | Type | State | Performed by | Description |
| --- | --- | --- | --- | --- |
{{- for i in p.invokes }}
| {{ md_code i.name }} | {{ i.type }} | {{ md_code i.state.path }} | {{ if i.process }}{{ process_link(i.process, "../") }}{{ else }}{{ actor_links(i.actors, "../") }}{{ end }} | {{ md_inline(i.description) }} |
{{- end }}
{{- end }}
{{- if p.actors.size > 0 }}

## Actors

| Actor | Type | Raises | Signs | Tasks |
| --- | --- | --- | --- | --- |
{{- for a in p.actors }}
{{- raises = [] }}
{{- for e in p.events }}{{ if has_actor(e.actors, a) }}{{ raises[raises.size] = md_code e.name }}{{ end }}{{ end }}
{{- signs = [] }}
{{- for g in p.gates }}{{ if has_actor(g.signers, a) }}{{ signs[signs.size] = (md_code g.name) + (has_actor(g.required_actors, a) ? " (required)" : "") }}{{ end }}{{ end }}
{{- tasks = [] }}
{{- for i in p.invokes }}{{ if has_actor(i.actors, a) }}{{ tasks[tasks.size] = md_code i.name }}{{ end }}{{ end }}
| {{ actor_link(a, "../") }} | {{ a.type }}{{ if a.relative }}, {{ relative_text(a, subject_words(p)) }}{{ end }} | {{ raises | array.join ", " }} | {{ signs | array.join ", " }} | {{ tasks | array.join ", " }} |
{{- end }}
{{- end }}
{{- if p.scenarios.size > 0 }}

## Scenarios
{{ for sc in p.scenarios }}
- [{{ md_cell sc.display_name }}]({{ kebab p.name }}/{{ kebab sc.name }}.md): {{ sc.steps.size }} {{ sc.steps.size == 1 ? "step" : "steps" }}, ends {{ sc.outcome == "final" ? "final" : "active" }}
{{- end }}
{{- end }}
