{{- include "_docs.scriban" -}}
{{- p = process -}}
{{- numbers = transition_numbers(p) -}}
{{- own_states = {} -}}
{{- for s in p.all_states }}{{ own_states[s.id] = true }}{{ end -}}
{{- # The states with a code, and whether the lifecycle section lists subjects, bindings and codes (several subjects, a code, or a
    # binding to a reference type or a plain status); otherwise it reads as before codes and subjects. -}}
{{- coded = [] -}}
{{- for s in p.all_states }}{{ if s.code != null }}{{ coded[coded.size] = s }}{{ end }}{{ end -}}
{{- listed = p.use == "lifecycle" && (p.subjects.size > 1 || coded.size > 0) -}}
{{- for sj in p.subjects }}{{ if p.use == "lifecycle" && sj.bound_attribute && !sj.bound_enum }}{{ listed = true }}{{ end }}{{ end -}}
{{ banner "<!--" }} -->

# {{ md_cell p.display_name }}
{{- if p.description }}

{{ p.description }}
{{- end }}

| | |
| --- | --- |
| Name | {{ md_code p.name }} |
{{- if p.package }}
| Domain | {{ md_code p.package.qualified_name }} |
{{- end }}
| Use | {{ p.use }} |
{{- if p.subject }}
| Subject | {{ md_code p.subject.name }} |
{{- else if p.subjects.size > 1 }}
| Subjects | {{ subject_names(p) }} |
{{- end }}
{{- owners = owner_fields(p) }}
{{- if owners != "" }}
| Owner held in | {{ owners }} |
{{- end }}
{{- if p.initial }}
| Initial state | {{ md_code p.initial.path }} |
{{- end }}
{{- if p.tags.size > 0 }}
| Tags | {{ for tag in p.tags }}{{ for.first ? "" : ", " }}{{ md_code tag }}{{ end }} |
{{- end }}
{{- if p.stereotypes.size > 0 }}
| Stereotypes | {{ for st in p.stereotypes }}{{ for.first ? "" : ", " }}{{ md_code st.key }}{{ end }} |
{{- end }}
{{- if !listed && p.use == "lifecycle" && p.bound_attribute }}

## Lifecycle

The attribute {{ md_code (p.subject.name + "." + p.bound_attribute.name) }} of {{ md_code p.subject.name }} holds the top-level state{{ if p.bound_enum }}, as a member of the enum {{ md_code p.bound_enum.name }}{{ end }}; a nested state counts as its top-level ancestor.

| State | Enum member |
| --- | --- |
{{- for s in p.bound_states }}
| {{ md_code s.path }} | {{ s.bound_member ? (md_code s.bound_member.name) : "none" }} |
{{- end }}
{{- else if listed }}

## Lifecycle
{{- if p.subjects.size > 0 }}

| Subject | Attribute | Type |
| --- | --- | --- |
{{- for sj in p.subjects }}
| {{ md_code subject_label(p, sj) }} | {{ sj.bound_attribute ? (md_code (subject_label(p, sj) + "." + sj.bound_attribute.name)) : "none" }} | {{ if !sj.bound_attribute }}{{ else if sj.bound_enum }}enum {{ md_code sj.bound_enum.name }}{{ else if sj.bound_reference_type }}reference type {{ md_code sj.bound_reference_type.name }}{{ else }}{{ md_code attr_type(sj.bound_attribute) }}{{ end }} |
{{- end }}
{{- end }}
{{- if coded.size > 0 }}

{{ if p.codes_map }}The codes form a map: an attribute bound to a reference type or a plain status holds the code of the state's nearest coded ancestor, and a state with none has no code.{{ else }}The codes do not form a map, since two coded states share a path or one sits inside a parallel region: they are constants only, and no attribute can hold them.{{ end }}

| State | Code |
| --- | --- |
{{- for s in coded }}
| {{ md_code s.path }} | {{ md_code (json s.code) }} |
{{- end }}
{{- end }}
{{- if p.bound_enum }}

The attribute {{ md_code (p.subject.name + "." + p.bound_attribute.name) }} holds the top-level state as a member of the enum {{ md_code p.bound_enum.name }}.

| State | Enum member |
| --- | --- |
{{- for s in p.bound_states }}
| {{ md_code s.path }} | {{ s.bound_member ? (md_code s.bound_member.name) : "none" }} |
{{- end }}
{{- end }}
{{- end }}
{{- if pack.params.diagrams && p.all_states.size > 0 }}

## Diagram

```mermaid
{{ diagram(p) -}}
```
{{- end }}

## States

| State | Type | Details |
| --- | --- | --- |
{{- for s in p.all_states }}
{{- details = [] }}
{{- if s.initial }}{{ details[details.size] = "initial " + (md_code s.initial.name) }}{{ end }}
{{- if s.type == "history" }}{{ details[details.size] = s.history + " history" + (s.default_target ? ", default " + (md_code s.default_target.path) : "") }}{{ end }}
{{- if s.region_index != null }}{{ details[details.size] = "region " + (s.region_index + 1) + " of " + (md_code s.parent.path) }}{{ end }}
{{- if s.entry.size > 0 }}{{ details[details.size] = "entry " + code_names(s.entry) }}{{ end }}
{{- if s.exit.size > 0 }}{{ details[details.size] = "exit " + code_names(s.exit) }}{{ end }}
{{- for i in s.invoke }}{{ details[details.size] = "invokes " + (md_code i.name) + " (" + i.type + ")" }}{{ end }}
{{- if s.description }}{{ details[details.size] = md_inline(s.description) }}{{ end }}
| {{ md_code s.path }} | {{ s.type }} | {{ details | array.join "; " }} |
{{- end }}
{{- if p.transitions.size > 0 }}

## Transitions

In priority order: among the transitions of one source and one trigger, the first whose guard holds is taken.

| # | Source | Trigger | Guard | Targets | Actions | Gate |
| --- | --- | --- | --- | --- | --- | --- |
{{- for t in p.transitions }}
| {{ for.index + 1 }} | {{ md_code t.source.path }} | {{ trigger_text(t) }} | {{ t.guard ? (md_code t.guard.name) : "" }} | {{ t.is_targetless ? "none (stays in the source)" : code_paths(t.targets) }}{{ t.external ? " (external)" : "" }} | {{ code_names(t.actions) }} | {{ t.gate ? (md_code t.gate.name) + " (" + t.gate.required + " of " + t.gate.signers.size + ")" : "" }} |
{{- end }}
{{- end }}
{{- if p.gates.size > 0 }}

## Gates

A gated transition fires on the occurrence of its event that completes the gate; each earlier occurrence records one signature
and changes no state. Leaving the source state discards the signatures.
{{- for g in p.gates }}

### {{ md_cell g.display_name }}

- Name: {{ md_code g.name }}
{{ if g.transition }}- On: transition {{ numbers[g.transition.id] }}, {{ trigger_text(g.transition) }} from {{ md_code g.transition.source.path }}{{ if !g.transition.is_targetless }} to {{ code_paths(g.transition.targets) }}{{ end }}{{ else }}- On: {{ for t in p.transitions }}{{ if t.gate == g }}transition {{ numbers[t.id] }}, {{ end }}{{ end }}a gate from a library{{ end }}
- Signatures required: {{ g.required }}, from {{ actor_links(g.signers, "../") }}
{{- if g.required_actors.size > 0 }}
- Required actors: at least one signature from each of {{ actor_links(g.required_actors, "../") }}
{{- end }}
- Repeat signer: {{ g.allow_repeat_signer ? "allowed (one person may count more than once)" : "not allowed (each signature from a different person)" }}
- Reason: {{ g.reason_required ? "required with each signature" : "optional" }}
- Meanings: {{ for m in g.meanings }}{{ for.first ? "" : ", " }}{{ md_code m.name }}{{ if m.display_name != m.name }} ({{ md_cell m.display_name }}){{ end }}{{ end }}
{{- if g.description }}

{{ g.description }}
{{- end }}

The audit record, one per signature attempt and per outcome of the gate:

| Field | Type | Required | Values | Description |
| --- | --- | --- | --- | --- |
{{- for f in g.audit }}
| {{ md_code f.name }} | {{ md_code f.type }} | {{ f.required ? "yes" : "no" }} | {{ for v in f.values }}{{ for.first ? "" : ", " }}{{ md_code v }}{{ end }} | {{ md_inline(f.description) }} |
{{- end }}
{{- end }}
{{- end }}
{{- if p.events.size > 0 }}

## Events

| Event | Raised by | Payload | Transitions | Description |
| --- | --- | --- | --- | --- |
{{- for e in p.events }}
| {{ md_code e.name }} | {{ e.actors.size > 0 ? actor_links(e.actors, "../") : "any actor" }} | {{ attr_list(e.payload) }} | {{ for t in e.transitions }}{{ for.first ? "" : ", " }}{{ numbers[t.id] }}{{ end }} | {{ md_inline(e.description) }} |
{{- end }}
{{- end }}
{{- if p.context.size > 0 }}

## Context

The data a running instance carries.

| Attribute | Type | Required | Default | Description |
| --- | --- | --- | --- | --- |
{{- for a in p.context }}
| {{ md_code a.name }} | {{ md_code attr_type(a) }} | {{ a.required ? "yes" : "no" }} | {{ a.default != null ? (md_code (json a.default)) : "" }} | {{ md_inline(a.description) }} |
{{- end }}
{{- end }}
{{- if p.guards.size > 0 }}

## Guards

| Guard | Expression | Used by transitions | Description |
| --- | --- | --- | --- |
{{- for g in p.guards }}
| {{ md_code g.name }} | {{ g.is_stub ? "none: a named stub the host answers" : (md_code g.expression) }} | {{ sep = "" }}{{ for t in g.used_by }}{{ if numbers[t.id] }}{{ sep }}{{ numbers[t.id] }}{{ sep = ", " }}{{ end }}{{ end }} | {{ md_inline(g.description) }} |
{{- end }}
{{- end }}
{{- if p.actions.size > 0 }}

## Actions

| Action | Expression | Raises | Used by | Description |
| --- | --- | --- | --- | --- |
{{- for a in p.actions }}
{{- uses = [] }}
{{- for u in a.used_by }}
{{- if u.kind == "transition" }}{{ if numbers[u.id] }}{{ uses[uses.size] = "transition " + numbers[u.id] }}{{ end }}{{ else if own_states[u.id] }}{{ uses[uses.size] = "state " + (md_code u.path) }}{{ end }}
{{- end }}
| {{ md_code a.name }} | {{ a.is_stub ? "none: a named stub the host implements" : (md_code a.expression) }} | {{ code_names(a.raises) }} | {{ uses | array.join ", " }} | {{ md_inline(a.description) }} |
{{- end }}
{{- end }}
{{- if p.invokes.size > 0 }}

## Invokes

Started when their state is entered and cancelled when it is left.

| Invoke | Type | State | Performed by | Description |
| --- | --- | --- | --- | --- |
{{- for i in p.invokes }}
| {{ md_code i.name }} | {{ i.type }} | {{ md_code i.state.path }} | {{ if i.process }}{{ process_link(i.process, "../") }}{{ else }}{{ actor_links(i.actors, "../") }}{{ end }} | {{ md_inline(i.description) }} |
{{- end }}
{{- end }}
{{- if p.actors.size > 0 }}

## Actors

| Actor | Type | Raises | Signs | Tasks |
| --- | --- | --- | --- | --- |
{{- for a in p.actors }}
{{- raises = [] }}
{{- for e in p.events }}{{ if has_actor(e.actors, a) }}{{ raises[raises.size] = md_code e.name }}{{ end }}{{ end }}
{{- signs = [] }}
{{- for g in p.gates }}{{ if has_actor(g.signers, a) }}{{ signs[signs.size] = (md_code g.name) + (has_actor(g.required_actors, a) ? " (required)" : "") }}{{ end }}{{ end }}
{{- tasks = [] }}
{{- for i in p.invokes }}{{ if has_actor(i.actors, a) }}{{ tasks[tasks.size] = md_code i.name }}{{ end }}{{ end }}
| {{ actor_link(a, "../") }} | {{ a.type }}{{ if a.relative }}, {{ relative_text(a, subject_words(p)) }}{{ end }} | {{ raises | array.join ", " }} | {{ signs | array.join ", " }} | {{ tasks | array.join ", " }} |
{{- end }}
{{- end }}
{{- if p.scenarios.size > 0 }}

## Scenarios
{{ for sc in p.scenarios }}
- [{{ md_cell sc.display_name }}]({{ kebab p.name }}/{{ kebab sc.name }}.md): {{ sc.steps.size }} {{ sc.steps.size == 1 ? "step" : "steps" }}, ends {{ sc.outcome == "final" ? "final" : "active" }}
{{- end }}
{{- end }}
