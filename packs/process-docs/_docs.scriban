{{-
# Shared functions of the process-docs pack. Include this file once at the top of a page template; it prints nothing.
# Names (identifiers and paths) are written as code spans with md_code; display names, which are free text, go through
# md_cell; descriptions are the author's own Markdown and are written as they are (md_inline only keeps a table row on one line).

# A description for a table cell: line breaks become spaces and pipes are escaped, so the row stays one row.
func md_inline(text)
  if !text
    ret ""
  end
  ret string.replace (string.replace (string.replace text "\r\n" " ") "\n" " ") "|" "\\|"
end

# Code spans of the names of a list, separated by commas.
func code_names(list)
  $text = ""
  for $item in list
    $text = $text + (for.first ? "" : ", ") + (md_code $item.name)
  end
  ret $text
end

# An action's sets as code spans, "attribute ← value" each, separated by commas (object-effects-design.md section 9).
func sets_cell(a)
  $text = ""
  for $s in a.sets
    $text = $text + (for.first ? "" : ", ") + (md_code ($s.attribute.name + " ← " + $s.value.text))
  end
  ret $text
end

# An action's call as one code span, "operation (input = value, ...)" (processes-operations-design.md section 13): it reads action.call, its
# operation's name, and each input's member name and value text.
func call_cell(a)
  if !a.call
    ret ""
  end
  $text = a.call.operation.name
  if a.call.inputs.size > 0
    $parts = ""
    for $i in a.call.inputs
      $parts = $parts + (for.first ? "" : ", ") + $i.member.name + " = " + $i.value.text
    end
    $text = $text + " (" + $parts + ")"
  end
  ret md_code $text
end

# Whether an expression reads current_actor() or in_state (object-effects-design.md section 9): such a guard shows its condition's text.
func reads_effects(e)
  if !e
    ret false
  end
  if e.node == "current-actor" || e.node == "in-state"
    ret true
  end
  for $arg in e.args
    if reads_effects($arg)
      ret true
    end
  end
  ret false
end

# Code spans of the paths of a list of states, separated by commas.
func code_paths(list)
  $text = ""
  for $item in list
    $text = $text + (for.first ? "" : ", ") + (md_code $item.path)
  end
  ret $text
end

# The link to an actor's page from a page `up` folders below the output root ("../" for a process page).
func actor_link(a, up)
  ret "[" + (md_cell a.display_name) + "](" + up + "actors/" + (kebab a.name) + ".md)"
end

# An actor's type as readers see it: the system itself shows as Automatic (actors-design.md decision 2), never its file value.
func actor_type(a)
  ret a.type == "system" ? "Automatic" : a.type
end

# Links to the pages of a list of actors, separated by commas.
func actor_links(list, up)
  $text = ""
  for $item in list
    $text = $text + (for.first ? "" : ", ") + actor_link($item, up)
  end
  ret $text
end

# Who a right applies to (rights-design.md decision 4): links to its actors, or everyone.
func right_who(r, up)
  ret r.everyone ? "everyone" : actor_links(r.actors, up)
end

# The name a page gives a relation end it speaks of links through: its navigation, the name the object reaches the links by, else its
# role (an end has no name of its own).
func end_name(e)
  ret e.navigation ?? e.role
end

# What a right does: its verbs as code, and the links it speaks of through its ends.
func right_does(r)
  $text = ""
  for $v in r.verbs
    $text = $text + (for.first ? "" : ", ") + (md_code $v.key)
  end
  if r.ends.size > 0
    $ends = ""
    for $e in r.ends
      $ends = $ends + (for.first ? "" : ", ") + (md_code end_name($e))
    end
    $text = $text + " on links through " + $ends
  end
  ret $text
end

# The attributes a right speaks of (rights-design.md decision 21), as code; empty for the object as a whole.
func right_attributes(r)
  $text = ""
  for $a in r.attributes
    $text = $text + (for.first ? "" : ", ") + (md_code $a.name)
  end
  ret $text
end

# A cell of "who can do what" (rights-design.md decision 31): its answer, the default when it decides, the lifecycles it depends on.
func cell_answer(c)
  if c.depends_on.size > 0
    $names = ""
    for $d in c.depends_on
      $names = $names + (for.first ? "" : ", ") + (md_cell $d.display_name)
    end
    ret "depends on " + $names
  end
  ret c.answer + (c.by_default ? " (default)" : "")
end

# What decides a cell: the rights, events, tasks and gates by name, or the lifecycle whose default answers.
func cell_by(c)
  $text = ""
  for $b in c.by
    $text = $text + (for.first ? "" : ", ") + ($b.kind == "process" ? "the default of " + (md_cell $b.display_name) : (md_code $b.name))
  end
  ret $text
end

# The element that refused a scenario step (rights-design.md decision 26), by its id: a right with why, a lifecycle's default, an event,
# a task or a gate of the process; else the id.
func refuser(id, p)
  for $r in model.rights
    if $r.id == id
      ret (md_code $r.name) + ($r.description ? ": " + (md_inline $r.description) : "")
    end
  end
  for $pr in model.processes
    if $pr.id == id
      ret "the default of " + (md_cell $pr.display_name)
    end
    for $u in $pr.rights
      if $u.right.id == id
        ret (md_code $u.right.name) + ($u.right.description ? ": " + (md_inline $u.right.description) : "")
      end
    end
  end
  for $e in p.events
    if $e.id == id
      ret "event " + (md_code $e.name)
    end
  end
  for $i in p.invokes
    if $i.id == id
      ret "task " + (md_code $i.name)
    end
  end
  for $g in p.gates
    if $g.id == id
      ret "gate " + (md_code $g.name)
    end
  end
  # A check (trigger-points-design.md section 10): its name and the message it shows, in whichever lifecycle holds it.
  for $tl in model.trigger_lifecycles
    for $tp in $tl.trigger_points
      if $tp.id == id
        ret (md_code $tp.name) + ": " + (md_inline $tp.message)
      end
    end
  end
  ret md_code id
end

# The link to a process's page from a page `up` folders below the output root.
func process_link(p, up)
  ret "[" + (md_cell p.display_name) + "](" + up + "processes/" + (kebab p.name) + ".md)"
end

# The entities of a process's subjects as code, in one line: the one subject of either form, or every entry of subjects.
func subject_names(p)
  $text = ""
  for $sj in p.subjects
    $text = $text + (for.first ? "" : ", ") + (md_code subject_label(p, $sj))
  end
  ret $text
end

# A subject's entity name, qualified by its package where another subject of the process has an entity of the same name.
func subject_label(p, sj)
  for $o in p.subjects
    if $o.id != sj.id && $o.entity.name == sj.entity.name && sj.entity.package
      ret sj.entity.package.qualified_name + "." + sj.entity.name
    end
  end
  ret sj.entity.name
end

# An attribute's type as the model writes it: the type name, a length in parentheses, "[]" for a collection.
func attr_type(a)
  $t = a.type.name
  if a.length
    $t = $t + "(" + a.length + ")"
  end
  if a.collection
    $t = $t + "[]"
  end
  ret $t
end

# A list of attributes in one line: `name` type, "(required)" when required.
func attr_list(list)
  $text = ""
  for $item in list
    $text = $text + (for.first ? "" : ", ") + (md_code $item.name) + " " + (md_code attr_type($item)) + ($item.required ? " (required)" : "")
  end
  ret $text
end

# What starts a transition, in words: an event, a time span, a finished or failed invoke, the end of the source, or nothing.
func trigger_text(t)
  case t.trigger
    when "event"
      ret "event " + (t.event ? (md_code t.event.name) : "`?`")
    when "after"
      ret "after " + (md_code t.after)
    when "done"
      ret "done"
    when "always"
      ret "always"
    when "invoke-done"
      ret "done of " + (t.invoke ? (md_code t.invoke.name) : "`?`")
    when "invoke-error"
      ret "error of " + (t.invoke ? (md_code t.invoke.name) : "`?`")
  end
  ret t.trigger
end

# The number of each transition in the transitions table (its priority order, from 1), keyed by transition id.
func transition_numbers(p)
  $numbers = {}
  for $t in p.transitions
    $numbers[$t.id] = for.index + 1
  end
  ret $numbers
end

# Whether a list of actors holds an actor (compared by id).
func has_actor(list, a)
  for $item in list
    if $item.id == a.id
      ret true
    end
  end
  ret false
end

# ---------------------------------------------------------------------------------------------------------------------------
# The state diagram, in diagram text. Compound states are nested blocks with "[*]" to their initial child and from their final
# children; the regions of a parallel state are blocks separated by "--"; a choice state is a choice pseudo-state; a history
# state is a state labelled "H" (shallow) or "H*" (deep) with an edge "default" to its default target; each transition with
# targets is an edge per target labelled as the editor labels it (plus the gate's count); a targetless transition, which leaves
# its source active, is a note beside the source. Each edge is declared in the innermost compound state holding both its ends,
# so the renderer places it inside that block.

# The diagram id of each state, keyed by path: the state's name when no other state of the process has it and it is not a word
# the diagram text reserves, else "s_" and the path with "_" between names.
func diagram_ids(p)
  $count = {}
  for $s in p.all_states
    $count[$s.name] = ($count[$s.name] ?? 0) + 1
  end
  $ids = {}
  for $s in p.all_states
    if $count[$s.name] == 1 && !(diagram_reserved $s.name)
      $ids[$s.path] = $s.name
    else
      $ids[$s.path] = "s_" + (string.replace $s.path "." "_")
    end
  end
  ret $ids
end

# Whether a state lies strictly inside the state at `prefix` (the container's path followed by a dot).
func inside(s, prefix)
  ret string.starts_with s.path prefix
end

# The path of the block an edge belongs in ("" for the top level): the innermost compound state that strictly contains the
# source and every target. A parallel state is skipped, since its body holds only its regions.
func edge_container(t)
  $c = t.source.parent
  while $c
    $ok = $c.type != "parallel" && inside(t.source, $c.path + ".")
    if $ok
      for $x in t.targets
        if !inside($x, $c.path + ".")
          $ok = false
        end
      end
    end
    if $ok
      ret $c.path
    end
    $c = $c.parent
  end
  ret ""
end

# The edge label of a transition: the editor's label, and "(gate N of M)" when a gate guards it, or "(approval, N signatures)" when the
# gate has stages (signoff-design.md section 10).
func edge_label(t)
  $label = t.label
  if t.gate
    $label = $label + (t.gate.uses_stages ? " (" + gate_count(t.gate) + ")" : " (gate " + t.gate.required + " of " + t.gate.signers.size + ")")
  end
  ret diagram_text $label
end

# A gate's count for the transitions table: "N of M" (required of signers), or "approval, N signatures" for a gate with stages, whose
# named signatures carry the counts (signoff-design.md section 10).
func gate_count(g)
  if g.uses_stages
    ret "approval, " + g.all_signatures.size + (g.all_signatures.size == 1 ? " signature" : " signatures")
  end
  ret g.required + " of " + g.signers.size
end

# Who may not give a named signature (signoff-design.md decision 15): each verb as "verb `key`", each move as "transition N".
func not_by_text(s, numbers)
  $text = ""
  for $e in s.not_by
    $item = $e.verb_key ? "verb " + (md_code $e.verb_key) : ($e.transition ? "transition " + numbers[$e.transition.id] : "")
    if $item != ""
      $text = $text + ($text == "" ? "" : ", ") + $item
    end
  end
  ret $text
end

# The lines of one state inside its container's block, with its own block when it has children.
func diagram_state(p, ids, where, s, ind)
  $id = ids[s.path]
  if s.type == "choice"
    ret ind + "state " + $id + " <<choice>>\n"
  end
  if s.type == "history"
    ret ind + "state \"" + (diagram_text s.name) + (s.history == "deep" ? " H*" : " H") + "\" as " + $id + "\n"
  end
  $head = $id == s.name ? "" : ind + "state \"" + (diagram_text s.name) + "\" as " + $id + "\n"
  if s.children.size == 0
    ret $head == "" ? ind + $id + "\n" : $head
  end
  $out = $head + ind + "state " + $id + " {\n"
  if s.type == "parallel"
    for $region in s.children
      if !for.first
        $out = $out + ind + "    --\n"
      end
      $out = $out + diagram_state(p, ids, where, $region, ind + "    ") + diagram_notes(ids, $region, ind + "    ")
    end
  else
    $out = $out + diagram_body(p, ids, where, s.path, s.children, s.initial, ind + "    ")
  end
  ret $out + ind + "}\n"
end

# The body of the top level or of a compound state: the initial edge, the children, the edges that belong here, history
# defaults, the edges to the end, then notes for targetless transitions.
func diagram_body(p, ids, where, path, children, initial, ind)
  $out = ""
  if initial
    $out = $out + ind + "[*] --> " + ids[initial.path] + "\n"
  end
  for $child in children
    $out = $out + diagram_state(p, ids, where, $child, ind)
  end
  for $t in p.transitions
    if !$t.is_targetless && where[$t.id] == path
      for $x in $t.targets
        $out = $out + ind + ids[$t.source.path] + " --> " + ids[$x.path] + " : " + edge_label($t) + "\n"
      end
    end
  end
  for $child in children
    if $child.type == "history" && $child.default_target
      $out = $out + ind + ids[$child.path] + " --> " + ids[$child.default_target.path] + " : default\n"
    end
  end
  for $child in children
    if $child.is_final
      $out = $out + ind + ids[$child.path] + " --> [*]\n"
    end
  end
  for $child in children
    $out = $out + diagram_notes(ids, $child, ind)
  end
  ret $out
end

# The note beside a state listing its targetless transitions, or "". A region of a parallel state gets its note inside its own
# part of the parallel block, after the region.
func diagram_notes(ids, s, ind)
  $lines = ""
  for $t in s.transitions_out
    if $t.is_targetless
      $lines = $lines + ind + "    internal: " + edge_label($t) + "\n"
    end
  end
  if $lines == ""
    ret ""
  end
  ret ind + "note right of " + ids[s.path] + "\n" + $lines + ind + "end note\n"
end

# The whole diagram of a process, from the header line to the last edge, without the fence.
func diagram(p)
  $ids = diagram_ids(p)
  $where = {}
  for $t in p.transitions
    $where[$t.id] = edge_container($t)
  end
  ret "stateDiagram-v2\n" + diagram_body(p, $ids, $where, "", p.states, p.initial, "    ")
end

# A name in plain lower-case words: "accountManager" -> "account manager".
func words(name)
  ret (regex.replace name "([a-z0-9])([A-Z])" "$1 $2") | string.downcase
end

# How an actor taken from the object is worked out (actors-design.md section 8), in plain words for an object called `subject`
# ("order", or "object"): "the order's owner", "the order's account manager", "members of Approver within the order's project".
func relative_text(a, subject)
  $r = a.relative
  $steps = ""
  for $s in $r.path
    $steps = $steps + "'s " + words($s.kind == "end" ? $s.role : $s.name)
  end
  if $r.form == "owner"
    ret "the " + subject + "'s owner"
  else if $r.form == "members-of"
    ret "members of " + ($r.members_of ? $r.members_of.name : "?") + " within the " + subject + $steps
  end
  ret "the " + subject + $steps
end

# The subject of a process in plain words for relative_text: its entity when it has one subject, else "object".
func subject_words(p)
  ret p.subjects.size == 1 ? words(p.subjects[0].entity.name) : "object"
end

# Where each subject of a process holds the object's owner (actors-design.md decision 10), as code: "`Order.ownerLogin`"; "" when
# no subject names an owner field.
func owner_fields(p)
  $out = ""
  for $sj in p.subjects
    $f = $sj.owner_attribute ? $sj.owner_attribute.name : ($sj.owner_end ? ($sj.owner_end.navigation ?? $sj.owner_end.role) : null)
    if $f
      $out = $out + ($out == "" ? "" : ", ") + (md_code (subject_label(p, $sj) + "." + $f))
    end
  end
  ret $out
end

# A trigger point's type, with an action's timing or a check's severity: "check", "check (warning)", "action, before the checks",
# "replace" (trigger-points-design.md decisions 5 to 7); "warning check" for a check that only warns.
func tp_type(tp)
  if tp.type == "check"
    ret tp.severity == "warning" ? "warning check" : "check"
  end
  if tp.type == "action"
    ret "action, " + (tp.timing == "before" ? "before the checks" : (tp.timing == "after-commit" ? "after commit" : "with the change"))
  end
  ret tp.type
end

# Where a trigger point runs (decision 10), from its narrowing keys: "in `Draft`; into `Review`"; "everywhere" when it names none.
func tp_where(tp, numbers)
  $parts = []
  if tp.states.size > 0
    $parts[$parts.size] = "in " + code_paths(tp.states)
  end
  if tp.targets.size > 0
    $parts[$parts.size] = "into " + code_paths(tp.targets)
  end
  if tp.transitions.size > 0
    $moves = ""
    for $t in tp.transitions
      $moves = $moves + (for.first ? "" : ", ") + (numbers[$t.id] ?? (md_code $t.id))
    end
    $parts[$parts.size] = (tp.transitions.size == 1 ? "on transition " : "on transitions ") + $moves
  end
  if tp.entities.size > 0
    $parts[$parts.size] = "for " + code_names(tp.entities)
  end
  if tp.attributes.size > 0
    $parts[$parts.size] = "attributes " + code_names(tp.attributes)
  end
  if tp.ends.size > 0
    $ends = ""
    for $e in tp.ends
      $ends = $ends + (for.first ? "" : ", ") + (md_code end_name($e))
    end
    $parts[$parts.size] = "links through " + $ends
  end
  ret $parts.size == 0 ? "everywhere" : ($parts | array.join "; ")
end

# What a trigger point's body does (decision 3): a check's condition, an action's or a replace's sets, or "the team's code".
func tp_what(tp)
  if tp.team_code
    ret "the team's code"
  end
  if tp.type == "check"
    ret tp.condition ? (md_code tp.condition.text) : ""
  end
  $text = ""
  for $s in tp.sets
    $text = $text + (for.first ? "sets " : ", ") + (md_code ($s.attribute.name + " ← " + $s.value.text))
  end
  ret $text
end

# One trigger point as a sentence of a "What happens when" list (section 10): its name and type, what it does (a team-code body says "the
# team's code: <why>"), a check's message, its places, its when, and whether it reaches outside systems.
func tp_sentence(tp, numbers)
  $why = md_inline tp.message
  if string.ends_with $why "."
    $why = string.slice $why 0 ($why.size - 1)
  end
  $text = (md_code tp.name) + " (" + tp_type(tp) + "): "
  if tp.team_code
    $text = $text + "the team's code: " + $why
  else if tp.type == "check"
    $text = $text + "passes when " + tp_what(tp) + "; otherwise it " + (tp.severity == "warning" ? "warns" : "refuses") + ": " + $why
  else
    $text = $text + tp_what(tp)
  end
  $where = tp_where(tp, numbers)
  if $where != "everywhere"
    $text = $text + ". Only " + $where
  end
  if tp.when
    $text = $text + ". Only when " + (md_code tp.when.text)
  end
  if tp.outside
    $text = $text + ". It reaches outside systems"
  end
  if tp.no_bypass
    $text = $text + ". Never skipped by a bulk load"
  end
  ret $text
end

# "promotes a `Document`" for a "What happens when someone ..." heading: a one-word verb key takes its third person; any other is "does
# `<key>` to"; the object is the one subject, else an object of the process.
func someone_does(v, p)
  $key = v.key
  $object = p.subject ? ((string.contains "aeiouAEIOU" (string.slice p.subject.name 0 1)) ? "an " : "a ") + (md_code p.subject.name) : "an object of " + (md_cell p.display_name)
  if string.contains $key "-"
    ret "does " + (md_code $key) + " to " + $object
  end
  if (string.ends_with $key "y") && !(string.contains "aeiou" (string.slice $key ($key.size - 2) 1))
    ret (string.slice $key 0 ($key.size - 1)) + "ies " + $object
  end
  if (string.ends_with $key "s") || (string.ends_with $key "sh") || (string.ends_with $key "ch") || (string.ends_with $key "x")
    ret $key + "es " + $object
  end
  ret $key + "s " + $object
end
-}}
