{{-
# process-states: the state union type and the path constants of one process; for a lifecycle, the bound enum's value of each
# bound state and a function that reads it off the active states. States with a code get their constants, and when the codes
# form a map (lifecycle-design.md decision 4) the mapping between configurations and codes and the moves between codes.
include "_process.scriban"
P = pascal process.name
p = camel process.name
self = pmod(process, "states.ts")
bound = process.use == "lifecycle" && process.bound_enum != null

# Whether a state can hold a code: history and choice states can't, since nothing rests in them.
func can_rest(s)
  ret s.type != "history" && s.type != "choice"
end

# The states that have a code, in document order, and the TypeScript type of their codes.
coded = []
for s in process.all_states
  if s.code != null && can_rest(s)
    coded[coded.size] = s
  end
end
code_ts = coded.size > 0 && (object.typeof coded[0].code) == "number" ? "number" : "string"

# A code as a TypeScript literal: an integer unquoted, a string single-quoted; null for no code.
func code_lit(s)
  if s == null
    ret "null"
  end
  ret (object.typeof s.code) == "number" ? (json s.code) : (ts_string s.code)
end

# The coded state that gives a state its code: itself or its nearest coded ancestor; null when no state on its path has one.
func coded_of(s)
  $c = s
  while $c != null
    if $c.code != null && can_rest($c)
      ret $c
    end
    $c = $c.parent
  end
  ret null
end

# The coded state a move into a state rests in: the state's own, else the one its compound states' defaults enter.
func entered_of(s)
  $c = coded_of(s)
  $d = s
  while $c == null && $d != null && $d.type == "compound"
    $d = $d.initial
    if $d != null
      $c = coded_of($d)
    end
  end
  ret $c
end

# Whether a state is the other state or sits inside it.
func within(s, outer)
  $c = s
  while $c != null
    if $c.id == outer.id
      ret true
    end
    $c = $c.parent
  end
  ret false
end

# The coded states a move leaves from: the one on the source's path; for a source without one, each coded state inside it, and null
# where a state without a code rests inside it (or the source is a choice state, which a move only passes through).
func sources_of(s)
  $c = coded_of(s)
  if $c != null
    ret [$c]
  end
  $out = []
  $uncoded = !can_rest(s)
  for $d in process.all_states
    if within($d, s) && can_rest($d)
      if $d.code != null
        $out[$out.size] = $d
      else if $d.children.size == 0 && coded_of($d) == null
        $uncoded = true
      end
    end
  end
  if $uncoded
    $out[$out.size] = null
  end
  ret $out
end

# The coded state a move rests in: its first target's (a history state's nearest coded state, since every state it restores sits
# inside that one); null for a move into a choice state, which the move decides when it runs.
func target_of(t)
  for $target in t.targets
    if $target.type == "choice"
      ret null
    end
  end
  ret t.targets.size == 0 ? null : entered_of(t.targets[0])
end

# The leaves a default entry of a state rests in, added to the list: a compound state enters its initial state, a parallel state
# each region, a history state its default target and the other regions of any parallel state on the way. A choice state is
# added as it is, since the chart picks its branch when it runs.
func enter_default(s, depth, entered)
  if depth > 64
    ret
  end
  if s.type == "history"
    if s.default_target
      enter_default(s.default_target, depth + 1, entered)
      $c = s.default_target
      while $c.parent != null && (s.parent == null || $c.parent.id != s.parent.id)
        if $c.parent.type == "parallel"
          for $r in $c.parent.children
            if $r.id != $c.id && $r.type != "history"
              enter_default($r, depth + 1, entered)
            end
          end
        end
        $c = $c.parent
      end
    end
  else if s.type == "parallel"
    for $r in s.children
      if $r.type != "history"
        enter_default($r, depth + 1, entered)
      end
    end
  else if s.type == "compound" && s.initial
    enter_default(s.initial, depth + 1, entered)
  else
    entered[entered.size] = s
  end
end

# The configuration a coded state restores: the leaves its default entry rests in, in document order; null when the entry meets a
# choice state, so no configuration is fixed.
func default_leaves(s)
  $entered = []
  enter_default(s, 0, $entered)
  $out = []
  for $a in process.all_states
    for $e in $entered
      if $e.id == $a.id
        if $a.type == "choice"
          ret null
        end
        $out[$out.size] = $a
        break
      end
    end
  end
  ret $out
end

# The key of a coded state's constant: its name in PascalCase, or its path's where two coded states share a name.
func code_key(s)
  $n = pascal s.name
  for $o in coded
    if $o.id != s.id && (pascal $o.name) == $n
      ret path_key(s.path)
    end
  end
  ret $n
end
-}}
{{ banner "//" }}
{{ if bound }}
import type { {{ pascal process.bound_enum.name }} } from {{ imp(self, (kebab process.bound_enum.name)) }};
{{ end }}
/** A state of {{ P }}, by its dotted path from the root. */
export type {{ P }}State =
{{- for s in process.all_states }}
  | {{ ts_string s.path }}
{{- end }};

/** Every state's path, named after the path (document order). */
export const {{ P }}States = {
{{- for s in process.all_states }}
  {{ path_key(s.path) }}: {{ ts_string s.path }},
{{- end }}
} as const satisfies Readonly<Record<string, {{ P }}State>>;

/** The states a configuration reports as active leaves (atomic and final states), in document order. */
export const {{ p }}AtomicStates = {{ str_list(paths(process.atomic_states)) }} as const satisfies readonly {{ P }}State[];
{{- if bound }}
{{- E = pascal process.bound_enum.name }}

/**
 * The {{ E }} value of each bound state (the root's children that are not history or choice states): {{ pascal process.subject.name }}.{{ camel process.bound_attribute.name }}
 * holds the value of the root-level state that contains the active states.
 */
export const {{ p }}Status = {
{{- for s in process.bound_states }}
{{- if s.bound_member }}
  {{ s.name }}: {{ ts_string (s.bound_member.code ?? s.bound_member.name) }},
{{- end }}
{{- end }}
} as const satisfies Readonly<Record<string, {{ E }}>>;

/** The {{ E }} value for a list of active state paths, or undefined when their root-level state is not bound. */
export function {{ p }}StatusOf(states: readonly string[]): {{ E }} | undefined {
  const root = states[0]?.split('.')[0];
  return root !== undefined && Object.hasOwn({{ p }}Status, root) ? {{ p }}Status[root as keyof typeof {{ p }}Status] : undefined;
}
{{- end }}
{{- if coded.size > 0 }}

/** The code of each state that has one, named after the state (or after its path where two coded states share a name). */
export const {{ p }}StateCodes = {
{{- for s in coded }}
  {{ code_key(s) }}: {{ code_lit(s) }},
{{- end }}
} as const;
{{- if process.codes_map }}

/** The code of each state that rests in a coded state, its own or its nearest coded ancestor's, by path. */
const {{ p }}CodeOfState = new Map<string, {{ code_ts }}>([
{{- for s in process.all_states }}
{{- if can_rest(s) }}
{{- c = coded_of(s) }}
{{- if c }}
  [{{ ts_string s.path }}, {{ code_lit(c) }}],
{{- end }}
{{- end }}
{{- end }}
]);

/** The configuration each code restores: the active leaf states' paths, in document order, that entering the coded state rests in. */
const {{ p }}StatesOfCode = new Map<{{ code_ts }}, readonly {{ P }}State[]>([
{{- for s in coded }}
{{- leaves = default_leaves(s) }}
{{- if leaves != null }}
  [{{ code_lit(s) }}, [{{ for l in leaves }}{{ if !for.first }}, {{ end }}{{ ts_string l.path }}{{ end }}]],
{{- end }}
{{- end }}
]);

/** The code of a configuration: the code of the coded state that holds its active states, or undefined when no state on their paths has one. */
export function {{ p }}ToCode(states: readonly string[]): {{ code_ts }} | undefined {
  for (const state of states) {
    const code = {{ p }}CodeOfState.get(state);
    if (code !== undefined) return code;
  }
  return undefined;
}

/**
 * The configuration a code restores: the active leaf states' paths, in document order, that entering the coded state rests in. A compound
 * state enters its initial state and a parallel state each of its regions, as the chart does, so the paths suit a snapshot. Undefined for
 * no state's code, or for a state that enters a choice state by default, since the chart picks its states when it runs.
 */
export function {{ p }}FromCode(code: {{ code_ts }}): readonly {{ P }}State[] | undefined {
  return {{ p }}StatesOfCode.get(code);
}

/**
 * Every transition as a move, in document order: the source's code, the code the target rests in, the trigger and the event. A source
 * without a code on its path gives one move per coded state inside it, plus one with a null code where a state without a code rests
 * inside it. A move without a target keeps its code. The target's code is null for a state without one, for a history state outside
 * every coded state and for a choice state, since the move decides it when it runs. The event is null for timers, completions and
 * eventless moves.
 */
export const {{ p }}Moves: readonly { readonly from: {{ code_ts }} | null; readonly to: {{ code_ts }} | null; readonly trigger: string; readonly event: string | null }[] = [
{{- for t in process.transitions }}
{{- to = target_of(t) }}
{{- for from in sources_of(t.source) }}
  { from: {{ code_lit(from) }}, to: {{ code_lit(t.is_targetless ? from : to) }}, trigger: {{ ts_string t.trigger }}, event: {{ t.event ? (ts_string t.event.name) : "null" }} },
{{- end }}
{{- end }}
];
{{- end }}
{{- end }}
