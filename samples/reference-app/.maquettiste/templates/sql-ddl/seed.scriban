{{-
# One seed script per database in "regions" mode: the lookup rows of lookup tables (enums stored as "lookup") are regenerated
# on every run as idempotent upserts (so the script can run again on a database that already holds them), and the protected
# region keeps the team's own seed data. Everything between the maquettiste:keep and
# maquettiste:end-keep lines survives regeneration; edits anywhere else are reported as hand edits.
include "_sql.scriban"
db = database
-}}
-- Generated by Maquettiste (sql-ddl/seed). Edit only inside the protected region below; the rest is regenerated.
-- Seed data of database {{ db.name }} ({{ dialect_title(db) }}). Run it after the schema script or the migrations; the lookup rows can run again.
{{- for t in db.tables }}
{{- if t.is_lookup && t.lookup_rows.size > 0 }}

-- Lookup rows of {{ t.name }}{{ if t.entity }} ({{ t.entity.name }}){{ end }}.
{{ lookup_upsert(t) }}
{{- end }}
{{- end }}

-- maquettiste:keep id=seed-data
-- Hand-written seed data for {{ db.name }} goes here, for example:
-- INSERT INTO ... VALUES (...);
-- maquettiste:end-keep
