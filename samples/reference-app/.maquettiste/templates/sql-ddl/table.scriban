{{- include "_sql.scriban" -}}
{{ banner "--" }}
-- Table {{ table.schema ? table.schema + "." : "" }}{{ table.name }} of database {{ table.database.name }} ({{ dialect_title(table.database) }}).
{{- if table.entity }}
-- Maps entity {{ table.entity.name }}{{ if table.is_junction }} (junction){{ end }}.
{{- else if table.relation }}
-- Junction table of relation "{{ table.relation.name }}".
{{- end }}
{{- if pack.params.comments && table.comment && table.database.dialect == "sqlite" }}
-- {{ table.comment | string.replace "\n" " " }}
{{- end }}

{{ include "_table.scriban" table }}
