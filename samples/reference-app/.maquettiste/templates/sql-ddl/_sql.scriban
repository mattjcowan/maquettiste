{{-
# Shared SQL functions for the sql-ddl pack. Include this file once at the top of a template; it prints nothing.
# Supported dialects: postgresql, sqlserver, mysql (MySQL 8 and MariaDB), sqlite and oracle (tables, keys, constraints, indexes,
# sequences, views and comments; routines and database types on PostgreSQL and SQL Server only).

# The number of SQL Server procedure calls the script checked so far (ms_checked): each check declares a variable of its own.
mq_ms_checks = 0

# SQL Server: a call of a system procedure (sp_rename, the extended property procedures) whose failure is an error XACT_ABORT does
# not act on and a return code: the code is checked and THROW, which XACT_ABORT does act on, aborts the script and rolls its
# transaction back. A batch declares a variable name once, so each call gets its own. A BEGIN ... END block without its semicolon
# (it can stand after IF or ELSE).
func ms_checked(call, db)
  mq_ms_checks = mq_ms_checks + 1
  $v = "@mq_rc" + mq_ms_checks
  $proc = (call | string.split " ")[0]
  ret "BEGIN DECLARE " + $v + " int; EXEC " + $v + " = " + call + "; IF " + $v + " <> 0 THROW 50000, " + lit($proc + " failed: the migration stops here.", db) + ", 1; END"
end

# Whether the pack writes idempotent DDL (the "idempotent" parameter): CREATE ... IF NOT EXISTS, DROP ... IF EXISTS and the
# dialect's guards where it has no such clause (SQL Server OBJECT_ID tests, PostgreSQL DO blocks for constraints).
func idem()
  ret pack.params.idempotent == true
end

# A PostgreSQL DO block that runs a statement only when a constraint of a table is missing (ADD CONSTRAINT has no IF NOT EXISTS).
func pg_unless_constraint(t, name, statement)
  ret "DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = " + lit(name, t.database) + " AND conrelid = " + lit(qt(t), t.database) + "::regclass) THEN " + statement + " END IF; END $$;"
end

# SQL Server: the N'...' literal of a schema-qualified object name, for OBJECT_ID.
func ms_object(schema, name, db)
  ret lit((schema ? schema + "." : "") + name, db)
end

# ALTER TABLE ... ADD CONSTRAINT, guarded when idempotent (PostgreSQL DO block, SQL Server OBJECT_ID test; MySQL, SQLite and Oracle
# have no guard for it and add it as is).
func add_constraint_sql(t, name, body)
  $db = t.database
  $s = "ALTER TABLE " + qt(t) + " ADD CONSTRAINT " + q(name, $db) + " " + body + ";"
  if !idem()
    ret $s
  end
  if $db.dialect == "postgresql"
    ret pg_unless_constraint(t, name, $s)
  else if $db.dialect == "sqlserver"
    ret "IF OBJECT_ID(" + ms_object(t.schema, name, $db) + ") IS NULL " + $s
  else if $db.dialect == "mysql"
    $kind = (body | string.starts_with "PRIMARY KEY") ? "PRIMARY KEY" : null
    ret my_guard($db, "NOT " + my_exists_constraint(t, $kind ? "PRIMARY" : name, $kind), $s)
  end
  ret $s
end

# MySQL: a statement run only when a condition holds, through a prepared statement (MySQL has no IF outside stored programs and no
# IF [NOT] EXISTS for most of ALTER TABLE), for the idempotent parameter.
func my_guard(db, condition, statement)
  $st = statement | string.rstrip
  if $st | string.ends_with ";"
    $st = $st | string.slice 0 ($st.size - 1)
  end
  ret "SET @mq_sql = IF(" + condition + ", " + lit($st, db) + ", 'DO 0');\nPREPARE mq_stmt FROM @mq_sql;\nEXECUTE mq_stmt;\nDEALLOCATE PREPARE mq_stmt;"
end

# MySQL: the information_schema test of the schema a table is in (its database, or the current one).
func my_schema(schema, db)
  ret "table_schema = " + (schema ? lit(schema, db) : "DATABASE()")
end

# MySQL: EXISTS tests for a table (or view), a column, an index and a constraint, by name.
func my_exists_table(schema, name, db)
  ret "EXISTS (SELECT 1 FROM information_schema.tables WHERE " + my_schema(schema, db) + " AND table_name = " + lit(name, db) + ")"
end

func my_exists_column(t, name)
  ret "EXISTS (SELECT 1 FROM information_schema.columns WHERE " + my_schema(t.schema, t.database) + " AND table_name = " + lit(t.name, t.database) + " AND column_name = " + lit(name, t.database) + ")"
end

func my_exists_index(t, name)
  ret "EXISTS (SELECT 1 FROM information_schema.statistics WHERE " + my_schema(t.schema, t.database) + " AND table_name = " + lit(t.name, t.database) + " AND index_name = " + lit(name, t.database) + ")"
end

# kind narrows the constraint type (PRIMARY KEY, FOREIGN KEY, UNIQUE, CHECK), or null for any.
func my_exists_constraint(t, name, kind)
  ret "EXISTS (SELECT 1 FROM information_schema.table_constraints WHERE " + my_schema(t.schema, t.database) + " AND table_name = " + lit(t.name, t.database) + " AND constraint_name = " + lit(name, t.database) + (kind ? " AND constraint_type = " + lit(kind, t.database) : "") + ")"
end

# A PostgreSQL DO block that runs a statement only when a condition holds, for the idempotent parameter.
func pg_do_if(condition, statement)
  ret "DO $$ BEGIN IF " + condition + " THEN " + statement + " END IF; END $$;"
end

# PostgreSQL: the information_schema test of the schema a table is in (its schema, or the search path's first).
func pg_schema(schema, db)
  ret "table_schema = " + (schema ? lit(schema, db) : "current_schema()")
end

# PostgreSQL: EXISTS test for a column of a table, by name; is_identity narrows it to an identity column.
func pg_exists_column(t, name, identity)
  ret "EXISTS (SELECT 1 FROM information_schema.columns WHERE " + pg_schema(t.schema, t.database) + " AND table_name = " + lit(t.name, t.database) + " AND column_name = " + lit(name, t.database) + (identity ? " AND is_identity = 'YES'" : "") + ")"
end

# Quotes one identifier for a database, honouring the pack's "quoting" parameter ("" = the database's own setting).
func q(name, db)
  if pack.params.quoting != ""
    ret sql_quote name db pack.params.quoting
  end
  ret sql_quote name db
end

# Schema-qualified name of a table, view or sequence ("billing.invoices"; SQLite has no schemas).
func qn(schema, name, db)
  if schema && db.dialect != "sqlite"
    ret q(schema, db) + "." + q(name, db)
  end
  ret q(name, db)
end

func qt(t)
  ret qn(t.schema, t.name, t.database)
end

# Comma-separated quoted column names.
func cols(list, db)
  $text = ""
  for c in list
    $text = $text + (for.first ? "" : ", ") + q(c.name, db)
  end
  ret $text
end

# SQL text of a string literal for the database's dialect.
func lit(value, db)
  ret sql_literal value db
end

# ON DELETE / ON UPDATE action, or "" for the default (no action). SQL Server has no RESTRICT; NO ACTION behaves the same there.
# Oracle has only ON DELETE CASCADE and ON DELETE SET NULL, and MySQL's InnoDB refuses SET DEFAULT: what they lack is left out
# (MQ4056).
func fk_action(action, db)
  if db.dialect == "oracle" && action != "cascade" && action != "set-null"
    ret ""
  end
  if db.dialect == "mysql" && action == "set-default"
    ret ""
  end
  case action
    when "cascade"
      ret "CASCADE"
    when "set-null"
      ret "SET NULL"
    when "set-default"
      ret "SET DEFAULT"
    when "restrict"
      if db.dialect == "sqlserver"
        ret ""
      end
      ret "RESTRICT"
  end
  ret ""
end

# Whether a table's primary key is a single SQLite rowid alias (an identity integer column), written inline as
# "INTEGER PRIMARY KEY" because SQLite only auto-assigns values to that exact form.
func sqlite_rowid(t)
  if t.database.dialect != "sqlite" || !t.primary_key || t.primary_key.columns.size != 1
    ret false
  end
  ret t.primary_key.columns[0].identity
end

# The SQL expression for a named attribute default expression (now, today, new-uuid), or "" when the dialect has none. MySQL takes
# an expression default in parentheses, and CURRENT_TIMESTAMP with the column's fractional seconds.
func default_expression(expr, c, db)
  $d = db.dialect
  if expr == "now"
    if $d == "sqlserver"
      ret c.type == "datetimeoffset" ? "SYSDATETIMEOFFSET()" : "SYSUTCDATETIME()"
    else if $d == "mysql" && c.precision && c.precision > 0
      ret "CURRENT_TIMESTAMP(" + c.precision + ")"
    end
    ret "CURRENT_TIMESTAMP"
  else if expr == "today"
    if $d == "sqlserver"
      ret "CAST(SYSUTCDATETIME() AS date)"
    else if $d == "mysql"
      ret "(CURRENT_DATE)"
    end
    ret "CURRENT_DATE"
  else if expr == "new-uuid"
    if $d == "postgresql"
      ret "gen_random_uuid()"
    else if $d == "sqlserver"
      ret "NEWID()"
    else if $d == "mysql"
      ret "(UUID())"
    else if $d == "oracle"
      ret "SYS_GUID()"
    end
  end
  ret ""
end

# MySQL: whether a column's type is a text, blob or json type, whose literal default must be written as an expression in
# parentheses (MySQL 8.0.13 and later; MariaDB takes both) and whose index needs a key prefix length.
func mysql_blob(c)
  $t = column_type(c) | string.downcase
  ret ($t | string.contains "text") || ($t | string.contains "blob") || ($t | string.starts_with "json")
end

# The default clause of a column without the DEFAULT keyword, or "": per-dialect SQL, then a literal, then a sequence, then a
# named default expression of the attribute.
func default_sql(c, db)
  if c.default_sql
    ret c.default_sql
  end
  if c.default != null
    if db.dialect == "mysql" && mysql_blob(c)
      ret "(" + lit(c.default, db) + ")"
    end
    ret lit(c.default, db)
  end
  if c.sequence && !c.identity
    if db.dialect == "postgresql"
      ret "nextval(" + lit(qn(c.sequence.schema, c.sequence.name, db), db) + ")"
    else if db.dialect == "sqlserver"
      ret "(NEXT VALUE FOR " + qn(c.sequence.schema, c.sequence.name, db) + ")"
    else if db.dialect == "oracle"
      ret qn(c.sequence.schema, c.sequence.name, db) + ".NEXTVAL"
    end
    ret ""
  end
  if c.attribute && c.attribute.default_expression
    ret default_expression(c.attribute.default_expression, c, db)
  end
  ret ""
end

# The name of a column's default constraint on SQL Server: its file's defaultName, else df_<table>_<column>.
func default_name(c, table_name)
  ret c.default_name ?? ("df_" + table_name + "_" + c.name)
end

# UNIQUE (columns) of a unique constraint, with NULLS NOT DISTINCT on PostgreSQL (15 and later; MQ4056 elsewhere).
func unique_body(u, db)
  ret "UNIQUE" + (u.nulls_not_distinct && db.dialect == "postgresql" ? " NULLS NOT DISTINCT" : "") + " (" + cols(u.columns, db) + ")"
end

# The options of an identity column in parentheses with a leading space (START WITH, INCREMENT BY), or "" when it sets none.
func identity_options(c)
  $o = ""
  if c.identity_seed != null
    $o = "START WITH " + c.identity_seed
  end
  if c.identity_increment != null
    $o = $o + ($o == "" ? "" : " ") + "INCREMENT BY " + c.identity_increment
  end
  ret $o == "" ? "" : " (" + $o + ")"
end

# GENERATED ALWAYS / BY DEFAULT AS IDENTITY with its options (PostgreSQL, Oracle).
func identity_clause(c)
  ret "GENERATED " + (c.identity_always ? "ALWAYS" : "BY DEFAULT") + " AS IDENTITY" + identity_options(c)
end

# FOREIGN KEY ... REFERENCES ... with its actions and deferral, without the CONSTRAINT name. SQL Server and MySQL have no deferrable
# keys (MQ4056); Oracle has no ON UPDATE.
func foreign_key_body(f, db)
  $s = "FOREIGN KEY (" + cols(f.columns, db) + ") REFERENCES " + qt(f.referenced_table) + " (" + cols(f.referenced_columns, db) + ")"
  if fk_action(f.on_delete, db) != ""
    $s = $s + " ON DELETE " + fk_action(f.on_delete, db)
  end
  if fk_action(f.on_update, db) != "" && db.dialect != "oracle"
    $s = $s + " ON UPDATE " + fk_action(f.on_update, db)
  end
  if f.deferrable != "not-deferrable" && db.dialect != "sqlserver" && db.dialect != "mysql"
    $s = $s + (f.deferrable == "initially-deferred" ? " DEFERRABLE INITIALLY DEFERRED" : " DEFERRABLE INITIALLY IMMEDIATE")
  end
  ret $s
end

# The realization of a reference type's storage strategy key ("lookup-table", "check" or "native") through the strategyMap
# parameter; a null key (the project leaves the choice to the template) takes the referenceStrategy parameter. A key the map does
# not know fails the unit with a message naming it (reference_realization in helpers.js), so the pack reserves no strategy name.
func ref_realization(key)
  ret reference_realization (key ?? pack.params.referenceStrategy) pack.params.strategyMap
end

# The PostgreSQL enum type of a reference type stored as "native" ("unit_of_measure_t"), unqualified: it is created in the
# search path's first schema.
func native_type_name(rt)
  ret (snake rt.name) + "_t"
end

# The SQL type of a column: the enum type for a reference-typed column realized as "native" on PostgreSQL, else type_of (for a
# reference-typed column, the code's type).
func column_type(c)
  $d = c.table.database.dialect
  if c.reference_type && $d == "postgresql" && ref_realization(c.strategy) == "native"
    ret q(native_type_name(c.reference_type), c.table.database)
  end
  ret type_of c $d
end

# One column definition, without indentation or trailing comma.
func column_def(c)
  $t = c.table
  $db = $t.database
  $d = $db.dialect
  $s = q(c.name, $db)
  if c.computed
    if $d == "sqlserver"
      ret $s + " AS (" + c.computed + ")" + (c.computed_stored ? " PERSISTED" : "")
    end
    $s = $s + " " + column_type(c)
    if $d == "postgresql"
      ret $s + " GENERATED ALWAYS AS (" + c.computed + ") STORED"
    end
    # Oracle computes every generated column on read.
    ret $s + " GENERATED ALWAYS AS (" + c.computed + ")" + (c.computed_stored && $d != "oracle" ? " STORED" : " VIRTUAL")
  end
  if c.is_primary_key && sqlite_rowid($t)
    ret $s + " INTEGER NOT NULL CONSTRAINT " + q($t.primary_key.name, $db) + " PRIMARY KEY"
  end
  $s = $s + " " + column_type(c)
  if c.collation
    $s = $s + " COLLATE " + collation_sql(c.collation, $db)
  end
  if c.identity
    if $d == "postgresql" || $d == "oracle"
      $s = $s + " " + identity_clause(c)
    else if $d == "sqlserver"
      $s = $s + " IDENTITY(" + (c.identity_seed ?? 1) + "," + (c.identity_increment ?? 1) + ")"
    end
  end
  $dflt = default_sql(c, $db)
  if $d == "oracle"
    # Oracle takes the default before the column's constraints.
    ret $s + ($dflt != "" ? " DEFAULT " + $dflt : "") + (c.nullable ? " NULL" : " NOT NULL")
  end
  $s = $s + (c.nullable ? " NULL" : " NOT NULL")
  if $dflt != ""
    if $d == "sqlserver"
      $s = $s + " CONSTRAINT " + q(default_name(c, $t.name), $db)
    end
    $s = $s + " DEFAULT " + $dflt
  end
  if $d == "mysql"
    if c.identity
      $s = $s + " AUTO_INCREMENT"
    end
    if pack.params.comments && c.comment
      $s = $s + " COMMENT " + lit(c.comment, $db)
    end
  end
  ret $s
end

# A collation name as the dialect writes it: PostgreSQL's in double quotes (its collation names are case-sensitive, "C" and
# "en_US"), the others as written.
func collation_sql(name, db)
  if db.dialect == "postgresql"
    ret "\"" + (name | string.replace "\"" "\"\"") + "\""
  end
  ret name
end

# SQL Server: whether the tables need SET QUOTED_IDENTIFIER ON (a persisted computed column or a filtered index refuses to be created
# without it, and sqlcmd starts with it off).
func ms_needs_quoted_identifier(tables)
  for t in tables
    for c in t.columns
      if c.computed
        ret true
      end
    end
    for ix in t.indexes
      if ix.where
        ret true
      end
    end
  end
  ret false
end

# The table options after the closing parenthesis of CREATE TABLE: MySQL's first AUTO_INCREMENT value (an identity seed) and table
# comment, else "".
func table_options(t)
  if t.database.dialect != "mysql"
    ret ""
  end
  $s = ""
  for c in t.columns
    if c.identity && c.identity_seed != null
      $s = " AUTO_INCREMENT = " + c.identity_seed
    end
  end
  if pack.params.comments && t.comment
    $s = $s + " COMMENT = " + lit(t.comment, t.database)
  end
  ret $s
end

# The PRIMARY KEY clause's SQL Server clustering: the primary key's own clustered setting, else NONCLUSTERED when a clustered
# index takes the table's clustering, else the server's default (clustered).
func pk_clustering(t)
  if t.database.dialect != "sqlserver"
    ret ""
  end
  if t.primary_key.clustered == true
    ret " CLUSTERED"
  else if t.primary_key.clustered == false
    ret " NONCLUSTERED"
  end
  for ix in t.indexes
    if ix.method == "clustered"
      ret " NONCLUSTERED"
    end
  end
  ret ""
end

# The indexed parts of an index: each column (with its key prefix length on MySQL) or expression (in parentheses), then DESC.
func index_parts(ix, db)
  $parts = ""
  for ic in ix.columns
    if ic.column
      $part = q(ic.column.name, db) + (ic.length && db.dialect == "mysql" ? "(" + ic.length + ")" : "")
    else
      $part = "(" + ic.expression + ")"
    end
    $parts = $parts + (for.first ? "" : ", ") + $part + (ic.descending ? " DESC" : "")
  end
  ret $parts
end

# Why the DDL leaves an index out (MQ4056), or "": SQL Server indexes no expression, and MySQL indexes a text or blob column only
# with a key prefix length.
func index_left_out(ix, db)
  for ic in ix.columns
    if !ic.column && db.dialect == "sqlserver"
      ret "SQL Server indexes no expression (index a computed column instead)"
    else if ic.column && db.dialect == "mysql" && !ic.length && mysql_blob(ic.column)
      ret "MySQL indexes the text or blob column " + ic.column.name + " only with a key prefix length"
    end
  end
  ret ""
end

# A MySQL index declared in CREATE TABLE: [UNIQUE] INDEX name (columns) [USING BTREE|HASH].
func mysql_index_def(ix, db)
  ret (ix.unique ? "UNIQUE " : "") + "INDEX " + q(ix.name, db) + " (" + index_parts(ix, db) + ")" + ((ix.method == "btree" || ix.method == "hash") ? " USING " + (ix.method | string.upcase) : "")
end

# The CREATE INDEX statement of an index (with its terminating semicolon). What the dialect lacks is left out (MQ4056): include
# columns outside PostgreSQL and SQL Server, partial indexes on MySQL and Oracle, methods outside PostgreSQL (MySQL: btree, hash).
func index_sql(ix, t)
  $db = t.database
  $d = $db.dialect
  $out = index_left_out(ix, $db)
  if $out != ""
    ret "-- Index " + ix.name + " is left out: " + $out + "."
  end
  $parts = index_parts(ix, $db)
  $s = "CREATE " + (ix.unique ? "UNIQUE " : "")
  if $d == "sqlserver" && ix.method == "clustered"
    $s = $s + "CLUSTERED "
  end
  $s = $s + "INDEX " + (idem() && ($d == "postgresql" || $d == "sqlite") ? "IF NOT EXISTS " : "") + q(ix.name, $db) + " ON " + qt(t)
  if $d == "postgresql" && (ix.method == "btree" || ix.method == "hash" || ix.method == "gin" || ix.method == "gist")
    $s = $s + " USING " + ix.method
  end
  $s = $s + " (" + $parts + ")"
  if $d == "mysql" && (ix.method == "btree" || ix.method == "hash")
    $s = $s + " USING " + (ix.method | string.upcase)
  end
  if ix.include.size > 0 && ($d == "postgresql" || $d == "sqlserver")
    $s = $s + " INCLUDE (" + cols(ix.include, $db) + ")"
  end
  if ix.where && $d != "mysql" && $d != "oracle"
    $s = $s + " WHERE " + ix.where
  end
  $s = $s + ";"
  if idem() && $d == "sqlserver"
    $s = "IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = " + lit(ix.name, $db) + " AND object_id = OBJECT_ID(" + ms_object(t.schema, t.name, $db) + ")) " + $s
  else if idem() && $d == "mysql"
    $s = my_guard($db, "NOT " + my_exists_index(t, ix.name), $s)
  end
  if $d == "postgresql" && ix.method == "clustered"
    $s = $s + "\nCLUSTER " + qt(t) + " USING " + q(ix.name, $db) + ";"
  end
  ret $s
end

# A table comment or column comment statement for PostgreSQL, Oracle or SQL Server; "" elsewhere (MySQL writes comments in the
# column and table definitions, SQLite keeps them in the script's text). On SQL Server an idempotent script sets the description
# whether or not it exists (ms_description).
func comment_sql(t, c, text)
  $db = t.database
  if $db.dialect == "postgresql" || $db.dialect == "oracle"
    if c
      ret "COMMENT ON COLUMN " + qt(t) + "." + q(c.name, $db) + " IS " + lit(text, $db) + ";"
    end
    ret "COMMENT ON TABLE " + qt(t) + " IS " + lit(text, $db) + ";"
  else if $db.dialect == "sqlserver"
    if idem()
      ret ms_description($db, "TABLE", t.schema, t.name, c ? c.name : null, text)
    end
    ret ms_add_description($db, "TABLE", t.schema, t.name, c ? c.name : null, text)
  end
  ret ""
end

# SQL Server: adds the MS_Description of a new table, view or column (sp_addextendedproperty fails when it exists).
func ms_add_description(db, kind, schema, name, column, text)
  $s = "sys.sp_addextendedproperty @name = N'MS_Description', @value = " + lit(text, db) + ", @level0type = N'SCHEMA', @level0name = " + lit(schema ?? "dbo", db) + ", @level1type = N'" + kind + "', @level1name = " + lit(name, db)
  if column
    $s = $s + ", @level2type = N'COLUMN', @level2name = " + lit(column, db)
  end
  ret ms_checked($s, db) + ";"
end

# SQL Server: sets (text) or removes (null) the MS_Description of a table, view or column, whether or not it exists. kind is TABLE
# or VIEW; column is null for the object itself.
func ms_description(db, kind, schema, name, column, text)
  $args = "@name = N'MS_Description', @level0type = N'SCHEMA', @level0name = " + lit(schema ?? "dbo", db) + ", @level1type = N'" + kind + "', @level1name = " + lit(name, db)
  if column
    $args = $args + ", @level2type = N'COLUMN', @level2name = " + lit(column, db)
  end
  $where = "SELECT 1 FROM sys.extended_properties WHERE class = 1 AND name = N'MS_Description' AND major_id = OBJECT_ID(" + ms_object(schema ?? "dbo", name, db) + ") AND minor_id = " + (column ? "COLUMNPROPERTY(OBJECT_ID(" + ms_object(schema ?? "dbo", name, db) + "), " + lit(column, db) + ", 'ColumnId')" : "0")
  if text == null
    ret "IF EXISTS (" + $where + ") " + ms_checked("sys.sp_dropextendedproperty " + $args, db) + ";"
  end
  ret "IF EXISTS (" + $where + ") " + ms_checked("sys.sp_updateextendedproperty " + $args + ", @value = " + lit(text, db), db) + " ELSE " + ms_checked("sys.sp_addextendedproperty " + $args + ", @value = " + lit(text, db), db) + ";"
end

# The comment statement of a view, or "": PostgreSQL COMMENT ON VIEW, Oracle COMMENT ON TABLE, SQL Server MS_Description. MySQL and
# SQLite views have no comments.
func view_comment_sql(v, db, text)
  $d = db.dialect
  if $d == "postgresql"
    ret "COMMENT ON " + (v.materialized ? "MATERIALIZED VIEW " : "VIEW ") + qn(v.schema, v.name, db) + " IS " + (text ? lit(text, db) : "NULL") + ";"
  else if $d == "oracle"
    ret "COMMENT ON " + (v.materialized ? "MATERIALIZED VIEW " : "TABLE ") + qn(v.schema, v.name, db) + " IS " + lit(text ?? "", db) + ";"
  else if $d == "sqlserver"
    ret ms_description(db, "VIEW", v.schema, v.name, null, text)
  end
  ret ""
end

# Human-readable dialect name for headers.
func dialect_title(db)
  case db.dialect
    when "postgresql"
      $title = "PostgreSQL"
    when "sqlserver"
      $title = "SQL Server"
    when "sqlite"
      $title = "SQLite"
    when "mysql"
      $title = "MySQL"
    when "oracle"
      $title = "Oracle"
    else
      $title = db.dialect
  end
  ret db.version ? $title + " " + db.version : $title
end
-}}
