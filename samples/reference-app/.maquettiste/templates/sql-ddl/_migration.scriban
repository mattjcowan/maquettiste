{{-
# Migration statement builders over the schema diff (engine-design.md section 14). Needs _sql.scriban and _objects.scriban.
# Every builder appends statements to the list it is given (emit), because Scriban counts each element an array function
# copies against the template loop limit and a first migration holds every table of the database. What a diff cannot decide
# (data conversions, SQLite table rebuilds) becomes a "-- TODO" line for the reviewer.
#
# migration.scriban runs the builders in phases, so no statement uses a column or table before it exists: renames and drops of
# constraints and indexes ("before"), then column changes ("columns"), then new tables, then new constraints and indexes
# ("after"). A changed constraint or index is dropped in the first phase and created again in the last.

func emit(out, statement)
  out[out.size] = statement
end

func alter_prefix(t)
  ret "ALTER TABLE " + qt(t)
end

# sp_rename for SQL Server, its return code checked (ms_checked); kind is COLUMN, INDEX or OBJECT.
func rename_object(db, qualified_old, new_name, kind)
  ret ms_checked("sp_rename " + lit(qualified_old, db) + ", " + lit(new_name, db) + ", " + lit(kind, db), db) + ";"
end

func schema_prefix(schema)
  ret schema ? schema + "." : ""
end

func change_list(changes)
  $text = ""
  for ch in changes
    $text = $text + (for.first ? "" : "; ") + ch.property + ": " + (ch.old ?? "null") + " -> " + (ch.new ?? "null")
  end
  ret $text
end

func has_change(changes, names)
  for ch in changes
    for n in names
      if ch.property == n
        ret true
      end
    end
  end
  ret false
end

# The changes whose property is not one of the names.
func changes_except(changes, names)
  $kept = []
  for ch in changes
    if !has_change([ch], names)
      $kept[$kept.size] = ch
    end
  end
  ret $kept
end

# Whether a type keyword is range or multirange (section 3.4).
func range_keyword(type)
  ret type == "range" || type == "multirange"
end

# How PostgreSQL converts a column between two range types (section 3.4). from and to are the sides (each with type, the keyword,
# and native_type), col the quoted column. Between two ranges, or two multiranges, of other subtypes no direct cast exists but the
# text forms match: {using: <col>::text::<native>}. A range becomes the multirange of its own subtype through PostgreSQL's cast:
# {using: <col>::<native>}. No cast exists from a multirange to a range, nor from a range to a multirange of another subtype:
# {todo: why}, and the caller writes no ALTER. null when a side's keyword is not range or multirange: the caller keeps its own cast.
func range_using(from, to, col)
  if !from || !to || !range_keyword(from.type) || !range_keyword(to.type)
    ret null
  end
  if from.type == to.type
    ret { using: col + "::text::" + to.native_type }
  end
  if from.type == "range" && from.native_type && to.native_type && (from.native_type | string.replace "range" "multirange") == to.native_type
    ret { using: col + "::" + to.native_type }
  end
  $why = from.type == "multirange" ? "no cast exists from a multirange to a range, and range_merge keeps only the outer bounds of its ranges" : "no cast exists from a range to a multirange of another subtype"
  $change = "changes from " + (from.native_type ?? from.type) + " to " + (to.native_type ?? to.type) + ", which PostgreSQL cannot convert (" + $why + ")"
  ret { todo: $change + "; give a change-type migration fact the conversion expression. This migration leaves the column as it is.", change: $change }
end

# The side of a range_using conversion a column change starts from: the keyword and native type before the change.
func range_side_before(cc, c)
  $side = { type: c.type, native_type: c.native_type }
  for ch in cc.changes
    if ch.property == "type"
      $side.type = ch.old
    else if ch.property == "nativeType"
      $side.native_type = ch.old
    end
  end
  ret $side
end

# Whether a column change keeps its native type though its keyword or facets changed, with range or multirange on a side: the old
# idiom (string with nativeType tstzrange) moving to a range keyword of the same native type and back, or a range column's subtype
# change that a dialect without range types stores as the same text type. Such a change needs no ALTER and no type TODO; the
# differ still reports it, because the snapshot holds the keyword and facets (section 3.4).
func range_same_native(cc, c)
  if has_change(cc.changes, ["nativeType", "strategy", "referenceTable", "codeType", "collation"]) || !has_change(cc.changes, ["type", "length", "precision", "scale", "subtype"])
    ret false
  end
  ret range_keyword(c.type) || range_keyword(range_side_before(cc, c).type)
end

func find_named(list, name)
  for item in list
    if item.name == name
      ret item
    end
  end
  ret null
end

# The name of the default constraint SQL Server gets for a column by convention (default_name in _sql.scriban).
func df_name(table_name, column_name)
  ret "df_" + table_name + "_" + column_name
end

# SQL Server: drops a named default constraint when it exists (a column with a default cannot be dropped or retyped).
func drop_default_sql(t, df)
  ret "IF OBJECT_ID(" + lit(schema_prefix(t.schema) + df, t.database) + ", 'D') IS NOT NULL " + alter_prefix(t) + " DROP CONSTRAINT " + q(df, t.database) + ";"
end

# SQL Server: renames a named default constraint when it exists, so later migrations find it under its new name.
func rename_default_sql(t, old_df, new_df)
  $db = t.database
  ret "IF OBJECT_ID(" + lit(schema_prefix(t.schema) + old_df, $db) + ", 'D') IS NOT NULL " + rename_object($db, schema_prefix(t.schema) + old_df, new_df, "OBJECT")
end

# The schema a table, view or sequence is in once the migration's schema renames ran (PostgreSQL renames schemas in place; the
# other dialects move each object, see migration.scriban): the new name of a renamed schema, else the name itself.
func moved_schema(schema)
  if schema && mq_schema_renames && mq_schema_renames[schema]
    ret mq_schema_renames[schema]
  end
  ret schema
end

# " IF EXISTS" (with its leading space) for the idempotent parameter where the dialect has it in DROP INDEX.
func if_exists(db)
  ret idem() && (db.dialect == "postgresql" || db.dialect == "sqlserver" || db.dialect == "sqlite") ? " IF EXISTS" : ""
end

# " IF EXISTS" for the idempotent parameter in ALTER TABLE, ALTER INDEX, ALTER VIEW and ALTER SEQUENCE, which only PostgreSQL has.
func alter_if_exists(db)
  ret idem() && db.dialect == "postgresql" ? " IF EXISTS" : ""
end

# The ColumnChange of a table change for a column key, or null.
func column_change(tc, key)
  for x in tc.columns
    if x.key == key
      ret x
    end
  end
  ret null
end

# Whether SQLite can add a column with ALTER TABLE ... ADD COLUMN: not a key column, not NOT NULL without a default, no expression
# or CURRENT_* default, not a stored computed column.
func sqlite_can_add(c)
  $dflt = default_sql(c, c.table.database)
  if c.is_primary_key || (c.computed && c.computed_stored) || (!c.nullable && $dflt == "" && !c.computed)
    ret false
  end
  ret !($dflt | string.starts_with "(") && !($dflt | string.contains "CURRENT_")
end

# Why a SQLite table must be rebuilt (it cannot alter a column or change a key or constraint in place), or "" when it need not be.
# SQLite ignores lengths and precisions, so a facet change without a new native type needs nothing; a comment lives in the script.
func sqlite_rebuild_reason(tc)
  if tc.table.database.dialect != "sqlite" || (tc.kind != "renamed" && tc.kind != "altered")
    ret ""
  end
  $why = ""
  for cc in tc.columns
    if cc.kind == "added" && !sqlite_can_add(cc.column)
      $why = $why + (($why == "") ? "" : ", ") + "add " + cc.column.name
    else if cc.kind == "renamed" || cc.kind == "altered"
      # A range column change that keeps the native type changes nothing in the database (range_same_native), as
      # column_change_statements reads it: only its other changes can need a rebuild.
      $changes = range_same_native(cc, cc.column) ? changes_except(cc.changes, ["type", "subtype", "length", "precision", "scale"]) : cc.changes
      if has_change($changes, ["type", "nativeType", "nullable", "default", "defaultSql", "identity", "sequence", "computed", "computedStored", "collation", "strategy", "referenceTable", "codeType"])
        $why = $why + (($why == "") ? "" : ", ") + cc.new_name + " " + change_list($changes)
      end
    end
  end
  if tc.primary_key.size + tc.uniques.size + tc.foreign_keys.size + tc.checks.size > 0
    $why = $why + (($why == "") ? "" : ", ") + "keys and constraints"
  end
  ret $why
end

# The statements that rebuild a SQLite table under its current definition (SQLite's documented procedure): create it under a
# temporary name, copy the rows of the columns it keeps (from their old names), drop the old table, rename the new one and create
# its indexes and the triggers the model holds for it. migration.scriban turns foreign key enforcement off around the transaction;
# legacy_alter_table is on for the rename only, so views and other tables' foreign keys keep pointing at the table's name while every
# other rename of the migration still updates them. An added NOT NULL column without a default takes a NULL placeholder, which fails
# on the first row until the reviewer gives it a value (the TODO says so).
func sqlite_rebuild(tc, reason, out)
  $t = tc.table
  $db = $t.database
  $tmp = "_mq_new_" + $t.name
  emit(out, "-- Rebuild " + $t.name + " (SQLite cannot change it in place: " + reason + ").")
  for cc in tc.columns
    if cc.kind == "dropped"
      emit(out, data_loss_note($t.name, cc.old_name ?? cc.key))
    else if cc.kind != "added"
      narrowing_notes($t, cc, out)
    end
  end
  emit(out, include "_table.scriban" $t null $tmp)
  $targets = ""
  $sources = ""
  for c in $t.columns
    $cc = column_change(tc, c.key)
    if c.computed
      continue
    end
    $source = q(($cc && $cc.old_name) ? $cc.old_name : c.name, $db)
    if $cc && $cc.kind == "added"
      if c.nullable || default_sql(c, $db) != "" || c.identity
        continue
      end
      emit(out, "-- TODO: " + c.name + " is NOT NULL without a default: replace the NULL placeholder below with each row's value (it fails on the first row as it is).")
      $source = "NULL /* TODO: " + c.name + " */"
    end
    $targets = $targets + ($targets == "" ? "" : ", ") + q(c.name, $db)
    $sources = $sources + ($sources == "" ? "" : ", ") + $source
  end
  emit(out, "INSERT INTO " + q($tmp, $db) + " (" + $targets + ")\nSELECT " + $sources + " FROM " + qt($t) + ";")
  emit(out, "DROP TABLE " + qt($t) + ";")
  emit(out, "PRAGMA legacy_alter_table = ON;\nALTER TABLE " + q($tmp, $db) + " RENAME TO " + q($t.name, $db) + ";\nPRAGMA legacy_alter_table = OFF;")
  for ix in $t.indexes
    emit(out, index_sql(ix, $t))
  end
  # SQLite drops a table's triggers with the table: the triggers the model holds as SQL objects that depend on it are created again
  # (unless this migration creates them anyway, as new or changed objects); others are the reviewer's. A trigger with environments
  # is objects.<env>.sql's, which runs after the migration.
  $again = 0
  for o in $db.objects
    if (o.object_kind | string.downcase) == "trigger" && !find_change(diff.objects, o.id) && object_in_schema(o, $db)
      for dep in o.depends_on
        if dep.kind == "table" && dep.key == $t.key
          emit(out, object_sql(o, $db))
          $again = $again + 1
        end
      end
    end
  end
  emit(out, "-- SQLite dropped the triggers of " + $t.name + " with the old table" + ($again > 0 ? "; the model's are created again above" : "") + ": recreate any other trigger on it by hand.")
end

# A "data loss" note before a statement that drops a column (column given) or a table (column null).
func data_loss_note(table_name, column_name)
  if column_name
    ret "-- Data loss: dropping column " + table_name + "." + column_name + " deletes its values."
  end
  ret "-- Data loss: dropping table " + table_name + " deletes its rows."
end

# The function that counts a value's characters in the dialect, for data checks.
func length_function(db)
  case db.dialect
    when "sqlserver"
      ret "LEN"
    when "mysql"
      ret "CHAR_LENGTH"
  end
  ret "length"
end

# Whether a native type stores Unicode text in a national character type (SQL Server and Oracle nchar, nvarchar, nvarchar2, nclob, ntext).
func national_type(native)
  $n = (native ?? "") | string.downcase
  ret ($n | string.starts_with "nchar") || ($n | string.starts_with "nvarchar") || ($n | string.starts_with "nclob") || ($n | string.starts_with "ntext")
end

# "1" followed by n zeros: the smallest value with n + 1 integer digits.
func power_of_ten(n)
  $s = "1"
  for i in 1..n
    $s = $s + "0"
  end
  ret n > 0 ? $s : "1"
end

# TODO lines with a data-check query for a column change that can lose data: a shorter length, a smaller precision or scale, a switch
# from Unicode to single-byte text (SQL Server, Oracle) or another native type. Written before the statement that changes the column.
func narrowing_notes(t, cc, out)
  $db = t.database
  $d = $db.dialect
  # SQLite keeps any value in any column (lengths and precisions are not enforced).
  if $d == "sqlite"
    ret
  end
  $c = cc.column
  $name = cc.new_name ?? $c.name
  $col = q(cc.old_name ?? $name, $db)
  $where = t.name + "." + $name
  $facets = false
  for ch in cc.changes
    if ch.property == "length" && ch.new != null && (ch.old == null || ch.new < ch.old)
      $facets = true
      emit(out, "-- TODO: " + $where + " gets shorter (length: " + (ch.old ?? "unbounded") + " -> " + ch.new + "); longer values are cut or refused. Check first: SELECT count(*) FROM " + qt(t) + " WHERE " + length_function($db) + "(" + $col + ") > " + ch.new + ";")
    else if (ch.property == "precision" || ch.property == "scale") && ch.old != null && (ch.new == null || ch.new < ch.old)
      $facets = true
      if $c.type == "decimal" && $c.precision != null
        $scale = $c.scale ?? 0
        emit(out, "-- TODO: " + $where + " holds fewer digits (" + ch.property + ": " + ch.old + " -> " + (ch.new ?? "null") + "); values that do not fit are refused or rounded. Check first: SELECT count(*) FROM " + qt(t) + " WHERE abs(" + $col + ") >= " + power_of_ten($c.precision - $scale) + " OR " + $col + " <> round(" + $col + ", " + $scale + ");")
      else
        emit(out, "-- TODO: " + $where + " holds fewer digits (" + ch.property + ": " + ch.old + " -> " + (ch.new ?? "null") + "); check that every value fits before running this.")
      end
    end
  end
  # A larger scale without as many more digits of precision leaves fewer digits before the point: (10,2) -> (10,4) holds values
  # below 10^6, no longer below 10^8.
  if !$facets && $c.type == "decimal" && $c.precision != null
    $p = null
    $sc = null
    for ch in cc.changes
      if ch.property == "precision"
        $p = ch
      else if ch.property == "scale"
        $sc = ch
      end
    end
    $old_p = $p ? $p.old : $c.precision
    if $sc && $sc.old != null && $sc.new != null && $sc.new > $sc.old && $old_p != null && ($c.precision - $sc.new) < ($old_p - $sc.old)
      $facets = true
      emit(out, "-- TODO: " + $where + " holds fewer digits before the point (precision " + $old_p + " -> " + $c.precision + ", scale " + $sc.old + " -> " + $sc.new + "); larger values are refused. Check first: SELECT count(*) FROM " + qt(t) + " WHERE abs(" + $col + ") >= " + power_of_ten($c.precision - $sc.new) + ";")
    end
  end
  for ch in cc.changes
    if ch.property == "nativeType"
      if ($d == "sqlserver" || $d == "oracle") && national_type(ch.old) && !national_type(ch.new)
        $back = $d == "sqlserver" ? "CAST(CAST(" + $col + " AS " + ch.new + ") AS " + ch.old + ")" : "TO_NCHAR(TO_CHAR(" + $col + "))"
        emit(out, "-- TODO: " + $where + " switches from Unicode to single-byte text (" + ch.old + " -> " + ch.new + "); characters outside the code page become '?'. Check first: SELECT count(*) FROM " + qt(t) + " WHERE " + $back + " <> " + $col + ";")
      else if !$facets && !has_change(cc.changes, ["type", "length", "precision", "scale", "strategy", "referenceTable", "codeType"])
        emit(out, "-- TODO: " + $where + " changes its native type (" + (ch.old ?? "null") + " -> " + (ch.new ?? "null") + "); check that every value converts before running this.")
      end
    end
  end
end

# A column comment statement for a changed comment, or a note where the dialect keeps comments in the definition only.
func column_comment_statement(t, c, name, out)
  $db = t.database
  $d = $db.dialect
  if $d == "postgresql"
    emit(out, "COMMENT ON COLUMN " + qt(t) + "." + q(name, $db) + " IS " + (c.comment ? lit(c.comment, $db) : "NULL") + ";")
  else if $d == "oracle"
    emit(out, "COMMENT ON COLUMN " + qt(t) + "." + q(name, $db) + " IS " + lit(c.comment ?? "", $db) + ";")
  else if $d == "sqlserver"
    emit(out, ms_description($db, "TABLE", t.schema, t.name, name, c.comment))
  else if $d == "sqlite"
    emit(out, "-- " + t.name + "." + name + ": the column comment changed; SQLite keeps comments in the schema script only.")
  end
end

# Whether a list of resolved columns holds a column (by key).
func has_column(list, c)
  for x in list
    if x.key == c.key
      ret true
    end
  end
  ret false
end

# Whether a table change lists a constraint or index by name (changed objects are dropped and added by their own phases).
func lists_change(changes, name)
  for oc in changes
    if oc.old_name == name || oc.new_name == name
      ret true
    end
  end
  ret false
end

# Whether a SQL expression reads a column, by its name as a whole word (best effort: a string literal or another table's column of
# the same name counts too).
func reads_column(expression, name)
  $pattern = "(?i)(?<![A-Za-z0-9_$#])" + (name | regex.escape) + "(?![A-Za-z0-9_$#])"
  ret ((expression ?? "") | regex.match $pattern).size > 0
end

# The table change of the diff for a table key, or null.
func table_change_of(key)
  for x in diff.tables
    if x.key == key
      ret x
    end
  end
  ret null
end

# Drops a foreign key once per migration (the column, key and table phases may each need it gone) and queues its ADD CONSTRAINT,
# which migration.scriban writes with the other foreign keys once every column and key has its new type (mq_fk_readd). A key the
# diff changes itself, or one of a table the diff adds or drops, is left to its own phase; idempotent, a key of an added table is
# dropped too when the table exists (a second run finds it created).
func drop_fk_once(t, f, out)
  $tc = table_change_of(t.key)
  $added = $tc && $tc.kind == "added"
  if $tc && (($added && !idem()) || $tc.kind == "dropped" || lists_change($tc.foreign_keys, f.name))
    ret
  end
  $k = t.key + "|" + f.name
  if mq_fk_dropped[$k]
    ret
  end
  mq_fk_dropped[$k] = true
  $db = t.database
  $drop = drop_constraint_sql(t, "foreign key", f.name)
  if $added && $db.dialect == "sqlserver"
    $drop = "IF OBJECT_ID(" + ms_object(t.schema, t.name, $db) + ", N'U') IS NOT NULL " + $drop
  else if $added && $db.dialect == "postgresql"
    $drop = "ALTER TABLE IF EXISTS " + qt(t) + " DROP CONSTRAINT IF EXISTS " + q(f.name, $db) + ";"
  end
  emit(out, $drop)
  mq_fk_readd[mq_fk_readd.size] = add_constraint_sql(t, f.name, foreign_key_body(f, $db))
end

# The foreign keys of other tables (and the table itself) that reference a table, optionally only those that reference a column of
# it, as { table, fk } pairs.
func incoming_fks(t, c)
  $result = []
  for x in (mq_incoming[t.key] ?? [])
    if !c || has_column(x.fk.referenced_columns, c)
      $result[$result.size] = x
    end
  end
  ret $result
end

# Whether a foreign key referencing the columns refs (keys, in its order) relies on a key or index with the columns keys (null for
# an expression column): MySQL on any index whose first columns are the referenced ones in that order, the other dialects on a key
# with exactly those columns.
func relies_on(refs, keys, d)
  if keys.size < refs.size || (d != "mysql" && keys.size != refs.size)
    ret false
  end
  if d == "mysql"
    for i in 0..(refs.size - 1)
      if keys[i] != refs[i]
        ret false
      end
    end
    ret true
  end
  for k in refs
    if !(keys | array.contains k)
      ret false
    end
  end
  ret true
end

# Drops the foreign keys of other tables (and the table's own) that rely on a unique constraint or index of t the migration drops
# (to change or remove it), and queues them to be added back with the other foreign keys (drop_fk_once): PostgreSQL, SQL Server,
# MySQL and Oracle refuse to drop a key a foreign key relies on. oc is the constraint or index change; MySQL relies on any index,
# the others on a unique key (an index: without a filter).
func drop_fks_relying_on(t, oc, out)
  $d = t.database.dialect
  if $d == "sqlite" || (!oc.old_unique && $d != "mysql")
    ret
  end
  for x in incoming_fks(t, null)
    if relies_on(x.fk.referenced_columns | array.map "key", oc.old_columns, $d)
      drop_fk_once(x.table, x.fk, out)
    end
  end
end

# SQL Server: what depends on a column that the migration does not change itself, as { drop, add } statement pairs, so ALTER COLUMN
# can run between them (SQL Server refuses it while they exist): unique constraints, checks (column checks and table checks whose
# expression reads the column), indexes (keys or included), computed columns that read it (with their own indexes and constraints)
# and the primary key. Foreign keys on the column and those of other tables that reference it are dropped here once and added back
# after every column changed (drop_fk_once), since a key and the columns that reference it must agree on the type.
func ms_column_dependents(tc, c, out, pairs, retype)
  $t = tc.table
  $db = $t.database
  for x in incoming_fks($t, c)
    drop_fk_once(x.table, x.fk, out)
  end
  for f in $t.foreign_keys
    if has_column(f.columns, c)
      drop_fk_once($t, f, out)
    end
  end
  ms_column_constraints(tc, c, pairs)
  computed_dependents(tc, c, pairs)
  # Retyping an identity column rewrites every row, which SQL Server refuses while the table has a persisted computed column; and a
  # retype that converts values fails while the table has a filtered index (error 1934, whatever the session's SET options).
  if c.identity && retype
    for comp in $t.columns
      if comp.computed && comp.computed_stored && !reads_column(comp.computed, c.name) && !column_change(tc, comp.key)
        ms_column_constraints(tc, comp, pairs)
        pairs[pairs.size] = { drop: alter_prefix($t) + " DROP COLUMN " + q(comp.name, $db) + ";", add: add_column_sql($t, comp) }
      end
    end
  end
  if retype
    for ix in $t.indexes
      if ix.where && !lists_change(tc.indexes, ix.name)
        $listed = false
        for x in pairs
          if x.index == ix.name
            $listed = true
          end
        end
        if !$listed
          pairs[pairs.size] = { drop: drop_index_sql($t, ix.name), add: index_sql(ix, $t), index: ix.name }
        end
      end
    end
  end
  if $t.primary_key && has_column($t.primary_key.columns, c) && tc.primary_key.size == 0
    for x in incoming_fks($t, null)
      drop_fk_once(x.table, x.fk, out)
    end
    pairs[pairs.size] = { drop: drop_constraint_sql($t, "primary key", $t.primary_key.name), add: add_constraint_sql($t, $t.primary_key.name, constraint_body($t, "primary key", $t.primary_key.name)) }
  end
end

# The computed columns of a table that read a column (and are not changed themselves), each with its constraints and indexes, as
# { drop, add } pairs: SQL Server and PostgreSQL refuse to retype a column a computed column reads, so it is dropped first and
# added again (at the end of the table) after.
func computed_dependents(tc, c, pairs)
  $t = tc.table
  for comp in $t.columns
    if comp.computed && comp.key != c.key && reads_column(comp.computed, c.name) && !column_change(tc, comp.key)
      ms_column_constraints(tc, comp, pairs)
      pairs[pairs.size] = { drop: alter_prefix($t) + " DROP COLUMN " + q(comp.name, $t.database) + ";", add: add_column_sql($t, comp) }
    end
  end
end

# The unique constraints, checks and indexes of a table that use a column, as { drop, add } pairs (see ms_column_dependents).
func ms_column_constraints(tc, c, pairs)
  $t = tc.table
  for u in $t.uniques
    if has_column(u.columns, c) && !lists_change(tc.uniques, u.name)
      pairs[pairs.size] = { drop: drop_constraint_sql($t, "unique", u.name), add: add_constraint_sql($t, u.name, unique_body(u, $t.database)) }
    end
  end
  for k in $t.checks
    if ((k.column && k.column.key == c.key) || (!k.column && reads_column(k.expression, c.name))) && !lists_change(tc.checks, k.name)
      pairs[pairs.size] = { drop: drop_constraint_sql($t, "check", k.name), add: add_constraint_sql($t, k.name, "CHECK (" + k.expression + ")") }
    end
  end
  for ix in $t.indexes
    $uses = has_column(ix.include, c)
    for ic in ix.columns
      if ic.column && ic.column.key == c.key
        $uses = true
      end
    end
    if $uses && !lists_change(tc.indexes, ix.name)
      pairs[pairs.size] = { drop: drop_index_sql($t, ix.name), add: index_sql(ix, $t), index: ix.name }
    end
  end
end

# ALTER TABLE ... ADD of a new column: ADD COLUMN, ADD on SQL Server, ADD (...) on Oracle; guarded when idempotent (PostgreSQL IF
# NOT EXISTS, SQL Server COL_LENGTH, MySQL information_schema).
func add_column_sql(t, c)
  $db = t.database
  $d = $db.dialect
  if $d == "oracle"
    ret alter_prefix(t) + " ADD (" + column_def(c) + ");"
  else if $d == "sqlserver"
    $s = alter_prefix(t) + " ADD " + column_def(c) + ";"
    ret idem() ? "IF COL_LENGTH(" + ms_object(t.schema, t.name, $db) + ", " + lit(c.name, $db) + ") IS NULL " + $s : $s
  else if $d == "mysql" && idem()
    ret my_guard($db, "NOT " + my_exists_column(t, c.name), alter_prefix(t) + " ADD COLUMN " + column_def(c) + ";")
  end
  ret alter_prefix(t) + " ADD COLUMN " + (idem() && $d == "postgresql" ? "IF NOT EXISTS " : "") + column_def(c) + ";"
end

# ALTER TABLE ... DROP COLUMN, guarded when idempotent (PostgreSQL and SQL Server IF EXISTS, MySQL information_schema).
func drop_column_sql(t, name)
  $db = t.database
  $d = $db.dialect
  $s = alter_prefix(t) + " DROP COLUMN" + (idem() && ($d == "postgresql" || $d == "sqlserver") ? " IF EXISTS" : "") + " " + q(name, $db) + ";"
  ret idem() && $d == "mysql" ? my_guard($db, my_exists_column(t, name), $s) : $s
end

# The rename of a column: sp_rename on SQL Server, RENAME COLUMN elsewhere; guarded when idempotent (the old name still exists).
func rename_column_sql(t, old, name)
  $db = t.database
  $d = $db.dialect
  if $d == "sqlserver"
    $s = rename_object($db, schema_prefix(t.schema) + t.name + "." + old, name, "COLUMN")
    ret idem() ? "IF COL_LENGTH(" + ms_object(t.schema, t.name, $db) + ", " + lit(old, $db) + ") IS NOT NULL " + $s : $s
  end
  $s = alter_prefix(t) + " RENAME COLUMN " + q(old, $db) + " TO " + q(name, $db) + ";"
  if idem() && $d == "postgresql"
    ret pg_do_if(pg_exists_column(t, old, false), $s)
  else if idem() && $d == "mysql"
    ret my_guard($db, my_exists_column(t, old), $s)
  end
  ret $s
end

# The identity statements of a column change outside SQLite (rebuilt) and MySQL (MODIFY): PostgreSQL ADD GENERATED ... AS IDENTITY with
# a restart after the largest value the column holds, DROP IDENTITY, SET GENERATED / SET START WITH / SET INCREMENT BY; Oracle MODIFY
# with START WITH LIMIT VALUE; SQL Server cannot add, drop or change an identity in place (TODO lines).
func identity_statements(t, cc, c, col, out)
  $db = t.database
  $d = $db.dialect
  $added = has_change(cc.changes, ["identity"]) && c.identity
  $dropped = has_change(cc.changes, ["identity"]) && !c.identity
  $options = !has_change(cc.changes, ["identity"]) && c.identity && has_change(cc.changes, ["identitySeed", "identityIncrement", "identityAlways"])
  if $d == "postgresql"
    if $added
      $s = alter_prefix(t) + " ALTER COLUMN " + col + " ADD " + identity_clause(c) + ";"
      emit(out, idem() ? pg_do_if("NOT " + pg_exists_column(t, c.name, true), $s) : $s)
      # The identity starts at its seed whatever the column holds: restart it after the largest value, so the next insert gets a new one.
      emit(out, "DO $$ BEGIN PERFORM setval(pg_get_serial_sequence(" + lit(qt(t), $db) + ", " + lit(c.name, $db) + "), GREATEST(COALESCE(MAX(" + col + "), 0) + 1, " + (c.identity_seed ?? 1) + "), false) FROM " + qt(t) + "; END $$;")
    else if $dropped
      emit(out, alter_prefix(t) + " ALTER COLUMN " + col + " DROP IDENTITY IF EXISTS;")
    else if $options
      $set = ""
      if has_change(cc.changes, ["identityAlways"])
        $set = $set + " SET GENERATED " + (c.identity_always ? "ALWAYS" : "BY DEFAULT")
      end
      if has_change(cc.changes, ["identityIncrement"])
        $set = $set + " SET INCREMENT BY " + (c.identity_increment ?? 1)
      end
      if has_change(cc.changes, ["identitySeed"])
        $set = $set + " SET START WITH " + (c.identity_seed ?? 1)
      end
      emit(out, alter_prefix(t) + " ALTER COLUMN " + col + $set + ";")
      if has_change(cc.changes, ["identitySeed"])
        emit(out, "-- TODO: " + t.name + "." + c.name + " starts at " + (c.identity_seed ?? 1) + " only after ALTER TABLE " + qt(t) + " ALTER COLUMN " + col + " RESTART; restart it if the values should begin again.")
      end
    end
  else if $d == "oracle"
    if $added
      emit(out, alter_prefix(t) + " MODIFY (" + col + " GENERATED " + (c.identity_always ? "ALWAYS" : "BY DEFAULT") + " AS IDENTITY (START WITH LIMIT VALUE" + (c.identity_increment != null ? " INCREMENT BY " + c.identity_increment : "") + "));")
    else if $dropped
      emit(out, alter_prefix(t) + " MODIFY (" + col + " DROP IDENTITY);")
    else if $options
      # The next value stays after the largest one the column holds unless the seed itself changed.
      $start = has_change(cc.changes, ["identitySeed"]) ? "START WITH " + (c.identity_seed ?? 1) : "START WITH LIMIT VALUE"
      emit(out, alter_prefix(t) + " MODIFY (" + col + " GENERATED " + (c.identity_always ? "ALWAYS" : "BY DEFAULT") + " AS IDENTITY (" + $start + (c.identity_increment != null ? " INCREMENT BY " + c.identity_increment : "") + "));")
    end
  else if $d == "sqlserver" && ($added || $dropped || $options)
    if $options && has_change(cc.changes, ["identitySeed"]) && !has_change(cc.changes, ["identityIncrement"])
      emit(out, "-- TODO: " + t.name + "." + c.name + " identity seed " + change_list(cc.changes) + ": DBCC CHECKIDENT (" + lit(schema_prefix(t.schema) + t.name, $db) + ", RESEED, " + (c.identity_seed ?? 1) + ") if the values should begin again.")
    else
      emit(out, "-- TODO: " + t.name + "." + c.name + ": SQL Server cannot add, drop or change an identity in place (" + change_list(cc.changes) + "); create a new column or table and copy the rows.")
    end
  end
end

# One added, dropped, renamed or altered column of a table change, then the ledger rows of the migration facts whose steps it wrote
# (PostgreSQL). Not called for a SQLite table that is rebuilt (sqlite_rebuild covers its columns).
func column_statements(tc, cc, out)
  column_change_statements(tc, cc, out)
  if cc.kind != "added"
    fact_rows("column:" + tc.key + "|" + cc.key, ["rename", "change-type", "backfill", "drop"], out)
  end
end

# The statements of one column change (column_statements). On PostgreSQL a migration fact's step takes the place of its change: a
# type change's data check and conversion replace the TODO lines and the plain cast, a backfill's UPDATE comes before SET NOT NULL;
# a held fact's note replaces its change.
func column_change_statements(tc, cc, out)
  $t = tc.table
  $fk = "column:" + tc.key + "|" + cc.key
  $old_table = tc.old_name
  $db = $t.database
  $d = $db.dialect
  if cc.kind == "added"
    emit(out, add_column_sql($t, cc.column))
    if pack.params.comments && cc.column.comment && $d != "mysql" && $d != "sqlite"
      emit(out, comment_sql($t, cc.column, cc.column.comment))
    end
    if !cc.column.nullable && default_sql(cc.column, $db) == "" && !cc.column.identity && !cc.column.computed
      emit(out, "-- TODO: " + cc.column.name + " is NOT NULL without a default; fill existing rows first (the ADD above fails on a table with rows).")
    end
    ret
  end
  if cc.kind == "dropped"
    $old_col = cc.old_name ?? cc.key
    $held = fact_at(mq_held, $fk, "drop")
    if $held
      emit(out, held_note($held, "column " + $t.name + "." + $old_col))
      ret
    end
    emit(out, data_loss_note($t.name, $old_col))
    if $d == "sqlserver"
      if cc.old_default_name
        emit(out, drop_default_sql($t, cc.old_default_name))
      else
        emit(out, drop_default_sql($t, df_name($t.name, $old_col)))
        if $old_table && $old_table != $t.name
          emit(out, drop_default_sql($t, df_name($old_table, $old_col)))
        end
      end
    end
    emit(out, drop_column_sql($t, $old_col))
    ret
  end
  $c = cc.column
  $name = cc.new_name ?? $c.name
  # SQL Server: the default constraint's name now (after the table rename renamed conventional names) and after this migration.
  $df_now = cc.old_default_name ?? df_name($t.name, cc.old_name ?? $name)
  $df = default_name($c, $t.name)
  if cc.old_name && cc.old_name != $name
    $held = fact_at(mq_held, $fk, "rename")
    if $held
      # The column keeps its old name, so the statements below name it so.
      emit(out, held_note($held, "column " + $t.name + "." + cc.old_name + ", " + $name + " in the model"))
      $name = cc.old_name
    else
      emit(out, rename_column_sql($t, cc.old_name, $name))
    end
  end
  if $d == "sqlserver" && $df_now != $df && (default_sql($c, $db) != "" || has_change(cc.changes, ["default", "defaultSql", "defaultName"]))
    emit(out, rename_default_sql($t, $df_now, $df))
  end
  if cc.changes.size == 0
    ret
  end
  $col = q($name, $db)
  if $d == "sqlite"
    # A SQLite table with anything but a comment change is rebuilt instead (sqlite_rebuild_reason).
    if has_change(cc.changes, ["comment"]) && pack.params.comments
      column_comment_statement($t, $c, $name, out)
    end
    ret
  end
  $retype = has_change(cc.changes, ["type", "subtype", "length", "precision", "scale", "nativeType", "strategy", "referenceTable", "codeType", "collation"])
  # A range column change that keeps the native type changes nothing in the database (range_same_native): no ALTER, no type TODO.
  $range_same = range_same_native(cc, $c)
  $changes = $range_same ? changes_except(cc.changes, ["type", "subtype", "length", "precision", "scale"]) : cc.changes
  if $range_same
    $retype = false
  end
  # A type change a complete migration fact describes (PostgreSQL): its step replaces the TODO lines and the plain cast. A held one
  # waits: its note replaces the change.
  $type_fact = $retype ? fact_at(mq_matched, $fk, "change-type") : null
  $type_todo = false
  if $type_fact && !fact_usable($type_fact)
    # A cast between range types PostgreSQL cannot convert: the fact's TODO replaces the diff's, and the column stays as it is.
    $note = fact_range_todo($type_fact, $t.name + "." + $name)
    if $note != ""
      emit(out, $note)
      $type_todo = true
      $retype = false
    end
    $type_fact = null
  end
  $type_held = $retype ? fact_at(mq_held, $fk, "change-type") : null
  if $type_held
    emit(out, held_note($type_held, "column " + $t.name + "." + $name))
    $retype = false
  end
  if !$type_fact && !$type_held && !$type_todo && !$range_same
    narrowing_notes($t, cc, out)
  end
  $physical = ["type", "length", "precision", "scale", "nativeType", "nullable", "default", "defaultSql", "identity", "sequence", "computed", "computedStored", "collation", "comment", "strategy", "referenceTable", "codeType"]
  if $d == "mysql"
    # MySQL redefines the whole column; its comment is part of the definition. A key and the columns that reference it must agree on
    # the type, so the foreign keys on the column and those that reference it are dropped first and added back after every column.
    if $retype
      for x in incoming_fks($t, $c)
        drop_fk_once(x.table, x.fk, out)
      end
      for f in $t.foreign_keys
        if has_column(f.columns, $c)
          drop_fk_once($t, f, out)
        end
      end
    end
    if has_change($changes, $physical)
      # The definition names the column as the model does; while a held rename waits, by its old name.
      $def = column_def($c)
      if $name != $c.name
        $def = q($name, $db) + ($def | string.slice (string.size q($c.name, $db)))
      end
      emit(out, alter_prefix($t) + " MODIFY COLUMN " + $def + ";")
    end
    if has_change(cc.changes, ["identitySeed"]) && $c.identity && $c.identity_seed != null
      emit(out, alter_prefix($t) + " AUTO_INCREMENT = " + $c.identity_seed + ";")
    end
    for ch in $changes
      if ch.property == "type"
        emit(out, "-- TODO: convert existing values of " + $t.name + "." + $name + " (type: " + (ch.old ?? "null") + " -> " + (ch.new ?? "null") + "); MODIFY COLUMN converts each value as it can.")
      end
    end
    ret
  end
  $native = column_type($c)
  # A PostgreSQL retype between range types takes its USING from range_using; one PostgreSQL cannot convert is a TODO, not an ALTER.
  $range = ($d == "postgresql" && $retype && !$type_fact) ? range_using(range_side_before(cc, $c), { type: $c.type, native_type: $native }, $col) : null
  if $range && $range.todo
    emit(out, "-- TODO: " + $t.name + "." + $name + " " + $range.todo)
    $retype = false
  end
  $renull = has_change(cc.changes, ["nullable"])
  $redefault = has_change(cc.changes, ["default", "defaultSql"])
  $dflt = default_sql($c, $db)
  # A new type without COLLATE takes the database's default collation, so a column with its own keeps it.
  $collate = ""
  if $c.collation
    $collate = " COLLATE " + collation_sql($c.collation, $db)
  end
  # PostgreSQL: a column that holds the codes of another reference type (next-phase-2-design.md section 3.5), with no value map of the
  # migration covering it, gets its strategy objects dropped here and created again for the new type at the end; a column of an enum
  # type is retyped to the new type's enum type through text, which no plain cast between two enum types allows.
  $ref_change = $d == "postgresql" && has_change(cc.changes, ["referenceType"]) && !value_map_covers(tc.key, cc.key)
  $ref_objects = $ref_change && !($c.type_ref && $c.is_foreign_key)
  if $ref_change
    $rt = $c.reference_type
    if $rt
      emit(out, "-- " + $t.name + "." + $name + " now holds codes of " + $rt.name + " (" + realization_words($rt, $db) + "): its reference objects are dropped and created again.")
      $rows = ref_rows_exist_sql($rt, $db)
      if $rows != ""
        emit(out, $rows)
      end
    else
      emit(out, "-- " + $t.name + "." + $name + " no longer holds codes of a reference type: its reference objects are dropped.")
    end
    if $ref_objects
      emit(out, column_objects_drop_sql($t, $name, $db))
    end
    if $rt && $c.type == "reference" && column_realization($c, $db) == "native" && !$type_fact
      emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " DROP DEFAULT;")
      emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " TYPE " + $native + " USING " + $col + "::text::" + $native + ";")
      if $dflt != "" && !$redefault
        emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " SET DEFAULT " + $dflt + ";")
      end
      $retype = false
    end
  end
  if $d == "oracle"
    if $retype
      emit(out, alter_prefix($t) + " MODIFY (" + $col + " " + $native + ");")
    end
    if $renull
      emit(out, alter_prefix($t) + " MODIFY (" + $col + ($c.nullable ? " NULL" : " NOT NULL") + ");")
    end
    if $redefault
      emit(out, alter_prefix($t) + " MODIFY (" + $col + " DEFAULT " + ($dflt == "" ? "NULL" : $dflt) + ");")
    end
    identity_statements($t, cc, $c, $col, out)
  else
    # SQL Server refuses ALTER COLUMN while a default constraint depends on the column: drop it first and add it back after. What
    # else depends on the column (ms_column_dependents) goes the same way.
    $readd = false
    $dependents = []
    if $d == "sqlserver" && ($retype || $renull)
      ms_column_dependents(tc, $c, out, $dependents, $retype)
    else if $d == "postgresql" && $retype
      computed_dependents(tc, $c, $dependents)
    end
    for x in $dependents
      emit(out, x.drop)
    end
    if $d == "sqlserver" && ($redefault || (($retype || $renull) && $dflt != ""))
      emit(out, drop_default_sql($t, $df))
      $readd = $dflt != ""
    end
    if $retype
      if $d == "postgresql" && $type_fact
        change_type_statements($type_fact, qt($t), $col, $name, $native, $collate, idem(), $db, out)
      else if $d == "postgresql" && $range
        emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " TYPE " + $native + $collate + " USING " + $range.using + ";")
      else if $d == "postgresql"
        # USING casts explicitly when the logical type or the native type itself changes; a new length, precision or scale needs none.
        $using = has_change(cc.changes, ["type", "strategy", "referenceTable", "codeType"]) || (has_change(cc.changes, ["nativeType"]) && !has_change(cc.changes, ["length", "precision", "scale"]))
        emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " TYPE " + $native + $collate + ($using ? " USING " + $col + "::" + $native : "") + ";")
      else
        emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " " + $native + $collate + ($c.nullable ? " NULL" : " NOT NULL") + ";")
      end
    end
    # PostgreSQL's ALTER COLUMN ... TYPE keeps the nullability, so a new one follows it; SQL Server's ALTER COLUMN above states it.
    if $renull && ($d == "postgresql" || !$retype)
      if $d == "postgresql"
        # A backfill a complete migration fact describes fills the rows before SET NOT NULL; a held one waits, and so does the change.
        $fill = $c.nullable ? null : fact_at(mq_matched, $fk, "backfill")
        $fill_held = $c.nullable ? null : fact_at(mq_held, $fk, "backfill")
        if $fill_held
          emit(out, held_note($fill_held, "column " + $t.name + "." + $name))
        else
          if $fill && fact_usable($fill)
            backfill_statements($fill, qt($t), $col, $db, out)
          end
          emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + ($c.nullable ? " DROP NOT NULL;" : " SET NOT NULL;"))
        end
      else
        emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + " " + $native + $collate + ($c.nullable ? " NULL" : " NOT NULL") + ";")
      end
    end
    if $redefault && $d != "sqlserver"
      emit(out, alter_prefix($t) + " ALTER COLUMN " + $col + ($dflt == "" ? " DROP DEFAULT;" : " SET DEFAULT " + $dflt + ";"))
    else if $readd
      $s = alter_prefix($t) + " ADD CONSTRAINT " + q($df, $db) + " DEFAULT " + $dflt + " FOR " + $col + ";"
      emit(out, idem() ? "IF OBJECT_ID(" + lit(schema_prefix($t.schema) + $df, $db) + ", 'D') IS NULL " + $s : $s)
    end
    for x in $dependents
      emit(out, x.add)
    end
    identity_statements($t, cc, $c, $col, out)
    if $ref_objects && $c.reference_type
      $add = column_objects_add_sql($t, $name, $c.reference_type, $db, column_realization($c, $db))
      if $add != ""
        emit(out, $add)
      end
    end
  end
  # A change of logical type keeps each stored value as the cast leaves it; the reviewer decides whether values change
  # meaning (for example integer ids that become codes) and converts them before dropping anything they depend on. A migration
  # fact's conversion has decided it.
  if $retype && !$type_fact
    for ch in cc.changes
      if ch.property == "type"
        emit(out, "-- TODO: convert existing values of " + $t.name + "." + $name + " (type: " + (ch.old ?? "null") + " -> " + (ch.new ?? "null") + "); the cast keeps each value as it is.")
      end
    end
  end
  if has_change(cc.changes, ["comment"]) && pack.params.comments
    column_comment_statement($t, $c, $name, out)
  end
  $handled = ["type", "subtype", "length", "precision", "scale", "nativeType", "nullable", "default", "defaultSql", "defaultName", "comment", "collation", "strategy", "referenceTable", "codeType", "identity", "identitySeed", "identityIncrement", "identityAlways"]
  if $d == "postgresql"
    $handled[$handled.size] = "referenceType"
  end
  $rest = []
  for ch in cc.changes
    if !has_change([ch], $handled)
      $rest[$rest.size] = ch
    end
  end
  if $rest.size > 0
    emit(out, "-- TODO: " + $t.name + "." + $name + " " + change_list($rest))
  end
end

# The body of a constraint of the current table by name, for ADD CONSTRAINT; "" when it no longer exists.
func constraint_body(t, group, name)
  $db = t.database
  if group == "primary key"
    if t.primary_key && t.primary_key.name == name
      ret "PRIMARY KEY" + pk_clustering(t) + " (" + key_cols(t.primary_key, $db) + ")"
    end
  else if group == "unique"
    $u = find_named(t.uniques, name)
    if $u
      ret unique_body($u, $db)
    end
  else if group == "foreign key"
    $f = find_named(t.foreign_keys, name)
    if $f
      ret foreign_key_body($f, $db)
    end
  else if group == "check"
    $k = find_named(t.checks, name)
    if $k
      ret "CHECK (" + $k.expression + ")"
    end
  else if group == "exclusion"
    $x = find_named(t.exclusions, name)
    if $x
      ret exclusion_body($x, $db)
    end
  end
  ret ""
end

# ALTER TABLE ... DROP of a primary key, unique, foreign key or check constraint. MySQL has a statement per kind (DROP PRIMARY KEY,
# DROP INDEX, DROP FOREIGN KEY, DROP CONSTRAINT for a check); the others DROP CONSTRAINT, IF EXISTS when idempotent.
func drop_constraint_sql(t, group, name)
  $db = t.database
  if $db.dialect == "mysql"
    case group
      when "primary key"
        $s = alter_prefix(t) + " DROP PRIMARY KEY;"
        ret idem() ? my_guard($db, my_exists_constraint(t, "PRIMARY", "PRIMARY KEY"), $s) : $s
      when "unique"
        $s = alter_prefix(t) + " DROP INDEX " + q(name, $db) + ";"
        ret idem() ? my_guard($db, my_exists_index(t, name), $s) : $s
      when "foreign key"
        $s = alter_prefix(t) + " DROP FOREIGN KEY " + q(name, $db) + ";"
        ret idem() ? my_guard($db, my_exists_constraint(t, name, "FOREIGN KEY"), $s) : $s
    end
    $s = alter_prefix(t) + " DROP CONSTRAINT " + q(name, $db) + ";"
    ret idem() ? my_guard($db, my_exists_constraint(t, name, null), $s) : $s
  end
  ret alter_prefix(t) + " DROP CONSTRAINT" + (idem() && ($db.dialect == "postgresql" || $db.dialect == "sqlserver") ? " IF EXISTS" : "") + " " + q(name, $db) + ";"
end

# One primary key, unique, foreign key or check change, for one phase: "before" drops and renames, "after" adds (a changed
# constraint is dropped before and added after). MySQL renames a unique constraint as an index, cannot rename a foreign key or a
# check (dropped and added again) and ignores a primary key's name. Not called for a SQLite table, which is rebuilt.
func constraint_statements(t, oc, group, phase, out)
  $db = t.database
  $d = $db.dialect
  $old = oc.old_name ?? oc.new_name
  $name = oc.new_name ?? oc.old_name
  $renamed_only = oc.kind == "renamed" && oc.changes.size == 0
  if $d == "mysql" && $renamed_only && group == "primary key"
    ret
  end
  $recreate = oc.kind == "added" || oc.kind == "dropped" || oc.changes.size > 0 || ($d == "mysql" && $renamed_only && group != "unique")
  if phase == "before"
    if oc.kind == "dropped" || (oc.kind != "added" && $recreate)
      # A primary key cannot be dropped while foreign keys reference it: those are dropped first and added back with the other
      # foreign keys (drop_fk_once).
      if group == "primary key"
        for x in incoming_fks(t, null)
          drop_fk_once(x.table, x.fk, out)
        end
      else if group == "unique"
        drop_fks_relying_on(t, oc, out)
      end
      emit(out, drop_constraint_sql(t, group, $old))
    else if !$recreate
      if $d == "mysql"
        $s = alter_prefix(t) + " RENAME INDEX " + q($old, $db) + " TO " + q($name, $db) + ";"
        emit(out, idem() ? my_guard($db, my_exists_index(t, $old), $s) : $s)
      else if $d == "sqlserver"
        $s = rename_object($db, schema_prefix(t.schema) + $old, $name, "OBJECT")
        emit(out, idem() ? "IF OBJECT_ID(" + ms_object(t.schema, $old, $db) + ") IS NOT NULL " + $s : $s)
      else
        $s = alter_prefix(t) + " RENAME CONSTRAINT " + q($old, $db) + " TO " + q($name, $db) + ";"
        emit(out, idem() && $d == "postgresql" ? pg_do_if("EXISTS (SELECT 1 FROM pg_constraint WHERE conname = " + lit($old, $db) + " AND conrelid = " + lit(qt(t), $db) + "::regclass)", $s) : $s)
      end
    end
  else if oc.kind == "added" || (oc.kind != "dropped" && $recreate)
    emit(out, add_constraint_sql(t, $name, constraint_body(t, group, $name)))
  end
end

func drop_index_sql(t, name)
  $db = t.database
  if $db.dialect == "sqlserver"
    ret "DROP INDEX" + if_exists($db) + " " + q(name, $db) + " ON " + qt(t) + ";"
  else if $db.dialect == "mysql"
    $s = "DROP INDEX " + q(name, $db) + " ON " + qt(t) + ";"
    ret idem() ? my_guard($db, my_exists_index(t, name), $s) : $s
  end
  ret "DROP INDEX" + if_exists($db) + " " + qn(t.schema, name, $db) + ";"
end

# One index change, for one phase: "before" drops and renames, "after" creates (a changed index, or any non-new index on SQLite,
# is dropped before and created after). On PostgreSQL an index whose only change is its storage parameters keeps the index: ALTER
# INDEX SET and RESET, after any rename.
func index_statements(t, oc, phase, out)
  $db = t.database
  $d = $db.dialect
  $old = oc.old_name ?? oc.new_name
  $name = oc.new_name ?? oc.old_name
  $storage_only = $d == "postgresql" && oc.kind != "added" && oc.kind != "dropped" && oc.changes.size == 1 && oc.changes[0].property == "storage"
  $recreate = !$storage_only && (oc.kind == "added" || oc.kind == "dropped" || oc.changes.size > 0 || $d == "sqlite")
  if $storage_only && phase == "after"
    storage_alter_statements("ALTER INDEX" + alter_if_exists($db) + " " + qn(t.schema, $name, $db), find_named(t.indexes, $name).storage, oc.old_storage, $db, out)
  end
  if phase == "before"
    if oc.kind != "added" && $recreate
      drop_fks_relying_on(t, oc, out)
      emit(out, drop_index_sql(t, $old))
    else if !$recreate && $old != $name
      if $d == "postgresql" || $d == "oracle"
        emit(out, "ALTER INDEX" + alter_if_exists($db) + " " + qn(t.schema, $old, $db) + " RENAME TO " + q($name, $db) + ";")
      else if $d == "mysql"
        $s = alter_prefix(t) + " RENAME INDEX " + q($old, $db) + " TO " + q($name, $db) + ";"
        emit(out, idem() ? my_guard($db, my_exists_index(t, $old), $s) : $s)
      else
        $s = rename_object($db, schema_prefix(t.schema) + t.name + "." + $old, $name, "INDEX")
        emit(out, idem() ? "IF EXISTS (SELECT 1 FROM sys.indexes WHERE name = " + lit($old, $db) + " AND object_id = OBJECT_ID(" + ms_object(t.schema, t.name, $db) + ")) " + $s : $s)
      end
    end
  else if oc.kind != "dropped" && $recreate
    emit(out, index_sql(find_named(t.indexes, $name), t))
  end
end

# The rename of a renamed table (with its SQL Server default constraints that carry the table name by convention), from its schema
# before the migration (after the schema renames).
func table_rename_statements(tc, db, out)
  $t = tc.table
  if !tc.old_name || tc.old_name == $t.name
    ret
  end
  $schema = moved_schema(tc.old_schema)
  if db.dialect == "sqlserver"
    $s = rename_object(db, schema_prefix($schema) + tc.old_name, $t.name, "OBJECT")
    emit(out, idem() ? "IF OBJECT_ID(" + ms_object($schema, tc.old_name, db) + ", N'U') IS NOT NULL " + $s : $s)
    for c in $t.columns
      $cc = null
      for x in tc.columns
        if x.kind != "dropped" && (x.new_name ?? x.column.name) == c.name
          $cc = x
        end
      end
      if c.default_name || ($cc && $cc.old_default_name)
        continue
      end
      if default_sql(c, db) != "" || ($cc && has_change($cc.changes, ["default", "defaultSql"]))
        $old_col = ($cc && $cc.old_name) ? $cc.old_name : c.name
        emit(out, rename_default_sql($t, df_name(tc.old_name, $old_col), df_name($t.name, $old_col)))
      end
    end
  else
    $s = "ALTER TABLE" + alter_if_exists(db) + " " + qn($schema, tc.old_name, db) + " RENAME TO " + q($t.name, db) + ";"
    emit(out, idem() && db.dialect == "mysql" ? my_guard(db, my_exists_table($schema, tc.old_name, db), $s) : $s)
  end
end

# The move of a table to another schema: PostgreSQL SET SCHEMA, SQL Server ALTER SCHEMA ... TRANSFER, MySQL RENAME TABLE across
# databases; Oracle cannot move a table to another user. Nothing when a PostgreSQL schema rename already moved it.
func table_move_statements(tc, db, out)
  $t = tc.table
  $from = moved_schema(tc.old_schema)
  if $from == $t.schema || db.dialect == "sqlite"
    ret
  end
  $d = db.dialect
  if $d == "postgresql"
    emit(out, "ALTER TABLE" + alter_if_exists(db) + " " + qn($from, $t.name, db) + " SET SCHEMA " + q($t.schema, db) + ";")
  else if $d == "sqlserver"
    $s = "ALTER SCHEMA " + q($t.schema, db) + " TRANSFER " + qn($from, $t.name, db) + ";"
    emit(out, idem() ? "IF OBJECT_ID(" + ms_object($from, $t.name, db) + ", N'U') IS NOT NULL " + $s : $s)
  else if $d == "mysql"
    $s = "RENAME TABLE " + qn($from, $t.name, db) + " TO " + qt($t) + ";"
    emit(out, idem() ? my_guard(db, my_exists_table($from, $t.name, db), $s) : $s)
  else
    emit(out, "-- TODO: move table " + $t.name + " from schema " + ($from ?? "(default)") + " to " + ($t.schema ?? "(default)") + " (create it there and copy the rows).")
  end
end

# The statement for a changed table comment: COMMENT ON TABLE (PostgreSQL, Oracle), MS_Description (SQL Server), the table option
# (MySQL); a note on SQLite, which keeps comments in the schema script only.
func table_comment_statements(tc, db, out)
  $t = tc.table
  if !pack.params.comments || tc.old_comment == $t.comment
    ret
  end
  $d = db.dialect
  if $d == "postgresql"
    emit(out, "COMMENT ON TABLE " + qt($t) + " IS " + ($t.comment ? lit($t.comment, db) : "NULL") + ";")
  else if $d == "oracle"
    emit(out, "COMMENT ON TABLE " + qt($t) + " IS " + lit($t.comment ?? "", db) + ";")
  else if $d == "sqlserver"
    emit(out, ms_description(db, "TABLE", $t.schema, $t.name, null, $t.comment))
  else if $d == "mysql"
    emit(out, alter_prefix($t) + " COMMENT = " + lit($t.comment ?? "", db) + ";")
  else
    emit(out, "-- " + $t.name + ": the table comment changed; SQLite keeps comments in the schema script only.")
  end
end

# ALTER ... SET (the parameters that are new or changed) and RESET (those that went) for a PostgreSQL table or index; prefix is
# "ALTER TABLE t" or "ALTER INDEX i".
func storage_alter_statements(prefix, now, before, db, out)
  $set = []
  for p in now
    $same = false
    for o in before
      if o.name == p.name && o.value == p.value
        $same = true
      end
    end
    if !$same
      $set[$set.size] = p
    end
  end
  $reset = ""
  for o in before
    $kept = false
    for p in now
      if p.name == o.name
        $kept = true
      end
    end
    if !$kept
      $reset = $reset + ($reset == "" ? "" : ", ") + o.name
    end
  end
  if $set.size > 0
    emit(out, prefix + " SET (" + storage_list($set, db) + ");")
  end
  if $reset != ""
    emit(out, prefix + " RESET (" + $reset + ");")
  end
end

# The statements for a table whose storage parameters changed: ALTER TABLE SET and RESET on PostgreSQL, the table options on MySQL;
# a TODO elsewhere (SQL Server rebuilds for most options, Oracle's physical attributes apply to new blocks only).
func table_storage_statements(tc, db, out)
  if !has_change(tc.changes, ["storage"])
    ret
  end
  $t = tc.table
  $d = db.dialect
  if $d == "postgresql" && $t.partition_by
    # A partitioned table's storage parameters are its partitions'.
    for p in $t.partitions
      storage_alter_statements("ALTER TABLE" + alter_if_exists(db) + " " + qn($t.schema, p.name, db), $t.storage, tc.old_storage, db, out)
    end
  else if $d == "postgresql"
    storage_alter_statements(alter_prefix($t), $t.storage, tc.old_storage, db, out)
  else if $d == "mysql" && $t.storage.size > 0
    $s = alter_prefix($t)
    for p in $t.storage
      $s = $s + " " + (p.name | string.upcase) + " = " + p.value
    end
    emit(out, $s + ";")
  else
    $now = storage_list($t.storage, db)
    emit(out, "-- TODO: " + $t.name + " changes its storage parameters (now: " + ($now == "" ? "none" : $now) + "); apply them by hand (SQL Server: ALTER TABLE ... REBUILD WITH (...)).")
  end
end

# The partition statements of a renamed or altered PostgreSQL table: a new partition is created, a dropped one is dropped with its
# rows, a renamed one renamed, and one whose bounds changed is detached and attached again with them (PostgreSQL checks its rows
# against the new bounds). A change of the partitioning itself is a TODO: PostgreSQL cannot partition a table in place.
func table_partition_statements(tc, db, out)
  if db.dialect != "postgresql"
    ret
  end
  $t = tc.table
  if has_change(tc.changes, ["partitionBy"])
    emit(out, "-- TODO: " + $t.name + " changes its partitioning (" + change_list(tc.changes) + "). PostgreSQL cannot partition a table in place: create the table anew, copy the rows, then swap the names.")
    ret
  end
  for pc in tc.partitions
    if pc.kind == "dropped"
      emit(out, "-- Partition " + pc.old_name + " of " + $t.name + " is dropped with its rows.")
      emit(out, "DROP TABLE" + (idem() ? " IF EXISTS" : "") + " " + qn($t.schema, pc.old_name, db) + ";")
      continue
    end
    $p = find_named($t.partitions, pc.new_name)
    if pc.kind == "added"
      emit(out, partition_sql($t, $p))
      continue
    end
    if pc.kind == "renamed"
      emit(out, "ALTER TABLE" + alter_if_exists(db) + " " + qn($t.schema, pc.old_name, db) + " RENAME TO " + q($p.name, db) + ";")
    end
    if pc.changes.size > 0
      emit(out, alter_prefix($t) + " DETACH PARTITION " + qn($t.schema, $p.name, db) + ";")
      emit(out, alter_prefix($t) + " ATTACH PARTITION " + qn($t.schema, $p.name, db) + ($p.is_default ? " DEFAULT" : " FOR VALUES " + $p.bounds) + ";")
    end
  end
end

# The constraint and index statements of a renamed or altered table for one phase ("before" or "after"), limited to the groups
# listed ("foreign key", "check", "exclusion", "unique", "primary key", "index"). Nothing for a SQLite table that is rebuilt.
func table_phase_statements(tc, phase, groups, out)
  $t = tc.table
  if $t.database.dialect == "sqlite" && sqlite_rebuild_reason(tc) != ""
    ret
  end
  for g in groups
    case g
      when "foreign key"
        for oc in tc.foreign_keys
          constraint_statements($t, oc, g, phase, out)
        end
      when "check"
        for oc in tc.checks
          constraint_statements($t, oc, g, phase, out)
        end
      when "exclusion"
        # PostgreSQL only: the other dialects never had them (MQ4056).
        if $t.database.dialect == "postgresql"
          for oc in tc.exclusions
            constraint_statements($t, oc, g, phase, out)
          end
        end
      when "unique"
        for oc in tc.uniques
          constraint_statements($t, oc, g, phase, out)
        end
      when "primary key"
        for oc in tc.primary_key
          constraint_statements($t, oc, g, phase, out)
        end
      when "index"
        for oc in tc.indexes
          index_statements($t, oc, phase, out)
        end
    end
  end
end

# How many columns of a table a SQLite rebuild would drop or rename while a held fact keeps them; such a table is not rebuilt.
func sqlite_rebuild_held(tc)
  $n = 0
  for cc in tc.columns
    $fk = "column:" + tc.key + "|" + cc.key
    if cc.kind == "dropped" && fact_at(mq_held, $fk, "drop")
      $n = $n + 1
    else if (cc.kind == "renamed" || cc.kind == "altered") && cc.old_name && cc.old_name != (cc.new_name ?? cc.column.name) && fact_at(mq_held, $fk, "rename")
      $n = $n + 1
    end
  end
  ret $n
end

# The column statements of a renamed or altered table: drops first, so a column that is replaced by one of the same name (a
# new identity, such as a relation whose id changed) is dropped before it is added again. A SQLite table that cannot take its
# changes in place is rebuilt instead.
func table_column_statements(tc, out)
  $reason = sqlite_rebuild_reason(tc)
  if $reason != ""
    # A rebuild copies only the model's columns under their model names, so it would drop or rename a column a held fact keeps:
    # the held notes stand where the rebuild would go, and the rebuild is the reviewer's once the facts are released.
    $held = sqlite_rebuild_held(tc)
    if $held > 0
      for cc in tc.columns
        $fk = "column:" + tc.key + "|" + cc.key
        if cc.kind == "dropped" && fact_at(mq_held, $fk, "drop")
          emit(out, held_note(fact_at(mq_held, $fk, "drop"), "column " + tc.table.name + "." + (cc.old_name ?? cc.key)))
        else if (cc.kind == "renamed" || cc.kind == "altered") && cc.old_name && cc.old_name != (cc.new_name ?? cc.column.name) && fact_at(mq_held, $fk, "rename")
          emit(out, held_note(fact_at(mq_held, $fk, "rename"), "column " + tc.table.name + "." + cc.old_name + ", " + (cc.new_name ?? cc.column.name) + " in the model"))
        end
      end
      emit(out, "-- TODO: " + tc.table.name + " needs a rebuild (SQLite cannot change it in place: " + $reason + "), which would drop or rename the held column" + ($held > 1 ? "s" : "") + "; rebuild it by hand once the held facts are released.")
      ret
    end
    sqlite_rebuild(tc, $reason, out)
    ret
  end
  for cc in tc.columns
    if cc.kind == "dropped"
      column_statements(tc, cc, out)
    end
  end
  for cc in tc.columns
    if cc.kind != "dropped"
      column_statements(tc, cc, out)
    end
  end
end

# Whether a view change needs the view dropped and created again: a new body, schema, column list, check option or materialization
# (a rename alone is renamed in place, a comment alone is commented; Oracle renames no materialized view), or any change when every
# view is recreated (mq_all_views) or the view reads one that is (mq_view_dependents, see migration.scriban).
func view_recreates(oc)
  if oc.kind != "altered" && oc.kind != "renamed"
    ret false
  end
  ret mq_all_views || (mq_view_dependents && mq_view_dependents[oc.key]) || has_change(oc.changes, ["body", "schema", "columns", "withCheckOption", "materialized", "securityInvoker", "securityBarrier"]) || (oc.kind == "renamed" && oc.old_materialized && db.dialect == "oracle")
end

# DROP VIEW, or DROP MATERIALIZED VIEW for one that was materialized (PostgreSQL, Oracle), of a view by its schema and name.
func view_drop_sql(db, schema, name, was_materialized)
  $mat = was_materialized && (db.dialect == "postgresql" || db.dialect == "oracle")
  ret "DROP " + ($mat ? "MATERIALIZED VIEW" : "VIEW") + (idem() && db.dialect != "oracle" ? " IF EXISTS" : "") + " " + qn(schema, name, db) + ";"
end

func view_drop(db, oc)
  ret view_drop_sql(db, moved_schema(oc.old_schema), oc.old_name ?? oc.key, oc.old_materialized)
end

# The keys of the views a view reads (its resolved dependsOn).
func view_dependency_keys(v)
  $keys = []
  for dep in v.depends_on
    if dep.kind == "view"
      $keys[$keys.size] = dep.id
    end
  end
  ret $keys
end

# Views to drop, as { key, deps, sql } items, in the order to drop them: every view before the views it reads (the reverse of
# ddl_order over their dependencies), so PostgreSQL never refuses to drop a view another one still reads.
func views_in_drop_order(items)
  if items.size < 2
    ret items
  end
  $index = {}
  for x in items
    $index[x.key] = for.index
  end
  capture $spec
    for x in items
      if !for.first
        ";"
      end
      for k in x.deps
        if !for.first
          ","
        end
        ($index[k] == null || k == x.key) ? "x" : $index[k]
      end
    end
  end
  $result = []
  for i in (ddl_order ("" + $spec)) | array.reverse
    $result[$result.size] = items[i]
  end
  ret $result
end

# The rename of a view: ALTER VIEW (PostgreSQL), sp_rename (SQL Server), RENAME TABLE (MySQL), RENAME (Oracle); SQLite cannot rename
# a view, so it is dropped and created again.
func view_rename(db, oc, v, out)
  $d = db.dialect
  $schema = moved_schema(oc.old_schema)
  if $d == "postgresql"
    emit(out, "ALTER " + (materialized(v, db) ? "MATERIALIZED VIEW" : "VIEW") + alter_if_exists(db) + " " + qn($schema, oc.old_name, db) + " RENAME TO " + q(oc.new_name, db) + ";")
  else if $d == "sqlserver"
    $s = rename_object(db, schema_prefix($schema) + oc.old_name, oc.new_name, "OBJECT")
    emit(out, idem() ? "IF OBJECT_ID(" + ms_object($schema, oc.old_name, db) + ", N'V') IS NOT NULL " + $s : $s)
  else if $d == "mysql"
    $s = "RENAME TABLE " + qn($schema, oc.old_name, db) + " TO " + qn(v.schema, oc.new_name, db) + ";"
    emit(out, idem() ? my_guard(db, my_exists_table($schema, oc.old_name, db), $s) : $s)
  else if $d == "oracle"
    emit(out, "RENAME " + q(oc.old_name, db) + " TO " + q(oc.new_name, db) + ";")
  else
    emit(out, "DROP VIEW" + (idem() ? " IF EXISTS" : "") + " " + q(oc.old_name, db) + ";")
    emit(out, view_sql(v, db))
  end
end

# The statements of a sequence change: CREATE, DROP, a rename, a move to another schema and ALTER SEQUENCE for changed options. A
# changed start is written as START WITH on PostgreSQL (it takes effect at the next RESTART) and left to the reviewer elsewhere; a
# changed type is ALTER SEQUENCE ... AS on PostgreSQL and a note elsewhere.
func sequence_statements(db, oc, out)
  $d = db.dialect
  $old = oc.old_name ?? oc.new_name
  $name = oc.new_name ?? oc.old_name
  if $d == "sqlite" || $d == "mysql"
    emit(out, "-- " + dialect_title(db) + " has no sequences (" + oc.kind + " " + $name + ").")
    ret
  end
  $s = find_named(db.sequences, $name)
  if oc.kind == "added"
    emit(out, sequence_sql($s, db))
    ret
  end
  $from = moved_schema(oc.old_schema)
  $fk = "sequence:" + oc.key
  if oc.kind == "dropped"
    $held = fact_at(mq_held, $fk, "drop")
    if $held
      emit(out, held_note($held, "sequence " + $old))
      ret
    end
    emit(out, "DROP SEQUENCE" + (idem() && $d != "oracle" ? " IF EXISTS" : "") + " " + qn($from, $old, db) + ";")
    fact_rows($fk, ["drop"], out)
    ret
  end
  # The schema the sequence is in after this migration: the model's, or its old one while a held rename waits (the sequence keeps
  # its old name and schema then, so every statement below names it so).
  $at = $s.schema
  $held = fact_at(mq_held, $fk, "rename")
  if $held
    emit(out, held_note($held, "sequence " + $old + ", " + $name + " in the model"))
    $name = $old
    $at = $from
  end
  # SQL Server cannot rename or move a sequence a default constraint uses: those defaults are dropped first and added back after.
  $users = []
  if $d == "sqlserver" && ($old != $name || $from != $at)
    for t in db.tables
      for c in t.columns
        if c.sequence && c.sequence.id == oc.key && !c.identity
          $users[$users.size] = c
          emit(out, drop_default_sql(t, default_name(c, t.name)))
        end
      end
    end
  end
  if $old != $name
    if $d == "postgresql"
      emit(out, "ALTER SEQUENCE" + alter_if_exists(db) + " " + qn($from, $old, db) + " RENAME TO " + q($name, db) + ";")
    else if $d == "oracle"
      emit(out, "RENAME " + q($old, db) + " TO " + q($name, db) + ";")
    else
      $r = rename_object(db, schema_prefix($from) + $old, $name, "OBJECT")
      emit(out, idem() ? "IF OBJECT_ID(" + ms_object($from, $old, db) + ", N'SO') IS NOT NULL " + $r : $r)
    end
  end
  if $from != $at
    if $d == "postgresql"
      emit(out, "ALTER SEQUENCE" + alter_if_exists(db) + " " + qn($from, $name, db) + " SET SCHEMA " + q($s.schema, db) + ";")
    else if $d == "sqlserver"
      $r = "ALTER SCHEMA " + q($s.schema, db) + " TRANSFER " + qn($from, $name, db) + ";"
      emit(out, idem() ? "IF OBJECT_ID(" + ms_object($from, $name, db) + ", N'SO') IS NOT NULL " + $r : $r)
    else
      emit(out, "-- TODO: move sequence " + $name + " to schema " + ($s.schema ?? "(default)") + " (create it there and drop the old one).")
    end
  end
  for c in $users
    emit(out, alter_prefix(c.table) + " ADD CONSTRAINT " + q(default_name(c, c.table.name), db) + " DEFAULT " + default_sql(c, db) + " FOR " + q(c.name, db) + ";")
  end
  $options = ""
  $notes = []
  for ch in oc.changes
    case ch.property
      when "type"
        if $d == "postgresql"
          $options = $options + " AS " + $s.native_type
        else
          $notes[$notes.size] = "type " + (ch.old ?? "null") + " -> " + (ch.new ?? "null") + " (drop and create the sequence to change it)"
        end
      when "increment"
        $options = $options + " INCREMENT BY " + $s.increment
      when "min"
        $options = $options + ($s.min != null ? " MINVALUE " + $s.min : ($d == "oracle" ? " NOMINVALUE" : " NO MINVALUE"))
      when "max"
        $options = $options + ($s.max != null ? " MAXVALUE " + $s.max : ($d == "oracle" ? " NOMAXVALUE" : " NO MAXVALUE"))
      when "cycle"
        $options = $options + ($s.cycle ? " CYCLE" : ($d == "oracle" ? " NOCYCLE" : " NO CYCLE"))
      when "cache"
        if $s.cache != null
          $options = $options + " CACHE " + $s.cache
        else
          $options = $options + ($d == "postgresql" ? " CACHE 1" : ($d == "oracle" ? " NOCACHE" : " CACHE"))
        end
      when "start"
        if $d == "postgresql"
          $options = $options + " START WITH " + $s.start
        else
          $notes[$notes.size] = "start " + (ch.old ?? "null") + " -> " + (ch.new ?? "null") + " (RESTART WITH " + $s.start + " if the sequence should begin again)"
        end
    end
  end
  if $options != ""
    emit(out, "ALTER SEQUENCE " + qn($at, $name, db) + $options + ";")
  end
  for n in $notes
    emit(out, "-- TODO: sequence " + $name + " " + n)
  end
  fact_rows($fk, ["rename"], out)
end

# The statements of the schema changes that run first: PostgreSQL renames a schema in place; SQL Server and MySQL cannot, so the new
# schema is created here, each object moves on its own and the old schema is dropped at the end (schema_drop_statements).
func schema_first_statements(db, diff, out)
  for sc in diff.schemas
    if sc.kind == "added" || sc.kind == "renamed"
      $new = sc.new_name
      if sc.kind == "renamed" && db.dialect == "postgresql"
        $held = fact_at(mq_held, "schema:" + sc.key, "rename")
        if $held
          emit(out, held_note($held, "schema " + sc.old_name + ", " + $new + " in the model"))
          continue
        end
        $s = "ALTER SCHEMA " + q(sc.old_name, db) + " RENAME TO " + q($new, db) + ";"
        emit(out, idem() ? pg_do_if("EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = " + lit(sc.old_name, db) + ")", $s) : $s)
        fact_rows("schema:" + sc.key, ["rename"], out)
      else if creates_schemas(db) && !builtin_schema($new, db)
        emit(out, schema_sql($new, db))
      else if db.dialect == "oracle"
        emit(out, "-- Oracle schemas are users: " + sc.kind + " schema " + $new + " by hand.")
      end
    end
  end
end

# DROP SCHEMA for the schemas that left the model, and for the old name of a schema SQL Server renamed by moving its objects; MySQL
# drops a schema with everything still in it, so it is left to the reviewer there.
func schema_drop_statements(db, diff, out)
  for sc in diff.schemas
    if sc.kind == "dropped" || (sc.kind == "renamed" && db.dialect != "postgresql")
      if db.dialect == "postgresql" || db.dialect == "sqlserver"
        if !builtin_schema(sc.old_name, db)
          emit(out, "DROP SCHEMA" + (idem() ? " IF EXISTS" : "") + " " + q(sc.old_name, db) + ";")
        end
      else if db.dialect == "mysql"
        emit(out, "-- TODO: schema " + sc.old_name + " left the model; DROP SCHEMA " + q(sc.old_name, db) + " once nothing in it is needed (it drops what is left).")
      else if db.dialect == "oracle"
        emit(out, "-- Oracle schemas are users: drop schema " + sc.old_name + " by hand.")
      end
    end
  end
end

# The change of a routine, database type or SQL object with the given id, or null.
func find_change(changes, id)
  for ch in changes
    if ch.key == id
      ret ch
    end
  end
  ret null
end

# SQL Server: a statement with GO batch separators, each followed by a batch that rolls the migration's transaction back after an
# error and turns execution off (SET NOEXEC ON) when the transaction is gone, so no later batch runs outside it (XACT_ABORT already
# rolled it back on a run-time error; a compile error leaves @@ERROR set). The script turns execution on again at its end.
func ms_batch_guard(text)
  $g = "IF @@ERROR <> 0 AND @@TRANCOUNT > 0 ROLLBACK TRANSACTION;\nIF @@TRANCOUNT = 0 SET NOEXEC ON;\nGO"
  $t = text | string.replace "\nGO\n" ("\nGO\n" + $g + "\n")
  if $t | string.starts_with "GO\n"
    $t = "GO\n" + $g + "\n" + ($t | string.slice 3)
  end
  if $t | string.ends_with "\nGO"
    $t = $t + "\n" + $g
  end
  ret $t
end

# A statement that must run in a batch of its own on SQL Server (CREATE FUNCTION, PROCEDURE, VIEW or TRIGGER): wrapped in GO there.
func own_batch(text, db)
  ret db.dialect == "sqlserver" ? "GO\n" + text + "\nGO" : text
end

# DROP FUNCTION or DROP PROCEDURE for a routine that changed or left the model (it is created again later when it changed);
# nothing on SQLite, which never had it.
func routine_drop(db, rc, out)
  if db.dialect != "postgresql" && db.dialect != "sqlserver"
    ret
  end
  emit(out, "DROP " + (rc.old_kind == "procedure" ? "PROCEDURE" : "FUNCTION") + " IF EXISTS " + qn(rc.old_schema, rc.old_name, db) + ";")
end

# A database type that changed: a rename where the dialect has one, and a TODO for a changed definition, which a type in use
# cannot simply take (PostgreSQL ALTER TYPE ... ADD VALUE, a new domain constraint, a column conversion).
func type_change_statements(db, t, tc, out)
  $d = db.dialect
  if tc.kind == "added"
    # SQL Server compiles a batch before it runs it, so a table in the same batch cannot use a type the batch creates.
    emit(out, own_batch(type_sql(t, db), db))
    ret
  end
  if !t.is_created
    ret
  end
  if tc.old_name != tc.new_name
    if $d == "postgresql"
      $s = "ALTER " + (tc.old_kind == "domain" ? "DOMAIN " : "TYPE ") + qn(tc.old_schema, tc.old_name, db) + " RENAME TO " + q(tc.new_name, db) + ";"
      emit(out, idem() ? pg_do_if("EXISTS (SELECT 1 FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace WHERE t.typname = " + lit(tc.old_name, db) + " AND n.nspname = " + (tc.old_schema ? lit(tc.old_schema, db) : "current_schema()") + ")", $s) : $s)
    else if $d == "sqlserver"
      $s = rename_object(db, schema_prefix(tc.old_schema) + tc.old_name, tc.new_name, "USERDATATYPE")
      emit(out, idem() ? "IF TYPE_ID(" + ms_object(tc.old_schema, tc.old_name, db) + ") IS NOT NULL " + $s : $s)
    end
  end
  if has_change(tc.changes, ["kind", "definition", "schema"])
    emit(out, "-- TODO: database type " + t.name + " changed; change it in place or recreate it and the columns that use it. Now: " + (type_sql(t, db) | string.replace "\n" " "))
  end
end

# DROP DOMAIN or DROP TYPE for a database type that left the model, after the tables stopped using it; nothing where the dialect
# never created it.
func type_drop(db, tc, out)
  $d = db.dialect
  if $d == "postgresql"
    emit(out, "DROP " + (tc.old_kind == "domain" ? "DOMAIN" : "TYPE") + " IF EXISTS " + qn(tc.old_schema, tc.old_name, db) + ";")
  else if $d == "sqlserver" && tc.old_kind == "domain"
    emit(out, "DROP TYPE IF EXISTS " + qn(tc.old_schema, tc.old_name, db) + ";")
  end
end

# The unchanged SQL objects with phase "after" that depend on a view or routine the migration drops and creates again (recreated, by
# id), in dependency order: what was granted on the view or routine, or created on it, went with it, so they run again. A changed
# object runs anyway (object_change_statements). A run-once object does not run again: notes gets a TODO naming it instead.
# Objects with environments are objects.<env>.sql's, which runs after the migration (objects_in_phase leaves them out).
func reapplied_objects(db, diff, recreated, notes)
  $result = []
  for o in objects_in_phase(db, "after")
    if find_change(diff.objects, o.id)
      continue
    end
    for dep in o.depends_on
      if recreated[dep.id]
        if o.apply == "once"
          emit(notes, "-- TODO: run-once SQL object " + o.name + " depends on " + dep.name + ", which this migration drops and creates again, and does not run again where the ledger records it; reapply what it did by hand.")
        else
          $result[$result.size] = o
        end
        break
      end
    end
  end
  ret $result
end

# The statements of the SQL objects of one phase that were added or changed, in dependency order (a changed one was flagged for the
# reviewer, see object_drop_notes): a run-once object inside its ledger guard (object_run_sql), counted in mq_ledger_state.once so
# the migration writes the ledger DDL first. Objects with environments get no statements here (objects_in_phase leaves them out).
func object_change_statements(db, diff, phase, out)
  for o in objects_in_phase(db, phase)
    if find_change(diff.objects, o.id)
      if object_writes_ledger(o, db)
        mq_ledger_state.once = mq_ledger_state.once + 1
      end
      emit(out, own_batch(object_run_sql(o, db), db))
    end
  end
end

# Whether a changed SQL object converged before the change, so no ledger row records it: the definition text of its old snapshot
# holds no apply line ahead of its body (SnapshotCapture writes the line only for once). Without a definition change its apply
# mode did not change.
func object_was_converge(oc)
  for ch in oc.changes
    if ch.property == "definition"
      ret !((ch.old | string.split "\nbody: ")[0] | string.contains "\napply: once")
    end
  end
  ret false
end

# A TODO for every SQL object that changed or left the model: its statements are opaque, so only the reviewer knows how to undo
# them (DROP TRIGGER, REVOKE...). A changed object with environments is applied by objects.<env>.sql, not here, and a changed
# run-once object does not run again where the ledger records it, so each gets its own line; a left-out one (object_left_out) is
# never created. An object that converged before and runs once now has no ledger row, so its guard runs it one more time in every
# database: it gets a TODO instead. A dropped object leaves no model object to tell, so it keeps the plain TODO.
func object_drop_notes(db, diff, out)
  for oc in diff.objects
    if oc.kind == "dropped"
      emit(out, "-- TODO: " + oc.old_kind + " " + oc.old_name + " left the model; drop it by hand.")
    else if oc.kind != "added"
      $o = null
      for x in db.objects
        if x.id == oc.key
          $o = x
          break
        end
      end
      if $o && object_left_out($o, db)
        emit(out, "-- TODO: SQL object " + $o.name + " changed and runs once, which needs the migration ledger; " + db.dialect + " has none, so it is not created. Drop it by hand where it exists.")
      else if $o && ($o.environments.size > 0 || $o.apply == "once")
        if $o.environments.size > 0
          emit(out, "-- TODO: SQL object " + $o.name + " changed and runs in environments " + ($o.environments | array.join ", ") + " (objects.<env>.sql applies it there); drop it by hand where it should no longer run.")
        end
        if $o.apply == "once" && object_was_converge(oc)
          emit(out, "-- TODO: SQL object " + $o.name + " changed to run once and the ledger has no row for it yet, so it runs one more time in every database, also where it exists already; drop it by hand before it runs, or make its statements safe to run again.")
        else if $o.apply == "once"
          emit(out, "-- Run-once SQL object " + $o.name + " changed; it does not run again where the ledger records it.")
        end
      else
        emit(out, "-- TODO: " + oc.old_kind + " " + oc.old_name + " changed; drop it by hand before its new statements below run.")
      end
    end
  end
end

# Migration facts (next-phase-1-design.md section 3.2, sql-ddl). On PostgreSQL migration.scriban fills mq_matched with the listed
# facts (schema_diff.<db>.facts: the complete and released facts the baseline lacks) whose change the diff holds, and mq_held with the
# held facts not released whose change it holds, both by object key (fact_key); elsewhere both stay empty, so every builder writes
# what it always wrote. A listed fact's step takes its change's place and is followed by its migration ledger row (fact_rows); a held
# fact writes a note where its change would go and no row; the other listed facts write their own steps first (fact_steps).

# The object key of a fact, by its object's keys as they read today: "<kind>:<key>", a column "column:<table key>|<column key>"; null
# for a fact without an object.
func fact_key(f)
  $o = f.object
  if !$o
    ret null
  end
  if $o.kind == "column"
    ret "column:" + $o.current_table + "|" + $o.current_key
  end
  ret $o.kind + ":" + $o.current_key
end

# The diff's change of a fact's object when it is the change the fact describes (a rename: a new name or schema; a type change: a new
# type; a backfill: the column made NOT NULL; a drop: dropped), else null.
func fact_change(diff, f)
  $o = f.object
  if !$o
    ret null
  end
  $c = null
  if $o.kind == "schema"
    $c = find_change(diff.schemas, $o.current_key)
  else if $o.kind == "table"
    $c = find_change(diff.tables, $o.current_key)
  else if $o.kind == "view"
    $c = find_change(diff.views, $o.current_key)
  else if $o.kind == "sequence"
    $c = find_change(diff.sequences, $o.current_key)
  else if $o.kind == "column"
    $tc = find_change(diff.tables, $o.current_table)
    if $tc && ($tc.kind == "renamed" || $tc.kind == "altered")
      $c = column_change($tc, $o.current_key)
    end
  end
  if !$c || $c.kind == "added"
    ret null
  end
  if f.fact == "drop"
    ret $c.kind == "dropped" ? $c : null
  end
  if $c.kind == "dropped"
    ret null
  end
  if f.fact == "rename"
    if $c.kind == "renamed"
      ret $c
    end
    if $o.kind == "table"
      ret $c.old_schema != $c.table.schema ? $c : null
    end
    ret ($o.kind == "view" || $o.kind == "sequence") && has_change($c.changes, ["schema"]) ? $c : null
  end
  if $o.kind != "column"
    ret null
  end
  if f.fact == "change-type"
    ret has_change($c.changes, ["type", "subtype", "length", "precision", "scale", "nativeType", "strategy", "referenceTable", "codeType", "collation"]) ? $c : null
  else if f.fact == "backfill"
    ret has_change($c.changes, ["nullable"]) && !$c.column.nullable ? $c : null
  end
  ret null
end

# Adds a fact to the list a map holds under its object key.
func fact_add(by_key, f)
  $k = fact_key(f)
  if !by_key[$k]
    by_key[$k] = []
  end
  $list = by_key[$k]
  $list[$list.size] = f
end

# The fact of a type a map holds for an object key, or null.
func fact_at(by_key, k, type)
  if by_key[k]
    for f in by_key[k]
      if f.fact == type
        ret f
      end
    end
  end
  ret null
end

# Whether a fact has what its step needs in the database's dialect; a fact whose texts lack the dialect's entry (MQ4108: its
# conversion, value, statements or guard, or its data check's query) gets the diff's statements and TODO lines instead, and no row.
# So does a cast between range types PostgreSQL cannot convert (range_using; fact_range_todo says so).
func fact_usable(f)
  if f.data_check != null && f.data_check.query == null && f.data_check.accept == null
    ret false
  end
  if f.fact == "change-type"
    if f.conversion != null && f.conversion.expression == null && f.conversion.cast
      $range = range_using(f.from, f.to, "")
      ret !($range && $range.todo)
    end
    ret f.conversion != null && (f.conversion.cast || f.conversion.expression != null)
  else if f.fact == "backfill"
    ret f.value != null || (f.data_check != null && (f.data_check.query != null || f.data_check.accept != null))
  else if f.fact == "raw"
    ret f.sql != null && f.skip_when != null
  end
  ret true
end

# The TODO line of a cast fact between range types PostgreSQL cannot convert (fact_usable refuses it; what names the column), or ""
# for any other fact: the migration leaves the column as it is and records no row for the fact, and the line says which fact waits
# for a conversion expression.
func fact_range_todo(f, what)
  if f.fact != "change-type" || f.conversion == null || f.conversion.expression != null || !f.conversion.cast
    ret ""
  end
  $range = range_using(f.from, f.to, "")
  if !$range || !$range.todo
    ret ""
  end
  ret "-- TODO: migration fact " + f.id + " (change-type of column " + what + ") casts between range types: the column " + $range.change + "; give the fact a conversion expression. This migration leaves the column as it is and records nothing for the fact."
end

# The ledger row of a fact whose end state the migration reached, once (ledger_fact_row: none for an adopt fact).
func fact_row(f, out)
  if mq_rows_done[f.id]
    ret
  end
  $row = ledger_fact_row(f.database, f)
  if $row != ""
    emit(out, $row)
    mq_rows_done[f.id] = true
    mq_ledger_state.rows = mq_ledger_state.rows + 1
  end
end

# The ledger rows of the listed facts of the given types on an object (fact_key k), written right after the statements of its change.
func fact_rows(k, types, out)
  if !mq_matched[k]
    ret
  end
  for f in mq_matched[k]
    if (array.contains types f.fact) && fact_usable(f)
      fact_row(f, out)
    end
  end
end

# Whether a held fact that is not released writes its note in place of its change in the database's dialect: every one on
# PostgreSQL; elsewhere, where no fact writes a step, a drop or a rename, so the diff never drops or renames what a held fact keeps.
# A schema rename outside PostgreSQL is left out (those dialects create the new schema, move each object and drop the old one), and
# so is a sequence where the dialect has none (its change writes nothing).
func held_waits(db, f)
  if db.dialect == "postgresql"
    ret true
  end
  $kind = f.object ? f.object.kind : ""
  if $kind == "sequence" && (db.dialect == "sqlite" || db.dialect == "mysql")
    ret false
  end
  ret f.fact == "drop" || (f.fact == "rename" && $kind != "schema")
end

# Outside PostgreSQL: a TODO line for each listed held fact (so released) that held_waits holds and whose change the diff does not
# hold: an earlier migration wrote its held note, and no fact writes a step in this dialect, so the reviewer reaches its end state.
func held_release_todos(db, diff, out)
  for f in diff.facts
    if f.held && f.object && held_waits(db, f) && !fact_change(diff, f)
      $o = f.object
      emit(out, "-- TODO: migration fact " + f.id + " (" + f.fact + " of " + $o.kind + " " + ($o.table_name ? $o.table_name + "." : "") + ($o.name ?? $o.key) + ") was released after an earlier migration wrote its held note; " + dialect_title(db) + " has no fact steps, so reach its end state by hand.")
    end
  end
end

# The note a held fact that is not released writes where its change would go: the change waits (a held drop keeps the object), and
# the migration records no row for it.
func held_note(f, what)
  ret "-- Held: migration fact " + f.id + " (" + f.fact + " of " + what + ") waits until it is released; this migration leaves the database as it is there and records nothing for it."
end

# SQL text without its trailing semicolons and spaces, so it can stand inside another statement.
func sql_trimmed(text)
  $s = text | string.rstrip
  while $s | string.ends_with ";"
    $s = string.slice $s 0 ((string.size $s) - 1) | string.rstrip
  end
  ret $s
end

# A fact's SQL text (a query or an expression) with {table} and {column} expanded to the quoted names given.
func fact_sql(text, table, column)
  ret sql_trimmed(text | string.replace "{table}" table | string.replace "{column}" column)
end

# A fact's data check as PL/pgSQL, for a DO block: it raises, stopping the migration, when the query returns a row; "" without a query.
func data_check_plpgsql(f, table, column, db)
  if !f.data_check || !f.data_check.query
    ret ""
  end
  ret "IF EXISTS (" + fact_sql(f.data_check.query, table, column) + ") THEN RAISE EXCEPTION " + lit("migration fact " + f.id + ": the data check found rows the step must not find", db) + "; END IF;"
end

# A fact's data check before its step: a DO block that raises when the query returns a row, a note when the check was accepted
# without a query, a TODO when the query has no PostgreSQL entry.
func data_check_statements(f, table, column, db, out)
  $dc = f.data_check
  if !$dc
    ret
  end
  if $dc.query
    emit(out, "DO $mq$ BEGIN " + data_check_plpgsql(f, table, column, db) + " END $mq$;")
  else if $dc.accept
    emit(out, "-- Migration fact " + f.id + " needs no data check: " + ($dc.accept | string.replace "\n" " "))
  else
    emit(out, "-- TODO: the data check of migration fact " + f.id + " has no PostgreSQL query; check the rows by hand before running this.")
  end
end

# A complete type change: its data check, then ALTER COLUMN ... TYPE ... USING its conversion (a cast to the new type, through
# range_using between range types, or its expression). Guarded (the idempotent parameter, or an own step: an earlier migration may have changed the type already), it runs
# only while the column's type differs from the new one, compared in the catalog with a temporary probe column of the new type, so a
# second run converts nothing.
func change_type_statements(f, table, column, column_name, native, collate, guarded, db, out)
  $cv = f.conversion
  $using = column + "::" + native
  if $cv.expression
    $using = fact_sql($cv.expression, table, column)
  else
    # A cast between range types goes through range_using, as the diff's own retype does (fact_usable refused one it cannot write).
    $range = range_using(f.from, f.to ? { type: f.to.type, native_type: native } : null, column)
    if $range && $range.using
      $using = $range.using
    end
  end
  $alter = "ALTER TABLE " + table + " ALTER COLUMN " + column + " TYPE " + native + collate + " USING " + $using + ";"
  if !guarded || (f.data_check && !f.data_check.query)
    data_check_statements(f, table, column, db, out)
  end
  if !guarded
    emit(out, $alter)
    ret
  end
  $check = data_check_plpgsql(f, table, column, db)
  emit(out, "DO $mq$ BEGIN\nCREATE TEMP TABLE mq_type_probe (probe " + native + ") ON COMMIT DROP;\nIF EXISTS (SELECT 1 FROM pg_attribute a JOIN pg_attribute p ON p.attrelid = 'mq_type_probe'::regclass AND p.attname = 'probe' WHERE a.attrelid = to_regclass(" + lit(table, db) + ") AND a.attname = " + lit(column_name, db) + " AND NOT a.attisdropped AND (a.atttypid, a.atttypmod) IS DISTINCT FROM (p.atttypid, p.atttypmod)) THEN\n" + ($check == "" ? "" : $check + "\n") + $alter + "\nEND IF;\nDROP TABLE mq_type_probe;\nEND $mq$;")
end

# A complete backfill, before SET NOT NULL: UPDATE the rows its where names (by default those where the column IS NULL) to its value,
# then its data check.
func backfill_statements(f, table, column, db, out)
  if f.value
    $where = f.where ? fact_sql(f.where, table, column) : column + " IS NULL"
    emit(out, "UPDATE " + table + " SET " + column + " = " + fact_sql(f.value, table, column) + " WHERE " + $where + ";")
  end
  data_check_statements(f, table, column, db, out)
end

# A raw fact's statements behind its guard (EXECUTE, so any statement may stand there): they run unless its skipWhen query returns a
# row, that is unless its end state holds; then its row.
func raw_step(db, f, out)
  if !fact_usable(f)
    emit(out, "-- TODO: migration fact " + f.id + " (raw) has no PostgreSQL statements or guard; run its step by hand.")
    ret
  end
  emit(out, "-- Migration fact " + f.id + " (raw, phase " + f.phase + "): runs unless its guard finds a row.\nDO $mq$ BEGIN\nIF NOT EXISTS (" + sql_trimmed(f.skip_when) + ") THEN\nEXECUTE $mq_sql$\n" + (f.sql | string.rstrip) + "\n$mq_sql$;\nEND IF;\nEND $mq$;")
  fact_row(f, out)
end

# The objects of a fact, by the names it recorded: "table.column" for a column.
func fact_objects(f)
  $text = ""
  for o in f.objects
    $text = $text + (for.first ? "" : ", ") + (o.table_name ? o.table_name + "." : "") + (o.name ?? o.key)
  end
  ret $text == "" ? "(no objects)" : $text
end

# The TODO line of a fact type this pack writes no step for yet (adopt, baseline, state-map; value-map outside PostgreSQL, see
# value_map_todo); the migration does not reach its end state, so it records no row.
func fact_todo(f)
  if f.fact == "adopt"
    ret "-- TODO: migration fact " + f.id + " adopts " + fact_objects(f) + " (environment " + (f.environment ?? "none") + "); this pack writes no adopt step or object rows yet."
  else if f.fact == "baseline"
    ret "-- TODO: migration fact " + f.id + " is a baseline (the database is at the model's shape as of this fact); this pack writes no baseline step yet."
  end
  $pairs = ""
  for v in f.values
    $pairs = $pairs + (for.first ? "" : ", ") + v.from + " -> " + v.to
  end
  ret "-- TODO: migration fact " + f.id + " replaces stored " + (f.fact == "state-map" ? "states" : "values") + " of " + fact_objects(f) + " (" + $pairs + "); this pack writes no " + f.fact + " step yet: update them by hand."
end

# The schema and name a table has before the migration's statements run (own steps run first): from the diff's change, else the
# model, else as the fact recorded them.
func pre_table(db, diff, key, schema, name)
  $tc = find_change(diff.tables, key)
  if $tc && $tc.kind != "added"
    ret { schema: $tc.old_schema, name: $tc.old_name ?? name }
  end
  for t in db.tables
    if t.key == key
      ret { schema: t.schema, name: t.name }
    end
  end
  ret { schema: schema, name: name }
end

# The model's column a fact names (by its current keys), or null.
func model_column(db, o)
  for t in db.tables
    if t.key == o.current_table
      for c in t.columns
        if c.key == o.current_key
          ret c
        end
      end
    end
  end
  ret null
end

# The name a fact's column has before the migration's statements run: from the diff's change, else the model, else as recorded.
func pre_column_name(diff, o, c)
  $tc = find_change(diff.tables, o.current_table)
  if $tc && ($tc.kind == "renamed" || $tc.kind == "altered")
    $cc = column_change($tc, o.current_key)
    if $cc && $cc.kind != "added" && $cc.old_name
      ret $cc.old_name
    end
  end
  ret c ? c.name : o.name
end

# PostgreSQL: EXISTS test for a column of a table given by schema and name.
func pg_column_exists(t, name, db)
  ret "EXISTS (SELECT 1 FROM information_schema.columns WHERE " + pg_schema(t.schema, db) + " AND table_name = " + lit(t.name, db) + " AND column_name = " + lit(name, db) + ")"
end

# The own step of a listed fact whose change the diff does not hold (a held fact released after an earlier migration wrote its note,
# a fact completed after an earlier migration wrote its TODO), guarded by its end state so it does nothing where an earlier migration
# reached it; then its row. Names are those the objects have before the migration's statements, which run after the own steps.
func own_step(db, diff, f, out)
  $o = f.object
  if !$o
    ret
  end
  if f.fact == "rename"
    $old = f.from.name
    $new = f.to.name
    if $o.kind == "schema"
      emit(out, pg_do_if("EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = " + lit($old, db) + ") AND NOT EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = " + lit($new, db) + ")", "ALTER SCHEMA " + q($old, db) + " RENAME TO " + q($new, db) + ";"))
    else if $o.kind == "column"
      $t = pre_table(db, diff, $o.current_table, $o.schema, $o.table_name)
      emit(out, pg_do_if(pg_column_exists($t, $old, db) + " AND NOT " + pg_column_exists($t, $new, db), "ALTER TABLE " + qn($t.schema, $t.name, db) + " RENAME COLUMN " + q($old, db) + " TO " + q($new, db) + ";"))
    else
      $from = f.from.schema ?? $o.schema
      $to = f.to.schema ?? $o.schema
      if $old != $new
        emit(out, pg_do_if("to_regclass(" + lit(qn($from, $old, db), db) + ") IS NOT NULL AND to_regclass(" + lit(qn($from, $new, db), db) + ") IS NULL", "ALTER TABLE " + qn($from, $old, db) + " RENAME TO " + q($new, db) + ";"))
      end
      if $from != $to && $to
        emit(out, pg_do_if("to_regclass(" + lit(qn($from, $new, db), db) + ") IS NOT NULL AND to_regclass(" + lit(qn($to, $new, db), db) + ") IS NULL", "ALTER TABLE " + qn($from, $new, db) + " SET SCHEMA " + q($to, db) + ";"))
      end
    end
  else if f.fact == "drop"
    if $o.kind == "table"
      $name = $o.name ?? $o.table_name ?? $o.key
      emit(out, data_loss_note($name, null))
      emit(out, "DROP TABLE IF EXISTS " + qn($o.schema, $name, db) + ";")
    else if $o.kind == "column"
      $t = pre_table(db, diff, $o.current_table, $o.schema, $o.table_name)
      emit(out, data_loss_note($t.name, $o.name))
      emit(out, "ALTER TABLE IF EXISTS " + qn($t.schema, $t.name, db) + " DROP COLUMN IF EXISTS " + q($o.name, db) + ";")
    else if $o.kind == "sequence"
      emit(out, "DROP SEQUENCE IF EXISTS " + qn($o.schema, $o.name, db) + ";")
    end
  else
    $t = pre_table(db, diff, $o.current_table, $o.schema, $o.table_name)
    $tq = qn($t.schema, $t.name, db)
    $c = model_column(db, $o)
    $name = pre_column_name(diff, $o, $c)
    if f.fact == "change-type"
      $native = (f.to && f.to.native_type) ? f.to.native_type : ($c ? column_type($c) : null)
      if !$native
        emit(out, "-- TODO: migration fact " + f.id + " changes the type of " + $t.name + "." + $name + ", but its new native type is unknown; change it by hand.")
        ret
      end
      change_type_statements(f, $tq, q($name, db), $name, $native, "", true, db, out)
    else
      backfill_statements(f, $tq, q($name, db), db, out)
      if $c && !$c.nullable
        emit(out, "ALTER TABLE " + $tq + " ALTER COLUMN " + q($name, db) + " SET NOT NULL;")
      end
    end
  end
  fact_row(f, out)
end

# ---------------------------------------------------------------- value maps (next-phase-2-design.md section 3.5)

# The CASE that maps a value map's codes: CASE <expr> WHEN 'a' THEN 'b' ... ELSE <otherwise> END (the ELSE gives the CASE its type);
# otherwise alone when the map has no values (a merge whose codes all match).
func value_map_case(f, expr, otherwise, db)
  if f.values.size == 0
    ret otherwise
  end
  $s = "CASE " + expr
  for v in f.values
    $s = $s + " WHEN " + lit(v.from, db) + " THEN " + lit(v.to, db)
  end
  ret $s + " ELSE " + otherwise + " END"
end

# The codes a value map maps away, as SQL literals separated by commas.
func value_map_froms(f, db)
  $s = ""
  for v in f.values
    $s = $s + (for.first ? "" : ", ") + lit(v.from, db)
  end
  ret $s
end

# What a value map does, in words: "maps PaymentTerm codes net30 -> net-30", "... into PaymentTerm" for a merge ("merges CreditTerm
# into PaymentTerm" when every code matches), or "renames reference type PaymentTerm to PaymentCondition".
func value_map_words(f)
  $from = f.from ? f.from.name : null
  $to = f.to ? f.to.name : null
  if f.values.size == 0 && f.from_reference_type
    ret "merges " + ($from ?? "?") + " into " + ($to ?? "?")
  end
  if f.values.size == 0
    ret "renames reference type " + ($from ?? "?") + " to " + ($to ?? "?")
  end
  $pairs = ""
  for v in f.values
    $pairs = $pairs + (for.first ? "" : ", ") + v.from + " -> " + v.to
  end
  ret "maps " + ($from ?? "") + " codes " + $pairs + ((f.from_reference_type && $to) ? " into " + $to : "")
end

# Outside PostgreSQL: the TODO line of a value map, which this pack writes no step for in the dialect (MQ4056); no row is written.
func value_map_todo(db, f)
  $where = fact_objects(f)
  for x in f.collections
    $where = ($where == "(no objects)" ? "" : $where + ", ") + (x.table_name ? x.table_name + "." : "") + (x.name ?? x.attribute)
  end
  ret "-- TODO: migration fact " + f.id + " " + value_map_words(f) + " in " + $where + "; " + dialect_title(db) + " has no value-map step in this pack: update the stored codes, and rename what is named after the type, by hand."
end

# Outside PostgreSQL: the TODO lines of the value maps the migration lists.
func value_map_todos(db, diff, out)
  for f in diff.facts
    if f.fact == "value-map"
      emit(out, value_map_todo(db, f))
    end
  end
end

# Whether a value map the migration lists holds a column (by its current keys): its step maps the column's codes and reconciles its
# strategy objects, so the column step leaves the column's reference type change to it.
func value_map_covers(table_key, column_key)
  for f in diff.facts
    if f.fact == "value-map"
      for o in f.objects
        if o.current_table == table_key && o.current_key == column_key
          ret true
        end
      end
    end
  end
  ret false
end

# A value map's type rename (names that differ, no merge): the lookup table named after the type's plural name, or the enum type named
# after its name, is renamed to the current name while only the old one exists. A tableName option keeps the lookup table's name.
func value_map_rename_type(db, f, rt, out)
  if f.from_reference_type || !f.from || !f.to
    ret
  end
  $r = type_realization(rt, db)
  if $r == "lookup-table" && !storage_option(rt, db, "tableName")
    $old = snake (f.from.plural_name ?? (pluralize f.from.name))
    $new = lookup_name(rt, db)
    $schema = lookup_schema(rt, db)
    if $old != $new
      emit(out, "DO $mq$ BEGIN IF to_regclass(" + lit(qn($schema, $old, db), db) + ") IS NOT NULL AND to_regclass(" + lit(qn($schema, $new, db), db) + ") IS NULL THEN ALTER TABLE " + qn($schema, $old, db) + " RENAME TO " + q($new, db) + "; END IF; END $mq$;")
    end
  else if $r == "native"
    $old = (snake f.from.name) + "_t"
    $new = native_type_name(rt)
    if $old != $new
      emit(out, "DO $mq$ BEGIN IF " + pg_enum_type($old, db) + " IS NOT NULL AND " + pg_enum_type($new, db) + " IS NULL THEN ALTER TYPE " + q($old, db) + " RENAME TO " + q($new, db) + "; END IF; END $mq$;")
    end
  end
end

# The realization a holder column had before the migration: its strategy or bound table as the diff's change of it says they were,
# else the one it has now (after). A projected column only is stored as the enum type.
func value_map_before(diff, o, c, after)
  $tc = find_change(diff.tables, o.current_table)
  $cc = $tc ? column_change($tc, o.current_key) : null
  if !$cc || !c.reference_type
    ret after
  end
  $changed = false
  $strategy = null
  for ch in $cc.changes
    if ch.property == "referenceTable" && ch.old
      ret "table"
    end
    if ch.property == "strategy"
      $changed = true
      $strategy = ch.old
    end
  end
  if !$changed
    ret after
  end
  $r = ref_realization($strategy)
  ret ($r == "native" && c.type != "reference") ? "check" : $r
end

# The PL/pgSQL that stops the migration, naming the codes, when a mapped value the query yields (column m of the rows of from) is not
# a label of an enum type: PostgreSQL cannot use an enum value in the transaction that adds it.
func value_map_enum_guard(f, enum, from, db)
  $message = "migration fact " + f.id + ": the enum type " + enum + " has no value for the codes %; add them in an earlier migration (PostgreSQL cannot use an enum value in the transaction that adds it)"
  ret "SELECT string_agg(DISTINCT v.m, ', ' ORDER BY v.m) INTO missing FROM (" + from + ") AS v WHERE v.m IS NOT NULL AND NOT " + pg_enum_has(enum, "v.m", db) + ";\nIF missing IS NOT NULL THEN RAISE EXCEPTION " + lit($message, db) + ", missing; END IF;"
end

# One column of a value map, named as the database knows it before the migration's statements: its strategy objects dropped by name,
# its stored codes mapped, then its objects created again for the type that holds the codes now. A column of an enum type is mapped
# through text: in place while it keeps the enum type, else retyped (a merge's other enum type, or a type that is no enum).
func value_map_column(db, diff, f, rt, o, out)
  $c = model_column(db, o)
  $t = pre_table(db, diff, o.current_table, o.schema, o.table_name)
  $name = pre_column_name(diff, o, $c)
  if !$c
    emit(out, "-- " + $t.name + "." + $name + " leaves the model in this migration, so its codes are not mapped.")
    ret
  end
  $pt = { name: $t.name, schema: $t.schema, database: db }
  $tq = qt($pt)
  $col = q($name, db)
  $crt = $c.reference_type
  $objects = $crt && !($c.type_ref && $c.is_foreign_key)
  $after = $crt ? column_realization($c, db) : null
  $before = value_map_before(diff, o, $c, $after)
  $enum_before = $before == "native" ? (f.from_reference_type ? (snake f.from.name) + "_t" : native_type_name(rt)) : null
  $enum_after = $after == "native" ? native_type_name($crt) : null
  $froms = value_map_froms(f, db)
  if $objects
    emit(out, column_objects_drop_sql($pt, $name, db))
  end
  if $enum_before && $enum_before != $enum_after
    # Retyped through text: a USING expression cannot hold a subquery, so the guard reads the mapped values first.
    $type = $enum_after ? q($enum_after, db) : column_type($c)
    $mapped = value_map_case(f, $col + "::text", $col + "::text", db)
    $s = "DO $mq$ DECLARE missing text; BEGIN\nIF EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid = to_regclass(" + lit($tq, db) + ") AND attname = " + lit($name, db) + " AND atttypid = " + pg_enum_type($enum_before, db) + ") THEN\n"
    if $enum_after
      $s = $s + value_map_enum_guard(f, $enum_after, "SELECT " + $mapped + " AS m FROM " + $tq, db) + "\n"
    end
    $s = $s + "ALTER TABLE " + $tq + " ALTER COLUMN " + $col + " DROP DEFAULT;\nALTER TABLE " + $tq + " ALTER COLUMN " + $col + " TYPE " + $type + " USING (" + $mapped + ")::" + $type + ";\n"
    $default = default_sql($c, db)
    if $default != ""
      $s = $s + "ALTER TABLE " + $tq + " ALTER COLUMN " + $col + " SET DEFAULT " + $default + ";\n"
    end
    emit(out, $s + "END IF;\nEND $mq$;")
  else if f.values.size == 0
    # A merge whose codes all match: the stored codes stay as they are.
  else if $enum_before
    $enum = q($enum_before, db)
    $mapped = value_map_case(f, $col + "::text", $col + "::text", db)
    emit(out, "DO $mq$ DECLARE missing text; BEGIN\n" + value_map_enum_guard(f, $enum_before, "SELECT " + $mapped + " AS m FROM " + $tq + " WHERE " + $col + "::text IN (" + $froms + ")", db) + "\nUPDATE " + $tq + " SET " + $col + " = (" + $mapped + ")::" + $enum + " WHERE " + $col + "::text IN (" + $froms + ");\nEND $mq$;")
  else
    emit(out, "UPDATE " + $tq + " SET " + $col + " = " + value_map_case(f, $col, $col, db) + " WHERE " + $col + " IN (" + $froms + ");")
  end
  if $objects
    $add = column_objects_add_sql($pt, $name, $crt, db, $after)
    if $add != ""
      emit(out, $add)
    end
  end
end

# One collection of a value map, its owner table named as the database knows it before the migration's statements. A junction table
# (lookup-table, check) drops the rows the map would make twice for one owner, then maps its code column between a drop and a
# reconcile of its strategy objects; an array of the enum type ("native") keeps the first position of each mapped code, retyped
# through text when a merge moves it to another enum type. Each runs only where seed.sql created the junction table or the column.
func value_map_collection(db, diff, f, rt, x, out)
  $found = null
  for y in ref_collections(db)
    if y[0].key == x.current_table && y[1].id == x.attribute
      $found = y
      break
    end
  end
  $t = pre_table(db, diff, x.current_table, x.schema, x.table_name)
  if !$found
    emit(out, "-- The collection " + $t.name + "." + (x.name ?? x.attribute) + " leaves the model in this migration, so its codes are not mapped.")
    ret
  end
  $a = $found[1]
  $crt = $a.type.reference_type
  $pt = { name: $t.name, schema: $t.schema, database: db }
  $tq = qt($pt)
  $froms = value_map_froms(f, db)
  if type_realization($crt, db) == "native"
    $name = snake $a.name
    $col = q($name, db)
    $enum_before = f.from_reference_type ? (snake f.from.name) + "_t" : native_type_name(rt)
    $enum_after = native_type_name($crt)
    $mapped = value_map_case(f, "u.x::text", "u.x::text", db)
    if $enum_before == $enum_after
      if f.values.size == 0
        ret
      end
      $enum = q($enum_after, db)
      $kept = "ARRAY(SELECT (k.m)::" + $enum + " FROM (SELECT " + $mapped + " AS m, min(u.o) AS o FROM unnest(" + $col + ") WITH ORDINALITY AS u(x, o) GROUP BY 1) AS k ORDER BY k.o)"
      emit(out, "DO $mq$ DECLARE missing text; BEGIN\nIF " + pg_column_exists($t, $name, db) + " THEN\n" + value_map_enum_guard(f, $enum_after, "SELECT " + $mapped + " AS m FROM " + $tq + ", unnest(" + $col + ") AS u(x) WHERE u.x::text IN (" + $froms + ")", db) + "\nUPDATE " + $tq + " SET " + $col + " = " + $kept + " WHERE " + $col + "::text[] && ARRAY[" + $froms + "]::text[];\nEND IF;\nEND $mq$;")
    else
      $enum = q($enum_after, db)
      $kept = "ARRAY(SELECT k.m FROM (SELECT " + value_map_case(f, "u.x", "u.x", db) + " AS m, min(u.o) AS o FROM unnest(" + $col + ") WITH ORDINALITY AS u(x, o) GROUP BY 1) AS k ORDER BY k.o)"
      $s = "DO $mq$ DECLARE missing text; BEGIN\nIF EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid = to_regclass(" + lit($tq, db) + ") AND attname = " + lit($name, db) + " AND atttypid = to_regtype(" + lit(q($enum_before, db) + "[]", db) + ")) THEN\n"
      $s = $s + value_map_enum_guard(f, $enum_after, "SELECT " + $mapped + " AS m FROM " + $tq + ", unnest(" + $col + ") AS u(x)", db) + "\n"
      $s = $s + "ALTER TABLE " + $tq + " ALTER COLUMN " + $col + " DROP DEFAULT;\nALTER TABLE " + $tq + " ALTER COLUMN " + $col + " TYPE text[] USING " + $col + "::text[];\n"
      if f.values.size > 0
        $s = $s + "UPDATE " + $tq + " SET " + $col + " = " + $kept + " WHERE " + $col + " && ARRAY[" + $froms + "]::text[];\n"
      end
      $s = $s + "ALTER TABLE " + $tq + " ALTER COLUMN " + $col + " TYPE " + $enum + "[] USING " + $col + "::" + $enum + "[];\nALTER TABLE " + $tq + " ALTER COLUMN " + $col + " SET DEFAULT '{}';\nEND IF;\nEND $mq$;"
      emit(out, $s)
    end
    ret
  end
  $jt = { name: junction_name($pt, $a), schema: $t.schema, database: db }
  $jq = qt($jt)
  $code = q(junction_code_column($a), db)
  $same = ""
  for pk in $found[0].primary_key.columns
    $owner = q(junction_owner_column($found[2], pk), db)
    $same = $same + "k." + $owner + " = d." + $owner + " AND "
  end
  $s = "DO $mq$ BEGIN\nIF to_regclass(" + lit($jq, db) + ") IS NOT NULL THEN\n" + column_objects_drop_sql($jt, junction_code_column($a), db) + "\n"
  if f.values.size > 0
    $s = $s + "DELETE FROM " + $jq + " AS d WHERE d." + $code + " IN (" + $froms + ") AND EXISTS (SELECT 1 FROM " + $jq + " AS k WHERE " + $same + "k." + $code + " <> d." + $code + " AND " + value_map_case(f, "k." + $code, "k." + $code, db) + " = " + value_map_case(f, "d." + $code, "d." + $code, db) + " AND (k." + $code + " NOT IN (" + $froms + ") OR k." + $code + " < d." + $code + "));\n"
    $s = $s + "UPDATE " + $jq + " SET " + $code + " = " + value_map_case(f, $code, $code, db) + " WHERE " + $code + " IN (" + $froms + ");\n"
  end
  $add = column_objects_add_sql($jt, junction_code_column($a), $crt, db, type_realization($crt, db))
  emit(out, $s + ($add == "" ? "" : $add + "\n") + "END IF;\nEND $mq$;")
end

# A value-map fact's data step on PostgreSQL (next-phase-2-design.md section 3.5), in the fact's applied order before the schema
# statements and the native type prelude: a type rename renames the lookup table or enum type named after the type; with codes to map,
# the rows of the type that holds them are made to exist (ref_rows_exist_sql), each code of an enum type that was not merged is
# renamed in place where it is a label and its replacement is not, and each holder column and collection has its stored codes mapped;
# then the fact's row. Every part can run twice. A value map whose type the model no longer has is a TODO line.
func value_map_step(db, diff, f, out)
  $rt = reference_type_by_id(f.reference_type)
  if !$rt
    emit(out, "-- TODO: migration fact " + f.id + " " + value_map_words(f) + ", a reference type the model no longer has; update the stored codes by hand.")
    ret
  end
  emit(out, "-- Migration fact " + f.id + " (value-map): " + value_map_words(f) + ".")
  value_map_rename_type(db, f, $rt, out)
  if (f.values.size > 0 || f.from_reference_type) && (f.objects.size > 0 || f.collections.size > 0)
    $rows = ref_rows_exist_sql($rt, db)
    if $rows != ""
      emit(out, $rows)
    end
    if type_realization($rt, db) == "native" && !f.from_reference_type && f.values.size > 0
      $enum = native_type_name($rt)
      $s = "DO $mq$ BEGIN"
      for v in f.values
        $s = $s + "\nIF " + pg_enum_has($enum, lit(v.from, db), db) + " AND NOT " + pg_enum_has($enum, lit(v.to, db), db) + " THEN ALTER TYPE " + q($enum, db) + " RENAME VALUE " + lit(v.from, db) + " TO " + lit(v.to, db) + "; END IF;"
      end
      emit(out, $s + "\nEND $mq$;")
    end
    for o in f.objects
      if o.kind == "column"
        value_map_column(db, diff, f, $rt, o, out)
      end
    end
    for x in f.collections
      value_map_collection(db, diff, f, $rt, x, out)
    end
  end
  fact_row(f, out)
end

# The fact steps no change of the diff carries, on PostgreSQL, in applied order: raw steps (phase before into out, after into after),
# the rows of rekey facts (a rekey writes no DDL; ledger_rekey_rows moves the object rows of the SQL objects it lists), the data steps
# of value maps (value_map_step), TODO lines for the fact types this pack writes no step for, and the own steps of listed facts whose
# change the diff does not hold. A
# migration from nothing builds the database at the model's shape, so it writes only the raw steps, and after them one row per fact
# a build reaches (ledger_build_facts, as schema.sql writes them).
func fact_steps(db, diff, out, after)
  for f in diff.facts
    if f.fact == "raw"
      raw_step(db, f, f.phase == "before" ? out : after)
    else if mq_from_nothing
      continue
    else if f.fact == "rekey"
      $moves = ledger_rekey_rows(db, f)
      if $moves != ""
        emit(out, $moves)
      end
      fact_row(f, out)
    else if f.fact == "value-map"
      value_map_step(db, diff, f, out)
    else if f.fact == "adopt" || f.fact == "baseline" || f.fact == "state-map"
      emit(out, fact_todo(f))
    else if !fact_change(diff, f)
      if fact_usable(f)
        own_step(db, diff, f, out)
      else
        $note = f.object ? fact_range_todo(f, (f.object.table_name ? f.object.table_name + "." : "") + (f.object.name ?? f.object.key)) : ""
        emit(out, $note != "" ? $note : "-- TODO: migration fact " + f.id + " (" + f.fact + ") has no PostgreSQL text for its step; reach its end state by hand.")
      end
    end
  end
  if mq_from_nothing
    for f in ledger_build_facts(db)
      fact_row(f, after)
    end
  end
end
-}}
