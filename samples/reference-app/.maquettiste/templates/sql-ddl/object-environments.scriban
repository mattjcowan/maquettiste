{{-
# One SQL object script per environment the environments parameter names (next-phase-1-design.md section 3.4): the SQL objects whose
# environments include it, those with phase "before" first, each phase in dependency order, a run-once object inside its ledger
# guard after the ledger DDL. It runs on every deploy, after schema.sql or the migrations and before the seed scripts, so every
# statement in it must be safe to run again (CREATE OR REPLACE, IF NOT EXISTS, or DROP ... IF EXISTS first); no SQL is parsed. No
# file for an environment none of the database's SQL objects names. A run-once object outside PostgreSQL is left out (MQ4056).
include "_sql.scriban"
include "_objects.scriban"
include "_ledger.scriban"
db = database
go = db.dialect == "sqlserver" ? "\nGO" : ""
for env in pack.params.environments
  env_objects = []
  for phase in ["before", "after"]
    phase_objects = []
    for o in db.objects
      if o.phase == phase && (array.contains o.environments env) && !object_left_out(o, db)
        phase_objects[phase_objects.size] = o
      end
    end
    ordered = in_dependency_order(phase_objects)
    env_objects = env_objects | array.concat ordered
  end
  if env_objects.size == 0
    continue
  end
  ledger = false
  for o in env_objects
    if object_writes_ledger(o, db)
      ledger = true
    end
  end
  capture content
-}}
-- Generated by Maquettiste (sql-ddl/object-environments). Do not edit; changes are overwritten.
-- SQL objects of database {{ db.name }} ({{ dialect_title(db) }}) for the {{ env }} environment.
-- Run it after schema.sql or the migrations on every deploy; it can run again, so every statement in it must be safe to run again.
{{- if ledger }}

{{ ledger_prelude(db) }}
{{- end }}
{{- for o in env_objects }}

{{ object_run_sql(o, db) }}{{ go }}
{{- end }}
{{ end -}}
{{- file ((kebab db.name) + "/objects." + (kebab env) + ".sql") content -}}
{{- end -}}
