{{-
# The generated statechart interpreter (phase-3-design.md section 4.1): one runtime for every process of the model. It holds
# no model data: each process's <P>Definition.cs gives it a ChartDefinition, and its <P>Handlers class gives it the guards and
# actions. The companion ProcessHost.cs (unit interpreter-companion, written once) implements the extension points (clock, timer
# scheduler, invoke host). Both are written only when the model has processes. When an actor is a member of another, the actor
# checks for events, human tasks, signers and required actors go through the generated Actors.Allows and Actors.Accepts. When an
# actor is taken from the object, the interpreter accepts it only when the process's Handlers, as an IActorResolver, says the
# caller is that actor for the instance (actors-design.md decision 27); without a resolver it refuses.
include "_csharp.scriban"
if model.processes.size > 0
# Whether any actor is a member of another (actors-design.md decision 25): only then do actor checks follow membership.
has_members = false
for a in model.actors
  if a.member_of.size > 0
    has_members = true
  end
end
actors_type = "global::" + base_ns + ".Processes.Actors"
# The actors taken from the object (actors-design.md decision 27), by name: only with them does the interpreter ask a resolver.
relative_names = []
for a in model.actors
  if a.relative
    relative_names[relative_names.size] = a.name
  end
end
has_relative = relative_names.size > 0
# Whether the project uses rights (rights-design.md decision 28): only then are the rights checks, Refusals.Right and Default, and
# RefusedBy written. model.rights_lifecycles keys only on the rights naming key.
rights = model.rights_lifecycles.size > 0
rights_ns = "global::" + base_ns + ".Processes"
# Whether the project uses freezing (rights-design.md decision 28): an event, a transition or a right names freeze or thaw, or a right
# has whileFrozen. Only then are the frozen check of events, its frozen state and Refusals.Frozen written. model.freezing keys only on
# the freezing naming key, so no other edit renders the interpreter again.
freezing = model.freezing.used
# Whether the project uses trigger points (trigger-points-design.md decision 29): only then are the trigger points' rows of selection,
# Refusals.Check, CheckWarnings, TriggerPoints and AfterCommit written. model.trigger_lifecycles keys only on the trigger points naming key.
triggers = model.trigger_lifecycles.size > 0 || model.trigger_points.size > 0
# Whether a named trigger point exists (decisions 33 and 34): only then does the chart take the named points that cover its subject, which
# run before every lifecycle's at each moment.
named = model.trigger_points.size > 0
# Whether a lifecycle uses an approval (signoff-design.md decision 29): only then are SignatureResponse, the envelope's Response and
# Signature, the gates' stages and signatures, the snapshot's Approvals and Acts, the new refusals and outcomes, and the interpreter's
# approvals written. model.approval_lifecycles keys only on the approvals naming key.
approvals = model.approval_lifecycles.size > 0
# Whether refusals name what refused (decision 28): in a project that uses rights or trigger points. With rights the ids come from the
# rights' table, else from the chart's own.
refusals = rights || triggers
ids = rights ? "Rights?.Id" : "Id"
verb_type = "global::" + base_ns + ".Verb"
verb_keys = {}
object_verbs = []
for v in model.verbs
  verb_keys[v.key] = true
  if v.group == "object" || v.group == "link" || v.group == "project"
    object_verbs[object_verbs.size] = verb_type + "." + (pascal v.key)
  end
end
# The check that an acting actor taken from the object is the caller, appended to each actor check.
func resolves(snapshot, actor, envelope)
  ret has_relative ? (" || !Resolves(" + snapshot + ", " + actor + ", " + envelope + ")") : ""
end
-}}
{{- capture content -}}
{{ header() }}
using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;

namespace {{ base_ns }}.Runtime;

/// <summary>The type of a state.</summary>
public enum StateKind
{
    /// <summary>A state without children.</summary>
    Atomic,

    /// <summary>A state with one active child.</summary>
    Compound,

    /// <summary>A state whose children (regions) are all active.</summary>
    Parallel,

    /// <summary>A final state: entering it completes its parent.</summary>
    Final,

    /// <summary>A pseudo-state that restores its parent's last configuration.</summary>
    History,

    /// <summary>A pseudo-state left at once by the first eventless transition whose guard holds.</summary>
    Choice,
}

/// <summary>What fires a transition.</summary>
public enum TriggerKind
{
    /// <summary>An event of the process.</summary>
    Event,

    /// <summary>A delay after the source was entered.</summary>
    After,

    /// <summary>The source reached its final configuration.</summary>
    Done,

    /// <summary>Eventless: checked after every microstep.</summary>
    Always,

    /// <summary>An invoke of the source completed.</summary>
    InvokeDone,

    /// <summary>An invoke of the source failed.</summary>
    InvokeError,
}

/// <summary>What a state starts on entry.</summary>
public enum InvokeKind
{
    /// <summary>Another process, run by the host.</summary>
    Process,

    /// <summary>A service task: generated code calls a service, which reports done or error.</summary>
    Service,

    /// <summary>A human task: one of its actors reports done or error.</summary>
    HumanTask,
}

/// <summary>The outcome an audit record reports for a gate.</summary>
public enum GateOutcome
{
    /// <summary>A signature was added.</summary>
    Signed,

    /// <summary>The signature completed the gate and its transition fired.</summary>
    Completed,

    /// <summary>An attempt the gate did not count.</summary>
    Refused,

    /// <summary>The signatures were discarded because the source state was exited.</summary>
    Discarded,
{{- if approvals }}

    /// <summary>A rejection vetoed the approval: its signatures were cleared and nothing moved (signoff-design.md decision 10).</summary>
    Rejected,

    /// <summary>A person abstained on a named signature: they are finished on it and its count is unchanged.</summary>
    Ignored,

    /// <summary>A person took back their latest signature on a named signature.</summary>
    Withdrawn,
{{- end }}
}
{{- if approvals }}

/// <summary>What a signer answers an approval (signoff-design.md decision 9): the occurrence's verb is the response.</summary>
public enum SignatureResponse
{
    /// <summary>Give a signature (the default).</summary>
    Sign,

    /// <summary>Veto the approval: its signatures are cleared and nothing moves.</summary>
    Reject,

    /// <summary>Abstain: the person is finished on the signature and its count is unchanged.</summary>
    Ignore,

    /// <summary>Take back the person's latest signature.</summary>
    Withdraw,
}
{{- end }}

/// <summary>Why an input was refused (the texts the model's simulation reports).</summary>
public static class Refusals
{
    /// <summary>No transition takes the input.</summary>
    public const string NoTransition = "no-transition";

    /// <summary>Every candidate transition's guard was false.</summary>
    public const string Guard = "guard";

    /// <summary>The input's actor may not raise it.</summary>
    public const string Actor = "actor";

    /// <summary>The actor may not sign the gate, or no signer was given.</summary>
    public const string GateSigner = "gate-signer";

    /// <summary>The signer already signed the gate.</summary>
    public const string GateRepeat = "gate-repeat";

    /// <summary>The gate requires a reason.</summary>
    public const string GateReason = "gate-reason";
{{- if approvals }}

    /// <summary>The person did a verb or move the signature's notBy names since the object entered the move's source state (signoff-design.md decision 15).</summary>
    public const string GateExcluded = "gate-excluded";

    /// <summary>The person has no signature to withdraw.</summary>
    public const string GateNotSigned = "gate-not-signed";
{{- end }}
{{- if rights }}

    /// <summary>A right denies the verb (rights-design.md decision 12).</summary>
    public const string Right = "right";

    /// <summary>No right allows the verb and a lifecycle denies by default.</summary>
    public const string Default = "default";
{{- end }}
{{- if freezing }}

    /// <summary>The object, or the link, is frozen and the verb is modify, connect, disconnect or delete (rights-design.md decision 17): the first check, which no allow lifts.</summary>
    public const string Frozen = "frozen";
{{- end }}
{{- if triggers }}

    /// <summary>A trigger point's check refuses the change (trigger-points-design.md decision 6); it works as a false guard while a move is picked.</summary>
    public const string Check = "check";
{{- end }}

    /// <summary>The command's payload is not valid (dispatch).</summary>
    public const string Validation = "validation";

    /// <summary>No instance has the command's identity, or one already has (dispatch).</summary>
    public const string Instance = "instance";
}

/// <summary>A state of a chart. Index 0 is the implicit root, the process itself.</summary>
/// <param name="id">The model id (the process id for the root).</param>
/// <param name="name">The state name.</param>
/// <param name="kind">The state type.</param>
/// <param name="parent">The parent's index; -1 for the root.</param>
/// <param name="initial">The declared initial child's index, or -1 for the first child.</param>
/// <param name="deepHistory">Whether a history state records the deep configuration.</param>
/// <param name="defaultTarget">A history state's default target, or -1 for its parent's initial child.</param>
/// <param name="entry">Actions run on entry.</param>
/// <param name="exit">Actions run on exit.</param>
public sealed class StateDefinition(string id, string name, StateKind kind, int parent, int initial = -1, bool deepHistory = false, int defaultTarget = -1,
    string[]? entry = null, string[]? exit = null)
{
    private readonly List<StateDefinition> _children = [];
    private readonly List<TransitionDefinition> _transitions = [];
    private readonly List<TransitionDefinition> _timers = [];
    private readonly List<InvokeDefinition> _invokes = [];

    /// <summary>The model id.</summary>
    public string Id { get; } = id;

    /// <summary>The state name.</summary>
    public string Name { get; } = name;

    /// <summary>The state type.</summary>
    public StateKind Kind { get; } = kind;

    /// <summary>The parent's index; -1 for the root.</summary>
    public int ParentIndex { get; } = parent;

    /// <summary>Actions run on entry, in order.</summary>
    public IReadOnlyList<string> Entry { get; } = entry ?? [];

    /// <summary>Actions run on exit, in order.</summary>
    public IReadOnlyList<string> Exit { get; } = exit ?? [];

    /// <summary>Whether a history state is deep.</summary>
    public bool DeepHistory { get; } = deepHistory;

    /// <summary>The position in document order (0 for the root).</summary>
    public int Index { get; internal set; }

    /// <summary>The dotted path from the root ("" for the root).</summary>
    public string Path { get; internal set; } = "";

    /// <summary>The parent state; null for the root.</summary>
    public StateDefinition? Parent { get; internal set; }

    /// <summary>The children in document order.</summary>
    public IReadOnlyList<StateDefinition> Children => _children;

    /// <summary>The initial child of a compound state or of the root.</summary>
    public StateDefinition? Initial { get; internal set; }

    /// <summary>A history state's default target.</summary>
    public StateDefinition? DefaultTarget { get; internal set; }

    /// <summary>The outgoing transitions in priority order.</summary>
    public IReadOnlyList<TransitionDefinition> Transitions => _transitions;

    /// <summary>The delayed transitions whose timers start on entry.</summary>
    public IReadOnlyList<TransitionDefinition> Timers => _timers;

    /// <summary>The invokes started on entry.</summary>
    public IReadOnlyList<InvokeDefinition> Invokes => _invokes;

    /// <summary>Whether this is the root.</summary>
    public bool IsRoot => Parent is null;

    /// <summary>Whether the state is an active leaf when active (no children, not history).</summary>
    public bool IsLeaf => _children.Count == 0 && Kind != StateKind.History;

    internal int InitialIndex { get; } = initial;

    internal int DefaultTargetIndex { get; } = defaultTarget;

    /// <summary>Whether <paramref name="ancestor"/> is a proper ancestor of this state.</summary>
    /// <param name="ancestor">The candidate ancestor.</param>
    /// <returns>True when it is.</returns>
    public bool IsDescendantOf(StateDefinition ancestor)
    {
        for (var p = Parent; p is not null; p = p.Parent)
        {
            if (ReferenceEquals(p, ancestor))
                return true;
        }

        return false;
    }

    /// <summary>The proper ancestors, nearest first, ending with the root.</summary>
    /// <returns>The ancestors.</returns>
    public IEnumerable<StateDefinition> Ancestors()
    {
        for (var p = Parent; p is not null; p = p.Parent)
            yield return p;
    }

    internal void AddChild(StateDefinition child) => _children.Add(child);

    internal void AddTransition(TransitionDefinition t)
    {
        _transitions.Add(t);
        if (t.Trigger == TriggerKind.After && t.AfterTicks is not null)
            _timers.Add(t);
    }

    internal void AddInvoke(InvokeDefinition invoke) => _invokes.Add(invoke);

    /// <inheritdoc/>
    public override string ToString() => Path;
}

/// <summary>A transition of a chart, in priority order.</summary>
/// <param name="id">The model id.</param>
/// <param name="source">The source state's index.</param>
/// <param name="trigger">The trigger.</param>
/// <param name="key">The event name, the invoke name, or "".</param>
/// <param name="targets">The target states' indexes (empty: targetless).</param>
/// <param name="guard">The guard name, or null.</param>
/// <param name="actions">The actions, in order.</param>
/// <param name="afterTicks">The delay of an after transition, in ticks of 100 ns.</param>
/// <param name="external">Whether the source is exited and entered again when a target is its descendant.</param>
/// <param name="gate">The gate's index, or -1.</param>
/// <param name="guardMissing">Whether the transition names a guard the process does not declare: it never holds, as in the engine.</param>
{{- if model.verbs.size > 0 }}
/// <param name="verb">The verb of an automatic move, or null; a move on an event has its event's.</param>
public sealed class TransitionDefinition(string id, int source, TriggerKind trigger, string key, int[] targets, string? guard = null, string[]? actions = null,
    long? afterTicks = null, bool external = false, int gate = -1, bool guardMissing = false, Verb? verb = null)
{
    /// <summary>The verb of an automatic move, or null; a move on an event has its event's.</summary>
    public Verb? Verb { get; } = verb;
{{ else }}
public sealed class TransitionDefinition(string id, int source, TriggerKind trigger, string key, int[] targets, string? guard = null, string[]? actions = null,
    long? afterTicks = null, bool external = false, int gate = -1, bool guardMissing = false)
{
{{- end }}
    /// <summary>The model id.</summary>
    public string Id { get; } = id;

    /// <summary>The trigger.</summary>
    public TriggerKind Trigger { get; } = trigger;

    /// <summary>The event name, the invoke name, or "".</summary>
    public string Key { get; } = key;

    /// <summary>The guard name, or null.</summary>
    public string? Guard { get; } = guard;

    /// <summary>The actions, in order.</summary>
    public IReadOnlyList<string> Actions { get; } = actions ?? [];

    /// <summary>The delay in ticks of 100 ns.</summary>
    public long? AfterTicks { get; } = afterTicks;

    /// <summary>Whether the transition names a guard the process does not declare (it never holds).</summary>
    public bool GuardMissing { get; } = guardMissing;

    /// <summary>Whether the transition is external.</summary>
    public bool External { get; } = external;

    /// <summary>The position in priority order.</summary>
    public int Index { get; internal set; }

    /// <summary>The source state.</summary>
    public StateDefinition Source { get; internal set; } = null!;

    /// <summary>The target states.</summary>
    public IReadOnlyList<StateDefinition> Targets { get; internal set; } = [];

    /// <summary>The gate, or null.</summary>
    public GateDefinition? Gate { get; internal set; }

    internal int SourceIndex { get; } = source;

    internal int[] TargetIndexes { get; } = targets;

    internal int GateIndex { get; } = gate;
}

/// <summary>An event of a process.</summary>
/// <param name="Name">The event name.</param>
/// <param name="Actors">The actors that may raise it; empty means any.</param>
{{- if model.verbs.size > 0 }}
/// <param name="Verb">The verb the event names, or null.</param>
public sealed record EventDefinition(string Name, IReadOnlyList<string> Actors, Verb? Verb = null);
{{- else }}
public sealed record EventDefinition(string Name, IReadOnlyList<string> Actors);
{{- end }}

/// <summary>An action of a process.</summary>
/// <param name="Name">The action name.</param>
/// <param name="Raises">The events queued after it runs.</param>
public sealed record ActionDefinition(string Name, IReadOnlyList<string> Raises);

/// <summary>An invoke of a state.</summary>
/// <param name="Name">The invoke name.</param>
/// <param name="Kind">What it starts.</param>
/// <param name="State">The state's index.</param>
/// <param name="Actors">Who may complete a human task.</param>
/// <param name="Process">The invoked process's name, for a process invoke.</param>
public sealed record InvokeDefinition(string Name, InvokeKind Kind, int State, IReadOnlyList<string> Actors, string? Process = null);

/// <summary>A signature gate on a transition.</summary>
/// <param name="Id">The model id.</param>
/// <param name="Name">The gate name.</param>
/// <param name="Required">The signatures needed.</param>
/// <param name="Signers">The actors that may sign.</param>
/// <param name="RequiredActors">The actors each of which must sign at least once.</param>
/// <param name="AllowRepeatSigner">Whether one signer may count twice.</param>
/// <param name="ReasonRequired">Whether every signature needs a reason.</param>
/// <param name="Meanings">The names of what a signature means.</param>
/// <param name="MeaningIds">The meanings' ids, in the order of <paramref name="Meanings"/>.</param>
public sealed record GateDefinition(string Id, string Name, int Required, IReadOnlyList<string> Signers, IReadOnlyList<string> RequiredActors, bool AllowRepeatSigner,
    bool ReasonRequired, IReadOnlyList<string> Meanings, IReadOnlyList<string> MeaningIds)
{
    /// <summary>The id of a meaning named by a signature (audit records hold ids, as the engine's do); the name when it is not one.</summary>
    /// <param name="meaning">The meaning's name, or null.</param>
    /// <returns>The id, or null.</returns>
    public string? MeaningId(string? meaning)
    {
        if (meaning is null)
            return null;
        for (var i = 0; i < Meanings.Count && i < MeaningIds.Count; i++)
        {
            if (string.Equals(Meanings[i], meaning, StringComparison.Ordinal))
                return MeaningIds[i];
        }

        return meaning;
    }
{{- if approvals }}

    /// <summary>The approval's stages, each holding named signatures (signoff-design.md decision 1); empty for a gate without stages, which
    /// counts its own signers.</summary>
    public IReadOnlyList<StageDefinition> Stages { get; init; } = [];

    /// <summary>Whether one person may give more than one response that counts on the approval, across its signatures (decision 16).</summary>
    public bool AllowSignerAcrossSignatures { get; init; }
{{- end }}
}
{{- if approvals }}

/// <summary>A stage of an approval: its named signatures (signoff-design.md decision 4).</summary>
/// <param name="Id">The model id.</param>
/// <param name="Name">The stage name.</param>
/// <param name="Signatures">The named signatures, in file order.</param>
public sealed record StageDefinition(string Id, string Name, IReadOnlyList<SignatureDefinition> Signatures);

/// <summary>A named signature of an approval (signoff-design.md decision 3): complete when it has <paramref name="Required"/> signatures
/// and each required actor has signed.</summary>
/// <param name="Id">The model id.</param>
/// <param name="Name">The signature name.</param>
/// <param name="Required">The signatures needed.</param>
/// <param name="Signers">The actors that may give it.</param>
/// <param name="RequiredActors">The actors each of which must give it at least once.</param>
/// <param name="AllowRepeatSigner">Whether one person may count twice on it.</param>
public sealed record SignatureDefinition(string Id, string Name, int Required, IReadOnlyList<string> Signers, IReadOnlyList<string> RequiredActors, bool AllowRepeatSigner)
{
    /// <summary>The text of the condition that decides whether it is needed, asked of the lifecycle's IApprovalConditions when its round
    /// starts (decision 7); null when it is always needed.</summary>
    public string? When { get; init; }

    /// <summary>The keys of the verbs whose doer since the source state was entered may not give it (its notBy, decision 15).</summary>
    public IReadOnlyList<string> NotByVerbs { get; init; } = [];

    /// <summary>The ids of the transitions whose doer since the source state was entered may not give it (its notBy).</summary>
    public IReadOnlyList<string> NotByTransitions { get; init; } = [];
}
{{- end }}

/// <summary>A process's chart as static data: states in document order (the root first), transitions in priority order.</summary>
public sealed class ChartDefinition
{
    private readonly Dictionary<(int Source, TriggerKind Trigger, string Key), TransitionDefinition[]> _groups = [];
    private readonly Dictionary<string, StateDefinition> _byPath = new(StringComparer.Ordinal);
    private readonly Dictionary<string, TransitionDefinition> _transitionsById = new(StringComparer.Ordinal);
    private readonly Dictionary<string, EventDefinition> _events = new(StringComparer.Ordinal);
    private readonly Dictionary<string, ActionDefinition> _actions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, InvokeDefinition> _invokes = new(StringComparer.Ordinal);
    private readonly IReadOnlyDictionary<string, string> _actorIds;
{{- if triggers && !rights }}
    private readonly IReadOnlyDictionary<string, string> _ids;
{{- end }}

    /// <summary>Builds the chart and its lookups.</summary>
    /// <param name="processId">The process id.</param>
    /// <param name="processName">The process name.</param>
    /// <param name="states">The states, the root first, in document order.</param>
    /// <param name="transitions">The transitions in priority order.</param>
    /// <param name="events">The events.</param>
    /// <param name="actions">The actions.</param>
    /// <param name="invokes">The invokes.</param>
    /// <param name="gates">The gates.</param>
    /// <param name="actorIds">The ids of the actors the process names, by name (audit records hold ids, as the engine's do).</param>
{{- if rights }}
    /// <param name="rights">What the process states for rights: its rights and default, and the ids a refusal names.</param>
{{- end }}
{{- if triggers && !rights }}
    /// <param name="ids">The ids a refusal names, by "event:", "invoke:" or "guard:" and the name.</param>
{{- end }}
{{- if triggers }}
    /// <param name="triggerSteps">The step methods of the trigger points that run in the process: its lifecycle's own first, when it has points, then
    /// those of the other lifecycles that govern its object with points on a verb its events name, by name; none when no trigger point runs.</param>
{{- end }}
{{- if named }}
    /// <param name="typeSteps">The step methods of the named trigger points that cover the process's subject, which run before every lifecycle's
    /// at each moment (trigger-points-design.md decision 34); null when none does.</param>
{{- end }}
    public ChartDefinition(string processId, string processName, StateDefinition[] states, TransitionDefinition[] transitions, EventDefinition[] events,
        ActionDefinition[] actions, InvokeDefinition[] invokes, GateDefinition[] gates, IReadOnlyDictionary<string, string>? actorIds = null{{ if rights }},
        {{ rights_ns }}.ProcessRights? rights = null{{ end }}{{ if triggers && !rights }}, IReadOnlyDictionary<string, string>? ids = null{{ end }}{{ if triggers }},
        IReadOnlyList<{{ rights_ns }}.ITriggerPointSteps>? triggerSteps = null{{ end }}{{ if named }}, {{ rights_ns }}.ITriggerPointSteps? typeSteps = null{{ end }})
    {
        _actorIds = actorIds ?? new Dictionary<string, string>(StringComparer.Ordinal);
{{- if rights }}
        Rights = rights;
{{- end }}
{{- if triggers && !rights }}
        _ids = ids ?? new Dictionary<string, string>(StringComparer.Ordinal);
{{- end }}
{{- if triggers }}
        TriggerSteps = triggerSteps ?? [];
{{- end }}
{{- if named }}
        TypeSteps = typeSteps;
{{- end }}
        ArgumentNullException.ThrowIfNull(states);
        ArgumentNullException.ThrowIfNull(transitions);
        ArgumentNullException.ThrowIfNull(events);
        ArgumentNullException.ThrowIfNull(actions);
        ArgumentNullException.ThrowIfNull(invokes);
        ArgumentNullException.ThrowIfNull(gates);
        ProcessId = processId;
        ProcessName = processName;
        States = states;
        Transitions = transitions;
        Gates = gates;
        for (var i = 0; i < states.Length; i++)
        {
            var s = states[i];
            s.Index = i;
            if (s.ParentIndex >= 0)
            {
                s.Parent = states[s.ParentIndex];
                s.Parent.AddChild(s);
                s.Path = s.Parent.IsRoot ? s.Name : s.Parent.Path + "." + s.Name;
                _byPath[s.Path] = s;
            }
        }

        foreach (var s in states)
        {
            if (s.Kind == StateKind.Compound || s.IsRoot)
                s.Initial = s.InitialIndex >= 0 ? states[s.InitialIndex] : s.Children.FirstOrDefault();
        }

        foreach (var s in states)
        {
            if (s.Kind == StateKind.History && s.Parent is { } parent)
                s.DefaultTarget = s.DefaultTargetIndex >= 0 ? states[s.DefaultTargetIndex] : parent.Initial;
        }

        var groups = new Dictionary<(int, TriggerKind, string), List<TransitionDefinition>>();
        for (var i = 0; i < transitions.Length; i++)
        {
            var t = transitions[i];
            t.Index = i;
            t.Source = states[t.SourceIndex];
            t.Targets = [.. t.TargetIndexes.Select(x => states[x])];
            t.Gate = t.GateIndex >= 0 ? gates[t.GateIndex] : null;
            t.Source.AddTransition(t);
            _transitionsById[t.Id] = t;
            var key = (t.SourceIndex, t.Trigger, t.Key);
            if (!groups.TryGetValue(key, out var list))
                groups[key] = list = [];
            list.Add(t);
        }

        foreach (var (key, list) in groups)
            _groups[key] = [.. list];
        foreach (var e in events)
            _events[e.Name] = e;
        foreach (var a in actions)
            _actions[a.Name] = a;
        foreach (var invoke in invokes)
        {
            _invokes[invoke.Name] = invoke;
            states[invoke.State].AddInvoke(invoke);
        }
    }

    /// <summary>The process id.</summary>
    public string ProcessId { get; }

    /// <summary>The process name.</summary>
    public string ProcessName { get; }
{{- if rights }}

    /// <summary>What the process states for rights, or null.</summary>
    public {{ rights_ns }}.ProcessRights? Rights { get; }
{{- end }}
{{- if triggers }}

    /// <summary>The step methods of the trigger points that run in the process, its lifecycle's own first (trigger-points-design.md decisions 11 and 30).</summary>
    public IReadOnlyList<{{ rights_ns }}.ITriggerPointSteps> TriggerSteps { get; }
{{- end }}
{{- if named }}

    /// <summary>The step methods of the named trigger points that cover the process's subject, which run first at each moment (trigger-points-design.md decision 34), or null.</summary>
    public {{ rights_ns }}.ITriggerPointSteps? TypeSteps { get; }
{{- end }}
{{- if triggers && !rights }}

    /// <summary>The id a refusal names for a key ("event:", "invoke:" or "guard:" and the name), or null.</summary>
    /// <param name="key">The key.</param>
    /// <returns>The id, or null.</returns>
    public string? Id(string key) => _ids.GetValueOrDefault(key);
{{- end }}

    /// <summary>The states, the root first, in document order.</summary>
    public IReadOnlyList<StateDefinition> States { get; }

    /// <summary>The root.</summary>
    public StateDefinition Root => States[0];

    /// <summary>The transitions in priority order.</summary>
    public IReadOnlyList<TransitionDefinition> Transitions { get; }

    /// <summary>The gates.</summary>
    public IReadOnlyList<GateDefinition> Gates { get; }
{{- if approvals }}

    /// <summary>Whether the chart keeps the record of acts that a signature's notBy reads (signoff-design.md decision 28): set for a lifecycle
    /// one of whose approvals has a notBy.</summary>
    public bool RecordsActs { get; init; }
{{- end }}

    /// <summary>The state with a path, or null.</summary>
    /// <param name="path">The dotted path.</param>
    /// <returns>The state.</returns>
    public StateDefinition? State(string path) => _byPath.GetValueOrDefault(path);

    /// <summary>The transition with an id, or null.</summary>
    /// <param name="id">The model id.</param>
    /// <returns>The transition.</returns>
    public TransitionDefinition? Transition(string id) => _transitionsById.GetValueOrDefault(id);

    /// <summary>The event with a name, or null.</summary>
    /// <param name="name">The event name.</param>
    /// <returns>The event.</returns>
    public EventDefinition? Event(string name) => _events.GetValueOrDefault(name);

    /// <summary>The action with a name, or null.</summary>
    /// <param name="name">The action name.</param>
    /// <returns>The action.</returns>
    public ActionDefinition? Action(string name) => _actions.GetValueOrDefault(name);

    /// <summary>The invoke with a name, or null.</summary>
    /// <param name="name">The invoke name.</param>
    /// <returns>The invoke.</returns>
    public InvokeDefinition? Invoke(string name) => _invokes.GetValueOrDefault(name);

    /// <summary>The id of an actor named by an envelope; the name when the process does not name that actor.</summary>
    /// <param name="actor">The actor's name, or null.</param>
    /// <returns>The id, or null.</returns>
    public string? ActorId(string? actor) => actor is null ? null : _actorIds.GetValueOrDefault(actor, actor);

    /// <summary>The transitions of one source, trigger and key, in priority order.</summary>
    /// <param name="source">The source.</param>
    /// <param name="trigger">The trigger.</param>
    /// <param name="key">The event or invoke name, or "".</param>
    /// <returns>The candidates.</returns>
    public IReadOnlyList<TransitionDefinition> Candidates(StateDefinition source, TriggerKind trigger, string key) =>
        _groups.TryGetValue((source.Index, trigger, key), out var list) ? list : [];
}

/// <summary>A running instance: everything the interpreter needs between inputs. The store persists it.</summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public sealed class ProcessSnapshot<TContext>
    where TContext : class
{
    /// <summary>The instance identity, supplied by the host.</summary>
    public string Instance { get; set; } = "";

    /// <summary>The process name.</summary>
    public string Process { get; set; } = "";

    /// <summary>The active leaf states' paths, in document order.</summary>
    public List<string> States { get; set; } = [];

    /// <summary>Recorded history by history state path.</summary>
    public Dictionary<string, List<string>> History { get; set; } = [];

    /// <summary>The context.</summary>
    public TContext Context { get; set; } = null!;

    /// <summary>The scheduled timers.</summary>
    public List<TimerEntry> Timers { get; set; } = [];

    /// <summary>The pending invokes' names.</summary>
    public List<string> Pending { get; set; } = [];

    /// <summary>The signatures collected on gated transitions, by transition id.</summary>
    public Dictionary<string, List<SignatureEntry>> Signatures { get; set; } = [];
{{- if approvals }}

    /// <summary>The progress of the approvals on gated transitions whose source is active, by transition id (signoff-design.md decision 7).</summary>
    public Dictionary<string, ApprovalProgress> Approvals { get; set; } = [];

    /// <summary>Who did which verb and which move, kept while a signature's notBy may read it (signoff-design.md decision 28); empty unless
    /// the chart records acts.</summary>
    public List<ActRecord> Acts { get; set; } = [];
{{- end }}

    /// <summary>Whether the root reached a final state.</summary>
    public bool Final { get; set; }

    /// <summary>The last audit sequence number.</summary>
    public long AuditSequence { get; set; }

    /// <summary>The last timer sequence number.</summary>
    public long TimerSequence { get; set; }

    /// <summary>The instance's clock: set by the start and moved only by time inputs (the timers due), as in the engine's interpreter.</summary>
    public DateTimeOffset Clock { get; set; }

    /// <summary>The stored version: 0 until the store first saves the instance, then one more on every save (the store's concurrency
    /// check compares it).</summary>
    public long Version { get; set; }
}

/// <summary>A save that found the stored instance at another version than the one loaded: another command saved it first.</summary>
public sealed class ProcessConcurrencyException : Exception
{
    /// <summary>Creates the exception.</summary>
    public ProcessConcurrencyException()
    {
    }

    /// <summary>Creates the exception.</summary>
    /// <param name="message">The message.</param>
    public ProcessConcurrencyException(string message)
        : base(message)
    {
    }

    /// <summary>Creates the exception.</summary>
    /// <param name="message">The message.</param>
    /// <param name="innerException">The cause.</param>
    public ProcessConcurrencyException(string message, Exception innerException)
        : base(message, innerException)
    {
    }

    /// <summary>The instance's stored version does not match the expected one.</summary>
    /// <param name="instance">The instance identity.</param>
    /// <param name="expected">The version the command loaded.</param>
    /// <param name="stored">The version the store holds.</param>
    /// <returns>The exception.</returns>
    public static ProcessConcurrencyException Conflict(string instance, long expected, long stored) =>
        new($"Instance '{instance}' is at version {stored.ToString(CultureInfo.InvariantCulture)}, not {expected.ToString(CultureInfo.InvariantCulture)}: another command saved it first; load it again and retry.");
}

/// <summary>A scheduled timer.</summary>
/// <param name="Transition">The delayed transition's id.</param>
/// <param name="Due">When it fires.</param>
/// <param name="Sequence">The order it was scheduled in.</param>
public sealed record TimerEntry(string Transition, DateTimeOffset Due, long Sequence);

/// <summary>A signature on a gate.</summary>
/// <param name="Signer">The person's identity.</param>
/// <param name="Actor">The actor signed as.</param>
/// <param name="Meaning">The meaning's name.</param>
/// <param name="Reason">The reason.</param>
public sealed record SignatureEntry(string Signer, string Actor, string? Meaning, string? Reason)
{{- if approvals }}
{
    /// <summary>On an approval, the id of the named signature the entry is for; null on a gate without stages.</summary>
    public string? Signature { get; init; }

    /// <summary>On an approval, the id of that signature's stage.</summary>
    public string? Stage { get; init; }
}

/// <summary>An approval's progress on a gated transition (signoff-design.md decisions 7 to 16): when its round started, which named
/// signatures it needs, and each person's response. With nothing needed it is complete, and the gated event's next occurrence moves.</summary>
public sealed class ApprovalProgress
{
    /// <summary>When the round started, on the instance's clock.</summary>
    public DateTimeOffset Started { get; set; }

    /// <summary>The input sequence number at which the gated transition's source was entered, from which a notBy reads the record of acts
    /// (0 unless the chart records acts).</summary>
    public long Entered { get; set; }

    /// <summary>The ids of the named signatures the round needs, in file order: those whose condition was not false when it started.</summary>
    public List<string> Needed { get; set; } = [];

    /// <summary>The signatures counted, in the order given; a withdraw takes one back out.</summary>
    public List<SignatureEntry> Signed { get; set; } = [];

    /// <summary>The abstentions, in the order given: each finishes its person on its signature.</summary>
    public List<SignatureEntry> Ignored { get; set; } = [];
}

/// <summary>An act of a person, which a signature's notBy reads (signoff-design.md decision 28).</summary>
/// <param name="Sequence">The input's sequence number in the instance: acts are ordered by input, not by time.</param>
/// <param name="Signer">The person's identity.</param>
/// <param name="Verb">The verb's key, or null.</param>
/// <param name="Transition">The transition's id for a move, or null.</param>
public sealed record ActRecord(long Sequence, string Signer, string? Verb, string? Transition);
{{- else }};
{{- end }}

/// <summary>The envelope every command carries.</summary>
/// <param name="Instance">The instance identity.</param>
/// <param name="Actor">The actor the caller acts as (a name from Actors).</param>
/// <param name="Signer">The signing person's identity, for gated events.</param>
/// <param name="Meaning">The meaning of the signature (a name).</param>
/// <param name="Reason">The reason of the signature.</param>
public sealed record ProcessEnvelope(string Instance, string? Actor = null, string? Signer = null, string? Meaning = null, string? Reason = null)
{{- if approvals }}
{
    /// <summary>What the signer answers an approval (signoff-design.md decision 9): sign, the default, reject, ignore or withdraw.</summary>
    public SignatureResponse Response { get; init; }

    /// <summary>The name of the named signature the response answers; null lets the interpreter pick it (decision 8).</summary>
    public string? Signature { get; init; }
}
{{- else }};
{{- end }}

/// <summary>A command of a process: every event command and built-in command carries an envelope.</summary>
public interface IProcessCommand
{
    /// <summary>The instance identity and the caller.</summary>
    ProcessEnvelope Envelope { get; }
}

/// <summary>The event a guard or action sees.</summary>
/// <param name="Name">The event name; null for time and invoke inputs.</param>
/// <param name="Actor">The actor's name.</param>
/// <param name="Payload">The payload by attribute name.</param>
public sealed record ProcessEvent(string? Name, string? Actor, IReadOnlyDictionary<string, object?> Payload)
{
    /// <summary>An event without a name, actor or payload.</summary>
    public static ProcessEvent None { get; } = new(null, null, new Dictionary<string, object?>());

    /// <summary>A payload value, or the type's default.</summary>
    /// <typeparam name="T">The value type.</typeparam>
    /// <param name="name">The attribute name.</param>
    /// <returns>The value.</returns>
    public T? Get<T>(string name) => Payload.TryGetValue(name, out var value) && value is T typed ? typed : default;
}

/// <summary>What a guard or action receives.</summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
/// <param name="Instance">The instance identity.</param>
/// <param name="Context">The context.</param>
/// <param name="Event">The current event.</param>
/// <param name="States">The paths of the active states, all levels, in document order.</param>
public sealed record StatechartCall<TContext>(string Instance, TContext Context, ProcessEvent Event, IReadOnlyList<string> States)
{
    /// <summary>Whether a state (by path) is active.</summary>
    /// <param name="path">The dotted path.</param>
    /// <returns>True when it is.</returns>
    public bool IsActive(string path) => States.Contains(path, StringComparer.Ordinal);
}

/// <summary>A process's guards and actions (its generated Handlers class).</summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public interface IStatechartBehaviour<TContext>
    where TContext : class
{
    /// <summary>Evaluates a guard.</summary>
    /// <param name="guard">The guard name.</param>
    /// <param name="call">The call.</param>
    /// <returns>Whether it holds.</returns>
    bool Guard(string guard, StatechartCall<TContext> call);

    /// <summary>Runs an action.</summary>
    /// <param name="action">The action name.</param>
    /// <param name="call">The call.</param>
    /// <returns>The context after it.</returns>
    TContext Action(string action, StatechartCall<TContext> call);

    /// <summary>The names of the context attributes that differ.</summary>
    /// <param name="before">The context before.</param>
    /// <param name="after">The context after.</param>
    /// <returns>The names, in declaration order.</returns>
    IReadOnlyList<string> Changed(TContext before, TContext after);
}
{{- if approvals }}

/// <summary>What a named signature's condition receives when its round starts (signoff-design.md section 10).</summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
/// <param name="Instance">The instance identity.</param>
/// <param name="Context">The context.</param>
/// <param name="Lifecycle">The lifecycle's name.</param>
/// <param name="Gate">The gate's name.</param>
/// <param name="Stage">The stage's name.</param>
/// <param name="Signature">The named signature's name.</param>
/// <param name="States">The paths of the active states, all levels, in document order.</param>
public sealed record ApprovalCall<TContext>(string Instance, TContext Context, string Lifecycle, string Gate, string Stage, string Signature, IReadOnlyList<string> States);

/// <summary>
/// Whether a named signature with a condition (its when) is needed (signoff-design.md section 10). Generated code can't read the object
/// yet, so a lifecycle's Handlers class implements this when one of its signatures has a condition, each answered by a method of its
/// &lt;Lifecycle&gt;ApprovalConditions. Without it every signature is needed, the safe choice.
/// </summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public interface IApprovalConditions<TContext>
    where TContext : class
{
    /// <summary>Whether a signature is needed, asked when its round starts.</summary>
    /// <param name="signature">The named signature's id.</param>
    /// <param name="call">The call.</param>
    /// <returns>Whether it is needed.</returns>
    bool Needed(string signature, ApprovalCall<TContext> call);
}
{{- end }}
{{- if has_relative }}

/// <summary>
/// Whether a caller is an actor taken from the object, such as the order's owner or an approver on its project (actors-design.md
/// decision 27). The generated code can't read the object, so a process's Handlers class implements this when the process names
/// such an actor, each one a partial method of its companion. The interpreter accepts such an actor only when the behaviour
/// implements this and answers yes, so nothing is let through by accident.
/// </summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public interface IActorResolver<TContext>
    where TContext : class
{
    /// <summary>Whether the caller of an envelope is, for this instance, the actor taken from the object.</summary>
    /// <param name="actor">The actor's name (from Actors).</param>
    /// <param name="snapshot">The instance before the input.</param>
    /// <param name="envelope">The envelope: the instance, the actor, and for an event the caller's identity as its Signer.</param>
    /// <returns>Whether the caller is that actor.</returns>
    bool IsActor(string actor, ProcessSnapshot<TContext> snapshot, ProcessEnvelope envelope);
}
{{- end }}

{{ if rights || triggers -}}
/// <summary>
/// The object's states in the other lifecycles that could say no to a verb an event names (rights-design.md decision 29{{ if triggers }}), or whose
/// trigger points run on it (trigger-points-design.md decision 11{{ end }}): generated code
/// can't read another lifecycle's state for the same object, so a process's Handlers class implements this when one could. A lifecycle
/// missing from the answer, or with no states, reads as its initial state.
/// </summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public interface ILifecycleStates<TContext>
    where TContext : class
{
    /// <summary>The object's active state paths, by lifecycle name; a lifecycle left out that doesn't govern the object isn't asked.</summary>
    /// <param name="call">The current call.</param>
    /// <returns>The states.</returns>
    IReadOnlyDictionary<string, IReadOnlyList<string>> StatesIn(StatechartCall<TContext> call);
}

{{ end -}}
{{ if named -}}
/// <summary>
/// The object's own entity (trigger-points-design.md decision 33): a named trigger point's entities and exceptEntities are tested on it, and
/// a process's subject may be a base of it. Generated code can't read the object yet, so a process's Handlers class implements this when a
/// named trigger point it runs names an entity derived from a subject's; otherwise the call gives the subject's entity.
/// </summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public interface IObjectEntity<TContext>
    where TContext : class
{
    /// <summary>The entity of the instance's object: the subject's, or one derived from it.</summary>
    /// <param name="call">The current call.</param>
    /// <returns>The entity's type.</returns>
    Type EntityOf(StatechartCall<TContext> call);
}

{{ end -}}
/// <summary>The clock the interpreter reads (an extension point; ProcessHost implements it).</summary>
public interface IProcessClock
{
    /// <summary>The current instant.</summary>
    DateTimeOffset Now { get; }
}

/// <summary>Where timers are scheduled (an extension point; ProcessHost implements it). A due timer is fired by a TimersDue command.</summary>
public interface ITimerScheduler
{
    /// <summary>A timer was scheduled.</summary>
    /// <param name="timer">The timer.</param>
    void Schedule(TimerRequest timer);

    /// <summary>A timer was cancelled (its state was exited).</summary>
    /// <param name="timer">The timer.</param>
    void Cancel(TimerRequest timer);
}

/// <summary>Where invokes run (an extension point; ProcessHost implements it). A result comes back as an InvokeResult command.</summary>
public interface IInvokeHost
{
    /// <summary>An invoke was started.</summary>
    /// <param name="invoke">The invoke.</param>
    void Start(InvokeRequest invoke);

    /// <summary>An invoke was cancelled (its state was exited).</summary>
    /// <param name="invoke">The invoke.</param>
    void Cancel(InvokeRequest invoke);
}

/// <summary>A timer of an instance.</summary>
/// <param name="Process">The process name.</param>
/// <param name="Instance">The instance identity.</param>
/// <param name="Transition">The delayed transition's id.</param>
/// <param name="Due">When it fires.</param>
public sealed record TimerRequest(string Process, string Instance, string Transition, DateTimeOffset Due);

/// <summary>An invoke of an instance.</summary>
/// <param name="Process">The process name.</param>
/// <param name="Instance">The instance identity.</param>
/// <param name="Invoke">The invoke name.</param>
/// <param name="Kind">What it starts.</param>
/// <param name="State">The path of the state that started it.</param>
/// <param name="Actors">Who may complete a human task.</param>
public sealed record InvokeRequest(string Process, string Instance, string Invoke, InvokeKind Kind, string State, IReadOnlyList<string> Actors);

/// <summary>A clock that moves only when told to: the clock of scenario tests and simulations.</summary>
/// <param name="start">The first instant.</param>
public sealed class ManualClock(DateTimeOffset start) : IProcessClock
{
    /// <inheritdoc/>
    public DateTimeOffset Now { get; private set; } = start;

    /// <summary>Moves the clock forward.</summary>
    /// <param name="span">How far.</param>
    public void Advance(TimeSpan span) => Now += span;
}

/// <summary>An audit record of a gate (phase-3-design.md section 2.3); the typed record per gate is in the process's contracts.</summary>
/// <param name="Instance">The instance identity.</param>
/// <param name="Process">The process id.</param>
/// <param name="Gate">The gate id.</param>
/// <param name="Transition">The transition id.</param>
/// <param name="Sequence">The order within the instance.</param>
/// <param name="Signer">The signing person's identity.</param>
/// <param name="Actor">The id of the actor signed as (as in the engine's audit records; the envelope carries its name).</param>
/// <param name="Meaning">The meaning's id.</param>
/// <param name="Reason">The reason.</param>
/// <param name="At">When, on the instance's clock.</param>
/// <param name="Outcome">The outcome.</param>
/// <param name="Attributes">The gate's audit attributes by name.</param>
public sealed record GateAuditRecord(string Instance, string Process, string Gate, string Transition, long Sequence, string? Signer, string? Actor, string? Meaning,
    string? Reason, DateTimeOffset At, GateOutcome Outcome, IReadOnlyDictionary<string, object?> Attributes)
{
{{- if approvals }}
    /// <summary>On an approval, the id of the named signature the record is about; null on a record about the whole approval, and on a gate
    /// without stages.</summary>
    public string? Signature { get; init; }

    /// <summary>The id of that signature's stage, or null.</summary>
    public string? Stage { get; init; }

    /// <summary>The outcome's text: signed, completed, refused, discarded, rejected, ignored or withdrawn.</summary>
    public string OutcomeText => Outcome switch
    {
        GateOutcome.Signed => "signed",
        GateOutcome.Completed => "completed",
        GateOutcome.Refused => "refused",
        GateOutcome.Rejected => "rejected",
        GateOutcome.Ignored => "ignored",
        GateOutcome.Withdrawn => "withdrawn",
        _ => "discarded",
    };
{{- else }}
    /// <summary>The outcome's text: signed, completed, refused or discarded.</summary>
    public string OutcomeText => Outcome switch
    {
        GateOutcome.Signed => "signed",
        GateOutcome.Completed => "completed",
        GateOutcome.Refused => "refused",
        _ => "discarded",
    };
{{- end }}

    /// <summary>An audit attribute's value, or the type's default.</summary>
    /// <typeparam name="T">The value type.</typeparam>
    /// <param name="name">The attribute name.</param>
    /// <returns>The value.</returns>
    public T? Attribute<T>(string name) => Attributes.TryGetValue(name, out var value) && value is T typed ? typed : default;
}

/// <summary>The result of one input.</summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
public sealed class StepResult<TContext>
    where TContext : class
{
    /// <summary>Whether the input was accepted.</summary>
    public bool Accepted { get; init; }

    /// <summary>Why it was refused (<see cref="Refusals"/>).</summary>
    public string? Refusal { get; init; }
{{- if rights }}

    /// <summary>The id of the element that refused it: the event or invoke, the right, the lifecycle whose default denies, the guard or the
    /// gate{{ if triggers }}, or the check{{ end }}; null when accepted, and for no-transition.</summary>
    public string? RefusedBy { get; init; }
{{- else if triggers }}

    /// <summary>The id of the element that refused it: the event or invoke, the guard, the gate or the check; null when accepted, and for
    /// no-transition.</summary>
    public string? RefusedBy { get; init; }
{{- end }}
{{- if triggers }}

    /// <summary>The checks that warned, each once, in the order they first warned (trigger-points-design.md decision 6).</summary>
    public IReadOnlyList<{{ rights_ns }}.TriggerPointWarning> CheckWarnings { get; init; } = [];

    /// <summary>The ids of the trigger points that ran, in run order: a refusing check once, and after-commit points last, as queued.</summary>
    public IReadOnlyList<string> TriggerPoints { get; init; } = [];

    /// <summary>The after-commit work of an accepted input, one message per due point; the command handler adds each to the result's events with its id.</summary>
    public IReadOnlyList<{{ rights_ns }}.TriggerPointMessage> AfterCommit { get; init; } = [];
{{- end }}

    /// <summary>The input: the event name, "invoke-done:&lt;invoke&gt;", "invoke-error:&lt;invoke&gt;", ":time" or ":start".</summary>
    public string Input { get; init; } = "";

    /// <summary>The active leaf states before the input.</summary>
    public IReadOnlyList<string> From { get; init; } = [];

    /// <summary>The active leaf states after it, in document order.</summary>
    public IReadOnlyList<string> States { get; init; } = [];

    /// <summary>The names of the context attributes it changed.</summary>
    public IReadOnlyList<string> Changed { get; init; } = [];

    /// <summary>The audit records it produced.</summary>
    public IReadOnlyList<GateAuditRecord> Audit { get; init; } = [];

    /// <summary>Invokes started, for the invoke host.</summary>
    public IReadOnlyList<InvokeRequest> Started { get; init; } = [];

    /// <summary>Invokes cancelled, for the invoke host.</summary>
    public IReadOnlyList<InvokeRequest> Cancelled { get; init; } = [];

    /// <summary>Timers scheduled, for the timer scheduler.</summary>
    public IReadOnlyList<TimerRequest> Scheduled { get; init; } = [];

    /// <summary>Timers cancelled, for the timer scheduler.</summary>
    public IReadOnlyList<TimerRequest> Unscheduled { get; init; } = [];

    /// <summary>The instant of the input on the instance's clock (the end of the advance for a time input).</summary>
    public DateTimeOffset At { get; init; }

    /// <summary>Why the input stopped short, or null: a macrostep ran more than the most microsteps allowed (the engine's MQ9507).
    /// The instance keeps the state it reached, as the engine's interpreter does.</summary>
    public string? Failure { get; init; }

    /// <summary>The instance after the input.</summary>
    public ProcessSnapshot<TContext> Snapshot { get; init; } = null!;

    /// <summary>The context after the input.</summary>
    public TContext Context => Snapshot.Context;

    /// <summary>Whether the instance reached a final state.</summary>
    public bool Final => Snapshot.Final;

    /// <summary>Whether the input changed the active states.</summary>
    public bool Moved => !From.SequenceEqual(States, StringComparer.Ordinal);
}

/// <summary>
/// The statechart interpreter of phase-3-design.md section 4.1, generated and never edited: configuration, macrosteps and microsteps,
/// selection by document order with conflict removal, exit and entry sets, shallow and deep history, done events, timers on the
/// clock, invokes, gates with audit records, and actors. It keeps no state between calls: each call reads a snapshot, runs one input
/// and writes the snapshot back. A process invoke is started through the invoke host and reports back like a service task.
/// </summary>
/// <typeparam name="TContext">The process's context type.</typeparam>
/// <param name="chart">The chart.</param>
/// <param name="behaviour">The guards and actions.</param>
/// <param name="clock">The clock.</param>
/// <param name="maxMicrosteps">The most microsteps one input may run.</param>
public sealed class Statechart<TContext>(ChartDefinition chart, IStatechartBehaviour<TContext> behaviour, IProcessClock clock, int maxMicrosteps = 1000)
    where TContext : class
{
    /// <summary>The chart.</summary>
    public ChartDefinition Chart { get; } = chart ?? throw new ArgumentNullException(nameof(chart));
{{- if has_relative }}

    // The actors taken from the object, by name: the behaviour must say the caller is one before it may act as one.
    private static readonly HashSet<string> FromObject = new(StringComparer.Ordinal) { {{ for n in relative_names }}{{ for.first ? "" : ", " }}{{ json n }}{{ end }} };
{{- end }}

    /// <summary>Starts an instance: enters the initial configuration.</summary>
    /// <param name="instance">The instance identity.</param>
    /// <param name="context">The initial context.</param>
    /// <returns>The result; its snapshot is the new instance.</returns>
    public StepResult<TContext> Start(string instance, TContext context)
    {
        ArgumentNullException.ThrowIfNull(instance);
        ArgumentNullException.ThrowIfNull(context);
        var snapshot = new ProcessSnapshot<TContext> { Instance = instance, Process = Chart.ProcessName, Context = context, Clock = _clock.Now };
        var run = new Run(this, snapshot, ":start", null);
        run.EnterRoot();
        run.Macrostep(() =>
        {
            if (Chart.Root.Initial is { } initial)
                run.Microstep([], initial);
            run.RunToCompletion();
        });
        return run.Finish();
    }

    /// <summary>Checks a stored snapshot against the chart.</summary>
    /// <param name="snapshot">The snapshot.</param>
    /// <returns>The snapshot.</returns>
    public ProcessSnapshot<TContext> Restore(ProcessSnapshot<TContext> snapshot)
    {
        ArgumentNullException.ThrowIfNull(snapshot);
        foreach (var path in snapshot.States)
        {
            if (Chart.State(path) is not { IsLeaf: true })
                throw new InvalidOperationException($"The snapshot of instance '{snapshot.Instance}' names state '{path}', which is not a leaf state of process {Chart.ProcessName}.");
        }

        return snapshot;
    }

    /// <summary>Runs an event.</summary>
    /// <param name="snapshot">The instance.</param>
    /// <param name="name">The event name.</param>
    /// <param name="envelope">The envelope.</param>
    /// <param name="payload">The payload by attribute name.</param>
    /// <param name="audit">Gate audit attribute values by name.</param>
{{- if rights }}
    /// <param name="held">The actors the caller holds with no context, besides the one it acts as (ICallerHoldings).</param>
{{- end }}
{{- if freezing }}
    /// <param name="frozen">Whether the object, or a link of it, is frozen (IFrozenState); the team's FrozenState when null.</param>
{{- end }}
    /// <returns>The result.</returns>
    public StepResult<TContext> Send(ProcessSnapshot<TContext> snapshot, string name, ProcessEnvelope envelope, IReadOnlyDictionary<string, object?>? payload = null,
        IReadOnlyDictionary<string, object?>? audit = null{{ if rights }}, IReadOnlyList<string>? held = null{{ end }}{{ if freezing }}, {{ rights_ns }}.IFrozenState? frozen = null{{ end }})
    {
        ArgumentNullException.ThrowIfNull(snapshot);
        ArgumentNullException.ThrowIfNull(envelope);
        var run = new Run(this, snapshot, name, envelope) { AuditValues = audit ?? new Dictionary<string, object?>(){{ if rights }}, Held = held ?? []{{ end }}{{ if freezing }}, Frozen = frozen{{ end }} };
        if (run.Done || Chart.Event(name) is not { } ev)
            return run.Refuse(Refusals.NoTransition);
{{- if freezing }}

        // Freezing first (rights-design.md decision 17): a frozen object can't be modified, deleted, connected or disconnected, whatever
        // the actors and rights say. The frozen state (IFrozenState) answers; the team's FrozenState answers "not frozen" until the team writes it.
        if (ev.Verb is { } frozenVerb && new {{ rights_ns }}.FrozenFlags(new {{ rights_ns }}.FrozenQuery { Process = Chart.ProcessName, Envelope = envelope{{ if rights }}, Subject = Chart.Rights?.Subject{{ end }} }, state: frozen).Refuses(frozenVerb))
            return run.Refuse(Refusals.Frozen);
{{- end }}
        if (ev.Actors.Count > 0 && (envelope.Actor is null || !{{ has_members ? (actors_type + ".Allows(ev.Actors, envelope.Actor)") : "ev.Actors.Contains(envelope.Actor, StringComparer.Ordinal)" }}{{ resolves("snapshot", "envelope.Actor", "envelope") }}))
            return run.Refuse(Refusals.Actor{{ if refusals }}, Chart.{{ ids }}("event:" + name){{ end }});
{{- if rights }}

        // Rights on the event's verb, before any guard (rights-design.md decision 12): the event's list, and the signers of the gates on the
        // transitions it can take, count as allows of this lifecycle.
        var allowed = new List<string>();
        if (ev.Actors.Count > 0)
            allowed.Add(Chart.Rights?.Id("event:" + name) ?? name);
        if (envelope.Actor is { } signer)
            allowed.AddRange(run.GateSigners(name, signer));
        if (run.CheckRights(ev.Verb, allowed) is { Allowed: false } denied)
            return run.Refuse(denied.Refusal!, denied.RefusedBy);
{{- end }}
        run.Event = new ProcessEvent(name, envelope.Actor, payload ?? new Dictionary<string, object?>());
        run.Macrostep(() =>
        {
            var selection = run.Select(TriggerKind.Event, name, external: true);
            if (selection.Transitions.Count == 0 && !selection.Consumed)
            {
                run.SetRefusal(selection.Reason);
                return;
            }
{{- if approvals }}

            // Whoever sent the event did its moves (signoff-design.md decision 28); a gated move's acts are recorded when it completes.
            run.Sent(selection.Transitions);
{{- end }}

            if (selection.Transitions.Count > 0)
                run.Microstep(selection.Transitions);
            run.RunToCompletion();
        });
        return run.Finish();
    }

    /// <summary>Reports an invoke's result.</summary>
    /// <param name="snapshot">The instance.</param>
    /// <param name="invoke">The invoke name.</param>
    /// <param name="failed">True for an error, false for done.</param>
    /// <param name="actor">The actor reporting it (checked for human tasks).</param>
{{- if rights }}
    /// <param name="held">The actors the caller holds with no context, besides the one it acts as (ICallerHoldings).</param>
{{- end }}
{{- if freezing }}
    /// <param name="frozen">Whether the object, or a link of it, is frozen (IFrozenState); the team's FrozenState when null.</param>
{{- end }}
    /// <returns>The result.</returns>
    public StepResult<TContext> Complete(ProcessSnapshot<TContext> snapshot, string invoke, bool failed, string? actor{{ if rights }}, IReadOnlyList<string>? held = null{{ end }}{{ if freezing }}, {{ rights_ns }}.IFrozenState? frozen = null{{ end }})
    {
        ArgumentNullException.ThrowIfNull(snapshot);
        ArgumentNullException.ThrowIfNull(invoke);
        var run = new Run(this, snapshot, (failed ? "invoke-error:" : "invoke-done:") + invoke, new ProcessEnvelope(snapshot.Instance, actor)){{ if rights || freezing }} { {{ if rights }}Held = held ?? []{{ end }}{{ if rights && freezing }}, {{ end }}{{ if freezing }}Frozen = frozen{{ end }} }{{ end }};
        if (Chart.Invoke(invoke) is not { } found || !run.Pending.Contains(found))
            return run.Refuse(Refusals.NoTransition);
        if (found.Kind == InvokeKind.HumanTask && found.Actors.Count > 0 && (actor is null || !{{ has_members ? (actors_type + ".Allows(found.Actors, actor)") : "found.Actors.Contains(actor, StringComparer.Ordinal)" }}{{ resolves("snapshot", "actor", "new ProcessEnvelope(snapshot.Instance, actor)") }}))
            return run.Refuse(Refusals.Actor{{ if refusals }}, Chart.{{ ids }}("invoke:" + invoke){{ end }});
{{- if rights }}

        // A human task's completion, done or error, is checked as complete; its actors count as an allow of this lifecycle.
        if (found.Kind == InvokeKind.HumanTask
            && run.CheckRights({{ verb_keys["complete"] ? ("global::" + base_ns + ".Verb.Complete") : "null" }}, found.Actors.Count > 0 ? [Chart.Rights?.Id("invoke:" + invoke) ?? invoke] : []) is { Allowed: false } denied)
            return run.Refuse(denied.Refusal!, denied.RefusedBy);
{{- end }}
{{- if triggers && verb_keys["complete"] }}

        // A human task's completion runs complete's before actions and checks before its transition is picked (trigger-points-design.md
        // section 8): a refusing check refuses the step, and the task stays pending.
        if (found.Kind == InvokeKind.HumanTask && run.TaskChecks() is { Passed: false } completing)
            return run.Refuse(Refusals.Check, completing.RefusedBy);
{{- end }}
        run.Event = new ProcessEvent(null, actor, new Dictionary<string, object?>());
        run.Macrostep(() =>
        {
            var selection = run.SelectAt(Chart.States[found.State], failed ? TriggerKind.InvokeError : TriggerKind.InvokeDone, found.Name);
            if (selection.Transitions.Count == 0)
            {
                run.SetRefusal(selection.Reason);
                return;
            }

            run.Pending.Remove(found);
{{- if triggers && verb_keys["complete"] }}
            run.Completed(selection.Transitions);
{{- end }}
            run.Microstep(selection.Transitions);
            run.RunToCompletion();
        });
        return run.Finish();
    }

    /// <summary>Fires every timer due at the clock's current instant, in due order, each as its own macrostep at its due instant.</summary>
    /// <param name="snapshot">The instance.</param>
    /// <returns>The result (always accepted).</returns>
    public StepResult<TContext> Tick(ProcessSnapshot<TContext> snapshot)
    {
        ArgumentNullException.ThrowIfNull(snapshot);
        var run = new Run(this, snapshot, ":time", null);
        var end = _clock.Now > run.Clock ? _clock.Now : run.Clock;
        while (!run.Done)
        {
            var next = run.Timers.Where(t => t.Due <= end).OrderBy(t => t.Due).ThenBy(t => t.Transition.Source.Index).ThenBy(t => t.Transition.Index)
                .ThenBy(t => t.Sequence).FirstOrDefault();
            if (next is null)
                break;
            run.Clock = next.Due;
            run.Timers.Remove(next);
            run.Macrostep(() =>
            {
                if (!run.Guard(next.Transition){{ if triggers }} || run.Checks(next.Transition) is not null{{ end }})
                    return;
                run.Microstep([next.Transition]);
                run.RunToCompletion();
            });
        }

        run.Clock = end;
        return run.Finish();
    }

    /// <summary>A refused result that reports the instance as it is.</summary>
    /// <param name="snapshot">The instance.</param>
    /// <param name="refusal">The reason.</param>
    /// <param name="input">The input's name.</param>
    /// <returns>The result.</returns>
    public StepResult<TContext> Refused(ProcessSnapshot<TContext> snapshot, string refusal, string input)
    {
        ArgumentNullException.ThrowIfNull(snapshot);
{{- if refusals }}
        return new Run(this, snapshot, input, null).Refuse(refusal, refusal == Refusals.Actor ? Chart.{{ ids }}("event:" + input) : null);
{{- else }}
        return new Run(this, snapshot, input, null).Refuse(refusal);
{{- end }}
    }

    private sealed record Selection(List<TransitionDefinition> Transitions, bool Consumed, string Reason);

    // Thrown by the microstep over the bound and caught by the macrostep, which records the failure and keeps the state reached.
    private sealed class MacrostepOverflowException : Exception
    {
    }

    private sealed class Timer(TransitionDefinition transition, DateTimeOffset due, long sequence)
    {
        public TransitionDefinition Transition { get; } = transition;

        public DateTimeOffset Due { get; } = due;

        public long Sequence { get; } = sequence;
    }

    // One input over one instance: loads the snapshot, runs, and writes it back in Finish.
    private sealed class Run
    {
        private readonly Statechart<TContext> _owner;
        private readonly ProcessSnapshot<TContext> _snapshot;
        private readonly ChartDefinition _chart;
        private readonly HashSet<StateDefinition> _config = [];
        private readonly Dictionary<StateDefinition, List<StateDefinition>> _history = [];
        private readonly Dictionary<TransitionDefinition, List<SignatureEntry>> _signatures = [];
        private readonly Queue<(TriggerKind Kind, string Key)> _queue = new();
        private readonly List<GateAuditRecord> _audit = [];
        private readonly List<InvokeRequest> _started = [];
        private readonly List<InvokeRequest> _cancelled = [];
        private readonly List<TimerRequest> _scheduled = [];
        private readonly List<TimerRequest> _unscheduled = [];
        private readonly string _input;
        private readonly ProcessEnvelope? _envelope;
        private readonly IReadOnlyList<string> _from;
        private readonly TContext _before;
        private long _auditSequence;
        private long _timerSequence;
        private int _micro;
        private string? _refusal;
        private string? _failure;
{{- if refusals }}
        private string? _refusedBy;
        private string? _by; // the id that decides the refusal being worked out
{{- end }}

        public Run(Statechart<TContext> owner, ProcessSnapshot<TContext> snapshot, string input, ProcessEnvelope? envelope)
        {
            _owner = owner;
            _snapshot = snapshot;
            _chart = owner.Chart;
            _input = input;
            _envelope = envelope;
            Clock = snapshot.Clock;
            Context = snapshot.Context;
            _before = snapshot.Context;
            Done = snapshot.Final;
            _auditSequence = snapshot.AuditSequence;
            _timerSequence = snapshot.TimerSequence;
            _from = [.. snapshot.States];
            if (snapshot.States.Count > 0)
                _config.Add(_chart.Root);
            foreach (var path in snapshot.States)
            {
                if (_chart.State(path) is not { } leaf)
                    continue;
                _config.Add(leaf);
                foreach (var a in leaf.Ancestors())
                    _config.Add(a);
            }

            foreach (var (path, recorded) in snapshot.History)
            {
                if (_chart.State(path) is { } h)
                    _history[h] = [.. recorded.Select(_chart.State).OfType<StateDefinition>()];
            }

            foreach (var t in snapshot.Timers)
            {
                if (_chart.Transition(t.Transition) is { } transition)
                    Timers.Add(new Timer(transition, t.Due, t.Sequence));
            }

            foreach (var name in snapshot.Pending)
            {
                if (_chart.Invoke(name) is { } invoke)
                    Pending.Add(invoke);
            }

            foreach (var (id, list) in snapshot.Signatures)
            {
                if (_chart.Transition(id) is { } transition)
                    _signatures[transition] = [.. list];
            }
{{- if approvals }}

            foreach (var (id, approval) in snapshot.Approvals)
            {
                if (_chart.Transition(id) is { } transition)
                    _approvals[transition] = new ApprovalProgress { Started = approval.Started, Entered = approval.Entered, Needed = [.. approval.Needed], Signed = [.. approval.Signed], Ignored = [.. approval.Ignored] };
            }

            _acts.AddRange(snapshot.Acts);

            // The input's sequence number for the record of acts: one past the highest an act or an approval's entry holds, so what this
            // input does orders after everything kept (signoff-design.md decision 28).
            if (_chart.RecordsActs)
                _sequence = Math.Max(_acts.Select(a => a.Sequence).DefaultIfEmpty().Max(), _approvals.Values.Select(a => a.Entered).DefaultIfEmpty().Max()) + 1;
{{- end }}
        }

        public DateTimeOffset Clock { get; set; }

        public TContext Context { get; private set; }

        public bool Done { get; private set; }

        public ProcessEvent Event { get; set; } = ProcessEvent.None;

        public IReadOnlyDictionary<string, object?> AuditValues { get; init; } = new Dictionary<string, object?>();

        public List<Timer> Timers { get; } = [];

        public List<InvokeDefinition> Pending { get; } = [];

{{ if freezing ~}}
        public {{ rights_ns }}.IFrozenState? Frozen { get; init; }

{{ end ~}}
{{ if rights ~}}
        public IReadOnlyList<string> Held { get; init; } = [];

{{ end ~}}
{{ if refusals ~}}
        public void SetRefusal(string reason)
        {
            if (_refusal is not null)
                return;
            _refusal = reason;
            _refusedBy = reason == Refusals.NoTransition ? null : _by;
        }

        public StepResult<TContext> Refuse(string reason, string? by)
        {
            _by = by;
            return Refuse(reason);
        }
{{ else ~}}
        public void SetRefusal(string reason) => _refusal ??= reason;
{{ end ~}}

        public void EnterRoot() => _config.Add(_chart.Root);

        public StepResult<TContext> Refuse(string reason)
        {
            SetRefusal(reason);
            return Finish();
        }

        public void Macrostep(Action body)
        {
            _micro = 0;
            try
            {
                body();
            }
            catch (MacrostepOverflowException)
            {
                _failure ??= $"A macrostep of process {_chart.ProcessName} ran more than {_owner._maxMicrosteps.ToString(CultureInfo.InvariantCulture)} microsteps; break the eventless loop or the chain of raised events with a guard that turns false.";
            }
        }

        // ---- selection ----

        public Selection Select(TriggerKind trigger, string key, bool external)
        {
            var enabled = new List<TransitionDefinition>();
            var tried = new Dictionary<TransitionDefinition, bool>();
            var consumed = false;
            var reason = Refusals.NoTransition;
            var rank = 0;
{{- if refusals }}
            _by = null;
{{- end }}
            foreach (var leaf in Leaves())
            {
                var found = false;
                foreach (var s in Prepend(leaf, leaf.Ancestors()))
                {
                    if (s.IsRoot)
                        break;
                    foreach (var t in _chart.Candidates(s, trigger, key))
                    {
                        if (tried.TryGetValue(t, out var taken))
                        {
                            if (taken)
                            {
                                found = true;
                                break;
                            }

                            continue;
                        }

{{- if approvals }}

                        // A response other than sign selects only gated moves with an open approval (signoff-design.md decision 9).
                        if (external && Response != SignatureResponse.Sign && !OpenApproval(t))
                            continue;
{{- end }}

                        tried[t] = false;
                        if (!Guard(t))
                        {
                            Fail(Refusals.Guard, 1{{ if refusals }}, GuardId(t){{ end }});
                            continue;
                        }

                        if (t.Gate is { } gate)
                        {
                            if (!external)
                            {
                                Fail(Refusals.GateSigner, 2{{ if refusals }}, gate.Id{{ end }});
                                continue;
                            }

                            if ({{ approvals ? "CheckGate" : "CheckSigner" }}(t, gate) is { } refusal)
                            {
                                Fail(refusal, 2{{ if rights }}, refusal == Refusals.Right ? _signRefusedBy : gate.Id{{ else if triggers }}, gate.Id{{ end }});
                                continue;
                            }
                        }
{{- if triggers }}

                        // The trigger points' before actions and checks, on a scratch copy (trigger-points-design.md decision 18): a refusing
                        // check leaves the candidate out, as a false guard does, and outranks a gate and a guard.
                        if (Checks(t) is { } check)
                        {
                            Fail(Refusals.Check, 3, check);
                            continue;
                        }
{{- end }}

                        tried[t] = true;
                        enabled.Add(t);
                        found = true;
                        break;
                    }

                    if (found)
                        break;
                }
            }

            var selected = RemoveConflicts(enabled, t =>
            {
                if (t.Gate is not { } gate || {{ triggers ? "Signed" : (approvals ? "Admit" : "Sign") }}(t, gate))
                    return true;
                consumed = true; // the occurrence signed an incomplete gate: accepted, and the transition waits for more signatures
                return false;
            });
            return new Selection(selected, consumed, reason);

            void Fail(string why, int level{{ if refusals }}, string? by{{ end }})
            {
                if (level > rank)
                {
                    rank = level;
                    reason = why;
{{- if refusals }}
                    _by = by;
{{- end }}
                }
            }
        }

        public Selection SelectAt(StateDefinition source, TriggerKind trigger, string key)
        {
            var reason = Refusals.NoTransition;
{{- if refusals }}
            _by = null;
{{- end }}
            foreach (var t in _chart.Candidates(source, trigger, key))
            {
{{- if triggers }}
                if (Guard(t))
                {
                    // A refusing check leaves the candidate out, as a false guard does, and is the more telling reason.
                    if (Checks(t) is not { } check)
                        return new Selection([t], false, reason);
                    if (reason != Refusals.Check)
                        (reason, _by) = (Refusals.Check, check);
                    continue;
                }

                if (reason == Refusals.Check)
                    continue;
                reason = Refusals.Guard;
                _by ??= GuardId(t);
{{- else }}
                if (Guard(t))
                    return new Selection([t], false, reason);
                reason = Refusals.Guard;
{{- if rights }}
                _by ??= GuardId(t);
{{- end }}
{{- end }}
            }

            return new Selection([], false, reason);
        }

        private List<TransitionDefinition> RemoveConflicts(List<TransitionDefinition> enabled, Func<TransitionDefinition, bool> admit)
        {
            var filtered = new List<TransitionDefinition>();
            foreach (var t1 in enabled)
            {
                if (filtered.Contains(t1))
                    continue;
                var preempted = false;
                var remove = new List<TransitionDefinition>();
                var exit1 = ExitSet(t1);
                foreach (var t2 in filtered)
                {
                    if (!exit1.Overlaps(ExitSet(t2)))
                        continue;
                    if (t1.Source.IsDescendantOf(t2.Source))
                    {
                        remove.Add(t2);
                    }
                    else
                    {
                        preempted = true;
                        break;
                    }
                }

                if (preempted || !admit(t1))
                    continue;
                filtered.RemoveAll(remove.Contains);
                filtered.Add(t1);
            }

            return filtered;
        }

        // ---- guards and actions ----

        public bool Guard(TransitionDefinition t) => !t.GuardMissing && (t.Guard is not { } guard || _owner._behaviour.Guard(guard, Call()));

        private void RunAction(string name)
        {
            Context = _owner._behaviour.Action(name, Call()) ?? Context;
            if (_chart.Action(name) is { } action)
            {
                foreach (var raised in action.Raises)
                {
                    if (_chart.Event(raised) is not null)
                        _queue.Enqueue((TriggerKind.Event, raised));
                }
            }
        }

        private StatechartCall<TContext> Call() =>
            new(_snapshot.Instance, Context, Event, [.. _config.Where(s => !s.IsRoot).OrderBy(s => s.Index).Select(s => s.Path)]);

        // ---- gates ----

        private string? CheckSigner(TransitionDefinition t, GateDefinition gate)
        {
            var signatures = _signatures.TryGetValue(t, out var existing) ? existing : [];
            var actor = _envelope?.Actor;
            var signer = _envelope?.Signer;
            string? refusal = null;
            if (actor is null || string.IsNullOrEmpty(signer) || !{{ has_members ? (actors_type + ".Allows(gate.Signers, actor)") : "gate.Signers.Contains(actor, StringComparer.Ordinal)" }}{{ resolves("_snapshot", "actor", "_envelope!") | string.replace "!Resolves(" "!_owner.Resolves(" }})
                refusal = Refusals.GateSigner;
{{- if rights && verb_keys["sign"] }}
            else if (CheckRights(global::{{ base_ns }}.Verb.Sign, [gate.Id]) is { Allowed: false } denied)
            {
                refusal = denied.Refusal;
                _signRefusedBy = denied.RefusedBy;
            }
{{- end }}
            else if (!gate.AllowRepeatSigner && signatures.Any(s => string.Equals(s.Signer, signer, StringComparison.Ordinal)))
                refusal = Refusals.GateRepeat;
            else if (gate.ReasonRequired && string.IsNullOrWhiteSpace(_envelope?.Reason))
                refusal = Refusals.GateReason;
            if (refusal is not null)
                Audit(gate, t, signer, actor, Meaning(gate), _envelope?.Reason, GateOutcome.Refused, AuditValues);
            return refusal;
        }

        private string? Meaning(GateDefinition gate) => _envelope?.Meaning ?? (gate.Meanings.Count == 1 ? gate.Meanings[0] : null);
{{- if rights }}

        // The right that refused the last signature, for the refusal's id.
        private string? _signRefusedBy;

        private string? GuardId(TransitionDefinition t) => t.Guard is { } guard ? _chart.Rights?.Id("guard:" + guard) ?? guard : null;

        // The gates whose signers count as an allow of this lifecycle for an event: those on the transitions it can take from the active
        // states, whose signers the actor is one of (rights-design.md decision 14).
        public IEnumerable<string> GateSigners(string name, string actor)
        {
            foreach (var s in _config.OrderBy(s => s.Index))
            {
                foreach (var t in _chart.Candidates(s, TriggerKind.Event, name))
                {
                    if (t.Gate is { } gate && {{ approvals ? "SignersAllow(t, gate, actor)" : (has_members ? (actors_type + ".Allows(gate.Signers, actor)") : "gate.Signers.Contains(actor, StringComparer.Ordinal)") }})
                        yield return gate.Id;
                }
            }
        }

        // Asks the rights check for a verb of this run: this process's states, and for an object, link or own verb the other lifecycles'
        // states its behaviour gives (ILifecycleStates).
        public {{ rights_ns }}.RightDecision CheckRights(global::{{ base_ns }}.Verb? verb, IReadOnlyList<string> allowed)
        {
            var states = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal) { [_chart.ProcessName] = [.. Leaves().Select(s => s.Path)] };
            if (verb is { } v && {{ rights_ns }}.Rights.SpeaksOfObject(v) && _owner._behaviour is ILifecycleStates<TContext> others)
            {
                foreach (var (lifecycle, paths) in others.StatesIn(Call()))
                    states[lifecycle] = paths;
            }

            var envelope = _envelope ?? new ProcessEnvelope(_snapshot.Instance);
            return {{ rights_ns }}.Rights.Check(new {{ rights_ns }}.RightRequest
            {
                Verb = verb,
                Lifecycle = _chart.Rights is { Lifecycle: true } ? _chart.ProcessName : null,
                Subject = _chart.Rights?.Subject,
                Actor = envelope.Actor,
                Envelope = envelope,
                Held = Held,
{{- if freezing }}
                FrozenState = Frozen,
{{- end }}
                States = states,
                Allowed = allowed,
{{- if has_relative }}
                Resolves = actor => _owner.Resolves(_snapshot, actor, envelope),
{{- end }}
            });
        }
{{- end }}
{{- if triggers && !rights }}

        private string? GuardId(TransitionDefinition t) => t.Guard is { } guard ? _chart.Id("guard:" + guard) ?? guard : null;
{{- end }}
{{- if triggers }}

        // ---- trigger points (trigger-points-design.md decisions 18 and 19) ----

        // What a candidate's before actions and checks prepared during selection, on a scratch copy of the proposed values: for a gated
        // move, sign's outcome, and the move's on the occurrence that would complete the gate. The taken transition keeps it for its microstep.
        private sealed class Candidate(Verb? verb, {{ rights_ns }}.TriggerPointCall call)
        {
            public Verb? Verb { get; } = verb;

            // The lifecycles whose points the move's verb runs (decision 11), its own first.
            public IReadOnlyList<{{ rights_ns }}.ITriggerPointSteps> Lifecycles { get; set; } = [];

            public {{ rights_ns }}.TriggerPointCall Call { get; } = call;

            public {{ rights_ns }}.TriggerPointOutcome? Sign { get; set; }

            public {{ rights_ns }}.TriggerPointOutcome? Move { get; set; }

            public bool Listed { get; set; }
        }

        private readonly Dictionary<TransitionDefinition, Candidate> _candidates = [];
        private readonly List<string> _ran = [];
        private readonly List<string> _queued = [];
        private readonly List<{{ rights_ns }}.TriggerPointWarning> _warnings = [];
        private readonly List<{{ rights_ns }}.TriggerPointMessage> _messages = [];
        private ({{ rights_ns }}.TriggerPointOutcome Outcome, {{ rights_ns }}.TriggerPointCall Call)? _task;

        // The lifecycle's own steps, which moves, signatures and tasks run (decision 11); null when it has no points.
        private {{ rights_ns }}.ITriggerPointSteps? Steps => _chart.TriggerSteps.FirstOrDefault(s => string.Equals(s.Lifecycle, _chart.ProcessName, StringComparison.Ordinal));
{{- if named }}

        // The steps a move's own verb, sign or complete runs (decisions 19 and 34): the named trigger points that cover the subject, then this
        // lifecycle's, each only when it has points on the verb.
        private List<{{ rights_ns }}.ITriggerPointSteps> Own(Verb verb) =>
            [.. new[] { _chart.TypeSteps, Steps }.OfType<{{ rights_ns }}.ITriggerPointSteps>().Where(s => s.Speaks(verb))];
{{- end }}

        // The verb a transition does: its event's, else its own (automatic moves). A move with no verb runs no trigger points.
        private Verb? VerbOf(TransitionDefinition t) => t.Trigger == TriggerKind.Event ? _chart.Event(t.Key)?.Verb : t.Verb;

        // Whether a verb is an object, link or own verb, whose trigger points every lifecycle that governs the object runs (decision 11).
        private static bool SpeaksOfObject(Verb verb) => {{ object_verbs.size > 0 ? ("verb is " + (object_verbs | array.join " or ")) : "false" }};

        // The object's states: in this lifecycle the given ones; for an object, link or own verb, in each other lifecycle with points the
        // ones the behaviour gives (ILifecycleStates), a lifecycle left out being one that doesn't govern the object.
        private Dictionary<string, IReadOnlyList<string>> States(Verb? verb, IReadOnlyList<string> own)
        {
            var states = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal) { [_chart.ProcessName] = own };
            if (verb is { } v && SpeaksOfObject(v) && _chart.TriggerSteps.Any(s => !string.Equals(s.Lifecycle, _chart.ProcessName, StringComparison.Ordinal))
                && _owner._behaviour is ILifecycleStates<TContext> others)
            {
                foreach (var (lifecycle, paths) in others.StatesIn(Call()))
                {
                    if (!string.Equals(lifecycle, _chart.ProcessName, StringComparison.Ordinal))
                        states[lifecycle] = paths;
                }
            }

            return states;
        }

        // The active leaves, which a task's end and the moments after a move read.
        private List<string> Live() => [.. Leaves().Select(s => s.Path)];

        // The states a move leaves (decision 10's states): the active states inside its source, else the source itself. A compound state that
        // contains the source counts through InState; other parallel regions don't count.
        private List<string> SourceStates(TransitionDefinition t)
        {
            var inside = Leaves().Where(s => s == t.Source || t.Source.IsRoot || s.Path.StartsWith(t.Source.Path + ".", StringComparison.Ordinal)).Select(s => s.Path).ToList();
            return inside.Count > 0 ? inside : [t.Source.Path];
        }

{{- if named }}

        // The steps whose points a verb runs (decisions 11 and 34), in run order: the named trigger points that cover the subject; this
        // lifecycle; and for an object, link or own verb each other lifecycle with points on it that governs the object, by name. Only those
        // with points on the verb are listed.
        private List<{{ rights_ns }}.ITriggerPointSteps> Lifecycles(Verb verb, IReadOnlyDictionary<string, IReadOnlyList<string>> states) =>
            [.. new[] { _chart.TypeSteps }.OfType<{{ rights_ns }}.ITriggerPointSteps>().Where(s => s.Speaks(verb)), .. _chart.TriggerSteps.Where(s => s.Speaks(verb)
{{- else }}

        // The lifecycles whose points a verb runs (decision 11), in run order: this lifecycle; and for an object, link or own verb each other
        // lifecycle with points on it that governs the object, by name. Only those with points on the verb are listed.
        private List<{{ rights_ns }}.ITriggerPointSteps> Lifecycles(Verb verb, IReadOnlyDictionary<string, IReadOnlyList<string>> states) =>
            [.. _chart.TriggerSteps.Where(s => s.Speaks(verb)
{{- end }}
                && (string.Equals(s.Lifecycle, _chart.ProcessName, StringComparison.Ordinal) || (SpeaksOfObject(verb) && states.ContainsKey(s.Lifecycle))))];

        private {{ rights_ns }}.TriggerPointCall NewCall(Verb verb, IReadOnlyDictionary<string, IReadOnlyList<string>> states) => new()
        {
            Verb = verb,
            Lifecycle = _chart.ProcessName,
            Entity = {{ named ? "_owner._behaviour is IObjectEntity<TContext> own ? own.EntityOf(Call()) : (Steps ?? _chart.TypeSteps)?.Subject" : "Steps?.Subject" }},
            Instance = _snapshot.Instance,
            Envelope = _envelope,
            Held = {{ rights ? "Held" : "[]" }},
            States = states,
            Event = Event.Name,
            Payload = Event.Payload,
        };

        // Rows 8 and 9 for a candidate: its before actions fill the proposed values, then its checks run. On a gated move, sign's points run
        // on every signature, and the move's only on the occurrence that would complete the gate, after sign's on the same scratch copy; a
        // refusing check there leaves the signature uncounted and audited as refused. Returns the refusing check's id, or null.
        public string? Checks(TransitionDefinition t)
        {
            _candidates.Remove(t);
            if (_chart.TriggerSteps.Count == 0{{ if named }} && _chart.TypeSteps is null{{ end }})
                return null;
            var verb = VerbOf(t);
            var call = NewCall(verb ?? default, States(verb, SourceStates(t))) with { Entered = EnteredBy(t), Transition = t.Id };
            var candidate = new Candidate(verb, call);
            var completes = true;
{{- if approvals }}

            // On an approval the response's verb runs where sign's run (signoff-design.md decision 17); one that needs nothing moves as a move
            // without a gate.
            var gated = t.Gate is { } open && (!IsApproval(open) || OpenApproval(t)) ? t.Gate : null;
            if (gated is { } gate)
            {
                var response = IsApproval(gate) ? Response : SignatureResponse.Sign;
                if (ResponseVerb(response) is { } responding && Responders(responding) is { Count: > 0 } signing)
                {
                    candidate.Sign = Ready(signing, responding, call with { Verb = responding });
                    if (!candidate.Sign.Passed)
                        return RefuseSignature(t, gate, candidate.Sign);
                }

                completes = response == SignatureResponse.Sign && WouldComplete(t, gate);
            }

            if (completes && verb is { } v && Lifecycles(v, call.States) is { Count: > 0 } lifecycles)
            {
                candidate.Lifecycles = lifecycles;
                candidate.Move = Ready(lifecycles, v, call);
                if (!candidate.Move.Passed)
                    return gated is { } g ? RefuseSignature(t, g, candidate.Move) : candidate.Move.RefusedBy;
            }
{{- else }}
            if (t.Gate is { } gate)
            {
{{- if verb_keys["sign"] }}
{{- if named }}
                if (Own({{ verb_type }}.Sign) is { Count: > 0 } signing)
                {
                    candidate.Sign = Ready(signing, {{ verb_type }}.Sign, call with { Verb = {{ verb_type }}.Sign });
{{- else }}
                if (Steps is { } own && own.Speaks({{ verb_type }}.Sign))
                {
                    candidate.Sign = Ready([own], {{ verb_type }}.Sign, call with { Verb = {{ verb_type }}.Sign });
{{- end }}
                    if (!candidate.Sign.Passed)
                        return RefuseSignature(t, gate, candidate.Sign);
                }

{{- end }}
                completes = WouldComplete(t, gate);
            }

            if (completes && verb is { } v && Lifecycles(v, call.States) is { Count: > 0 } lifecycles)
            {
                candidate.Lifecycles = lifecycles;
                candidate.Move = Ready(lifecycles, v, call);
                if (!candidate.Move.Passed)
                    return t.Gate is { } g ? RefuseSignature(t, g, candidate.Move) : candidate.Move.RefusedBy;
            }
{{- end }}

            _candidates[t] = candidate;
            return null;
        }

        // Before actions, then checks, across the lifecycles (decision 19): each moment in every lifecycle before the next.
        private static {{ rights_ns }}.TriggerPointOutcome Ready(IReadOnlyList<{{ rights_ns }}.ITriggerPointSteps> lifecycles, Verb verb, {{ rights_ns }}.TriggerPointCall call)
        {
            var outcome = new {{ rights_ns }}.TriggerPointOutcome();
            foreach (var steps in lifecycles)
                steps.Before(verb, call, outcome);
            foreach (var steps in lifecycles)
            {
                if (outcome.Passed)
                    steps.Check(verb, call, outcome);
            }

            return outcome;
        }

        private string? RefuseSignature(TransitionDefinition t, GateDefinition gate, {{ rights_ns }}.TriggerPointOutcome outcome)
        {
            Audit(gate, t, _envelope?.Signer, _envelope?.Actor, Meaning(gate), _envelope?.Reason, GateOutcome.Refused, AuditValues{{ if approvals }}, IsApproval(gate) ? _picks.GetValueOrDefault(t) : null{{ end }});
            return outcome.RefusedBy;
        }

        // Whether this occurrence would complete the gate, worked out without counting it.
        private bool WouldComplete(TransitionDefinition t, GateDefinition gate)
        {
{{- if approvals }}
            if (IsApproval(gate))
                return WouldRespond(t, gate);
{{- end }}
            var signatures = new List<SignatureEntry>(_signatures.TryGetValue(t, out var existing) ? existing : []);
            signatures.Add(new SignatureEntry(_envelope?.Signer ?? "", _envelope?.Actor ?? "", Meaning(gate), _envelope?.Reason));
            return signatures.Count >= Math.Max(1, gate.Required)
                && gate.RequiredActors.All(a => signatures.Any(s => {{ has_members ? (actors_type + ".Accepts(a, s.Actor)") : "string.Equals(s.Actor, a, StringComparison.Ordinal)" }}));
        }

        // The state paths a move enters, compound states included.
        private List<string> EnteredBy(TransitionDefinition t)
        {
            var toEnter = new HashSet<StateDefinition>();
            if (t.Targets.Count > 0)
            {
                var domain = Domain(t);
                foreach (var s in t.Targets)
                    AddDescendants(s, toEnter, 0);
                foreach (var s in EffectiveTargets(t))
                    AddAncestors(s, domain, toEnter, 0);
            }

            return [.. toEnter.Where(s => !s.IsRoot).OrderBy(s => s.Index).Select(s => s.Path)];
        }

        // An admitted signature: sign's before values are written, the signature is counted, then sign's with-change points run and its
        // after-commit points are queued. On the completing occurrence the move's before actions and checks are listed with sign's.
        private bool Signed(TransitionDefinition t, GateDefinition gate)
        {
{{- if named }}
            if (!_candidates.TryGetValue(t, out var candidate))
                return {{ approvals ? "Admit" : "Sign" }}(t, gate);
{{- else }}
            if (Steps is not { } steps || !_candidates.TryGetValue(t, out var candidate))
                return {{ approvals ? "Admit" : "Sign" }}(t, gate);
{{- end }}
            ListRan(candidate.Sign, null);
            if (candidate.Move is not null)
            {
                ListRan(candidate.Move, null);
                candidate.Listed = true;
            }

            Write(candidate.Sign, null);
            var complete = {{ approvals ? "Admit" : "Sign" }}(t, gate);
{{- if approvals }}
            if (candidate.Sign is not null && ResponseVerb(IsApproval(gate) ? Response : SignatureResponse.Sign) is { } responding)
                Change(Responders(responding), responding, [candidate.Call with { Verb = responding }]);
{{- else if verb_keys["sign"] }}
            if (candidate.Sign is not null)
                Change({{ named ? ("Own(" + verb_type + ".Sign)") : "[steps]" }}, {{ verb_type }}.Sign, [candidate.Call with { Verb = {{ verb_type }}.Sign }]);
{{- end }}
            return complete;
        }

        // complete's before actions and checks for a human task, before its transition is picked; null when the lifecycle has none.
        public {{ rights_ns }}.TriggerPointOutcome? TaskChecks()
        {
{{- if verb_keys["complete"] }}
{{- if named }}
            if (Own({{ verb_type }}.Complete) is not { Count: > 0 } steps)
                return null;
            var call = NewCall({{ verb_type }}.Complete, States(null, Live()));
            var outcome = Ready(steps, {{ verb_type }}.Complete, call);
{{- else }}
            if (Steps is not { } steps || !steps.Speaks({{ verb_type }}.Complete))
                return null;
            var call = NewCall({{ verb_type }}.Complete, States(null, Live()));
            var outcome = Ready([steps], {{ verb_type }}.Complete, call);
{{- end }}
            _task = (outcome, call);
            return outcome;
{{- else }}
            return null;
{{- end }}
        }

        // The task's end, as a verb of its own: complete's points and the selected transition's are listed, complete's before values are
        // written, then its with-change points run and its after-commit points are queued. The transition's rows 10 to 12 follow in Microstep.
        public void Completed(IReadOnlyList<TransitionDefinition> selected)
        {
{{- if named }}
            if (_task is not { } task)
                return;
{{- else }}
            if (Steps is not { } steps || _task is not { } task)
                return;
{{- end }}
            ListRan(task.Outcome, null);
            foreach (var t in selected)
            {
                if (_candidates.TryGetValue(t, out var c) && !c.Listed)
                {
                    ListRan(c.Move, null);
                    c.Listed = true;
                }
            }

            Write(task.Outcome, null);
{{- if verb_keys["complete"] }}
            Change({{ named ? ("Own(" + verb_type + ".Complete)") : "[steps]" }}, {{ verb_type }}.Complete, [task.Call]);
{{- end }}
        }

        // Before the exit actions: the taken transitions' proposed values are written, once per point, in selection order, so the later
        // wins when two set one attribute; their points are listed once per microstep.
        private List<Candidate> Taken(IReadOnlyList<TransitionDefinition> transitions)
        {
            var taken = new List<Candidate>();
            var once = new HashSet<string>(StringComparer.Ordinal);
            var written = new HashSet<string>(StringComparer.Ordinal);
            foreach (var t in transitions)
            {
                if (!_candidates.Remove(t, out var candidate))
                    continue;
                if (!candidate.Listed)
                    ListRan(candidate.Move, once);
                Write(candidate.Move, written);
                taken.Add(candidate);
            }

            return taken;
        }

        // After the entry actions: the taken transitions' with-change points, once per point, then their after-commit points queued.
        private void Changed(List<Candidate> taken)
        {
            foreach (var group in taken.Where(c => c.Verb is not null && c.Lifecycles.Count > 0).GroupBy(c => c.Verb!.Value))
                Change(group.First().Lifecycles, group.Key, [.. group.Select(c => c.Call)]);
        }

        // A verb's with-change points over the object after it, then its after-commit points queued, each point once, the lifecycles in run
        // order within each moment (decision 19). This lifecycle reads its states after the move; the others' are unchanged.
        private void Change(IReadOnlyList<{{ rights_ns }}.ITriggerPointSteps> lifecycles, Verb verb, IReadOnlyList<{{ rights_ns }}.TriggerPointCall> calls)
        {
            var live = Live();
            var after = calls.Select(c => c with { Verb = verb, States = new Dictionary<string, IReadOnlyList<string>>(c.States, StringComparer.Ordinal) { [_chart.ProcessName] = live } }).ToList();
            var change = new {{ rights_ns }}.TriggerPointOutcome();
            foreach (var call in after)
            {
                foreach (var steps in lifecycles)
                    steps.With(verb, call, change);
            }

            _ran.AddRange(change.Ran);
            var queued = new {{ rights_ns }}.TriggerPointOutcome();
            foreach (var call in after)
            {
                foreach (var steps in lifecycles)
                    steps.After(verb, call, queued);
            }

            _queued.AddRange(queued.Ran);
            _messages.AddRange(queued.Messages);
        }

        private void ListRan({{ rights_ns }}.TriggerPointOutcome? outcome, HashSet<string>? once)
        {
            if (outcome is null)
                return;
            foreach (var id in outcome.Ran)
            {
                if (once is null || once.Add(id))
                    _ran.Add(id);
            }

            foreach (var w in outcome.Warnings)
            {
                if (!_warnings.Any(x => string.Equals(x.Id, w.Id, StringComparison.Ordinal)))
                    _warnings.Add(w);
            }
        }

        private static void Write({{ rights_ns }}.TriggerPointOutcome? outcome, HashSet<string>? written)
        {
            if (outcome is null)
                return;
            foreach (var (id, write) in outcome.Records)
            {
                if (written is null || written.Add(id))
                    write();
            }
        }

        // The ids the step lists: those that ran, the refusing check once, then the after-commit points as queued.
        private List<string> Listed()
        {
            var listed = new List<string>(_ran);
            if (_refusal == Refusals.Check && _refusedBy is { } by && !listed.Contains(by, StringComparer.Ordinal))
                listed.Add(by);
            listed.AddRange(_queued);
            return listed;
        }
{{- end }}

        private bool Sign(TransitionDefinition t, GateDefinition gate)
        {
            if (!_signatures.TryGetValue(t, out var signatures))
                _signatures[t] = signatures = [];
            var meaning = Meaning(gate);
            signatures.Add(new SignatureEntry(_envelope!.Signer!, _envelope.Actor!, meaning, _envelope.Reason));
            Audit(gate, t, _envelope.Signer, _envelope.Actor, meaning, _envelope.Reason, GateOutcome.Signed, AuditValues);
{{- if approvals }}
            RecordAct(_envelope.Signer, "sign", null);
{{- end }}
            var complete = signatures.Count >= Math.Max(1, gate.Required)
                && gate.RequiredActors.All(a => signatures.Any(s => {{ has_members ? (actors_type + ".Accepts(a, s.Actor)") : "string.Equals(s.Actor, a, StringComparison.Ordinal)" }}));
            if (complete)
            {
                Audit(gate, t, _envelope.Signer, _envelope.Actor, meaning, _envelope.Reason, GateOutcome.Completed, AuditValues);
{{- if approvals }}

                // The gated move is done by everyone whose signature counted (signoff-design.md decision 15).
                foreach (var s in signatures)
                    RecordAct(s.Signer, MoveVerb(t), t.Id);
{{- end }}
                signatures.Clear();
            }

            return complete;
        }

        private void Audit(GateDefinition gate, TransitionDefinition t, string? signer, string? actor, string? meaning, string? reason, GateOutcome outcome,
            IReadOnlyDictionary<string, object?> attributes) =>
            _audit.Add(new GateAuditRecord(_snapshot.Instance, _chart.ProcessId, gate.Id, t.Id, ++_auditSequence, signer, _chart.ActorId(actor),
                gate.MeaningId(meaning), reason, Clock, outcome, attributes));
{{- if approvals }}

        // ---- approvals (signoff-design.md sections 8 and 10) ----

        private readonly Dictionary<TransitionDefinition, ApprovalProgress> _approvals = [];
        private readonly List<ActRecord> _acts = [];

        // The named signature each gated candidate answers in this input, from row 7 to its admit.
        private readonly Dictionary<TransitionDefinition, SignatureDefinition> _picks = [];

        // The entry of the source of each approval that completed in this input, kept for the round that starts again where its move stays.
        private readonly Dictionary<TransitionDefinition, long> _restart = [];

        // The input's sequence number for the record of acts, worked out when the run loads.
        private long _sequence;

        private SignatureResponse Response => _envelope?.Response ?? SignatureResponse.Sign;

        private static bool IsApproval(GateDefinition gate) => gate.Stages.Count > 0;

        // An approval's named signatures in file order: stage, then signature.
        private static IEnumerable<SignatureDefinition> Signatures(GateDefinition gate) => gate.Stages.SelectMany(s => s.Signatures);

        private static StageDefinition StageOf(GateDefinition gate, SignatureDefinition signature) => gate.Stages.First(s => s.Signatures.Contains(signature));

        private static string ResponseKey(SignatureResponse response) => response switch
        {
            SignatureResponse.Reject => "reject",
            SignatureResponse.Ignore => "ignore",
            SignatureResponse.Withdraw => "withdraw",
            _ => "sign",
        };
{{- if rights || triggers }}

        // The verb a response does, which its rights and trigger points speak of (decisions 17 and 18); null when the project has no such verb.
        private static {{ verb_type }}? ResponseVerb(SignatureResponse response) => response switch
        {
            SignatureResponse.Reject => {{ verb_keys["reject"] ? (verb_type + ".Reject") : "null" }},
            SignatureResponse.Ignore => {{ verb_keys["ignore"] ? (verb_type + ".Ignore") : "null" }},
            SignatureResponse.Withdraw => {{ verb_keys["withdraw"] ? (verb_type + ".Withdraw") : "null" }},
            _ => {{ verb_keys["sign"] ? (verb_type + ".Sign") : "null" }},
        };
{{- end }}
{{- if triggers }}

        // The steps a response's verb runs at an approval, where sign's run (decision 17).
        private List<{{ rights_ns }}.ITriggerPointSteps> Responders({{ verb_type }} verb) => {{ named ? "Own(verb)" : "Steps is { } own && own.Speaks(verb) ? [own] : []" }};

        // Whether this response would complete the approval, worked out without counting it: nothing is needed, or a signature on the picked
        // signature completes the round.
        private bool WouldRespond(TransitionDefinition t, GateDefinition gate)
        {
            var approval = ApprovalOf(t, gate);
            return approval.Needed.Count == 0 || (Response == SignatureResponse.Sign && _picks.TryGetValue(t, out var picked)
                && RoundDone(gate, approval, [.. approval.Signed, new SignatureEntry(_envelope?.Signer ?? "", _envelope?.Actor ?? "", null, null) { Signature = picked.Id }]));
        }
{{- end }}
{{- if rights }}

        // Whether an actor's signing counts as an allow for the gated event (decision 18): a gate's signers; an approval's, the signers of the
        // signatures its round needs; an approval that needs nothing is checked as a move without a gate (decision 7).
        private bool SignersAllow(TransitionDefinition t, GateDefinition gate, string actor) =>
            !IsApproval(gate) ? Allows(gate.Signers, actor) : ApprovalOf(t, gate) is { Needed.Count: > 0 } approval && Allows(NeededSigners(gate, approval), actor);
{{- end }}

        private static bool Allows(IReadOnlyList<string> actors, string actor) => {{ has_members ? (actors_type + ".Allows(actors, actor)") : "actors.Contains(actor, StringComparer.Ordinal)" }};

        private static bool Accepts(string required, string actor) => {{ has_members ? (actors_type + ".Accepts(required, actor)") : "string.Equals(actor, required, StringComparison.Ordinal)" }};

        // The person an input is (decision 15): the envelope's signer; nobody for a time input or an automatic move.
        private string? Person() => _envelope?.Signer is { Length: > 0 } signer ? signer : null;
{{- if model.verbs.size > 0 }}

        // The verb a move does, as the record of acts keeps it: its event's, else its own; null without one.
        private string? MoveVerb(TransitionDefinition t) => (t.Trigger == TriggerKind.Event ? _chart.Event(t.Key)?.Verb : t.Verb) is { } verb ? global::{{ base_ns }}.Verbs.Key(verb) : null;
{{- else }}

        // The verb a move does, as the record of acts keeps it: none, since no event or move of the project names a verb.
        private static string? MoveVerb(TransitionDefinition t) => null;
{{- end }}

        // Records an act of a person, only in a chart that keeps the record (decision 28); nobody's act is never recorded.
        private void RecordAct(string? person, string? verb, string? transition)
        {
            if (_chart.RecordsActs && !string.IsNullOrEmpty(person) && (verb is not null || transition is not null))
                _acts.Add(new ActRecord(_sequence, person, verb, transition));
        }

        // Whoever sent an event did the moves it takes that have no gate.
        public void Sent(IReadOnlyList<TransitionDefinition> transitions)
        {
            foreach (var t in transitions)
            {
                if (t.Gate is null)
                    RecordAct(Person(), MoveVerb(t), t.Id);
            }
        }

        // Drops the acts no waiting notBy can read (decision 28): those older than the earliest entry of an active source of an approval with
        // a notBy; all of them when there is none.
        private void TrimActs()
        {
            if (_acts.Count == 0)
                return;
            long? earliest = null;
            foreach (var (t, approval) in _approvals)
            {
                if (_config.Contains(t.Source) && Signatures(t.Gate!).Any(s => s.NotByVerbs.Count > 0 || s.NotByTransitions.Count > 0)
                    && (earliest is null || approval.Entered < earliest))
                    earliest = approval.Entered;
            }

            _acts.RemoveAll(a => earliest is null || a.Sequence < earliest);
        }

        // The approval of a gated move whose source is active; its round starts now if it has not (it starts on entry, so this is a fallback).
        private ApprovalProgress ApprovalOf(TransitionDefinition t, GateDefinition gate) =>
            _approvals.TryGetValue(t, out var approval) ? approval : StartApproval(t, gate, _sequence);

        // Whether a gated move holds an open approval: one with something needed.
        private bool OpenApproval(TransitionDefinition t) => t.Gate is { } gate && IsApproval(gate) && ApprovalOf(t, gate).Needed.Count > 0;

        // Starts the round (decision 7): a signature with a condition is needed unless the lifecycle's IApprovalConditions says it isn't;
        // without one, every signature is needed.
        private ApprovalProgress StartApproval(TransitionDefinition t, GateDefinition gate, long entered)
        {
            var approval = new ApprovalProgress { Started = Clock, Entered = entered };
            var states = Call().States;
            foreach (var stage in gate.Stages)
            {
                foreach (var signature in stage.Signatures)
                {
                    if (signature.When is null || _owner._behaviour is not IApprovalConditions<TContext> conditions
                        || conditions.Needed(signature.Id, new ApprovalCall<TContext>(_snapshot.Instance, Context, _chart.ProcessName, gate.Name, stage.Name, signature.Name, states)))
                        approval.Needed.Add(signature.Id);
                }
            }

            _approvals[t] = approval;
            return approval;
        }

        // Round 1 starts when the object enters a gated move's source state, and again where a gated move completed without leaving it.
        private void StartApprovals(IReadOnlyList<TransitionDefinition> transitions, List<StateDefinition> arrived)
        {
            foreach (var s in arrived)
            {
                foreach (var t in s.Transitions)
                {
                    if (t.Trigger == TriggerKind.Event && t.Gate is { } gate && IsApproval(gate))
                        StartApproval(t, gate, _sequence);
                }
            }

            foreach (var t in transitions)
            {
                if (t.Gate is { } gate && IsApproval(gate) && _config.Contains(t.Source) && !arrived.Contains(t.Source))
                    StartApproval(t, gate, _restart.TryGetValue(t, out var entered) ? entered : _sequence);
            }
        }

        // Whether a signature has its count and each of its required actors signed, among the signatures given.
        private static bool IsComplete(SignatureDefinition signature, IEnumerable<SignatureEntry> signed)
        {
            var own = signed.Where(s => string.Equals(s.Signature, signature.Id, StringComparison.Ordinal)).ToList();
            return own.Count >= Math.Max(1, signature.Required) && signature.RequiredActors.All(a => own.Any(s => Accepts(a, s.Actor)));
        }

        // Whether every signature the round needs is complete with the signatures given (decision 4).
        private static bool RoundDone(GateDefinition gate, ApprovalProgress approval, IReadOnlyList<SignatureEntry> signed) =>
            Signatures(gate).Where(s => approval.Needed.Contains(s.Id)).All(s => IsComplete(s, signed));

        // The signers of the signatures the round needs, in file order, each once.
        private static List<string> NeededSigners(GateDefinition gate, ApprovalProgress approval) =>
            [.. Signatures(gate).Where(s => approval.Needed.Contains(s.Id)).SelectMany(s => s.Signers).Distinct(StringComparer.Ordinal)];

        // Row 7c (decision 15): the person did a verb or move the signature's notBy names since the object entered the gated move's source
        // state, the move that entered it included.
        private bool Excluded(SignatureDefinition signature, ApprovalProgress approval, string? person) =>
            person is not null && (signature.NotByVerbs.Count > 0 || signature.NotByTransitions.Count > 0)
            && _acts.Any(a => a.Sequence >= approval.Entered && string.Equals(a.Signer, person, StringComparison.Ordinal)
                && ((a.Verb is not null && signature.NotByVerbs.Contains(a.Verb, StringComparer.Ordinal))
                    || (a.Transition is not null && signature.NotByTransitions.Contains(a.Transition, StringComparer.Ordinal))));

        // Row 7d by response (decision 14): an earlier answer of the person on this approval blocks the response.
        private static bool Repeated(GateDefinition gate, ApprovalProgress approval, SignatureDefinition signature, SignatureResponse response, string? person)
        {
            bool Mine(SignatureEntry e) => string.Equals(e.Signer, person, StringComparison.Ordinal);
            bool Here(SignatureEntry e) => Mine(e) && string.Equals(e.Signature, signature.Id, StringComparison.Ordinal);
            var elsewhere = !gate.AllowSignerAcrossSignatures && approval.Signed.Concat(approval.Ignored).Any(e => Mine(e) && !Here(e));
            return response switch
            {
                SignatureResponse.Sign => (approval.Signed.Any(Here) && !signature.AllowRepeatSigner) || approval.Ignored.Any(Here) || elsewhere,
                SignatureResponse.Ignore => approval.Signed.Any(Here) || approval.Ignored.Any(Here) || elsewhere,
                SignatureResponse.Reject => approval.Ignored.Any(e => Here(e) || (Mine(e) && !gate.AllowSignerAcrossSignatures)),
                _ => false,
            };
        }

        // A gate's row 7: a gate without stages checks its signers; an approval with something needed, the signature the response answers;
        // an approval that needs nothing is checked as a move without a gate (decision 7).
        private string? CheckGate(TransitionDefinition t, GateDefinition gate) =>
            !IsApproval(gate) ? CheckSigner(t, gate) : ApprovalOf(t, gate) is { Needed.Count: > 0 } approval ? CheckApproval(t, gate, approval) : null;

        // Row 7 of decision 14 on an approval: the signature the response answers (the envelope's, else the one decision 8 picks), then its
        // signers, the lifecycle's denies on the response's verb, notBy, an earlier answer, nothing to withdraw and a reason, in that order. A
        // refused attempt is audited refused, with the signature when one was found.
        private string? CheckApproval(TransitionDefinition t, GateDefinition gate, ApprovalProgress approval)
        {
            var actor = _envelope?.Actor;
            var signer = _envelope?.Signer;
            var response = Response;
            _picks.Remove(t);
            string? refusal = null;
            SignatureDefinition? signature;
            if (_envelope?.Signature is { } named && Signatures(gate).FirstOrDefault(s => string.Equals(s.Name, named, StringComparison.Ordinal)) is { } given)
            {
                // A signature the round doesn't need asks nobody to sign: no one meets its signers now.
                signature = given;
                if (!approval.Needed.Contains(given.Id))
                    refusal = Refusals.GateSigner;
            }
            else
            {
                (signature, refusal) = Pick(gate, approval, response, actor, signer);
            }

            if (refusal is null && signature is not null)
            {
                if (actor is null || string.IsNullOrEmpty(signer) || !Allows(signature.Signers, actor){{ resolves("_snapshot", "actor", "_envelope!") | string.replace "!Resolves(" "!_owner.Resolves(" }})
                    refusal = Refusals.GateSigner;
{{- if rights }}
                else if (ResponseVerb(response) is { } verb && CheckRights(verb, [gate.Id]) is { Allowed: false } denied)
                {
                    refusal = denied.Refusal;
                    _signRefusedBy = denied.RefusedBy;
                }
{{- end }}
                else if (Excluded(signature, approval, signer))
                    refusal = Refusals.GateExcluded;
                else if (Repeated(gate, approval, signature, response, signer) || (response == SignatureResponse.Sign && IsComplete(signature, approval.Signed)))
                    refusal = Refusals.GateRepeat;
                else if (response == SignatureResponse.Withdraw
                    && !approval.Signed.Any(s => string.Equals(s.Signer, signer, StringComparison.Ordinal) && string.Equals(s.Signature, signature.Id, StringComparison.Ordinal)))
                    refusal = Refusals.GateNotSigned;
                else if (gate.ReasonRequired && string.IsNullOrWhiteSpace(_envelope?.Reason))
                    refusal = Refusals.GateReason;
            }

            if (signature is not null)
                _picks[t] = signature;
            if (refusal is not null)
                Audit(gate, t, signer, actor, Meaning(gate), _envelope?.Reason, GateOutcome.Refused, AuditValues, signature);
            return refusal;
        }

        // Decision 8's pick, the same way every time: withdraw takes the person's latest signature in the round; reject the first needed
        // signature whose signers the person meets, complete or not; sign and ignore, among the needed signatures not complete, the first the
        // person may fill (rows 7a, 7c and 7d) where they meet a required actor not yet signed, else the first they may fill, else the first
        // whose signers they meet, so that row 7 refuses on it.
        private (SignatureDefinition? Signature, string? Refusal) Pick(GateDefinition gate, ApprovalProgress approval, SignatureResponse response, string? actor, string? signer)
        {
            var needed = Signatures(gate).Where(s => approval.Needed.Contains(s.Id)).ToList();
            bool Meets(SignatureDefinition s) => actor is not null && !string.IsNullOrEmpty(signer) && Allows(s.Signers, actor);
            if (response == SignatureResponse.Withdraw)
            {
                var latest = approval.Signed.LastOrDefault(s => string.Equals(s.Signer, signer, StringComparison.Ordinal))?.Signature;
                return needed.FirstOrDefault(s => string.Equals(s.Id, latest, StringComparison.Ordinal)) is { } mine ? (mine, null) : (null, Refusals.GateNotSigned);
            }

            if (response == SignatureResponse.Reject)
                return needed.FirstOrDefault(Meets) is { } first ? (first, null) : (null, Refusals.GateSigner);
            SignatureDefinition? fill = null, met = null;
            foreach (var s in needed)
            {
                if (IsComplete(s, approval.Signed) || !Meets(s))
                    continue;
                met ??= s;
                if (Excluded(s, approval, signer) || Repeated(gate, approval, s, response, signer))
                    continue;
                if (s.RequiredActors.Any(a => Accepts(a, actor!) && !approval.Signed.Any(c => string.Equals(c.Signature, s.Id, StringComparison.Ordinal) && Accepts(a, c.Actor))))
                    return (s, null);
                fill ??= s;
            }

            return (fill ?? met) is { } picked ? (picked, null) : (null, Refusals.GateSigner);
        }

        // An admitted occurrence: a response on an approval, else a signature on a gate.
        private bool Admit(TransitionDefinition t, GateDefinition gate) => IsApproval(gate) ? Respond(t, gate) : Sign(t, gate);

        // The response's effect on an approval, already checked by row 7 (decisions 7 and 10 to 13): with nothing needed the occurrence
        // completes it; a signature is counted, and completes it when every signature the round needs is complete; an ignore finishes the
        // person on the signature; a withdraw takes their latest signature on it back; a rejection clears the approval and starts its round
        // again. Whether the move follows.
        private bool Respond(TransitionDefinition t, GateDefinition gate)
        {
            var approval = ApprovalOf(t, gate);
            var meaning = Meaning(gate);
            var signer = _envelope?.Signer;
            var actor = _envelope?.Actor;
            var reason = _envelope?.Reason;
            if (approval.Needed.Count == 0)
            {
                // Nothing is needed: the move runs as if there were no gate, done by whoever sent it.
                Audit(gate, t, signer, actor, meaning, reason, GateOutcome.Completed, AuditValues);
                RecordAct(Person(), MoveVerb(t), t.Id);
                Close(t, approval);
                return true;
            }

            var signature = _picks[t];
            var entry = new SignatureEntry(signer!, actor!, meaning, reason) { Signature = signature.Id, Stage = StageOf(gate, signature).Id };
            RecordAct(signer, ResponseKey(Response), null);
            switch (Response)
            {
                case SignatureResponse.Sign:
                    approval.Signed.Add(entry);
                    Audit(gate, t, signer, actor, meaning, reason, GateOutcome.Signed, AuditValues, signature);
                    if (!RoundDone(gate, approval, approval.Signed))
                        return false;
                    Audit(gate, t, signer, actor, meaning, reason, GateOutcome.Completed, AuditValues);

                    // A gated move is done by everyone whose signature counted toward the approval that made it (decision 15).
                    foreach (var s in approval.Signed)
                        RecordAct(s.Signer, MoveVerb(t), t.Id);
                    Close(t, approval);
                    return true;
                case SignatureResponse.Ignore:
                    approval.Ignored.Add(entry);
                    Audit(gate, t, signer, actor, meaning, reason, GateOutcome.Ignored, AuditValues, signature);
                    return false;
                case SignatureResponse.Withdraw:
                    var at = approval.Signed.FindLastIndex(s => string.Equals(s.Signer, signer, StringComparison.Ordinal) && string.Equals(s.Signature, signature.Id, StringComparison.Ordinal));
                    if (at >= 0)
                        approval.Signed.RemoveAt(at);
                    Audit(gate, t, signer, actor, meaning, reason, GateOutcome.Withdrawn, AuditValues, signature);
                    return false;
                default:
                    // A veto: it clears every signature of this approval and moves nothing; its round starts again at once (decision 10).
                    Audit(gate, t, signer, actor, meaning, reason, GateOutcome.Rejected, AuditValues, signature);
                    StartApproval(t, gate, approval.Entered);
                    return false;
            }
        }

        // A completed approval ends; where its move stays in the source, StartApprovals starts its round again from the same entry.
        private void Close(TransitionDefinition t, ApprovalProgress approval)
        {
            _restart[t] = approval.Entered;
            _approvals.Remove(t);
        }

        private void Audit(GateDefinition gate, TransitionDefinition t, string? signer, string? actor, string? meaning, string? reason, GateOutcome outcome,
            IReadOnlyDictionary<string, object?> attributes, SignatureDefinition? signature) =>
            _audit.Add(new GateAuditRecord(_snapshot.Instance, _chart.ProcessId, gate.Id, t.Id, ++_auditSequence, signer, _chart.ActorId(actor),
                gate.MeaningId(meaning), reason, Clock, outcome, attributes) { Signature = signature?.Id, Stage = signature is null ? null : StageOf(gate, signature).Id });
{{- end }}

        // ---- microstep ----

        public void RunToCompletion()
        {
            while (!Done)
            {
                var always = Select(TriggerKind.Always, "", external: false);
                if (always.Transitions.Count > 0)
                {
                    Microstep(always.Transitions);
                    continue;
                }

                if (_queue.Count == 0)
                    break;
                var (kind, key) = _queue.Dequeue();
                var saved = Event;
                List<TransitionDefinition> transitions;
                if (kind == TriggerKind.Event)
                {
                    Event = new ProcessEvent(key, null, new Dictionary<string, object?>());
                    transitions = Select(TriggerKind.Event, key, external: false).Transitions;
                }
                else
                {
                    transitions = _chart.State(key) is { } state && _config.Contains(state) ? SelectAt(state, TriggerKind.Done, "").Transitions : [];
                }

                if (transitions.Count > 0)
                    Microstep(transitions);
                Event = saved;
            }
        }

        public void Microstep(IReadOnlyList<TransitionDefinition> transitions, StateDefinition? initial = null)
        {
            if (++_micro > _owner._maxMicrosteps)
                throw new MacrostepOverflowException();
{{- if triggers }}

            // The taken transitions' proposed values are written first, once per point (trigger-points-design.md decision 18).
            var taken = Taken(transitions);
{{- end }}

            // Exit, in reverse document order, recording history first.
            var exitSet = new HashSet<StateDefinition>();
            foreach (var t in transitions)
                exitSet.UnionWith(ExitSet(t));
            var exiting = exitSet.OrderByDescending(s => s.Index).ToList();
            foreach (var s in exiting)
            {
                foreach (var h in s.Children.Where(c => c.Kind == StateKind.History))
                {
                    _history[h] = h.DeepHistory
                        ? [.. _config.Where(c => c.IsLeaf && c.IsDescendantOf(s)).OrderBy(c => c.Index)]
                        : [.. _config.Where(c => ReferenceEquals(c.Parent, s)).OrderBy(c => c.Index)];
                }
            }

            foreach (var s in exiting)
            {
                foreach (var action in s.Exit)
                    RunAction(action);
                Cancel(s);
                _config.Remove(s);
            }

            // Transition actions, in transition order.
            foreach (var t in transitions)
            {
                foreach (var action in t.Actions)
                    RunAction(action);
            }

            // Entry, in document order.
            var toEnter = new HashSet<StateDefinition>();
            if (initial is not null)
            {
                AddDescendants(initial, toEnter, 0);
                AddAncestors(initial, _chart.Root, toEnter, 0);
            }

            foreach (var t in transitions)
            {
                if (t.Targets.Count == 0)
                    continue;
                var domain = Domain(t);
                foreach (var s in t.Targets)
                    AddDescendants(s, toEnter, 0);
                foreach (var s in EffectiveTargets(t))
                    AddAncestors(s, domain, toEnter, 0);
            }

            var doneQueued = new HashSet<StateDefinition>();
{{- if approvals }}
            var arrived = new List<StateDefinition>();
{{- end }}
            foreach (var s in toEnter.OrderBy(s => s.Index))
            {
                if (s.IsRoot || !_config.Add(s))
                    continue;
{{- if approvals }}
                arrived.Add(s);
{{- end }}
                foreach (var action in s.Entry)
                    RunAction(action);
                foreach (var timer in s.Timers)
                {
                    var entry = new Timer(timer, Clock.AddTicks(timer.AfterTicks!.Value), ++_timerSequence);
                    Timers.Add(entry);
                    _scheduled.Add(new TimerRequest(_chart.ProcessName, _snapshot.Instance, timer.Id, entry.Due));
                }

                foreach (var invoke in s.Invokes)
                {
                    Pending.Add(invoke);
                    _started.Add(Request(invoke));
                }

                if (s.Kind == StateKind.Final && s.Parent is { } parent)
                {
                    if (parent.IsRoot)
                    {
                        Done = true;
                    }
                    else
                    {
                        // A final child completes a compound parent; a parallel state completes when every region is final, and
                        // that completion travels up through enclosing parallel states (each queued once per microstep).
                        if (parent.Kind != StateKind.Parallel && doneQueued.Add(parent))
                            _queue.Enqueue((TriggerKind.Done, parent.Path));
                        for (var marker = parent.Kind == StateKind.Parallel ? parent : parent.Parent;
                             marker is { Kind: StateKind.Parallel, IsRoot: false } && marker.Children.All(InFinal);
                             marker = marker.Parent)
                        {
                            if (doneQueued.Add(marker))
                                _queue.Enqueue((TriggerKind.Done, marker.Path));
                        }
                    }
                }
            }
{{- if approvals }}

            // Approvals start once the entering move's actions and sets have run, and again where a gated move completed without leaving its
            // source (signoff-design.md decision 7).
            StartApprovals(transitions, arrived);
{{- end }}
{{- if triggers }}

            // After the entry actions, the with-the-change points; after-commit points are queued.
            Changed(taken);
{{- end }}

            if (Done)
            {
                foreach (var t in Timers)
                    _unscheduled.Add(new TimerRequest(_chart.ProcessName, _snapshot.Instance, t.Transition.Id, t.Due));
                foreach (var invoke in Pending)
                    _cancelled.Add(Request(invoke));
                Timers.Clear();
                Pending.Clear();
                _queue.Clear();
            }
        }

        private InvokeRequest Request(InvokeDefinition invoke) =>
            new(_chart.ProcessName, _snapshot.Instance, invoke.Name, invoke.Kind, _chart.States[invoke.State].Path, invoke.Actors);

        private void Cancel(StateDefinition s)
        {
            foreach (var t in Timers.Where(t => ReferenceEquals(t.Transition.Source, s)).ToList())
            {
                Timers.Remove(t);
                _unscheduled.Add(new TimerRequest(_chart.ProcessName, _snapshot.Instance, t.Transition.Id, t.Due));
            }

            foreach (var invoke in Pending.Where(p => p.State == s.Index).ToList())
            {
                Pending.Remove(invoke);
                _cancelled.Add(Request(invoke));
            }

            foreach (var t in s.Transitions)
            {
{{- if approvals }}
                // Leaving discards an approval's progress too, audited when it holds any response, ignores included (signoff-design.md section 8).
                if (t.Gate is { } approvalGate && IsApproval(approvalGate))
                {
                    if (_approvals.Remove(t, out var approval) && (approval.Signed.Count > 0 || approval.Ignored.Count > 0))
                        Audit(approvalGate, t, null, null, null, null, GateOutcome.Discarded, new Dictionary<string, object?>());
                }
                else if (t.Gate is { } gate && _signatures.TryGetValue(t, out var signatures) && signatures.Count > 0)
{{- else }}
                if (t.Gate is { } gate && _signatures.TryGetValue(t, out var signatures) && signatures.Count > 0)
{{- end }}
                {
                    Audit(gate, t, null, null, null, null, GateOutcome.Discarded, new Dictionary<string, object?>());
                    signatures.Clear();
                }
            }
        }

        private bool InFinal(StateDefinition region) => region.Kind switch
        {
            StateKind.Parallel => region.Children.All(InFinal),
            StateKind.Final => _config.Contains(region),
            _ => region.Children.Any(c => c.Kind == StateKind.Final && _config.Contains(c)),
        };

        // ---- exit and entry sets ----

        private HashSet<StateDefinition> ExitSet(TransitionDefinition t)
        {
            var set = new HashSet<StateDefinition>();
            if (Domain(t) is { } domain)
            {
                foreach (var s in _config)
                {
                    if (s.IsDescendantOf(domain))
                        set.Add(s);
                }
            }

            return set;
        }

        private StateDefinition? Domain(TransitionDefinition t)
        {
            var targets = EffectiveTargets(t);
            if (targets.Count == 0)
                return null;
            if (!t.External && targets.All(s => ReferenceEquals(s, t.Source) || s.IsDescendantOf(t.Source)))
                return t.Source;
            var all = new List<StateDefinition>(targets) { t.Source };
            foreach (var ancestor in all[0].Ancestors())
            {
                if (all.Skip(1).All(s => s.IsDescendantOf(ancestor)))
                    return ancestor;
            }

            return _chart.Root;
        }

        private List<StateDefinition> EffectiveTargets(TransitionDefinition t)
        {
            var list = new List<StateDefinition>();
            foreach (var target in t.Targets)
                Effective(target, 0);
            return list;

            void Effective(StateDefinition s, int depth)
            {
                if (s.Kind != StateKind.History)
                {
                    if (!list.Contains(s))
                        list.Add(s);
                    return;
                }

                if (_history.TryGetValue(s, out var recorded) && recorded.Count > 0)
                {
                    foreach (var r in recorded)
                        Effective(r, depth + 1);
                }
                else if (s.DefaultTarget is { } d && depth < 8)
                {
                    Effective(d, depth + 1);
                }
            }
        }

        private void AddDescendants(StateDefinition s, HashSet<StateDefinition> toEnter, int depth)
        {
            if (depth > 64)
                return;
            if (s.Kind == StateKind.History)
            {
                var parent = s.Parent!;
                if (_history.TryGetValue(s, out var recorded) && recorded.Count > 0)
                {
                    foreach (var r in recorded)
                        AddDescendants(r, toEnter, depth + 1);
                    foreach (var r in recorded)
                        AddAncestors(r, parent, toEnter, depth + 1);
                }
                else if (s.DefaultTarget is { } d)
                {
                    AddDescendants(d, toEnter, depth + 1);
                    AddAncestors(d, parent, toEnter, depth + 1);
                }

                return;
            }

            toEnter.Add(s);
            if (s.Kind == StateKind.Parallel)
            {
                foreach (var region in s.Children)
                {
                    if (region.Kind != StateKind.History && !toEnter.Any(x => x.IsDescendantOf(region)))
                        AddDescendants(region, toEnter, depth + 1);
                }
            }
            else if (s.Children.Count > 0 && s.Initial is { } initial)
            {
                AddDescendants(initial, toEnter, depth + 1);
                AddAncestors(initial, s, toEnter, depth + 1);
            }
        }

        private void AddAncestors(StateDefinition s, StateDefinition? domain, HashSet<StateDefinition> toEnter, int depth)
        {
            var ancestors = new List<StateDefinition>();
            foreach (var a in s.Ancestors())
            {
                if (ReferenceEquals(a, domain))
                    break;
                ancestors.Add(a);
            }

            if (domain is { Kind: StateKind.Parallel })
                ancestors.Add(domain);
            foreach (var a in ancestors)
            {
                if (!ReferenceEquals(a, domain) && !a.IsRoot)
                    toEnter.Add(a);
                if (a.Kind != StateKind.Parallel)
                    continue;
                foreach (var region in a.Children)
                {
                    if (region.Kind != StateKind.History && !toEnter.Any(x => x.IsDescendantOf(region)))
                        AddDescendants(region, toEnter, depth + 1);
                }
            }
        }

        private IEnumerable<StateDefinition> Leaves() => _config.Where(s => !s.IsRoot && s.IsLeaf).OrderBy(s => s.Index);

        private static IEnumerable<StateDefinition> Prepend(StateDefinition first, IEnumerable<StateDefinition> rest)
        {
            yield return first;
            foreach (var s in rest)
                yield return s;
        }

        // ---- result ----

        public StepResult<TContext> Finish()
        {
            var states = Leaves().Select(s => s.Path).ToList();
            _snapshot.States = states;
            _snapshot.Context = Context;
            _snapshot.Final = Done;
            _snapshot.AuditSequence = _auditSequence;
            _snapshot.TimerSequence = _timerSequence;
            _snapshot.Clock = Clock;
            _snapshot.History = _history.OrderBy(p => p.Key.Index).ToDictionary(p => p.Key.Path, p => p.Value.Select(s => s.Path).ToList(), StringComparer.Ordinal);
            _snapshot.Timers = [.. Timers.OrderBy(t => t.Sequence).Select(t => new TimerEntry(t.Transition.Id, t.Due, t.Sequence))];
            _snapshot.Pending = [.. Pending.OrderBy(p => p.State).ThenBy(p => p.Name, StringComparer.Ordinal).Select(p => p.Name)];
            _snapshot.Signatures = _signatures.Where(p => p.Value.Count > 0).OrderBy(p => p.Key.Index)
                .ToDictionary(p => p.Key.Id, p => p.Value.ToList(), StringComparer.Ordinal);
{{- if approvals }}
            TrimActs();
            _snapshot.Approvals = _approvals.OrderBy(p => p.Key.Index).ToDictionary(p => p.Key.Id, p => p.Value, StringComparer.Ordinal);
            _snapshot.Acts = [.. _acts];
{{- end }}
            return new StepResult<TContext>
            {
                Accepted = _refusal is null,
                Refusal = _refusal,
{{- if refusals }}
                RefusedBy = _refusedBy,
{{- end }}
{{- if triggers }}
                CheckWarnings = _warnings,
                TriggerPoints = Listed(),
                AfterCommit = _refusal is null ? _messages : [],
{{- end }}
                Input = _input,
                From = _from,
                States = states,
                Changed = _owner._behaviour.Changed(_before, Context),
                Audit = _audit,
                Started = _started,
                Cancelled = _cancelled,
                Scheduled = _scheduled,
                Unscheduled = _unscheduled,
                At = Clock,
                Failure = _failure,
                Snapshot = _snapshot,
            };
        }
    }

    private readonly IStatechartBehaviour<TContext> _behaviour = behaviour ?? throw new ArgumentNullException(nameof(behaviour));
    private readonly IProcessClock _clock = clock ?? throw new ArgumentNullException(nameof(clock));
    private readonly int _maxMicrosteps = maxMicrosteps;
{{- if has_relative }}

    // Whether an acting actor may act: one that stands for itself may; one taken from the object only when the behaviour, as its
    // resolver, says the caller is that actor for the instance.
    private bool Resolves(ProcessSnapshot<TContext> snapshot, string actor, ProcessEnvelope envelope) =>
        !FromObject.Contains(actor) || (_behaviour is IActorResolver<TContext> resolver && resolver.IsActor(actor, snapshot, envelope));
{{- end }}
}
{{ end -}}
