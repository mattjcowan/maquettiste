{{-
# Binding and row-model functions shared by the entity, repository and registration templates. Needs _csharp.scriban.
#
# A repository reads and writes through a bound entity's binding: a private row class whose properties are the binding's field
# names; the row converts to and from the entity (embedded value objects, enum codes, JSON columns), so Dapper only ever maps flat
# rows.

# The binding the repositories use (erratum E43): the entity's binding to the "database" parameter when set, else to the first
# database (by name) that binds the entity. An entity with one gets its repository from it.
func dapper_binding(e)
  if pack.params.database != ""
    ret e.bindings[pack.params.database]
  end
  for db in model.databases
    $b = e.bindings[db.name]
    if $b
      ret $b
    end
  end
  ret null
end

# Whether an entity gets a repository: concrete and bound, with its key in the binding's field map.
func has_repository(e)
  if e.is_abstract
    ret false
  end
  $b = dapper_binding(e)
  ret $b && $b.key.size > 0
end

# Whether a column type keyword is range or multirange, held as its text form like JSON (section 3.4).
func range_type(k)
  ret k == "range" || k == "multirange"
end

# The C# enum name of an enum-typed attribute, without "?".
func enum_type(a)
  ret type_of a.type "csharp"
end

# C# expression reading one simple attribute from a row property (src) that holds a column of type ctype, nullable or not.
func read_value(a, src, ctype, cnullable)
  $src = src
  $full = type_of a "csharp"
  if ctype == "json"
    if a.collection
      ret $src + " is null ? [] : JsonSerializer.Deserialize<" + $full + ">(" + $src + ")!"
    else if a.required
      ret "JsonSerializer.Deserialize<" + $full + ">(" + $src + (cnullable ? "!" : "") + ")!"
    end
    ret $src + " is null ? null : JsonSerializer.Deserialize<" + $full + ">(" + $src + ")"
  end
  if a.type.kind == "enum"
    $en = enum_type(a)
    if ctype == "string" || ctype == "text"
      if cnullable && !a.required
        ret $src + " is null ? null : " + $en + "Codes.Parse(" + $src + ")"
      end
      ret $en + "Codes.Parse(" + $src + (cnullable ? "!" : "") + ")"
    end
    if cnullable && !a.required
      ret "(" + $en + "?)" + $src
    end
    ret "(" + $en + ")" + $src + (cnullable ? "!" : "")
  end
  if cnullable && a.required
    ret "(" + $full + ")" + $src + "!"
  end
  ret $src
end

# ---- bindings (erratum E43) ------------------------------------------------------------------------------------------------
# A bound entity's repository reads into a private Row class whose properties are the binding's field names (the select's
# aliases and the statements' parameters), so Dapper maps both ways without renaming.

# Whether a field's row property is nullable: the column is, or the attribute (or a value object member on its path) is optional.
func bind_nullable(f)
  if f.nullable
    ret true
  end
  if f.member
    $optional = !f.attribute.required
    for m in f.members
      $optional = $optional || !m.required
    end
    ret $optional
  end
  if f.attribute
    ret !f.attribute.required
  end
  ret false
end

# Whether a child table field's row property is nullable: the column is, or a value object member on its path is optional (a row
# is one item, so the attribute's own required does not count).
func child_nullable(f)
  $optional = f.nullable
  for m in f.members
    $optional = $optional || !m.required
  end
  ret $optional
end

# The C# type of a row property for a column type keyword (JSON, range and multirange held as text), nullable or not.
func row_type_of(k, nullable)
  $k = k ? k : "string"
  $t = ($k == "json" || range_type($k)) ? "string" : (type_of $k "csharp")
  ret nullable ? $t + "?" : $t
end

# The C# type of a field's row property: its column's type keyword (JSON, range and multirange held as text), nullable as
# bind_nullable says.
func bind_row_type(f)
  ret row_type_of(f.type, bind_nullable(f))
end

# The fields of the entity's binding that hold a to-one relation's key: the entity class carries a property for each.
func bind_key_fields(e)
  $result = []
  $b = dapper_binding(e)
  if !$b
    ret $result
  end
  # A derived entity's class inherits the keys its base's class declares: the base's relations, which a table the hierarchy shares
  # holds once, so the derived binding names them too.
  $inherited = []
  if e.base
    for f in bind_key_fields(e.base)
      $inherited[$inherited.size] = f.name
    end
  end
  for f in $b.fields
    if f.end && !(array.contains $inherited f.name)
      $result[$result.size] = f
    end
  end
  ret $result
end
-}}
