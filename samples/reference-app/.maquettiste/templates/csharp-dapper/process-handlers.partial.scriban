{{-
include "_csharp.scriban"
include "_process.scriban"
p = process
name = p_name(p)
ctx = name + "Context"
call = "StatechartCall<" + ctx + ">"
stubs = 0
relatives = relative_actors(p)
-}}
using System;
using {{ runtime_ns() }};

namespace {{ ns(p) }};

// The hand-written half of {{ name }}Handlers. Maquettiste wrote this file once and never touches it again. Implement here the
// guards and actions whose expression the generated half could not translate (or that have none); a guard or action added to
// the model later is declared in {{ name }}Handlers.g.cs and fails the build until you add it here.
public sealed partial class {{ name }}Handlers
{
{{- for g in p.guards }}
{{- if translate(p, g, "guard") == "" }}
{{- if stubs > 0 }}
{{ end }}
{{- stubs = stubs + 1 }}
{{ doc(g.description ?? ("Guard " + g.name + "."), "    ") }}{{ if g.expression }}    // The model's expression, outside the translated subset: {{ cs_line g.expression }}
{{ end }}    private partial bool Guard{{ pascal g.name }}({{ call }} call) =>
        throw new NotImplementedException("Guard {{ g.name }} of process {{ p.name }} is not implemented yet.");
{{- end }}
{{- end }}
{{- for a in p.actions }}
{{- if translate(p, a, "action") == "" }}
{{- if stubs > 0 }}
{{ end }}
{{- stubs = stubs + 1 }}
{{ doc(a.description ?? ("Action " + a.name + "."), "    ") }}{{ if a.expression }}    // The model's expression, outside the translated subset: {{ cs_line a.expression }}
{{ end }}    private partial {{ ctx }} Action{{ pascal a.name }}({{ call }} call) =>
        throw new NotImplementedException("Action {{ a.name }} of process {{ p.name }} is not implemented yet.");
{{- end }}
{{- if a.sets.size > 0 }}
{{- if stubs > 0 }}
{{ end }}
{{- stubs = stubs + 1 }}
    // Record on the object what action {{ a.name }} sets: {{ sets_text(a) }}. Each value reads the object and call.Context as they were
    // before the action; the generated half runs this, then the action.
    private partial void Record{{ pascal a.name }}({{ call }} call) =>
        throw new NotImplementedException("Action {{ a.name }} of process {{ p.name }} does not record its sets yet.");
{{- end }}
{{- end }}
{{- for a in relatives }}
{{- if stubs > 0 }}
{{ end }}
{{- stubs = stubs + 1 }}
    // Whether the caller is {{ a.name }}, {{ relative_text(a, subject_words(p)) }}{{ owner_fields(p, a) }}: read the object for the instance
    // and compare it with the caller (the envelope's Signer for an event, or the host's principal). It refuses until you write it.
    private partial bool Is{{ pascal a.name }}(ProcessSnapshot<{{ ctx }}> snapshot, ProcessEnvelope envelope) => false;
{{- end }}
{{- for l in lifecycle_hooks(p) }}
{{- if stubs > 0 }}
{{ end }}
{{- stubs = stubs + 1 }}
    // The object's active state paths in lifecycle {{ l.name }}, which could say no to{{ if uses_triggers() }}, or whose trigger points run on,{{ end }} a verb an event names: read them from your
    // system for the instance's object. None means the initial state; null means {{ l.name }} doesn't govern the object, so it isn't asked
    // (a process with several subjects). It throws until you write it.
    private partial global::System.Collections.Generic.IReadOnlyList<string>? StatesIn{{ pascal l.name }}({{ call }} call) =>
        throw new NotImplementedException("The states of the object in lifecycle {{ l.name }} are not read yet.");
{{- end }}
}

{{- if uses_rights() }}
{{- conditions = inline_conditions(p) }}
{{- if conditions.size > 0 }}

// The conditions of the rights of lifecycle {{ p.name }}. A right holds only when its condition is true; read the object for the request.
public static partial class {{ name }}RightConditions
{
{{- for r in conditions }}
{{- if !for.first }}
{{ end }}
    // {{ r.name }}: {{ cs_line r.condition_text }}
    public static partial bool {{ pascal r.name }}(global::{{ actors_ns() }}.RightRequest request) =>
        throw new NotImplementedException("The condition of right {{ r.name }} of lifecycle {{ p.name }} is not implemented yet.");
{{- end }}
}
{{- end }}
{{- end }}
