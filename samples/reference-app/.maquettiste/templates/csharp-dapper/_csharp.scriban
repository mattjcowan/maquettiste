{{-
# Shared C# functions for the csharp-dapper pack. Include this file once at the top of a template; it prints nothing.

# The base namespace: the pack's "namespace" parameter when the project sets it, else the project's own
# baseNamespace property (Settings > General, shared by every pack), else App.Model.
func base_ns
  if pack.params.namespace != null && pack.params.namespace != ""
    ret pack.params.namespace
  end
  if project.properties.baseNamespace != null && project.properties.baseNamespace != ""
    ret project.properties.baseNamespace
  end
  ret "App.Model"
end

# The namespace of an element's package: the base namespace plus the package's qualified name.
func ns(element)
  if element.package
    ret base_ns + "." + element.package.qualified_name
  end
  ret base_ns
end

func type_name(element)
  ret pascal element.name
end

# The C# property name of an attribute; a name equal to its declaring type's name gets "Value" appended (C# forbids it).
func prop_name(attribute, owner_name)
  $name = pascal attribute.name
  if $name == owner_name
    ret $name + "Value"
  end
  ret cs_ident $name
end

# The C# type of an attribute (nullable when optional, a list when a collection).
func prop_type(attribute)
  ret type_of attribute "csharp"
end

# Whether the attribute's C# type can hold null or is a value type, i.e. needs no "= default!" initializer.
func needs_initializer(attribute)
  if attribute.collection
    ret false
  end
  if !attribute.required
    ret false
  end
  if attribute.type.kind == "enum"
    ret false
  end
  ret !(cs_value_type (type_of attribute "csharp"))
end

# The property initializer of an attribute: "[]" for collections, "default!" for non-null reference types, "" otherwise.
func initializer(attribute)
  if attribute.collection
    ret " = [];"
  end
  if needs_initializer(attribute)
    ret " = default!;"
  end
  ret ""
end

# XML documentation lines for a description, each prefixed with the given indentation.
func doc(text, pad)
  if !text
    ret ""
  end
  $lines = text | string.replace "\r\n" "\n" | string.replace "\r" "\n" | string.rstrip | string.split "\n"
  if $lines.size == 1
    ret pad + "/// <summary>" + ($lines[0] | string.strip | escape_xml) + "</summary>\n"
  end
  $out = pad + "/// <summary>\n"
  for line in $lines
    $trimmed = line | string.rstrip
    $out = $out + pad + "///" + ($trimmed == "" ? "" : " " + ($trimmed | escape_xml)) + "\n"
  end
  ret $out + pad + "/// </summary>\n"
end

# The namespaces (other than the element's own) that hold the enums, value objects and base entities its attributes use.
func namespaces_used(element, attributes)
  $own = ns(element)
  $result = []
  for a in attributes
    $target = null
    if a.type.kind == "enum"
      $target = a.type.enum
    else if a.type.kind == "value-object"
      $target = a.type.value_object
    end
    if $target
      $n = ns($target)
      if $n != $own && !($result | array.contains $n)
        $result[$result.size] = $n
      end
    end
  end
  ret $result | array.sort
end

# The standard header of a generated C# file.
func header()
  ret (banner "//") + "\n// <auto-generated />\n#nullable enable"
end
-}}
