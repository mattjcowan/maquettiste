{{-
# Where the instances of a process live (the generated half of a pair): the I<P>Store interface. The engine creates no table
# for it; the companion <P>Store.cs adapts it to whatever the project mapped (it starts as an in-memory store).
include "_csharp.scriban"
include "_process.scriban"
p = process
name = p_name(p)
ctx = name + "Context"
-}}
{{ header() }}
using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;
using {{ runtime_ns() }};

namespace {{ ns(p) }};

/// <summary>Loads and saves the instances of process {{ p.name }}, and appends their history and gate audit records.</summary>
public partial interface I{{ name }}Store
{
    /// <summary>Loads an instance.</summary>
    /// <param name="instance">The instance identity.</param>
    /// <param name="cancellationToken">Cancellation.</param>
    /// <returns>The instance, or null when there is none.</returns>
    Task<ProcessSnapshot<{{ ctx }}>?> LoadAsync(string instance, CancellationToken cancellationToken);

    /// <summary>
    /// Saves an instance (inserted the first time) when the stored version is still <paramref name="expectedVersion"/> (0: not stored
    /// yet); the snapshot's <see cref="ProcessSnapshot{TContext}.Version"/> is already the next one. Throws
    /// <see cref="ProcessConcurrencyException"/> when another command saved the instance since it was loaded.
    /// </summary>
    /// <param name="snapshot">The instance.</param>
    /// <param name="expectedVersion">The version the command loaded.</param>
    /// <param name="cancellationToken">Cancellation.</param>
    /// <returns>The task.</returns>
    Task SaveAsync(ProcessSnapshot<{{ ctx }}> snapshot, long expectedVersion, CancellationToken cancellationToken);

    /// <summary>Appends history records.</summary>
    /// <param name="transitions">The records.</param>
    /// <param name="cancellationToken">Cancellation.</param>
    /// <returns>The task.</returns>
    Task AppendHistoryAsync(IReadOnlyList<{{ name }}Transitioned> transitions, CancellationToken cancellationToken);

    /// <summary>Appends gate audit records.</summary>
    /// <param name="records">The records.</param>
    /// <param name="cancellationToken">Cancellation.</param>
    /// <returns>The task.</returns>
    Task AppendAuditAsync(IReadOnlyList<GateAuditRecord> records, CancellationToken cancellationToken);
}

/// <summary>The store of process {{ p.name }}; its members are in the companion {{ name }}Store.cs.</summary>
public sealed partial class {{ name }}Store : I{{ name }}Store
{
}
