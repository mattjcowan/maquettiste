{{-
# A Dapper query class per query: an interface and a class with one ExecuteAsync that runs the query's SQL (query_sql) and
# returns its rows as a generated <Name>Row record, the query's own shape. An entity reads a query through its binding instead
# (repository.scriban). The template's own names start with mq_, which the engine reserves (MQ4040), so no parameter or field
# name collides with them; enum types are written global::-qualified.
# Both forms of query come here. query.form is "structured" for a query built from parts and "sql" for one written as SQL text;
# query_sql gives either one's statement with @name placeholders. query.select is the built query's select fields, or the SQL
# text's declared columns (expression null: column_type_ref finds no table column, so each member takes the column's own type).
# A query with no columns is a command: it returns no rows, and ExecuteAsync returns the number of rows it changed.
include "_csharp.scriban"
include "_dapper.scriban"
name = cs_class (pascal query.name)
db = query.database

# The global::-qualified C# name of an enum.
func qualified(element)
  ret "global::" + ns(element) + "." + type_name(element)
end

# The C# type of a field's value in the private row class Dapper fills.
func field_type(f)
  $t = f.code_type ? (type_of f.code_type "csharp") : "object"
  ret f.nullable ? $t + "?" : $t
end

# The bound type of the table column a field reads (column.bound_type: the enum, reference type or scalar type of the attribute the
# bindings map to it), or null: a field that is not a plain column of a table (a declared column of a SQL text has no expression),
# or a column no binding maps to such an attribute.
func column_type_ref(f)
  if !f.expression
    ret null
  end
  $c = f.expression.table_column
  ret $c ? $c.bound_type : null
end

# The C# type of a field's member in a generated row or item record: the enum a typed column holds (nullable as the field), else
# the field's own type. A column typed by a reference type keeps its code's type (the record's summary names the type).
func record_member_type(f)
  $t = column_type_ref(f)
  if $t && $t.kind == "enum"
    ret qualified($t.enum) + (f.nullable ? "?" : "")
  end
  ret field_type(f)
end

# The C# expression that fills a record member from a row's field: an enum column's stored value converted as read_field converts
# an enum attribute's (a code parsed, a number cast), else the field as read.
func record_member_value(f, src)
  $t = column_type_ref(f)
  if !$t || $t.kind != "enum"
    ret src
  end
  $en = qualified($t.enum)
  if f.code_type == "string" || f.code_type == "text"
    ret f.nullable ? src + " is null ? null : " + $en + "Codes.Parse(" + src + ")" : $en + "Codes.Parse(" + src + ")"
  end
  ret "(" + $en + (f.nullable ? "?" : "") + ")" + src
end

# The summary sentences of a generated record: one per field that reads a column typed by a reference type, naming the type's
# record, which the reference-type unit declares in the root namespace.
func record_code_notes(fields)
  $s = ""
  for f in fields
    $t = column_type_ref(f)
    if $t && $t.kind == "reference"
      $s = $s + " " + (cs_ident (pascal f.name)) + " holds a code of <see cref=\"global::" + base_ns + "." + type_name($t.reference_type) + "\"/>."
    end
  end
  ret $s
end

# The C# literal of a parameter default, or null when the type has no constant form.
func default_literal(p)
  if p.default == null || p.collection
    ret null
  end
  if p.code_type == "string" || p.code_type == "text"
    ret json p.default
  end
  if p.code_type == "bool"
    ret p.default ? "true" : "false"
  end
  if p.code_type == "int16" || p.code_type == "int32" || p.code_type == "int64" || p.code_type == "double"
    ret json p.default
  end
  if p.code_type == "decimal"
    ret (json p.default) + "m"
  end
  if p.code_type == "float"
    ret (json p.default) + "f"
  end
  ret null
end

func param_type(p)
  $t = type_of p.code_type "csharp"
  ret p.collection ? "IEnumerable<" + $t + ">" : $t
end

# Method parameters: required ones first, then those with a default, then the cancellation token.
required_params = []
optional_params = []
for p in query.parameters
  $literal = default_literal(p)
  if $literal
    optional_params[optional_params.size] = (param_type(p) + " " + (cs_ident p.name) + " = " + $literal)
  else
    required_params[required_params.size] = (param_type(p) + " " + (cs_ident p.name))
  end
end
signature = (required_params | array.concat optional_params | array.add "CancellationToken mq_cancellationToken = default") | array.join ", "
args = []
for p in query.parameters
  args[args.size] = ((cs_ident p.name) + " = " + (cs_ident p.name))
end

item_type = name + "Row"
is_command = query.select.size == 0

# A JSON field is a JsonElement.
uses_json = false
for f in query.select
  if f.code_type == "json"
    uses_json = true
  end
end
-}}
{{ header() }}
using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
{{- if uses_json }}
using System.Text.Json;
{{- end }}
using System.Threading;
using System.Threading.Tasks;
using Dapper;

namespace {{ base_ns }}.Queries;

{{ doc(query.description, "") }}public partial interface I{{ name }}Query
{
{{- if is_command }}
    /// <summary>Runs the statement, which returns no rows.</summary>
    /// <returns>The number of rows the statement changed, as the database counts them.</returns>
    Task<int> ExecuteAsync({{ signature }});
{{- else }}
    /// <summary>Runs the query.</summary>
    Task<IReadOnlyList<{{ item_type }}>> ExecuteAsync({{ signature }});
{{- end }}
}
{{- if !is_command }}

/// <summary>One row of query {{ query.name }}.{{ record_code_notes(query.select) }}</summary>
public sealed partial record {{ name }}Row({{ for f in query.select }}{{ record_member_type(f) }} {{ cs_ident (pascal f.name) }}{{ if !for.last }}, {{ end }}{{ end }});
{{- end }}

/// <summary>The Dapper implementation of <see cref="I{{ name }}Query"/> (database {{ db.name }}, {{ db.dialect }}).</summary>
{{- if is_command }}
/// <remarks>The statement changes data and returns no rows; it runs in the transaction given, if any.</remarks>
{{- else }}
/// <remarks>
/// The results are read-only projections: rows of the query's own shape.
/// </remarks>
{{- end }}
public partial class {{ name }}Query(IDbConnection mq_connection, IDbTransaction? mq_transaction = null) : I{{ name }}Query
{
{{- mq_sql = query_sql query }}
    private const string Sql = {{ raw_quotes mq_sql }}
{{ indent mq_sql 8 }}
        {{ raw_quotes mq_sql }};

    /// <inheritdoc/>
{{- if is_command }}
    public Task<int> ExecuteAsync({{ signature }}) =>
        mq_connection.ExecuteAsync(new CommandDefinition(Sql, new { {{ args | array.join ", " }} }, mq_transaction, cancellationToken: mq_cancellationToken));
}
{{- else }}
    public async Task<IReadOnlyList<{{ item_type }}>> ExecuteAsync({{ signature }})
    {
        var mq_rows = (await mq_connection.QueryAsync<Row>(new CommandDefinition(Sql, new { {{ args | array.join ", " }} }, mq_transaction, cancellationToken: mq_cancellationToken)).ConfigureAwait(false)).ToList();
        return mq_rows.Select(mq_r => mq_r.ToItem()).ToList();
    }

    /// <summary>One row as Dapper reads it, field by field.</summary>
    private sealed class Row
    {
{{- for f in query.select }}
        public {{ field_type(f) }} {{ cs_ident f.name }} { get; set; }{{ if !f.nullable && f.code_type && !(cs_value_type (type_of f.code_type "csharp")) }} = default!;{{ end }}
{{- end }}

        public {{ item_type }} ToItem() => new({{ for f in query.select }}{{ record_member_value(f, cs_ident f.name) }}{{ if !for.last }}, {{ end }}{{ end }});
    }
}
{{- end }}
