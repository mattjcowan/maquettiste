{{-
# One .resx file per declared locale (reference-types-seeds-localization.md section 3.7): the display name, plural name and
# description of every reference type and the label of every row, through the locale's fallback chain. The default locale's
# file is the neutral ReferenceData.resx; the others are satellites (ReferenceData.fr.resx). Keys: <Type>_DisplayName,
# <Type>_PluralName, <Type>_Description and <Type>_<Row>, where <Row> is the row's code in PascalCase.
include "_csharp.scriban"
func entry(key, value)
  if value == null || value == ""
    ret ""
  end
  ret "\n  <data name=\"" + (escape_xml key) + "\" xml:space=\"preserve\">\n    <value>" + (escape_xml value) + "</value>\n  </data>"
end
-}}
<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by Maquettiste (csharp-dapper/resources) for locale {{ locale.tag }}. Do not edit; changes are overwritten. -->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
{{- for rt in model.reference_types }}
{{- n = type_name(rt) }}
{{- entry(n + "_DisplayName", display_name rt) }}
{{- entry(n + "_PluralName", plural_name rt) }}
{{- entry(n + "_Description", description_of rt) }}
{{- for r in rt.rows }}
{{- m = pascal ("" + r.code) }}
{{- entry(n + "_" + m, label_of r) }}
{{- end }}
{{- end }}
</root>
