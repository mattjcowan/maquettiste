{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tag vocabulary",
  "description": "The declared tags.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "package",
    "displayName",
    "pluralName",
    "description",
    "rationale",
    "decision",
    "status",
    "stereotypes",
    "tags",
    "category",
    "strict",
    "definitions",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "tag-vocabulary"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "package": {
      "$ref": "common.json#/$defs/id",
      "description": "The domain the vocabulary is scoped to (that domain and the domains nested under it); absent for the global vocabulary. At most one vocabulary of each kind per scope."
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "strict": {
      "type": "boolean",
      "default": false
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["key", "description", "color"],
        "properties": {
          "key": {
            "$ref": "common.json#/$defs/tagLabel"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": ["key"],
        "additionalProperties": false
      },
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name"],
  "additionalProperties": false
}
