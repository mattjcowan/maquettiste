{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL object",
  "description": "A named database object the model does not type (a trigger, a grant, an extension, a policy): SQL statements per dialect, run before or after the tables (model/databases/<db>/objects/).",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "database",
    "schema",
    "description",
    "stereotypes",
    "tags",
    "category",
    "objectKind",
    "phase",
    "dependsOn",
    "body",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "sql-object"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "objectKind": {
      "description": "What the object is, in free text: trigger, grant, extension, index, policy...",
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "description": "Whether the statements run before the database types and tables (an extension) or after the routines and views (a trigger, a grant).",
      "enum": ["before", "after"],
      "default": "after"
    },
    "dependsOn": {
      "description": "Tables, views, sequences, routines, database types and SQL objects of the same database that must exist first.",
      "$ref": "common.json#/$defs/idList",
      "uniqueItems": true,
      "default": []
    },
    "body": {
      "description": "Per dialect, the SQL statements that create the object, run as written.",
      "$ref": "common.json#/$defs/dialectMap",
      "minProperties": 1
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "database", "objectKind", "body"],
  "additionalProperties": false
}
