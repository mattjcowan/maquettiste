{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query",
  "description": "A query of a database (model/databases/<db>/queries/), in one of two forms. Built from parts: sources, joins, a select list, predicates, grouping, ordering, paging, collections and named queries (with), written as data; its result shape is an entity, or the select list when no entity is named. SQL text: the team's own statement per dialect (sql), with :name placeholders for its parameters, the columns each row has (columns) and the tables and other objects it reads and writes (reads, writes), declared rather than read from the text.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "database",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "entity",
    "parameters",
    "with",
    "from",
    "joins",
    "select",
    "where",
    "groupBy",
    "having",
    "orderBy",
    "distinct",
    "paging",
    "collections",
    "sql",
    "columns",
    "reads",
    "writes",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "query"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "description": "The owning package. Membership only: the database still decides where the object goes.",
      "$ref": "common.json#/$defs/id"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "entity": {
      "description": "The entity whose shape each result row has; absent, the select list is the row shape (a name and a type per field).",
      "$ref": "common.json#/$defs/id"
    },
    "parameters": {
      "description": "The values the caller passes, by name.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "default": []
    },
    "with": {
      "description": "Named queries (a WITH clause): each a select with a name that the query, its nested queries and the named queries listed after it may read as a source, by name. Built form only.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedQuery"
      },
      "default": []
    },
    "from": {
      "$ref": "#/$defs/from"
    },
    "joins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/join"
      },
      "default": []
    },
    "select": {
      "description": "The select list; required in the built form, and not written in the SQL text form.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "minItems": 1,
      "default": []
    },
    "where": {
      "$ref": "#/$defs/predicate"
    },
    "groupBy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expression"
      },
      "default": []
    },
    "having": {
      "$ref": "#/$defs/predicate"
    },
    "orderBy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      },
      "default": []
    },
    "distinct": {
      "type": "boolean",
      "default": false
    },
    "paging": {
      "$ref": "#/$defs/paging"
    },
    "collections": {
      "description": "Collections filled per result row by a correlated query (a sub-select yielding a list per parent row).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      },
      "default": []
    },
    "sql": {
      "description": "The statement as SQL text per dialect (or \"*\" for any): the text for the database's dialect is its own entry, else \"*\". Parameters are written :name in every dialect. Rendered as written, with only the white space at both ends removed (a final semicolon stays) and the placeholders rewritten; where a binding wraps it in a derived table, one final semicolon and the comments after it are left out. SQL text form only, and required there.",
      "$ref": "common.json#/$defs/dialectMap",
      "minProperties": 1
    },
    "columns": {
      "description": "The columns each row of a SQL text has, by name, in order. None: the statement returns no rows the code reads (a command returns the number of rows changed). Declared, not checked against the text or a database. SQL text form only.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/column"
      },
      "default": []
    },
    "reads": {
      "description": "The tables, views, routines, sequences and database types of the query's database that the SQL text reads or calls, as from.source names a table (a file id, a table key or an entity id). Declared, not read from the text. SQL text form only.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "writes": {
      "description": "The tables of the query's database that the SQL text inserts into, updates or deletes from, as from.source names a table. A query that writes changes data. SQL text form only.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "database"],
  "if": {
    "required": ["sql"]
  },
  "then": {
    "title": "SQL text",
    "description": "A query written as SQL text has none of the keys of a built query (an empty list or false is allowed, since the canonical writer drops it).",
    "x-order": ["entity", "with", "from", "joins", "select", "where", "groupBy", "having", "orderBy", "distinct", "paging", "collections"],
    "properties": {
      "entity": false,
      "with": {
        "maxItems": 0
      },
      "from": false,
      "joins": {
        "maxItems": 0
      },
      "select": false,
      "where": false,
      "groupBy": {
        "maxItems": 0
      },
      "having": false,
      "orderBy": {
        "maxItems": 0
      },
      "distinct": {
        "const": false
      },
      "paging": false,
      "collections": {
        "maxItems": 0
      }
    }
  },
  "else": {
    "title": "Built from parts",
    "description": "A query built from parts has from and select, and none of the keys of a query written as SQL text (an empty list is allowed).",
    "required": ["from", "select"],
    "x-order": ["columns", "reads", "writes"],
    "properties": {
      "columns": {
        "maxItems": 0
      },
      "reads": {
        "maxItems": 0
      },
      "writes": {
        "maxItems": 0
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "parameter": {
      "title": "Query parameter",
      "type": "object",
      "x-order": ["name", "type", "length", "precision", "scale", "collection", "default", "description"],
      "properties": {
        "name": {
          "$ref": "common.json#/$defs/identifier"
        },
        "type": {
          "$ref": "common.json#/$defs/dbTypeRef"
        },
        "length": {
          "$ref": "common.json#/$defs/length"
        },
        "precision": {
          "$ref": "common.json#/$defs/precision"
        },
        "scale": {
          "$ref": "common.json#/$defs/scale"
        },
        "collection": {
          "description": "Whether the caller passes a list of values (for in and notIn).",
          "type": "boolean",
          "default": false
        },
        "default": {
          "description": "The value the generated method uses when the caller passes none.",
          "type": ["string", "number", "boolean"]
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "from": {
      "title": "Query source",
      "type": "object",
      "x-order": ["source", "alias"],
      "properties": {
        "source": {
          "description": "A table or view of the query's database: a table or view file's id, a table key as the database view lists it (<entity id>@<database id>), or an entity id for the entity's table there; or the name of a named query of the query's with.",
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "description": "The name column references use (alias.column); absent, the table's or view's name.",
          "$ref": "common.json#/$defs/identifier"
        }
      },
      "required": ["source"],
      "additionalProperties": false
    },
    "join": {
      "title": "Join",
      "type": "object",
      "x-order": ["source", "alias", "kind", "on"],
      "properties": {
        "source": {
          "description": "A table or view of the query's database, or the name of a named query of the query's with, as in from.",
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "$ref": "common.json#/$defs/identifier"
        },
        "kind": {
          "enum": ["inner", "left", "right", "full", "cross"],
          "default": "inner"
        },
        "on": {
          "$ref": "#/$defs/predicate"
        }
      },
      "required": ["source"],
      "additionalProperties": false
    },
    "column": {
      "title": "Declared column",
      "description": "A column each row of a SQL text has.",
      "type": "object",
      "x-order": ["name", "type", "nullable", "description"],
      "properties": {
        "name": {
          "description": "The name the SQL returns (an alias in the SQL gives any other).",
          "$ref": "common.json#/$defs/identifier"
        },
        "type": {
          "$ref": "common.json#/$defs/dbTypeRef"
        },
        "nullable": {
          "description": "Whether the column may be null; false where the SQL guarantees a value.",
          "type": "boolean",
          "default": true
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "namedQuery": {
      "title": "Named query",
      "description": "A select with a name (an entry of a WITH clause). Its columns are its select fields' names. With recursive, its select is the anchor and recursive the part that repeats.",
      "type": "object",
      "x-order": ["name", "from", "joins", "select", "where", "groupBy", "having", "distinct", "recursive"],
      "properties": {
        "name": {
          "description": "The name sources use to read it.",
          "$ref": "common.json#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/join"
          },
          "default": []
        },
        "select": {
          "description": "The fields; each has a name, which is a column of the named query.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/field"
              },
              {
                "required": ["name"]
              }
            ]
          },
          "minItems": 1
        },
        "where": {
          "$ref": "#/$defs/predicate"
        },
        "groupBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          },
          "default": []
        },
        "having": {
          "$ref": "#/$defs/predicate"
        },
        "distinct": {
          "type": "boolean",
          "default": false
        },
        "recursive": {
          "$ref": "#/$defs/recursivePart"
        }
      },
      "required": ["name", "from", "select"],
      "additionalProperties": false
    },
    "recursivePart": {
      "title": "Repeating part",
      "description": "The part of a recursive named query that repeats: it reads the named query's own name once, and its rows are added to the anchor's with union until it adds none.",
      "type": "object",
      "x-order": ["union", "from", "joins", "select", "where"],
      "properties": {
        "union": {
          "description": "all keeps every row; distinct removes duplicates (not on SQL Server or Oracle).",
          "enum": ["all", "distinct"],
          "default": "all"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/join"
          },
          "default": []
        },
        "select": {
          "description": "The same number of fields as the anchor, with the same names in the same order.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/field"
              },
              {
                "required": ["name"]
              }
            ]
          },
          "minItems": 1
        },
        "where": {
          "$ref": "#/$defs/predicate"
        }
      },
      "required": ["from", "select"],
      "additionalProperties": false
    },
    "field": {
      "title": "Select field",
      "type": "object",
      "x-order": ["name", "attribute", "type", "nullable", "expression"],
      "properties": {
        "name": {
          "description": "The field's name in the result row; absent, the attribute's name.",
          "$ref": "common.json#/$defs/identifier"
        },
        "attribute": {
          "description": "What the field fills on the query's entity (or a collection's entity): an attribute id, attributeId.memberId for a member of a value object attribute, or the id of the relation end a to-one navigation of the entity leads to (or the navigation's id), for its foreign key column.",
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(\\.[0-7][0-9A-HJKMNP-TV-Z]{25})?$"
        },
        "type": {
          "description": "The field's type in an ad hoc row; absent, inferred from the expression.",
          "$ref": "common.json#/$defs/builtinType"
        },
        "nullable": {
          "description": "Whether the field may be null; absent, inferred from the expression.",
          "type": "boolean"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": ["expression"],
      "anyOf": [
        {
          "required": ["name"]
        },
        {
          "required": ["attribute"]
        }
      ],
      "additionalProperties": false
    },
    "order": {
      "title": "Order",
      "type": "object",
      "x-order": ["expression", "direction", "nulls"],
      "properties": {
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "direction": {
          "enum": ["asc", "desc"],
          "default": "asc"
        },
        "nulls": {
          "enum": ["first", "last"]
        }
      },
      "required": ["expression"],
      "additionalProperties": false
    },
    "paging": {
      "title": "Paging",
      "type": "object",
      "x-order": ["offset", "limit"],
      "properties": {
        "offset": {
          "description": "The rows to skip: an integer parameter's name or a number.",
          "anyOf": [
            {
              "$ref": "common.json#/$defs/identifier"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "limit": {
          "description": "The most rows to return: an integer parameter's name or a number.",
          "anyOf": [
            {
              "$ref": "common.json#/$defs/identifier"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "title": "Collection",
      "type": "object",
      "x-order": ["attribute", "entity", "query"],
      "properties": {
        "attribute": {
          "description": "The collection the rows fill: the id of a collection attribute of the query's entity or of the relation end its to-many navigation leads to, or a name for an ad hoc row.",
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "description": "The entity each element has; absent, the nested select list is the element shape.",
          "$ref": "common.json#/$defs/id"
        },
        "query": {
          "description": "The nested query; its predicates may name the outer query's aliases (the correlation), only in equality conditions at the top of its where.",
          "$ref": "#/$defs/subquery"
        }
      },
      "required": ["attribute", "query"],
      "additionalProperties": false
    },
    "subquery": {
      "title": "Nested query",
      "description": "A query inside a collection or an exists condition; it may name the aliases of the queries around it.",
      "type": "object",
      "x-order": ["from", "joins", "select", "where", "groupBy", "having", "orderBy", "distinct"],
      "properties": {
        "from": {
          "$ref": "#/$defs/from"
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/join"
          },
          "default": []
        },
        "select": {
          "description": "The fields; required in a collection, ignored by exists (which selects 1).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "default": []
        },
        "where": {
          "$ref": "#/$defs/predicate"
        },
        "groupBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          },
          "default": []
        },
        "having": {
          "$ref": "#/$defs/predicate"
        },
        "orderBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          },
          "default": []
        },
        "distinct": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["from"],
      "additionalProperties": false
    },
    "when": {
      "title": "Case branch",
      "type": "object",
      "x-order": ["when", "then"],
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "then": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": ["when", "then"],
      "additionalProperties": false
    },
    "expression": {
      "title": "Expression",
      "description": "Exactly one of: column (alias.column_name; the column part may also be an attribute id or a column key), param, value, null, op with args, call (with args), case (with else), cast with type, sql (an opaque text per dialect).",
      "type": "object",
      "x-order": ["column", "param", "value", "null", "op", "call", "args", "case", "else", "cast", "type", "sql"],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "param": {
          "$ref": "common.json#/$defs/identifier"
        },
        "value": {
          "type": ["string", "number", "boolean"]
        },
        "null": {
          "description": "The null literal.",
          "const": true
        },
        "op": {
          "enum": ["+", "-", "*", "/", "%", "concat"]
        },
        "call": {
          "description": "A function name (lower, upper, coalesce, count, sum, min, max, avg, length, now, or any other identifier, optionally schema-qualified, passed through) or a routine id of the database.",
          "type": "string",
          "anyOf": [
            {
              "$ref": "common.json#/$defs/id"
            },
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
            }
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "case": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/when"
          },
          "minItems": 1
        },
        "else": {
          "$ref": "#/$defs/expression"
        },
        "cast": {
          "$ref": "#/$defs/expression"
        },
        "type": {
          "description": "The type of a cast; on a value, decimal, with the number written as text (\"value\": \"2.0\") so that its digits are kept.",
          "$ref": "common.json#/$defs/builtinType"
        },
        "sql": {
          "description": "An opaque expression per dialect, for what the tree cannot say; the query cannot be rendered for a dialect without a text (nor \"*\").",
          "$ref": "common.json#/$defs/dialectMap",
          "minProperties": 1
        }
      },
      "oneOf": [
        {
          "required": ["column"]
        },
        {
          "required": ["param"]
        },
        {
          "required": ["value"]
        },
        {
          "required": ["null"]
        },
        {
          "required": ["op"]
        },
        {
          "required": ["call"]
        },
        {
          "required": ["case"]
        },
        {
          "required": ["cast"]
        },
        {
          "required": ["sql"]
        }
      ],
      "dependentRequired": {
        "op": ["args"],
        "cast": ["type"]
      },
      "additionalProperties": false
    },
    "predicate": {
      "title": "Predicate",
      "description": "Exactly one of: and, or (lists of predicates), not (a predicate), op with left and right (a list for in, notIn and between; none for isNull and isNotNull), exists (a nested query).",
      "type": "object",
      "x-order": ["and", "or", "not", "op", "left", "right", "exists"],
      "properties": {
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 1
        },
        "or": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 1
        },
        "not": {
          "$ref": "#/$defs/predicate"
        },
        "op": {
          "enum": ["eq", "ne", "lt", "le", "gt", "ge", "like", "ilike", "in", "notIn", "between", "isNull", "isNotNull"]
        },
        "left": {
          "$ref": "#/$defs/expression"
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/expression"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            }
          ]
        },
        "exists": {
          "$ref": "#/$defs/subquery"
        }
      },
      "oneOf": [
        {
          "required": ["and"]
        },
        {
          "required": ["or"]
        },
        {
          "required": ["not"]
        },
        {
          "required": ["op"]
        },
        {
          "required": ["exists"]
        }
      ],
      "dependentRequired": {
        "op": ["left"]
      },
      "additionalProperties": false
    }
  }
}
