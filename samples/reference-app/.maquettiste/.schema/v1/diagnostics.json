{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation output",
  "description": "The output of maquettiste validate --format json.",
  "type": "object",
  "x-order": ["errors", "warnings", "infos", "diagnostics", "suppressed"],
  "properties": {
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "integer",
      "minimum": 0
    },
    "infos": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "suppressed": {
      "description": "The findings the elements' suppressions accepted, in diagnostic order; the counts exclude them. Omitted when there are none.",
      "type": "array",
      "items": {
        "title": "Suppressed finding",
        "type": "object",
        "x-order": ["finding", "reason", "elementId", "jsonPointer"],
        "properties": {
          "finding": {
            "$ref": "#/$defs/diagnostic"
          },
          "reason": {
            "description": "The entry's reason.",
            "type": "string"
          },
          "elementId": {
            "description": "The element whose suppressions hold the entry.",
            "type": "string"
          },
          "jsonPointer": {
            "description": "The entry: /suppressions/<i>.",
            "type": "string"
          }
        },
        "required": ["finding", "reason", "elementId", "jsonPointer"],
        "additionalProperties": false
      }
    }
  },
  "required": ["errors", "warnings", "infos", "diagnostics"],
  "additionalProperties": false,
  "$defs": {
    "diagnostic": {
      "title": "Diagnostic",
      "type": "object",
      "x-order": ["rule", "severity", "message", "elementId", "filePath", "jsonPointer", "line", "column"],
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^(MQ[1-7][0-9]{3}|x/.+)$"
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "message": {
          "type": "string"
        },
        "elementId": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "jsonPointer": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["rule", "severity", "message"],
      "additionalProperties": false
    }
  }
}
