{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Value object",
  "description": "A composite type without identity.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "attributes",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "value-object"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "attributes": {
      "type": "array",
      "x-sort": "order",
      "items": {
        "$ref": "common.json#/$defs/attribute"
      },
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name"],
  "additionalProperties": false
}
