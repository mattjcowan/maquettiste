{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model batch",
  "description": "An atomic batch of element creates, updates and deletes and database schema operations, from the editor, a refactoring or an AI proposal.",
  "type": "object",
  "x-order": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "title": "Batch operation",
        "type": "object",
        "x-order": ["op", "id", "expectedHash", "element", "locale", "field", "value", "schema", "name", "target", "default"],
        "properties": {
          "op": {
            "enum": ["create", "update", "delete", "translate", "add-schema", "rename-schema", "remove-schema", "set-default-schema"]
          },
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "expectedHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "element": {
            "type": "object",
            "required": ["kind"]
          },
          "locale": {
            "$ref": "common.json#/$defs/locale"
          },
          "field": {
            "enum": ["displayName", "pluralName", "label", "description"]
          },
          "value": {
            "description": "The translated text, a sidecar reference, or null to remove the translation.",
            "anyOf": [
              {
                "$ref": "common.json#/$defs/description"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema": {
            "description": "The database schema id (rename-schema, remove-schema, set-default-schema; optional for add-schema).",
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "description": "The schema name (add-schema, rename-schema).",
            "type": "string",
            "minLength": 1
          },
          "target": {
            "description": "The schema id that the tables, views, sequences, convention entries and mappings of the removed schema move to (remove-schema).",
            "$ref": "common.json#/$defs/id"
          },
          "default": {
            "description": "The schema id that becomes the default when the removed schema is the default (remove-schema).",
            "$ref": "common.json#/$defs/id"
          }
        },
        "required": ["op"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["update", "delete"]
                }
              }
            },
            "then": {
              "required": ["id", "expectedHash"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["create", "update"]
                }
              }
            },
            "then": {
              "required": ["element"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "translate"
                }
              }
            },
            "then": {
              "required": ["locale", "id", "field", "value"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["add-schema", "rename-schema", "remove-schema", "set-default-schema"]
                }
              }
            },
            "then": {
              "required": ["id"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["add-schema", "rename-schema"]
                }
              }
            },
            "then": {
              "required": ["name"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["rename-schema", "remove-schema", "set-default-schema"]
                }
              }
            },
            "then": {
              "required": ["schema"]
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["operations"],
  "additionalProperties": false
}
