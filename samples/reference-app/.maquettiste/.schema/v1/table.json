{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Table",
  "description": "A physical table. A synthesized table's file holds only overrides.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "database",
    "schema",
    "origin",
    "entity",
    "attribute",
    "relation",
    "description",
    "rationale",
    "decision",
    "status",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "columns",
    "primaryKey",
    "uniques",
    "foreignKeys",
    "checks",
    "exclusions",
    "indexes",
    "redefines",
    "excludes",
    "partitionBy",
    "partitions",
    "storage",
    "comment",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "table"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "description": "The owning package. Membership only: the database still decides where the object goes.",
      "$ref": "common.json#/$defs/id"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "origin": {
      "enum": ["synthesized", "designed", "imported"],
      "default": "designed"
    },
    "entity": {
      "description": "Synthesized: the entity whose table (or, with attribute, child table) this file overrides.",
      "$ref": "common.json#/$defs/id"
    },
    "attribute": {
      "description": "Synthesized child table: the attribute of entity whose child table this file overrides.",
      "$ref": "common.json#/$defs/id"
    },
    "relation": {
      "description": "Synthesized junction table: the relation.",
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/tableColumn"
      },
      "default": []
    },
    "primaryKey": {
      "$ref": "common.json#/$defs/primaryKey"
    },
    "uniques": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/uniqueConstraint"
      },
      "default": []
    },
    "foreignKeys": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/foreignKey"
      },
      "default": []
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/checkConstraint"
      },
      "default": []
    },
    "exclusions": {
      "description": "Exclusion constraints (PostgreSQL EXCLUDE): no two rows may match on every element, each compared with its operator, such as a room (=) and a period (&&) for no overlapping bookings. The other dialects leave them out (MQ4056).",
      "type": "array",
      "items": {
        "title": "Exclusion constraint",
        "type": "object",
        "x-order": ["id", "name", "method", "elements", "where", "deferrable"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "description": "The constraint name; absent: ex_<table>_<columns>.",
            "$ref": "common.json#/$defs/label"
          },
          "method": {
            "description": "The index method that enforces it: gist (the usual one; the btree_gist extension compares scalar columns with =), spgist, btree or hash.",
            "enum": ["gist", "spgist", "btree", "hash"],
            "default": "gist"
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": ["column", "expression", "operatorClass", "operator"],
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "description": "An expression compared instead of a column, as SQL (written in parentheses).",
                  "type": "string",
                  "minLength": 1
                },
                "operatorClass": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "description": "The operator two rows must not both satisfy on this element: = for equal values, && for overlapping ranges.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["operator"],
              "oneOf": [
                {
                  "required": ["column"]
                },
                {
                  "required": ["expression"]
                }
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "where": {
            "description": "A predicate: only the rows that satisfy it are compared (a partial exclusion constraint).",
            "type": "string",
            "minLength": 1
          },
          "deferrable": {
            "enum": ["not-deferrable", "initially-immediate", "initially-deferred"],
            "default": "not-deferrable"
          }
        },
        "required": ["id", "elements"],
        "additionalProperties": false
      },
      "default": []
    },
    "indexes": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/tableIndex"
      },
      "default": []
    },
    "redefines": {
      "description": "Per-table exceptions to members (columns, keys, indexes and checks) the table inherits from its stereotypes: each entry names a stereotype member by its id and states only the facets it changes. The member keeps its keyed id (<table key>.<member id>). A column takes nullable, default, defaultSql, defaultName, comment and collation (default or defaultSql replaces the inherited default of either form); a primary key columns, name and clustered; a unique columns, name and nullsNotDistinct (columns lists the whole new list: own column ids and inherited keyed ids); a foreign key name, onDelete, onDeleteColumns, onUpdate and deferrable; an index name, where, method and storage (which replaces the inherited map); a check name. Type facets and a column's name are not redefinable: exclude the member and declare an own column (MQ2027).",
      "type": "array",
      "items": {
        "title": "Redefinition",
        "type": "object",
        "x-order": [
          "member",
          "name",
          "nullable",
          "default",
          "defaultSql",
          "defaultName",
          "comment",
          "collation",
          "columns",
          "clustered",
          "nullsNotDistinct",
          "onDelete",
          "onDeleteColumns",
          "onUpdate",
          "deferrable",
          "where",
          "method",
          "storage"
        ],
        "properties": {
          "member": {
            "description": "The id of the stereotype member the entry redefines.",
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "description": "A key's, index's or check's constraint name for this table, instead of the naming convention's.",
            "$ref": "common.json#/$defs/label"
          },
          "nullable": {
            "type": "boolean"
          },
          "default": {},
          "defaultSql": {
            "$ref": "common.json#/$defs/dialectMap"
          },
          "defaultName": {
            "$ref": "common.json#/$defs/label"
          },
          "comment": {
            "type": "string"
          },
          "collation": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "clustered": {
            "type": "boolean"
          },
          "nullsNotDistinct": {
            "type": "boolean"
          },
          "onDelete": {
            "enum": [
              "no-action",
              "restrict",
              "cascade",
              "set-null",
              "set-default"
            ]
          },
          "onDeleteColumns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "onUpdate": {
            "enum": [
              "no-action",
              "restrict",
              "cascade",
              "set-null",
              "set-default"
            ]
          },
          "deferrable": {
            "enum": [
              "not-deferrable",
              "initially-immediate",
              "initially-deferred"
            ]
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "default",
              "btree",
              "hash",
              "gin",
              "gist",
              "spgist",
              "brin",
              "hnsw",
              "ivfflat",
              "clustered"
            ]
          },
          "storage": {
            "description": "Index storage parameters per dialect for this table: they replace the inherited map whole, and an empty map removes them.",
            "allOf": [
              {
                "$ref": "common.json#/$defs/storage"
              }
            ]
          }
        },
        "required": [
          "member"
        ],
        "minProperties": 2,
        "additionalProperties": false
      },
      "x-sort": "member",
      "default": []
    },
    "excludes": {
      "description": "Ids of stereotype members (columns, keys, indexes and checks) the table does not inherit. A column that an inherited key, index or check the table keeps uses cannot be excluded alone (MQ2028).",
      "$ref": "common.json#/$defs/idList",
      "uniqueItems": true,
      "x-sort": ".",
      "default": []
    },
    "partitionBy": {
      "description": "Declarative partitioning (PostgreSQL PARTITION BY): the table holds no rows itself, its partitions do. Every primary or unique key includes the partition columns. The other dialects leave it out (MQ4056).",
      "type": "object",
      "x-order": ["strategy", "columns"],
      "properties": {
        "strategy": {
          "description": "range (by intervals, such as a month of a timestamp), list (by values) or hash (by a modulus).",
          "enum": ["range", "list", "hash"]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": ["strategy", "columns"],
      "additionalProperties": false
    },
    "partitions": {
      "description": "The partitions the DDL creates with the table (CREATE TABLE ... PARTITION OF), in the table's schema. The table's storage parameters are written on each of them (a partitioned table takes none). Partitions made over time (a month at a time) are an operational job, such as pg_partman's, set up by a SQL object.",
      "type": "array",
      "items": {
        "title": "Partition",
        "type": "object",
        "x-order": ["id", "name", "bounds", "default"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "bounds": {
            "description": "What follows FOR VALUES, as SQL: FROM ('2026-01-01') TO ('2026-02-01') for range, IN ('eu', 'us') for list, WITH (MODULUS 4, REMAINDER 0) for hash.",
            "type": "string",
            "minLength": 1
          },
          "default": {
            "description": "Whether this is the default partition, which takes the rows no other partition's bounds cover (not with hash); it has no bounds.",
            "type": "boolean",
            "default": false
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      },
      "default": []
    },
    "storage": {
      "description": "Table storage parameters per dialect: PostgreSQL WITH (fillfactor, autovacuum_*, toast.*, parallel_workers...), SQL Server WITH (DATA_COMPRESSION...), MySQL table options (ROW_FORMAT, KEY_BLOCK_SIZE...), Oracle physical attributes (PCTFREE...). Each parameter overrides the one the table's stereotypes give (a stereotype's storage, in stereotype order).",
      "$ref": "common.json#/$defs/storage"
    },
    "comment": {
      "type": "string"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "database"],
  "additionalProperties": false,
  "if": {
    "properties": {
      "origin": {
        "const": "synthesized"
      }
    },
    "required": ["origin"]
  },
  "then": {
    "oneOf": [
      {
        "required": ["entity"]
      },
      {
        "required": ["relation"]
      }
    ],
    "dependentRequired": {
      "attribute": ["entity"]
    }
  },
  "else": {
    "required": ["name"],
    "not": {
      "anyOf": [
        {
          "required": ["entity"]
        },
        {
          "required": ["attribute"]
        },
        {
          "required": ["relation"]
        }
      ]
    }
  }
}
