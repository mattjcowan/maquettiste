{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relation",
  "description": "A named association between entities.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "inverseName",
    "relationKind",
    "description",
    "rationale",
    "decision",
    "status",
    "stereotypes",
    "tags",
    "category",
    "ends",
    "attributes",
    "allowDuplicates",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "relation"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "inverseName": {
      "type": "string",
      "minLength": 1
    },
    "relationKind": {
      "enum": ["association", "aggregation", "composition", "n-ary"],
      "default": "association"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "ends": {
      "type": "array",
      "items": {
        "title": "Relation end",
        "type": "object",
        "x-order": ["id", "entity", "role", "navigation", "displayName", "pluralName", "min", "max", "onDelete", "ordered", "description"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "entity": {
            "$ref": "common.json#/$defs/id"
          },
          "role": {
            "$ref": "common.json#/$defs/identifier"
          },
          "navigation": {
            "description": "Property name generated on the opposite entity; empty means not navigable from there.",
            "anyOf": [
              {
                "$ref": "common.json#/$defs/identifier"
              },
              {
                "const": ""
              }
            ],
            "default": ""
          },
          "displayName": {
            "type": "string"
          },
          "pluralName": {
            "type": "string"
          },
          "min": {
            "enum": [0, 1],
            "default": 0
          },
          "max": {
            "enum": [1, "*"],
            "default": "*"
          },
          "onDelete": {
            "enum": ["none", "cascade", "restrict", "set-null"],
            "default": "none"
          },
          "ordered": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["id", "entity", "role"],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "attributes": {
      "type": "array",
      "x-sort": "order",
      "items": {
        "$ref": "common.json#/$defs/attribute"
      },
      "default": []
    },
    "allowDuplicates": {
      "type": "boolean",
      "default": false
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "ends"],
  "additionalProperties": false
}
