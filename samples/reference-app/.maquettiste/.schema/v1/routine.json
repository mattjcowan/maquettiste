{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routine",
  "description": "A stored function or procedure of a database, with typed parameters, a result and a body per dialect (model/databases/<db>/routines/).",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "database",
    "schema",
    "description",
    "stereotypes",
    "tags",
    "category",
    "routineKind",
    "parameters",
    "returns",
    "language",
    "body",
    "deterministic",
    "security",
    "dependsOn",
    "comment",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "routine"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "routineKind": {
      "description": "A function returns a value or a table; a procedure is called for its effects and may return result sets.",
      "enum": ["function", "procedure"],
      "default": "function"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["name", "type", "length", "precision", "scale", "nativeType", "mode", "default"],
        "properties": {
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "type": {
            "$ref": "common.json#/$defs/dbTypeRef"
          },
          "length": {
            "$ref": "common.json#/$defs/length"
          },
          "precision": {
            "$ref": "common.json#/$defs/precision"
          },
          "scale": {
            "$ref": "common.json#/$defs/scale"
          },
          "nativeType": {
            "description": "A native type that replaces the one the type gives.",
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["in", "out", "inout"],
            "default": "in"
          },
          "default": {
            "description": "A default value as SQL text.",
            "type": "string"
          }
        },
        "required": ["name"],
        "anyOf": [
          {
            "required": ["type"]
          },
          {
            "required": ["nativeType"]
          }
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "returns": {
      "description": "The result: a single value (type or nativeType) or a table (columns); absent for a procedure or a function that returns nothing.",
      "type": "object",
      "x-order": ["type", "length", "precision", "scale", "nativeType", "table"],
      "properties": {
        "type": {
          "$ref": "common.json#/$defs/dbTypeRef"
        },
        "length": {
          "$ref": "common.json#/$defs/length"
        },
        "precision": {
          "$ref": "common.json#/$defs/precision"
        },
        "scale": {
          "$ref": "common.json#/$defs/scale"
        },
        "nativeType": {
          "description": "A native type that replaces the one the type gives, or a result the built-in types do not name (trigger, setof record).",
          "type": "string",
          "minLength": 1
        },
        "table": {
          "description": "The columns of a table result.",
          "type": "array",
          "items": {
            "type": "object",
            "x-order": ["name", "type", "length", "precision", "scale", "nativeType", "nullable"],
            "properties": {
              "name": {
                "$ref": "common.json#/$defs/label"
              },
              "type": {
                "$ref": "common.json#/$defs/dbTypeRef"
              },
              "length": {
                "$ref": "common.json#/$defs/length"
              },
              "precision": {
                "$ref": "common.json#/$defs/precision"
              },
              "scale": {
                "$ref": "common.json#/$defs/scale"
              },
              "nativeType": {
                "type": "string",
                "minLength": 1
              },
              "nullable": {
                "type": "boolean",
                "default": true
              }
            },
            "required": ["name"],
            "anyOf": [
              {
                "required": ["type"]
              },
              {
                "required": ["nativeType"]
              }
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": ["type"]
        },
        {
          "required": ["nativeType"]
        },
        {
          "required": ["table"]
        }
      ],
      "additionalProperties": false
    },
    "language": {
      "description": "The body's language; absent means the dialect's own (plpgsql on PostgreSQL, tsql on SQL Server, sql elsewhere).",
      "type": "string",
      "minLength": 1
    },
    "body": {
      "description": "Per dialect, the routine's body: what follows the signature (on PostgreSQL the text inside the dollar quotes, on SQL Server what follows AS).",
      "$ref": "common.json#/$defs/dialectMap",
      "minProperties": 1
    },
    "deterministic": {
      "description": "Whether the routine returns the same result for the same arguments (IMMUTABLE on PostgreSQL).",
      "type": "boolean",
      "default": false
    },
    "security": {
      "description": "Whose rights the routine runs with: the caller's (invoker) or its owner's (definer).",
      "enum": ["invoker", "definer"],
      "default": "invoker"
    },
    "dependsOn": {
      "description": "Tables, views, sequences, routines, database types and SQL objects of the same database that must exist first.",
      "$ref": "common.json#/$defs/idList",
      "uniqueItems": true,
      "default": []
    },
    "comment": {
      "type": "string"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "database", "body"],
  "additionalProperties": false
}
