{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package",
  "description": "A namespace that groups elements.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "parent",
    "dependsOn",
    "defaultStereotypes",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "package"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "parent": {
      "$ref": "common.json#/$defs/id"
    },
    "dependsOn": {
      "description": "The packages this package's elements may reference. Declared, even as [], it makes the package and the packages under it checked; absent, the package is unchecked unless a parent declares it.",
      "$ref": "common.json#/$defs/idList",
      "uniqueItems": true
    },
    "defaultStereotypes": {
      "description": "Stereotype keys every element of the package and of the packages under it carries, applied before their own stereotypes, outermost package first. A default skips an element whose kind it does not apply to; an element leaves one out with excludeStereotypes.",
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name"],
  "additionalProperties": false
}
