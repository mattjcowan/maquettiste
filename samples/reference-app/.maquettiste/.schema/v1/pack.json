{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template pack",
  "description": "templates/<pack>/pack.json.",
  "type": "object",
  "x-order": [
    "$schema",
    "name",
    "version",
    "engine",
    "description",
    "parameters",
    "parameterSchema",
    "scripts",
    "usesSchemaDiff",
    "units"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "name": {
      "$ref": "common.json#/$defs/key"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "default": {}
    },
    "parameterSchema": {
      "description": "The parameters' schema: a JSON Schema properties object and the required names; defaults stay in parameters.",
      "type": "object",
      "x-order": [
        "properties",
        "required"
      ],
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "usesSchemaDiff": {
      "type": "boolean",
      "default": false
    },
    "units": {
      "type": "array",
      "items": {
        "title": "Unit",
        "type": "object",
        "x-order": [
          "id",
          "template",
          "for",
          "where",
          "output",
          "mode",
          "formatter",
          "delimiters",
          "companion",
          "transforms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "for": {
            "type": "string",
            "pattern": "^(model|each (package|entity|relation|enum|value object|table|reference type|seed|locale|process|actor|scenario)|select [A-Za-z_][A-Za-z0-9_]*)$"
          },
          "where": {
            "title": "Unit filters",
            "type": "object",
            "x-order": [
              "tags",
              "notTags",
              "stereotypes",
              "notStereotypes",
              "categories",
              "packages",
              "notPackages",
              "database",
              "abstract",
              "script"
            ],
            "properties": {
              "tags": {
                "$ref": "common.json#/$defs/tagList",
                "default": []
              },
              "notTags": {
                "$ref": "common.json#/$defs/tagList",
                "default": []
              },
              "stereotypes": {
                "$ref": "common.json#/$defs/keyList",
                "default": []
              },
              "notStereotypes": {
                "$ref": "common.json#/$defs/keyList",
                "default": []
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "notPackages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "database": {
                "type": "string",
                "minLength": 1
              },
              "abstract": {
                "type": "boolean"
              },
              "script": {
                "$ref": "common.json#/$defs/identifier"
              }
            },
            "additionalProperties": false
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "overwrite",
              "once",
              "regions",
              "pair"
            ],
            "default": "overwrite"
          },
          "formatter": {
            "type": "string",
            "minLength": 1
          },
          "delimiters": {
            "type": "object",
            "x-order": [
              "open",
              "close"
            ],
            "properties": {
              "open": {
                "type": "string",
                "minLength": 1
              },
              "close": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "open",
              "close"
            ],
            "additionalProperties": false
          },
          "companion": {
            "type": "object",
            "x-order": [
              "template",
              "output"
            ],
            "properties": {
              "template": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "template",
              "output"
            ],
            "additionalProperties": false
          },
          "transforms": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/identifier"
            },
            "default": []
          }
        },
        "required": [
          "id",
          "template",
          "for"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "mode": {
              "const": "pair"
            }
          },
          "required": [
            "mode"
          ]
        },
        "then": {
          "required": [
            "companion"
          ]
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "name",
    "version",
    "engine",
    "units"
  ],
  "additionalProperties": false
}
