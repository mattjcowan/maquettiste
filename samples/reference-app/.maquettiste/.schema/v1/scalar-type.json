{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom scalar type",
  "description": "A named restriction of a built-in type.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "description",
    "stereotypes",
    "tags",
    "category",
    "base",
    "length",
    "precision",
    "scale",
    "validation",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "scalar-type"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "base": {
      "$ref": "common.json#/$defs/builtinType"
    },
    "length": {
      "$ref": "common.json#/$defs/length"
    },
    "precision": {
      "$ref": "common.json#/$defs/precision"
    },
    "scale": {
      "$ref": "common.json#/$defs/scale"
    },
    "validation": {
      "$ref": "common.json#/$defs/validation"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "base"],
  "additionalProperties": false
}
