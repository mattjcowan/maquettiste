{
  "$schema": ".schema/v1/maquettiste.json",
  "formatVersion": 1,
  "name": "reference-app",
  "outputs": {
    "allow": [
      {
        "path": "db",
        "commit": true
      },
      {
        "path": "src/ReferenceApp.Data/Generated"
      }
    ]
  },
  "conventions": {
    "enumStorage": "string",
    "referenceStorage": {
      "strategy": "lookup-table"
    }
  },
  "referenceData": {
    "strategies": {
      "check": {
        "description": "CHECK (column IN (codes))"
      },
      "lookup-table": {
        "description": "Table keyed by code, a foreign key from each column",
        "collections": true,
        "options": {
          "schema": {
            "type": "string"
          },
          "tableName": {
            "type": "string"
          }
        }
      }
    }
  },
  "packs": {
    "csharp-dapper": {
      "output": "src/ReferenceApp.Data/Generated",
      "parameters": {
        "namespace": "ReferenceApp.Data"
      }
    },
    "sql-ddl": {
      "output": "db"
    }
  }
}
