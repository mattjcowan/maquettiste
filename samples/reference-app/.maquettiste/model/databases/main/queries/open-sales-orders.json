{
  "$schema": "../../../../.schema/v1/query.json",
  "kind": "query",
  "id": "01M271B0Z1YTW9BX14WNDVQ9PB",
  "name": "OpenSalesOrders",
  "database": "01M34AZ3RECQSPQQX1DXTCN03G",
  "description": "A customer's sales orders in some statuses, newest first.",
  "parameters": [
    {
      "name": "customerId",
      "type": "uuid"
    },
    {
      "name": "statuses",
      "type": "string",
      "length": 8,
      "collection": true,
      "description": "Status codes such as SUBMIT or CONFIRM."
    }
  ],
  "from": {
    "source": "01M1GBW3NDKS6WCM5FAXYVHV7B",
    "alias": "o"
  },
  "select": [
    {
      "name": "id",
      "expression": {
        "column": "o.id"
      }
    },
    {
      "name": "orderNumber",
      "expression": {
        "column": "o.order_number"
      }
    },
    {
      "name": "orderedAt",
      "expression": {
        "column": "o.ordered_at"
      }
    },
    {
      "name": "status",
      "expression": {
        "column": "o.status"
      }
    },
    {
      "name": "source",
      "expression": {
        "column": "o.source"
      }
    },
    {
      "name": "promisedDeliveryOn",
      "expression": {
        "column": "o.promised_delivery_on"
      }
    },
    {
      "name": "createdAt",
      "expression": {
        "column": "o.created_at"
      }
    }
  ],
  "where": {
    "and": [
      {
        "op": "eq",
        "left": {
          "column": "o.customer_id"
        },
        "right": {
          "param": "customerId"
        }
      },
      {
        "op": "in",
        "left": {
          "column": "o.status"
        },
        "right": {
          "param": "statuses"
        }
      },
      {
        "op": "isNull",
        "left": {
          "column": "o.deleted_at"
        }
      }
    ]
  },
  "orderBy": [
    {
      "expression": {
        "column": "o.ordered_at"
      },
      "direction": "desc"
    }
  ]
}
