<Project>
  <!-- Shared build settings (engine-design.md section 1). Owned by the scaffold; workers do not edit this file. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- InvariantGlobalization is set by the CLI and bench apps only: on a library it has no runtime effect (the host decides), and
         it would switch off the culture analyzers (CA1304, CA1305, CA1307, CA1309, CA1310, CA1311) that .editorconfig makes errors. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <Authors>Matt Cowan</Authors>
    <Company>Maquettiste</Company>
    <Product>Maquettiste</Product>
    <Copyright>Copyright (c) 2026 MJC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mattjcowan/maquettiste</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Missing XML docs (CS1591) are errors in src/ and allowed in tests/ and bench/. The test is on the project folder relative
       to this file, so a checkout that itself lives under a folder named tests or bench keeps src/ strict. -->
  <PropertyGroup>
    <_MqProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</_MqProjectFolder>
  </PropertyGroup>
  <PropertyGroup Condition="$(_MqProjectFolder.StartsWith('tests/')) Or $(_MqProjectFolder.StartsWith('bench/'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
