# User files
tmp/

# Build output
bin/
obj/
artifacts/
*.nupkg
*.snupkg

# JavaScript dependencies, tool caches and build output, wherever npm or Vite runs
node_modules/
.vite/
dist/
dist-mock/

# IDEs
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# Test output
TestResults/
test-results/
playwright-report/
blob-report/
*.trx
coverage*.xml
coverage*.json

# Benchmark output (bench writes its synthetic repos and reports here by default)
bench/out/
bench/results/
BenchmarkDotNet.Artifacts/

# Maquettiste working folders created by local runs of the CLI
.maquettiste/.cache/

# OS
.DS_Store
Thumbs.db

# Claude Code local permissions
.claude/settings.local.json

# The engine's working folders (unit state, run journal, locks) are never committed.
**/.maquettiste/.cache/

# The docs site's hook (docs/.hooks) and its build output
__pycache__/
site/
