<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owned by the scaffold (engine-design.md section 18); workers do not edit this file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Maquettiste.Engine.Tests</RootNamespace>
    <AssemblyName>Maquettiste.Engine.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- Tests run with real culture data, so culture tests (tr-TR, de-DE) exercise what a host with any culture would do. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Maquettiste.Engine/Maquettiste.Engine.csproj" />
    <ProjectReference Include="../Maquettiste.Testing/Maquettiste.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Fixture repos are read from tests/fixtures through their source path (see Maquettiste.Testing.Fixtures). -->
</Project>
