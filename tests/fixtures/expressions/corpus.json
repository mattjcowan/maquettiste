{
  "about": "The differential corpus of the expression language (next-phase-3-design.md, task H5). Each case types its columns, lowers its text to PostgreSQL and to JavaScript, and runs both over every row. A row's answer is the condition's three-valued result; a check passes unless it is false and a guard holds only when it is true. A case at a table reads its row by column name in each mode; a guard case reads its context and payload by name, through relations, with now(). Column types: bool, int16, int32, int64, decimal, decimal(p,s), double, string, char(n), date, time, datetime, datetimeoffset, uuid, json, enum:<name>:integer, enum:<name>:text and code:<name>; a trailing ? makes the column optional.",
  "enums": [
    {
      "name": "InvoiceStatus",
      "members": [
        { "name": "Draft", "code": "DRAFT", "value": 10 },
        { "name": "Sent", "code": "SENT", "value": 20 },
        { "name": "Paid", "code": "PAID", "value": 30 },
        { "name": "Void" }
      ]
    }
  ],
  "referenceTypes": [ { "name": "PaymentTerm", "codes": [ "NET30", "NET60", "DUE" ] } ],
  "constraints": [
    { "name": "PositiveAmount", "parameters": { "amount": "decimal" }, "condition": "amount > 0" },
    { "name": "ShortWindow", "parameters": { "opensOn": "date", "closesOn": "date" }, "condition": "closesOn between opensOn and add_days(opensOn, 31)" },
    { "name": "LargeSquare", "parameters": { "amount": "decimal" }, "condition": "amount * amount > 2000000000" },
    { "name": "LargeRateSquare", "parameters": { "rate": "double" }, "condition": "rate * rate > 2000000000" }
  ],
