  "name": "overdue_rentals",
  "database": "01K70SPKCH3XJRR0BM82TM9GT4",
  "schema": "01K70SPKCHE564R3A6M9TVDBPV",
  "description": "Rentals past their due time, with the member to call and the bike to find.",
  "body": {
    "*": "SELECT r.id, r.reference, r.due_at, m.member_number, m.phone, b.frame_number\nFROM rentals.rentals r\nJOIN membership.members m ON m.id = r.member_id\nJOIN fleet.bikes b ON b.id = r.bike_id\nWHERE r.status = 'Overdue'"
  },
  "columns": [
    {
      "name": "id",
