        "01K70SPKCJDF4WEW7YWHRM9TF8"
      ]
    }
  ],
  "guards": [
    {
      "id": "01K70SPKCJP7FYFNBYN8HD3MKQ",
      "name": "settlesTheBalance",
      "displayName": "Settles the balance",
      "expression": "context.amountPaid + event.payload.amount >= context.totalCharge"
    }
  ],
  "actions": [
    {
      "id": "01K70SPKCJDKZ04BRJP8BRMVCR",
      "name": "addLateFee",
      "displayName": "Add the late fee",
      "expression": "({ totalCharge: context.totalCharge + 5 })"
    },
    {
      "id": "01K70SPKCJJG9KRQV52DD3Z73T",
      "name": "recordPayment",
      "displayName": "Record the payment",
      "expression": "({ amountPaid: context.amountPaid + event.payload.amount })"
