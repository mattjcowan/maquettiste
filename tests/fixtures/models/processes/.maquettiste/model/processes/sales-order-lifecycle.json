                }
              ]
            },
            {
              "id": "01JQSTA0000000000000000010",
              "name": "Shipping",
              "type": "compound",
              "states": [
                {
                  "id": "01JQSTA0000000000000000011",
                  "name": "Picking"
                },
                {
                  "id": "01JQSTA0000000000000000012",
                  "name": "Packing"
                },
                {
                  "id": "01JQSTA0000000000000000013",
                  "name": "Shipped",
                  "type": "final"
                }
              ]
            }
          ]
        },
        {
          "id": "01JQSTA0000000000000000014",
          "name": "Resume",
          "type": "history",
          "history": "deep",
          "defaultTarget": "01JQSTA0000000000000000005"
        }
      ],
      "description": "Wraps the parallel regions so that the deep history state belongs to a compound state."
