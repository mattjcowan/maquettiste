<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The generated scenario tests (Generated/, the csharp-dapper pack's scenario-tests unit, gitignored) and ScenarioHost,
    which runs them against the Processes.Data stores over an in-memory SQLite database built from the sql-ddl output
    (db/main/schema.sql).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Processes.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Package advisories are not this fixture's concern: they would fail the gate on a new advisory, not on a change here. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Processes.Data/Processes.Data.csproj" />
    <None Include="../../db/main/schema.sql" Link="schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
