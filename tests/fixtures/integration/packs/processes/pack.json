{
  "name": "processes",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "description": "Fixture pack over the gate 3 model: one unit per process, per actor and per scenario.",
  "units": [
    {
      "id": "process",
      "template": "process.scriban",
      "for": "each process",
      "output": "processes/{{ kebab process.name }}.txt"
    },
    {
      "id": "actor",
      "template": "actor.scriban",
      "for": "each actor",
      "output": "actors/{{ kebab actor.name }}.txt"
    },
    {
      "id": "scenario",
      "template": "scenario.scriban",
      "for": "each scenario",
      "output": "scenarios/{{ kebab scenario.process.name }}/{{ kebab scenario.name }}.txt"
    }
  ]
}
