{
  "name": "records",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "description": "One record class per entity.",
  "uses": [
    { "pack": "naming", "version": "^1.2.0" }
  ],
  "units": [
    {
      "id": "record",
      "template": "record.scriban",
      "for": "each entity",
      "output": "records/{{ entity.package.name }}/{{ naming.class_name entity }}.cs"
    }
  ]
}
