{
  "name": "services",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "description": "One service class per entity.",
  "uses": [
    { "pack": "naming", "version": "^1.2.0" }
  ],
  "units": [
    {
      "id": "service",
      "template": "service.scriban",
      "for": "each entity",
      "output": "services/{{ entity.package.name }}/{{ naming.class_name entity }}Service.cs"
    }
  ]
}
