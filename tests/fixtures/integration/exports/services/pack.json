{
  "name": "services",
  "version": "1.0.0",
  "engine": ">=1.0",
  "uses": [{ "pack": "records", "version": "^1.0.0" }],
  "units": [
    { "id": "service", "template": "service.scriban", "for": "each entity", "output": "services/{{ entity.package.name }}/{{ pascal entity.name }}Service.cs" },
    { "id": "status", "template": "status.scriban", "for": "each enum", "output": "services/{{ pascal enum.name }}.txt" }
  ]
}
