{
  "name": "records",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "description": "One record class per entity.",
  "uses": [
    {
      "pack": "naming",
      "version": "^1.0.0"
    }
  ],
  "parameters": {
    "suffix": "Record"
  },
  "units": [
    {
      "id": "record",
      "template": "record.scriban",
      "for": "each entity",
      "output": "{{ entity.package.name }}/{{ naming.class_name entity }}.cs"
    }
  ]
}
