{
  "name": "modes",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "units": [
    {
      "id": "scaffold",
      "template": "scaffold.tpl",
      "for": "each entity",
      "output": "out/scaffold/{{name}}.txt",
      "mode": "once"
    },
    {
      "id": "pair",
      "template": "pair.tpl",
      "for": "each entity",
      "output": "gen/pair/{{name}}.g.txt",
      "mode": "pair",
      "companion": {
        "template": "companion.tpl",
        "output": "gen/pair/{{name}}.txt"
      }
    },
    {
      "id": "regions",
      "template": "regions.tpl",
      "for": "each entity",
      "output": "out/regions/{{name}}.txt",
      "mode": "regions"
    },
    {
      "id": "blocks",
      "template": "blocks.tpl",
      "for": "model"
    }
  ]
}
