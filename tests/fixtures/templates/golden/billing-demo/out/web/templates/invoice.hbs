<section class="invoice">
  <h1>{{title}}</h1>
  {{#each items}}
  <span data-attr="id">{{this.id}}</span>
  <span data-attr="number">{{this.number}}</span>
  <span data-attr="issued_on">{{this.issuedOn}}</span>
  <span data-attr="total">{{this.total}}</span>
  <span data-attr="status">{{this.status}}</span>
  <span data-attr="notes">{{this.notes}}</span>
  <span data-attr="created_at">{{this.createdAt}}</span>
  <span data-attr="updated_at">{{this.updatedAt}}</span>
  <span data-attr="deleted_at">{{this.deletedAt}}</span>
  {{/each}}
  <p>raw: <% not code %> and {{ braces }}</p>
   closes it anyway
</section>
