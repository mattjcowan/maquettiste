<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the editor's functions (phase2-design.md section 3.9): handlers called through a router that binds them as the host
       does, the sign-in gate, the hooks, realtime events, the contract with docs/api/openapi.yaml and the bundle limits. No Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Maquettiste.Functions.Tests</RootNamespace>
    <AssemblyName>Maquettiste.Functions.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/Maquettiste.Functions/Maquettiste.Functions.csproj" />
    <ProjectReference Include="../Maquettiste.Testing/Maquettiste.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
