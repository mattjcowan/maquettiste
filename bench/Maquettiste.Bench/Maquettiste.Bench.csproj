<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owned by the scaffold (engine-design.md section 18); workers do not edit this file. -->
  <!-- A console app (dotnet run on this project) whose public types the CLI bench command also calls. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Maquettiste.Bench</RootNamespace>
    <AssemblyName>Maquettiste.Bench</AssemblyName>
  </PropertyGroup>

  <!-- Runtime settings for the budgets of SPEC Section 13 (measured on the synthetic benchmark; see bench/README.md "Runtime
       settings"): server GC with concurrent collection and without dynamic adaptation (DATAS starts with one heap and grows it,
       which costs the cold run most of what server GC saves); tiered PGO off, because its instrumented tier-0 code roughly doubles
       the cold load's CPU time on eight parallel readers; and call counting from the first call instead of after 100 ms, so hot
       loader and resolver methods reach tier 1 during a cold run. Server GC takes one heap per core, so memory grows with the core
       count; the heap count is deliberately not capped: at eight heaps on 24 cores the incremental run's GC pauses went from about
       0.03 s to 0.15 to 0.8 s and two runs in eight passed the 2 s budget (bench/README.md "Runtime settings"). These apply to this
       process only: a host that embeds the engine (the functions host) keeps its own GC and JIT settings; the same section gives
       the numbers without them. -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="../../src/Maquettiste.Engine/Maquettiste.Engine.csproj" />
  </ItemGroup>

  <!-- The packs the synthetic repo needs (engine-design.md section 17), embedded so maquettiste bench works from an installed tool:
       the two example packs and the bench-only fanout pack, under Maquettiste.Bench.Packs/<pack>/<path>. -->
  <ItemGroup>
    <EmbeddedResource Include="../../packs/sql-ddl/**/*" WithCulture="false" LogicalName="Maquettiste.Bench.Packs/sql-ddl/%(RecursiveDir)%(Filename)%(Extension)" Link="Packs/sql-ddl/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../packs/csharp-dapper/**/*" WithCulture="false" LogicalName="Maquettiste.Bench.Packs/csharp-dapper/%(RecursiveDir)%(Filename)%(Extension)" Link="Packs/csharp-dapper/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../packs/fanout/**/*" WithCulture="false" LogicalName="Maquettiste.Bench.Packs/fanout/%(RecursiveDir)%(Filename)%(Extension)" Link="Packs/fanout/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maquettiste.Cli.Tests" />
    <InternalsVisibleTo Include="Maquettiste.Engine.Tests" />
    <InternalsVisibleTo Include="Maquettiste.Bench.Tests" />
  </ItemGroup>
</Project>
