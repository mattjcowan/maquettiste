{{ banner "--" }}
{{- b = entity.bindings.main }}
{{- if b && b.source_table }}
SELECT {{ for c in b.source_table.columns }}{{ sql_quote c.name "postgresql" }}{{ if !for.last }}, {{ end }}{{ end }}
FROM {{ sql_quote b.source_table.name "postgresql" }};
{{- else }}
-- {{ entity.name }} has no table in main.
{{- end }}
