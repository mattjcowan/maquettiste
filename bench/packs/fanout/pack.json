    },
    {
      "id": "u14",
      "template": "templates/api.scriban",
      "for": "each entity",
      "output": "built/{{ entity.package.name }}/{{ entity.name }}.u14.json"
    },
    {
      "id": "u15",
      "template": "templates/record.scriban",
      "for": "each entity",
      "output": "committed/{{ entity.package.name }}/{{ entity.name }}.u15.cs"
    },
    {
      "id": "u16",
