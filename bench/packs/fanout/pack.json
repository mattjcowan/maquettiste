{
  "$schema": "../../.schema/v1/pack.json",
  "name": "fanout",
  "version": "1.0.0",
  "engine": ">=1.0 <2.0",
  "description": "Benchmark-only pack: many small files per entity over the synthetic model (engine-design.md section 17).",
  "parameters": {
    "namespace": "Bench.Generated"
  },
  "units": [
    {
      "id": "u01",
      "template": "templates/record.scriban",
      "for": "each entity",
      "output": "built/{{ entity.package.name }}/{{ entity.name }}.u01.cs"
    },
    {
      "id": "u02",
      "template": "templates/dto.scriban",
      "for": "each entity",
      "output": "built/{{ entity.package.name }}/{{ entity.name }}.u02.ts"
    },
    {
      "id": "u03",
      "template": "templates/validator.scriban",
      "for": "each entity",
      "output": "built/{{ entity.package.name }}/{{ entity.name }}.u03.cs"
    },
    {
      "id": "u04",
      "template": "templates/doc.scriban",
      "for": "each entity",
      "output": "built/{{ entity.package.name }}/{{ entity.name }}.u04.md"
    },
    {
      "id": "u05",
      "template": "templates/query.scriban",
      "for": "each entity",
      "output": "committed/{{ entity.package.name }}/{{ entity.name }}.u05.sql"
    },
    {
      "id": "u06",
      "template": "templates/links.scriban",
      "for": "each entity",
      "output": "built/{{ entity.package.name }}/{{ entity.name }}.u06.cs"
    },
    {
      "id": "u07",
