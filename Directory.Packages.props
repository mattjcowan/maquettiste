<Project>
  <!-- Central package versions (engine-design.md section 1). Owned by the scaffold; workers do not edit this file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine -->
    <PackageVersion Include="Scriban" Version="7.5.0" />
    <PackageVersion Include="Jint" Version="4.16.4" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <!-- Phase 2 (editor functions); pinned now, referenced by no phase 1 project. -->
    <PackageVersion Include="StaticSiteHost.Abstractions" Version="0.2.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
