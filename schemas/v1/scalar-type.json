{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom scalar type",
  "description": "A named restriction of a built-in type.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "description",
    "rationale",
    "decision",
    "status",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "base",
    "length",
    "precision",
    "scale",
    "validation",
    "nativeTypes",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "scalar-type"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "base": {
      "$ref": "common.json#/$defs/builtinType"
    },
    "length": {
      "$ref": "common.json#/$defs/length"
    },
    "precision": {
      "$ref": "common.json#/$defs/precision"
    },
    "scale": {
      "$ref": "common.json#/$defs/scale"
    },
    "validation": {
      "$ref": "common.json#/$defs/validation"
    },
    "nativeTypes": {
      "description": "The native type per dialect name, used instead of the base's type map entry for the columns that store this type in a database of that dialect. A value may use the type maps' {length}, {precision} and {scale} placeholders.",
      "type": "object",
      "propertyNames": {
        "enum": ["postgresql", "sqlserver", "mysql", "sqlite", "oracle"]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "default": {}
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "base"],
  "additionalProperties": false
}
