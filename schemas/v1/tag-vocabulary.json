{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tag vocabulary",
  "description": "The declared tags.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "description",
    "stereotypes",
    "tags",
    "category",
    "strict",
    "definitions",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "tag-vocabulary"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "strict": {
      "type": "boolean",
      "default": false
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["key", "description", "color"],
        "properties": {
          "key": {
            "$ref": "common.json#/$defs/tagLabel"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": ["key"],
        "additionalProperties": false
      },
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name"],
  "additionalProperties": false
}
