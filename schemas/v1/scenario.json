{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "A recorded event sequence of one process (model/scenarios/<process stem>/); it belongs to the process.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "process",
    "description",
    "stereotypes",
    "tags",
    "category",
    "start",
    "steps",
    "outcome",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "scenario"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "process": {
      "description": "The process; the scenario belongs to it.",
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "start": {
      "description": "The starting point.",
      "type": "object",
      "x-order": [
        "context",
        "at"
      ],
      "properties": {
        "context": {
          "description": "Initial context values over the attribute defaults, by attribute id.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "description": "A value of the attribute's type."
          },
          "default": {}
        },
        "at": {
          "description": "The simulated clock's start (an ISO 8601 instant).",
          "type": "string",
          "default": "2000-01-01T00:00:00Z"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "steps": {
      "description": "In order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "outcome": {
      "description": "Whether the root is final after the last step.",
      "enum": [
        "final",
        "active"
      ],
      "default": "active"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "process",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "title": "Step",
      "description": "One input to the process and what is expected after it.",
      "type": "object",
      "x-order": [
        "id",
        "input",
        "event",
        "invoke",
        "after",
        "actor",
        "signer",
        "meaning",
        "reason",
        "payload",
        "assume",
        "expect",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "input": {
          "enum": [
            "event",
            "time",
            "invoke-done",
            "invoke-error"
          ],
          "default": "event"
        },
        "event": {
          "$ref": "common.json#/$defs/id"
        },
        "invoke": {
          "$ref": "common.json#/$defs/id"
        },
        "after": {
          "description": "An ISO 8601 duration to advance the clock by, for input time.",
          "type": "string"
        },
        "actor": {
          "$ref": "common.json#/$defs/id"
        },
        "signer": {
          "description": "The signing person's identity, for gated events.",
          "type": "string"
        },
        "meaning": {
          "$ref": "common.json#/$defs/id"
        },
        "reason": {
          "type": "string"
        },
        "payload": {
          "description": "Payload values by attribute id.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "description": "A value of the attribute's type."
          },
          "default": {}
        },
        "assume": {
          "description": "Results for guards without an expression, by guard id.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {}
        },
        "expect": {
          "description": "What is expected after the step.",
          "type": "object",
          "x-order": [
            "accepted",
            "states",
            "context"
          ],
          "properties": {
            "accepted": {
              "description": "false records a refusal.",
              "type": "boolean",
              "default": true
            },
            "states": {
              "description": "The active atomic states, in document order.",
              "$ref": "common.json#/$defs/idList",
              "default": []
            },
            "context": {
              "description": "The attributes the step changed, by attribute id.",
              "type": "object",
              "propertyNames": {
                "$ref": "common.json#/$defs/id"
              },
              "additionalProperties": {
                "description": "A value of the attribute's type."
              },
              "default": {}
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "description": {
          "$ref": "common.json#/$defs/description"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
