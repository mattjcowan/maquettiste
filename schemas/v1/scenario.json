{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "A recorded event sequence of one process (model/scenarios/<process stem>/); it belongs to the process.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "process",
    "objects",
    "subject",
    "participants",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "start",
    "steps",
    "outcome",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "scenario"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "process": {
      "description": "The process; the scenario belongs to it.",
      "$ref": "common.json#/$defs/id"
    },
    "objects": {
      "description": "The scenario's cast: the objects its process runs for and the objects they link to. Requires subject.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 1,
      "default": []
    },
    "subject": {
      "description": "The id of the object the process runs for; required once there are objects.",
      "$ref": "common.json#/$defs/id"
    },
    "participants": {
      "description": "Who acts in the scenario: each stands for an actor, holds roles, groups or organizations (optionally within one of the scenario's objects), and may have an object as its record. A step names the one that acts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      },
      "default": []
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "start": {
      "description": "The starting point.",
      "type": "object",
      "x-order": [
        "context",
        "at"
      ],
      "properties": {
        "context": {
          "description": "Initial context values over the attribute defaults, by attribute id.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "description": "A value of the attribute's type."
          },
          "default": {}
        },
        "at": {
          "description": "The simulated clock's start (an ISO 8601 instant).",
          "type": "string",
          "default": "2000-01-01T00:00:00Z"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "steps": {
      "description": "In order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "outcome": {
      "description": "Whether the root is final after the last step.",
      "enum": [
        "final",
        "active"
      ],
      "default": "active"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "process",
    "steps"
  ],
  "dependentRequired": {
    "objects": ["subject"]
  },
  "additionalProperties": false,
  "$defs": {
    "object": {
      "title": "Object",
      "description": "An object of the scenario: an instance of an entity with its values and its links to other objects.",
      "type": "object",
      "x-order": [
        "id",
        "name",
        "entity",
        "values",
        "links",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "name": {
          "$ref": "common.json#/$defs/identifier"
        },
        "entity": {
          "description": "The entity the object is an instance of.",
          "$ref": "common.json#/$defs/id"
        },
        "values": {
          "description": "Values by attribute id; a value not given reads as the attribute's default, then null.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "description": "A value of the attribute's type."
          },
          "default": {}
        },
        "links": {
          "description": "The objects this object links to, each through a relation end.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "default": []
        },
        "owner": {
          "description": "The id of the scenario's participant that owns the object, for a subject whose process entry names no owner field.",
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "id",
        "name",
        "entity"
      ],
      "additionalProperties": false
    },
    "link": {
      "title": "Link",
      "description": "A link from an object to another object of the scenario through a relation end.",
      "type": "object",
      "x-order": [
        "end",
        "object"
      ],
      "properties": {
        "end": {
          "description": "The id of the relation end navigated from the object.",
          "$ref": "common.json#/$defs/id"
        },
        "object": {
          "description": "The id of the linked object.",
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "end",
        "object"
      ],
      "additionalProperties": false
    },
    "participant": {
      "title": "Participant",
      "description": "Someone or something that acts in the scenario.",
      "type": "object",
      "x-order": [
        "id",
        "name",
        "displayName",
        "identity",
        "actor",
        "holds",
        "object"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "name": {
          "$ref": "common.json#/$defs/identifier"
        },
        "displayName": {
          "type": "string"
        },
        "identity": {
          "description": "The value the team's system would hold for them, such as a login or a number; the name when absent.",
          "type": [
            "string",
            "integer"
          ]
        },
        "actor": {
          "description": "The person, external system or system actor they stand for; they then have its memberships.",
          "$ref": "common.json#/$defs/id"
        },
        "holds": {
          "description": "The roles, groups and organizations they hold.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/holding"
          },
          "default": []
        },
        "object": {
          "description": "The id of the scenario object that is their record.",
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "holding": {
      "title": "Holding",
      "description": "A role, group or organization held, with no context or within one of the scenario's objects.",
      "type": "object",
      "x-order": [
        "id",
        "actor",
        "within"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "actor": {
          "description": "The role, group or organization held.",
          "$ref": "common.json#/$defs/id"
        },
        "within": {
          "description": "The id of the scenario object it counts within; without it, it counts only where no context is asked.",
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "id",
        "actor"
      ],
      "additionalProperties": false
    },
    "step": {
      "title": "Step",
      "description": "One input to the process and what is expected after it.",
      "type": "object",
      "x-order": [
        "id",
        "input",
        "event",
        "invoke",
        "after",
        "participant",
        "actor",
        "signer",
        "meaning",
        "reason",
        "payload",
        "assume",
        "expect",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "input": {
          "enum": [
            "event",
            "time",
            "invoke-done",
            "invoke-error"
          ],
          "default": "event"
        },
        "event": {
          "$ref": "common.json#/$defs/id"
        },
        "invoke": {
          "$ref": "common.json#/$defs/id"
        },
        "after": {
          "description": "An ISO 8601 duration to advance the clock by, for input time.",
          "type": "string"
        },
        "participant": {
          "description": "The id of the scenario's participant that acts; the engine works out the actor it acts as unless actor is given.",
          "$ref": "common.json#/$defs/id"
        },
        "actor": {
          "$ref": "common.json#/$defs/id"
        },
        "signer": {
          "description": "The signing person's identity, for gated events; the participant's identity when absent.",
          "type": "string"
        },
        "meaning": {
          "$ref": "common.json#/$defs/id"
        },
        "reason": {
          "type": "string"
        },
        "payload": {
          "description": "Payload values by attribute id.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "description": "A value of the attribute's type."
          },
          "default": {}
        },
        "assume": {
          "description": "Results for guards without an expression, by guard id.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {}
        },
        "expect": {
          "description": "What is expected after the step.",
          "type": "object",
          "x-order": [
            "accepted",
            "states",
            "context"
          ],
          "properties": {
            "accepted": {
              "description": "false records a refusal.",
              "type": "boolean",
              "default": true
            },
            "states": {
              "description": "The active atomic states, in document order.",
              "$ref": "common.json#/$defs/idList",
              "default": []
            },
            "context": {
              "description": "The attributes the step changed, by attribute id.",
              "type": "object",
              "propertyNames": {
                "$ref": "common.json#/$defs/id"
              },
              "additionalProperties": {
                "description": "A value of the attribute's type."
              },
              "default": {}
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "description": {
          "$ref": "common.json#/$defs/description"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
