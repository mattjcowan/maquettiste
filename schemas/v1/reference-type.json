{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference type",
  "description": "A named set of rows that attributes use as their type; its rows are held in seeds.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "description",
    "rationale",
    "decision",
    "status",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "code",
    "label",
    "attributes",
    "storage",
    "bindings",
    "formerCodes",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "reference-type"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "code": {
      "title": "Reference code field",
      "description": "The built-in code field: the row's business key, unique in the type.",
      "type": "object",
      "x-order": ["id", "type", "length", "pattern", "displayName", "description"],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "type": {
          "enum": ["string", "int16", "int32", "int64", "uuid"],
          "default": "string"
        },
        "length": {
          "$ref": "common.json#/$defs/length"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "$ref": "common.json#/$defs/description"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "label": {
      "title": "Reference label field",
      "description": "The built-in label field: the row's display text.",
      "type": "object",
      "x-order": ["id", "length", "displayName", "description"],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "length": {
          "$ref": "common.json#/$defs/length"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "$ref": "common.json#/$defs/description"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/attribute"
      },
      "x-sort": "order",
      "default": []
    },
    "storage": {
      "description": "Storage choices keyed by database id, or \"*\" for every database.",
      "type": "object",
      "propertyNames": {
        "pattern": "^([0-7][0-9A-HJKMNP-TV-Z]{25}|\\*)$"
      },
      "additionalProperties": {
        "$ref": "common.json#/$defs/storageChoice"
      },
      "default": {}
    },
    "bindings": {
      "description": "The table files that hold the rows, at most one per database (optional). A binding wins over the storage choice in its database.",
      "type": "array",
      "items": {
        "title": "Reference type binding",
        "description": "The table file of one database that holds the type's rows: the column of each field and the constant columns that tell the type's rows apart in a shared table.",
        "type": "object",
        "x-order": ["id", "database", "table", "constants", "fields", "description"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "database": {
            "description": "The id of the database.",
            "$ref": "common.json#/$defs/id"
          },
          "table": {
            "description": "The id of a table file of the database.",
            "$ref": "common.json#/$defs/id"
          },
          "constants": {
            "description": "Columns with a fixed value on every row of the type.",
            "type": "array",
            "items": {
              "title": "Reference type binding constant",
              "type": "object",
              "x-order": ["column", "value"],
              "properties": {
                "column": {
                  "description": "A column of the table: its id or physical name.",
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "description": "The value; absent or null is SQL NULL.",
                  "type": ["string", "number", "boolean", "null"]
                }
              },
              "required": ["column"],
              "additionalProperties": false
            },
            "default": []
          },
          "fields": {
            "description": "The field map: code, label, description or a user field's id, and the table column it fills.",
            "type": "array",
            "items": {
              "title": "Reference type binding field",
              "type": "object",
              "x-order": ["attribute", "column"],
              "properties": {
                "attribute": {
                  "description": "code, label, description, or the id of a user field of the type.",
                  "type": "string",
                  "minLength": 1
                },
                "column": {
                  "description": "A column of the table: its id or physical name.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["attribute", "column"],
              "additionalProperties": false
            },
            "default": []
          },
          "description": {
            "$ref": "common.json#/$defs/description"
          }
        },
        "required": ["id", "database", "table"],
        "additionalProperties": false
      },
      "default": []
    },
    "formerCodes": {
      "description": "Codes the type's rows used to have, each with the row that holds its value now. A former code is never a live code again; imports, validation, names-to-ids and generated code still understand it. Remove an entry once no database stores the code.",
      "type": "array",
      "items": {
        "title": "Former code",
        "description": "A code a row of the type used to have, and the row that replaced it.",
        "type": "object",
        "x-order": ["code", "replacedBy"],
        "properties": {
          "code": {
            "description": "The former code, as the code's canonical text: a string code as written, an integer code in decimal digits, a uuid code in lowercase.",
            "type": "string",
            "minLength": 1
          },
          "replacedBy": {
            "description": "The id of the row of this type that holds the code's value now.",
            "$ref": "common.json#/$defs/id"
          }
        },
        "required": ["code", "replacedBy"],
        "additionalProperties": false
      },
      "x-sort": "code",
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "code",
    "label"
  ],
  "additionalProperties": false
}
