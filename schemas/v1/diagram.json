{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagram",
  "description": "A saved canvas: membership, positions and view state only.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "process",
    "description",
    "stereotypes",
    "tags",
    "category",
    "members",
    "viewport",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "diagram"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "process": {
      "description": "Set when the diagram is that process's statechart: its members are then states of the process.",
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["element", "x", "y", "width", "height", "collapsed"],
        "properties": {
          "element": {
            "$ref": "common.json#/$defs/id"
          },
          "x": {
            "type": "number",
            "default": 0
          },
          "y": {
            "type": "number",
            "default": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "collapsed": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["element"],
        "additionalProperties": false
      },
      "default": []
    },
    "viewport": {
      "type": "object",
      "x-order": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "zoom": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name"],
  "additionalProperties": false
}
