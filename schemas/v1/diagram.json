{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagram",
  "description": "A saved canvas: membership, positions and view state only.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "process",
    "membership",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "members",
    "viewport",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "diagram"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "process": {
      "description": "Set when the diagram is that process's statechart: its members are then states of the process.",
      "$ref": "common.json#/$defs/id"
    },
    "membership": {
      "description": "explicit: the members list is the diagram; package: the diagram shows every entity of its package and its relationships, members only carry positions",
      "enum": ["explicit", "package"],
      "default": "explicit"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["element", "x", "y", "width", "height", "collapsed"],
        "properties": {
          "element": {
            "$ref": "common.json#/$defs/id"
          },
          "x": {
            "description": "The x position of the element's card. On a relation with an end of several types: the x position of its junction node or box.",
            "type": "number",
            "default": 0
          },
          "y": {
            "description": "The y position of the element's card. On a relation with an end of several types: the y position of its junction node or box.",
            "type": "number",
            "default": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "collapsed": {
            "description": "Whether the card is collapsed. On a relation with an end of several types: whether its lines are collapsed into one line to a box that lists the end's entries.",
            "type": "boolean",
            "default": false
          }
        },
        "required": ["element"],
        "additionalProperties": false
      },
      "default": []
    },
    "viewport": {
      "type": "object",
      "x-order": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "zoom": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name"],
  "additionalProperties": false
}
