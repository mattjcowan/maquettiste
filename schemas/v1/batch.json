{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model batch",
  "description": "An atomic batch of element creates, updates and deletes, database schema operations, materialize operations and process operations, from the editor, a refactoring or an AI proposal.",
  "type": "object",
  "x-order": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "title": "Batch operation",
        "type": "object",
        "x-order": ["op", "id", "expectedHash", "resolution", "element", "locale", "field", "value", "database", "entities", "tables", "package", "schema", "name", "target", "default"],
        "properties": {
          "op": {
            "enum": ["create", "update", "delete", "translate", "add-schema", "rename-schema", "remove-schema", "set-default-schema", "materialize-tables", "materialize-entities", "sync-enum", "set-lifecycle", "set-initial", "refresh-scenario"]
          },
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "expectedHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "resolution": {
            "description": "What a delete does with references to the element: refuse (the default) while anything references it, remove-references to clear optional references, or delete-dependents to also remove or delete what cannot exist without it (delete only).",
            "enum": ["refuse", "remove-references", "delete-dependents"]
          },
          "element": {
            "type": "object",
            "required": ["kind"]
          },
          "locale": {
            "$ref": "common.json#/$defs/locale"
          },
          "field": {
            "enum": ["displayName", "pluralName", "label", "description"]
          },
          "value": {
            "description": "The translated text, a sidecar reference, or null to remove the translation.",
            "anyOf": [
              {
                "$ref": "common.json#/$defs/description"
              },
              {
                "type": "null"
              }
            ]
          },
          "database": {
            "description": "The database id (materialize-tables, materialize-entities).",
            "$ref": "common.json#/$defs/id"
          },
          "entities": {
            "description": "The entities that get a designed table and a binding (materialize-tables).",
            "$ref": "common.json#/$defs/idList",
            "minItems": 1
          },
          "tables": {
            "description": "The designed or imported tables and the views that get an entity and a binding (materialize-entities).",
            "$ref": "common.json#/$defs/idList",
            "minItems": 1
          },
          "package": {
            "description": "The package the new entities go to (materialize-entities).",
            "$ref": "common.json#/$defs/id"
          },
          "schema": {
            "description": "The database schema id (rename-schema, remove-schema, set-default-schema; optional for add-schema; for materialize-tables, the schema the tables go to, else each projected table's own).",
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "description": "The schema name (add-schema, rename-schema).",
            "type": "string",
            "minLength": 1
          },
          "target": {
            "description": "The schema id that the tables, views, sequences, convention entries and mappings of the removed schema move to (remove-schema); the process the entity follows, or absent to clear the lifecycle (set-lifecycle); the child state that becomes the initial one (set-initial).",
            "$ref": "common.json#/$defs/id"
          },
          "default": {
            "description": "The schema id that becomes the default when the removed schema is the default (remove-schema).",
            "$ref": "common.json#/$defs/id"
          }
        },
        "required": ["op"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["update", "delete"]
                }
              }
            },
            "then": {
              "required": ["id", "expectedHash"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["create", "update"]
                }
              }
            },
            "then": {
              "required": ["element"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "translate"
                }
              }
            },
            "then": {
              "required": ["locale", "id", "field", "value"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["add-schema", "rename-schema", "remove-schema", "set-default-schema", "sync-enum", "set-lifecycle", "set-initial", "refresh-scenario"]
                }
              }
            },
            "then": {
              "required": ["id"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "materialize-tables"
                }
              }
            },
            "then": {
              "required": ["database", "entities"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "materialize-entities"
                }
              }
            },
            "then": {
              "required": ["database", "tables", "package"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "set-initial"
                }
              }
            },
            "then": {
              "required": ["target"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["add-schema", "rename-schema"]
                }
              }
            },
            "then": {
              "required": ["name"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": ["rename-schema", "remove-schema", "set-default-schema"]
                }
              }
            },
            "then": {
              "required": ["schema"]
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["operations"],
  "additionalProperties": false
}
