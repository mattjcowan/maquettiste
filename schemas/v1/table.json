{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Table",
  "description": "A physical table. A synthesized table's file holds only overrides.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "database",
    "schema",
    "origin",
    "entity",
    "attribute",
    "relation",
    "description",
    "stereotypes",
    "tags",
    "category",
    "columns",
    "primaryKey",
    "uniques",
    "foreignKeys",
    "checks",
    "indexes",
    "comment",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "table"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "origin": {
      "enum": ["synthesized", "designed", "imported"],
      "default": "designed"
    },
    "entity": {
      "description": "Synthesized: the entity whose table (or, with attribute, child table) this file overrides.",
      "$ref": "common.json#/$defs/id"
    },
    "attribute": {
      "description": "Synthesized child table: the attribute of entity whose child table this file overrides.",
      "$ref": "common.json#/$defs/id"
    },
    "relation": {
      "description": "Synthesized junction table: the relation.",
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "columns": {
      "type": "array",
      "items": {
        "title": "Column",
        "type": "object",
        "x-order": [
          "id",
          "name",
          "displayName",
          "pluralName",
          "attribute",
          "type",
          "length",
          "precision",
          "scale",
          "nativeType",
          "unicode",
          "fixedLength",
          "nullable",
          "default",
          "defaultSql",
          "defaultName",
          "generated",
          "identity",
          "sequence",
          "computed",
          "computedStored",
          "collation",
          "comment",
          "description",
          "stereotypes",
          "tags",
          "category",
          "properties",
          "generation",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label",
            "default": ""
          },
          "displayName": {
            "type": "string"
          },
          "pluralName": {
            "type": "string"
          },
          "attribute": {
            "type": "string",
            "minLength": 1,
            "description": "Overlay: the synthesized column key this column overrides."
          },
          "type": {
            "$ref": "common.json#/$defs/builtinType"
          },
          "length": {
            "$ref": "common.json#/$defs/length"
          },
          "precision": {
            "$ref": "common.json#/$defs/precision"
          },
          "scale": {
            "$ref": "common.json#/$defs/scale"
          },
          "nativeType": {
            "type": "string",
            "minLength": 1
          },
          "unicode": {
            "description": "String and text columns: true stores Unicode text (SQL Server nvarchar and nchar, Oracle nvarchar2 and nchar, MySQL the utf8mb4 character set), false single-byte text (SQL Server varchar and char, Oracle varchar2 and char); absent takes the dialect's default, which is Unicode on SQL Server. PostgreSQL and SQLite keep every text in the database's encoding, so it changes nothing there. The type map's string:unicode, string:ansi and text:unicode entries decide the native types.",
            "type": "boolean"
          },
          "fixedLength": {
            "description": "String and binary columns: a fixed-length type of the column's length (char, nchar, binary) instead of a varying one; the type map's string:fixed and binary:fixed entries decide the native types.",
            "type": "boolean",
            "default": false
          },
          "nullable": {
            "description": "Designed or extra column: true (the default) or false. Overlay (with attribute): omitted keeps the synthesized value.",
            "type": "boolean",
            "default": true,
            "x-default-unless": "attribute"
          },
          "default": {},
          "defaultSql": {
            "$ref": "common.json#/$defs/dialectMap",
            "default": {}
          },
          "defaultName": {
            "description": "The name of the column's default constraint, where the dialect names defaults (SQL Server); absent names it df_<table>_<column>. Other dialects keep defaults in the column and ignore it.",
            "$ref": "common.json#/$defs/label"
          },
          "generated": {
            "enum": ["identity", "sequence"]
          },
          "identity": {
            "description": "With generated identity: the identity's first value (seed), its step (increment) and whether the database always generates the value and refuses one an insert gives (always, GENERATED ALWAYS) instead of generating it only when none is given (GENERATED BY DEFAULT). PostgreSQL and Oracle write all three; SQL Server writes IDENTITY(seed, increment) and always generates; MySQL writes the seed as the table's AUTO_INCREMENT; what a dialect lacks is left out (MQ4056).",
            "type": "object",
            "x-order": ["seed", "increment", "always"],
            "properties": {
              "seed": {
                "type": "integer"
              },
              "increment": {
                "type": "integer",
                "not": {
                  "const": 0
                }
              },
              "always": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          },
          "sequence": {
            "$ref": "common.json#/$defs/id"
          },
          "computed": {
            "type": "string",
            "minLength": 1
          },
          "computedStored": {
            "type": "boolean",
            "default": false
          },
          "collation": {
            "type": "string",
            "minLength": 1
          },
          "comment": {
            "type": "string"
          },
          "description": {
            "$ref": "common.json#/$defs/description"
          },
          "stereotypes": {
            "$ref": "common.json#/$defs/keyList",
            "default": []
          },
          "tags": {
            "$ref": "common.json#/$defs/tagList",
            "default": []
          },
          "category": {
            "$ref": "common.json#/$defs/id"
          },
          "properties": {
            "$ref": "common.json#/$defs/properties",
            "default": {}
          },
          "generation": {
            "$ref": "common.json#/$defs/generation",
            "default": {}
          },
          "source": {
            "$ref": "common.json#/$defs/source"
          }
        },
        "required": ["id"],
        "additionalProperties": false,
        "if": {
          "required": ["attribute"]
        },
        "then": {},
        "else": {
          "required": ["name", "type"]
        }
      },
      "default": []
    },
    "primaryKey": {
      "title": "Primary key",
      "type": "object",
      "x-order": ["name", "columns", "clustered"],
      "properties": {
        "name": {
          "$ref": "common.json#/$defs/label"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "clustered": {
          "type": "boolean"
        }
      },
      "required": ["columns"],
      "additionalProperties": false
    },
    "uniques": {
      "type": "array",
      "items": {
        "title": "Unique constraint",
        "type": "object",
        "x-order": ["id", "name", "columns", "nullsNotDistinct"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "nullsNotDistinct": {
            "description": "Whether two rows with nulls in the columns conflict (NULLS NOT DISTINCT, PostgreSQL 15 and later); the other dialects leave it out (MQ4056).",
            "type": "boolean",
            "default": false
          }
        },
        "required": ["id", "columns"],
        "additionalProperties": false
      },
      "default": []
    },
    "foreignKeys": {
      "type": "array",
      "items": {
        "title": "Foreign key",
        "type": "object",
        "x-order": ["id", "name", "columns", "referencesTable", "referencesColumns", "onDelete", "onUpdate", "deferrable"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "referencesTable": {
            "type": "string",
            "minLength": 1
          },
          "referencesColumns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "onDelete": {
            "enum": ["no-action", "restrict", "cascade", "set-null", "set-default"],
            "default": "no-action"
          },
          "onUpdate": {
            "enum": ["no-action", "restrict", "cascade", "set-null", "set-default"],
            "default": "no-action"
          },
          "deferrable": {
            "description": "When the key is checked: not-deferrable (every statement), initially-immediate (every statement unless a transaction defers it with SET CONSTRAINTS) or initially-deferred (at commit). PostgreSQL, SQLite and Oracle have deferrable keys; SQL Server and MySQL check every statement and leave it out (MQ4056).",
            "enum": ["not-deferrable", "initially-immediate", "initially-deferred"],
            "default": "not-deferrable"
          }
        },
        "required": ["id", "columns", "referencesTable"],
        "additionalProperties": false
      },
      "default": []
    },
    "checks": {
      "type": "array",
      "items": {
        "title": "Check constraint",
        "type": "object",
        "x-order": ["id", "name", "column", "expression"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "column": {
            "description": "A column check: the id or key of the column it constrains. The constraint is written in the table like any other check; a migration that drops the column drops the check first.",
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "$ref": "common.json#/$defs/dialectMap",
            "minProperties": 1
          }
        },
        "required": ["id", "expression"],
        "additionalProperties": false
      },
      "default": []
    },
    "indexes": {
      "type": "array",
      "items": {
        "title": "Index",
        "type": "object",
        "x-order": ["id", "name", "columns", "include", "where", "unique", "method"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": ["column", "expression", "descending", "length"],
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "description": "An expression indexed instead of a column (a functional index), per dialect name or \"*\": written in parentheses. A dialect without an entry leaves the index out; SQL Server indexes no expression (MQ4056: index a computed column instead), MySQL from 8.0.13 (not MariaDB).",
                  "$ref": "common.json#/$defs/dialectMap",
                  "minProperties": 1
                },
                "descending": {
                  "type": "boolean",
                  "default": false
                },
                "length": {
                  "description": "A key prefix length: only the first characters or bytes of the column are indexed (MySQL, which needs one for a text or blob column; the other dialects leave it out, MQ4056).",
                  "type": "integer",
                  "minimum": 1
                }
              },
              "oneOf": [
                {
                  "required": ["column"]
                },
                {
                  "required": ["expression"]
                }
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "unique": {
            "type": "boolean",
            "default": false
          },
          "method": {
            "enum": ["default", "btree", "hash", "gin", "gist", "clustered"],
            "default": "default"
          }
        },
        "required": ["id", "columns"],
        "additionalProperties": false
      },
      "default": []
    },
    "comment": {
      "type": "string"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "database"],
  "additionalProperties": false,
  "if": {
    "properties": {
      "origin": {
        "const": "synthesized"
      }
    },
    "required": ["origin"]
  },
  "then": {
    "oneOf": [
      {
        "required": ["entity"]
      },
      {
        "required": ["relation"]
      }
    ],
    "dependentRequired": {
      "attribute": ["entity"]
    }
  },
  "else": {
    "required": ["name"],
    "not": {
      "anyOf": [
        {
          "required": ["entity"]
        },
        {
          "required": ["attribute"]
        },
        {
          "required": ["relation"]
        }
      ]
    }
  }
}
