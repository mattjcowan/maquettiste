{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database",
  "description": "A physical store with a dialect.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "dialect",
    "version",
    "defaultSchema",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "schemas",
    "quoting",
    "maxIdentifierLength",
    "byConvention",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "database"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "description": "The owning package. Membership only: it routes no table.",
      "$ref": "common.json#/$defs/id"
    },
    "dialect": {
      "enum": ["postgresql", "sqlserver", "mysql", "sqlite", "oracle"]
    },
    "version": {
      "type": "string"
    },
    "defaultSchema": {
      "description": "The name of the schema that tables, views and sequences without a schema go to; absent means the dialect's (PostgreSQL public, SQL Server dbo).",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "schemas": {
      "type": "array",
      "items": {
        "title": "Database schema",
        "type": "object",
        "x-order": [
          "id",
          "name",
          "displayName",
          "pluralName",
          "description",
          "rationale",
          "decision",
          "status",
          "stereotypes",
          "defaultStereotypes",
          "tags",
          "category",
          "properties",
          "generation",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label",
            "default": ""
          },
          "displayName": {
            "type": "string"
          },
          "pluralName": {
            "type": "string"
          },
          "description": {
            "$ref": "common.json#/$defs/description"
          },
          "rationale": {
            "description": "Markdown text: why the element is shaped this way.",
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "$ref": "common.json#/$defs/status"
          },
          "stereotypes": {
            "$ref": "common.json#/$defs/keyList",
            "default": []
          },
          "defaultStereotypes": {
            "description": "Stereotype keys every table, view, sequence, routine, database type and SQL object of the schema carries, applied before package defaults and their own stereotypes. A default skips an object whose kind it does not apply to; an object leaves one out with excludeStereotypes.",
            "$ref": "common.json#/$defs/keyList",
            "default": []
          },
          "tags": {
            "$ref": "common.json#/$defs/tagList",
            "default": []
          },
          "category": {
            "$ref": "common.json#/$defs/id"
          },
          "properties": {
            "$ref": "common.json#/$defs/properties",
            "default": {}
          },
          "generation": {
            "$ref": "common.json#/$defs/generation",
            "default": {}
          },
          "source": {
            "$ref": "common.json#/$defs/source"
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      },
      "default": []
    },
    "quoting": {
      "enum": ["always", "reserved", "never"],
      "default": "reserved"
    },
    "maxIdentifierLength": {
      "type": "integer",
      "minimum": 1
    },
    "byConvention": {
      "description": "Written \"none\" by the editor on new databases, and what every database means since 0.29.0: a database holds only the tables written for it. The values all and packages, and the key packages, were removed with projection (MQ4145). A file with no byConvention gets warning MQ4146 while an entity is not bound to the database; its quick fix writes \"none\".",
      "enum": ["none"]
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "dialect"],
  "additionalProperties": false
}
