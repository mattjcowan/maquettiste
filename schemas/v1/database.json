{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database",
  "description": "A physical store with a dialect.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "dialect",
    "version",
    "defaultSchema",
    "description",
    "stereotypes",
    "tags",
    "category",
    "schemas",
    "quoting",
    "maxIdentifierLength",
    "byConvention",
    "packages",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "database"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "dialect": {
      "enum": ["postgresql", "sqlserver", "mysql", "sqlite", "oracle"]
    },
    "version": {
      "type": "string"
    },
    "defaultSchema": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "schemas": {
      "type": "array",
      "items": {
        "title": "Database schema",
        "type": "object",
        "x-order": [
          "id",
          "name",
          "displayName",
          "pluralName",
          "description",
          "stereotypes",
          "tags",
          "category",
          "properties",
          "generation",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "$ref": "common.json#/$defs/label",
            "default": ""
          },
          "displayName": {
            "type": "string"
          },
          "pluralName": {
            "type": "string"
          },
          "description": {
            "$ref": "common.json#/$defs/description"
          },
          "stereotypes": {
            "$ref": "common.json#/$defs/keyList",
            "default": []
          },
          "tags": {
            "$ref": "common.json#/$defs/tagList",
            "default": []
          },
          "category": {
            "$ref": "common.json#/$defs/id"
          },
          "properties": {
            "$ref": "common.json#/$defs/properties",
            "default": {}
          },
          "generation": {
            "$ref": "common.json#/$defs/generation",
            "default": {}
          },
          "source": {
            "$ref": "common.json#/$defs/source"
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      },
      "default": []
    },
    "quoting": {
      "enum": ["always", "reserved", "never"],
      "default": "reserved"
    },
    "maxIdentifierLength": {
      "type": "integer",
      "minimum": 1
    },
    "byConvention": {
      "description": "Which entities map here by convention: all, the entities of packages (and their sub-packages; none when packages is empty), or none. Mapping elements add or ignore single entities either way. Absent (files written before 0.3.0): every entity when packages is empty, else the entities of packages.",
      "enum": ["all", "packages", "none"]
    },
    "packages": {
      "$ref": "common.json#/$defs/idList",
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "dialect"],
  "additionalProperties": false
}
