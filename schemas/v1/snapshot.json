{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical snapshot",
  "description": "snapshots/<db>.json: the schema diff baseline.",
  "type": "object",
  "x-order": ["$schema", "database", "name", "dialect", "revision", "schemas", "tables", "views", "sequences", "types", "routines", "objects", "aliases"],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dialect": {
      "enum": ["postgresql", "sqlserver", "mysql", "sqlite", "oracle"]
    },
    "revision": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    "schemas": {
      "description": "The declared schemas, by key (the schema's id). Absent in a snapshot written before schemas were recorded: the diff then reports no schema changes until the next snapshot records them.",
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["key", "name"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["key", "name"],
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["key", "name", "schema", "columns", "primaryKey", "uniques", "foreignKeys", "checks", "indexes", "comment"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": [
                "key",
                "name",
                "type",
                "length",
                "precision",
                "scale",
                "nativeType",
                "nullable",
                "default",
                "defaultSql",
                "defaultName",
                "identity",
                "identitySeed",
                "identityIncrement",
                "identityAlways",
                "sequence",
                "computed",
                "computedStored",
                "collation",
                "comment",
                "referenceType",
                "strategy"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "description": "A built-in type, or reference for a column typed by a reference type (its code facets ride along).",
                  "anyOf": [
                    {
                      "$ref": "common.json#/$defs/builtinType"
                    },
                    {
                      "const": "reference"
                    }
                  ]
                },
                "length": {
                  "$ref": "common.json#/$defs/length"
                },
                "precision": {
                  "$ref": "common.json#/$defs/precision"
                },
                "scale": {
                  "$ref": "common.json#/$defs/scale"
                },
                "nativeType": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean",
                  "default": false
                },
                "default": {},
                "defaultSql": {
                  "type": "string"
                },
                "defaultName": {
                  "type": "string",
                  "minLength": 1
                },
                "identity": {
                  "type": "boolean",
                  "default": false
                },
                "identitySeed": {
                  "type": "integer"
                },
                "identityIncrement": {
                  "type": "integer"
                },
                "identityAlways": {
                  "type": "boolean",
                  "default": false
                },
                "sequence": {
                  "type": "string",
                  "minLength": 1
                },
                "computed": {
                  "type": "string"
                },
                "computedStored": {
                  "type": "boolean",
                  "default": false
                },
                "collation": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                },
                "referenceType": {
                  "$ref": "common.json#/$defs/id"
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["key", "name", "type"],
              "additionalProperties": false
            },
            "default": []
          },
          "primaryKey": {
            "type": "object",
            "x-order": ["key", "name", "columns", "clustered", "nullsNotDistinct"],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clustered": {
                "type": "boolean"
              },
              "nullsNotDistinct": {
                "type": "boolean",
                "default": false
              }
            },
            "required": ["key", "name", "columns"],
            "additionalProperties": false
          },
          "uniques": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": ["key", "name", "columns", "clustered", "nullsNotDistinct"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "clustered": {
                  "type": "boolean"
                },
                "nullsNotDistinct": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": ["key", "name", "columns"],
              "additionalProperties": false
            },
            "default": []
          },
          "foreignKeys": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": ["key", "name", "columns", "referencedTable", "referencedColumns", "onDelete", "onDeleteColumns", "onUpdate", "deferrable"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "referencedTable": {
                  "type": "string",
                  "minLength": 1
                },
                "referencedColumns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "onDelete": {
                  "enum": ["no-action", "restrict", "cascade", "set-null", "set-default"],
                  "default": "no-action"
                },
                "onDeleteColumns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "onUpdate": {
                  "enum": ["no-action", "restrict", "cascade", "set-null", "set-default"],
                  "default": "no-action"
                },
                "deferrable": {
                  "enum": ["not-deferrable", "initially-immediate", "initially-deferred"],
                  "default": "not-deferrable"
                }
              },
              "required": ["key", "name", "columns", "referencedTable", "referencedColumns"],
              "additionalProperties": false
            },
            "default": []
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": ["key", "name", "expression"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "type": "string"
                }
              },
              "required": ["key", "name", "expression"],
              "additionalProperties": false
            },
            "default": []
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "x-order": ["key", "name", "columns", "include", "where", "unique", "method"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "x-order": ["column", "expression", "descending", "length"],
                    "properties": {
                      "column": {
                        "type": "string",
                        "minLength": 1
                      },
                      "expression": {
                        "type": "string"
                      },
                      "descending": {
                        "type": "boolean",
                        "default": false
                      },
                      "length": {
                        "type": "integer"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "where": {
                  "type": "string"
                },
                "unique": {
                  "type": "boolean",
                  "default": false
                },
                "method": {
                  "enum": ["default", "btree", "hash", "gin", "gist", "clustered"],
                  "default": "default"
                }
              },
              "required": ["key", "name", "columns"],
              "additionalProperties": false
            },
            "default": []
          },
          "comment": {
            "type": "string"
          }
        },
        "required": ["key", "name"],
        "additionalProperties": false
      },
      "default": []
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["key", "name", "schema", "body", "columns", "withCheckOption", "materialized", "dependsOn", "comment"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "columns": {
            "description": "The column names CREATE VIEW lists (columnList), or none.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "withCheckOption": {
            "type": "boolean",
            "default": false
          },
          "materialized": {
            "type": "boolean",
            "default": false
          },
          "dependsOn": {
            "description": "The keys of the views of the database the view reads, so a migration drops it before them.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "comment": {
            "type": "string"
          }
        },
        "required": ["key", "name", "body"],
        "additionalProperties": false
      },
      "default": []
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["key", "name", "schema", "type", "start", "increment", "min", "max", "cycle", "cache"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string"
          },
          "type": {
            "enum": ["int16", "int32", "int64"],
            "default": "int64"
          },
          "start": {
            "type": "integer",
            "default": 1
          },
          "increment": {
            "type": "integer",
            "default": 1
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "cycle": {
            "type": "boolean",
            "default": false
          },
          "cache": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["key", "name"],
        "additionalProperties": false
      },
      "default": []
    },
    "types": {
      "description": "Database types, sorted by key.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      },
      "default": []
    },
    "routines": {
      "description": "Routines, sorted by key.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      },
      "default": []
    },
    "objects": {
      "description": "SQL objects, sorted by key.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      },
      "default": []
    },
    "aliases": {
      "description": "The other keys a table or sequence has had, by key: what materialize-tables stored as files.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias"
      }
    }
  },
  "required": ["database", "name", "dialect"],
  "additionalProperties": false,
  "$defs": {
    "alias": {
      "description": "Two keys of one table or sequence: the synthesized key a projected table (or a key sequence) had, and the id of the file materialize-tables stored it as. The schema diff reads the snapshot through them, so the table is one table whichever key the model gives it (stored, or put back by an undo).",
      "type": "object",
      "x-order": ["key", "alias", "kind", "columns"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["table", "sequence"],
          "default": "table"
        },
        "columns": {
          "description": "A table's column keys under the synthesized key (attribute paths) and the file's column ids.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["key", "alias"],
      "additionalProperties": false
    },
    "definition": {
      "description": "A routine, database type or SQL object: what it is and a text that changes whenever its definition for the dialect does.",
      "type": "object",
      "x-order": ["key", "name", "schema", "kind", "definition"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string"
        },
        "kind": {
          "description": "function or procedure; domain, composite, enum or range; the SQL object's objectKind.",
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      },
      "required": ["key", "name", "kind", "definition"],
      "additionalProperties": false
    }
  }
}
