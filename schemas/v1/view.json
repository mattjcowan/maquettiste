{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "View",
  "description": "A view with per-dialect SQL bodies.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "database",
    "schema",
    "description",
    "stereotypes",
    "tags",
    "category",
    "body",
    "columns",
    "comment",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "view"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "body": {
      "$ref": "common.json#/$defs/dialectMap",
      "minProperties": 1
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["name", "type", "nullable"],
        "properties": {
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "type": {
            "$ref": "common.json#/$defs/builtinType"
          },
          "nullable": {
            "type": "boolean",
            "default": true
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "default": []
    },
    "comment": {
      "type": "string"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "database", "body"],
  "additionalProperties": false
}
