{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "View",
  "description": "A view with per-dialect SQL bodies.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "database",
    "schema",
    "description",
    "stereotypes",
    "tags",
    "category",
    "body",
    "columns",
    "columnList",
    "withCheckOption",
    "materialized",
    "dependsOn",
    "comment",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "view"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "body": {
      "$ref": "common.json#/$defs/dialectMap",
      "minProperties": 1
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "x-order": ["name", "type", "nullable"],
        "properties": {
          "name": {
            "$ref": "common.json#/$defs/label"
          },
          "type": {
            "$ref": "common.json#/$defs/builtinType"
          },
          "nullable": {
            "type": "boolean",
            "default": true
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "default": []
    },
    "columnList": {
      "description": "Whether CREATE VIEW names the columns (CREATE VIEW v (a, b) AS ...), which then name the body's result columns.",
      "type": "boolean",
      "default": false
    },
    "withCheckOption": {
      "description": "Whether an insert or update through the view must satisfy its WHERE (WITH CHECK OPTION). SQLite and materialized views leave it out (MQ4056).",
      "type": "boolean",
      "default": false
    },
    "materialized": {
      "description": "Whether the view stores its rows (CREATE MATERIALIZED VIEW: PostgreSQL and Oracle; the other dialects create a plain view, MQ4056). Refreshing it is up to the application.",
      "type": "boolean",
      "default": false
    },
    "dependsOn": {
      "description": "Tables, views, sequences, routines, database types and SQL objects of the same database that must exist first. Views the body names are found without it (by reading the body), so this is for what the body names in a way that reading misses.",
      "$ref": "common.json#/$defs/idList",
      "uniqueItems": true,
      "default": []
    },
    "comment": {
      "type": "string"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "database", "body"],
  "additionalProperties": false
}
