{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template pack",
  "description": "templates/<pack>/pack.json.",
  "type": "object",
  "x-order": [
    "$schema",
    "name",
    "version",
    "engine",
    "description",
    "uses",
    "parameters",
    "parameterSchema",
    "scripts",
    "usesSchemaDiff",
    "units"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "name": {
      "$ref": "common.json#/$defs/key"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "uses": {
      "description": "The packs this pack uses: their partials and helpers render in its units. Each entry names a pack folder and a version range in the engine-range syntax.",
      "type": "array",
      "items": {
        "title": "Pack use",
        "type": "object",
        "x-order": [
          "pack",
          "version"
        ],
        "properties": {
          "pack": {
            "$ref": "common.json#/$defs/key"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pack",
          "version"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "parameters": {
      "type": "object",
      "default": {}
    },
    "parameterSchema": {
      "description": "The parameters' schema: a JSON Schema properties object and the required names; defaults stay in parameters. On a string, or an array's items, x-ref types the value as the id of an element or sub-element (MQ2009).",
      "type": "object",
      "x-order": [
        "properties",
        "required"
      ],
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "usesSchemaDiff": {
      "type": "boolean",
      "default": false
    },
    "units": {
      "type": "array",
      "items": {
        "title": "Unit",
        "type": "object",
        "x-order": [
          "id",
          "template",
          "for",
          "where",
          "output",
          "mode",
          "sources",
          "tokens",
          "blockComment",
          "blockCommentEnd",
          "createFile",
          "formatter",
          "delimiters",
          "companion",
          "transforms",
          "exports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "template": {
            "description": "The pack-relative template path. Required unless mode is copy; a copy unit takes none.",
            "type": "string",
            "minLength": 1
          },
          "for": {
            "description": "The unit's scope: model, each <kind>, each custom:<type> for the elements of a custom kind the project declares, or select <name> for a selector the pack's scripts register.",
            "type": "string",
            "pattern": "^(model|each (package|entity|attribute|relation|enum|value object|database|table|view|sequence|routine|database type|sql object|query|reference type|seed|locale|process|actor|scenario|operation|custom:[a-z][a-z0-9]*(-[a-z0-9]+)*)|select [A-Za-z_][A-Za-z0-9_]*)$"
          },
          "where": {
            "title": "Unit filters",
            "type": "object",
            "x-order": [
              "tags",
              "notTags",
              "stereotypes",
              "notStereotypes",
              "categories",
              "packages",
              "notPackages",
              "database",
              "abstract",
              "script"
            ],
            "properties": {
              "tags": {
                "$ref": "common.json#/$defs/tagList",
                "default": []
              },
              "notTags": {
                "$ref": "common.json#/$defs/tagList",
                "default": []
              },
              "stereotypes": {
                "$ref": "common.json#/$defs/keyList",
                "default": []
              },
              "notStereotypes": {
                "$ref": "common.json#/$defs/keyList",
                "default": []
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "notPackages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "database": {
                "type": "string",
                "minLength": 1
              },
              "abstract": {
                "type": "boolean"
              },
              "script": {
                "$ref": "common.json#/$defs/identifier"
              }
            },
            "additionalProperties": false
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "description": "overwrite: rewritten when inputs change. once: written only when missing, then the team's. regions: rewritten, keeping the bodies of maquettiste:keep regions. pair: a generated file and a companion written once. block: a managed block inside a file the team owns; the template renders the block's lines, and only the lines between '<comment> maquettiste: begin <pack>/<unit>' and '<comment> maquettiste: end <pack>/<unit>' (each followed by blockCommentEnd when set) are replaced, inserted at the end of the file after a blank line, or removed when the unit no longer produces them. Formatters never run on block outputs. copy: the pack files that sources match are copied as they are, with tokens replaced, into the folder output names (the pack's output base when absent); a copy unit takes no template. Copied files are managed like overwrite files.",
            "enum": [
              "overwrite",
              "once",
              "regions",
              "pair",
              "block",
              "copy"
            ],
            "default": "overwrite"
          },
          "sources": {
            "description": "Mode copy, required there: pack-relative glob patterns of the files to copy. * and ? match within one path segment, ** across segments; matching is case-sensitive and skips dot files and folders. A pattern that matches no pack file is MQ6030. Each file lands at the output folder plus its path after the pattern's literal base. Matched files are copied, never run or parsed: a matched *.js is not a pack script unless scripts names it, and a matched types/*.json is not a type map.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "default": []
          },
          "tokens": {
            "description": "Mode copy: literal text replaced in copied text files and their output paths, mapped to the name of a pack parameter whose value is a string (MQ6031). Files that are not UTF-8 text are copied byte for byte.",
            "type": "object",
            "propertyNames": {
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "default": {}
          },
          "blockComment": {
            "description": "Mode block: the comment marker that starts the block's delimiter lines, for example // or ;.",
            "type": "string",
            "pattern": "^[^\\s]+$",
            "default": "#"
          },
          "blockCommentEnd": {
            "description": "Mode block: the text that closes each delimiter line, for example --> after <!-- in XML or HTML. A closed delimiter line is recognized whatever closing text it has, and other closing text is rewritten.",
            "type": "string",
            "pattern": "^[^\\s]+$"
          },
          "createFile": {
            "description": "Mode block: create the target file (holding just the block) when it does not exist. When false and the file is missing, the unit writes nothing and is listed as skipped (target-missing). A file the engine created is deleted when its block is removed and nothing but whitespace is left; any other file is kept.",
            "type": "boolean",
            "default": false
          },
          "formatter": {
            "type": "string",
            "minLength": 1
          },
          "delimiters": {
            "type": "object",
            "x-order": [
              "open",
              "close"
            ],
            "properties": {
              "open": {
                "type": "string",
                "minLength": 1
              },
              "close": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "open",
              "close"
            ],
            "additionalProperties": false
          },
          "companion": {
            "type": "object",
            "x-order": [
              "template",
              "output"
            ],
            "properties": {
              "template": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "template",
              "output"
            ],
            "additionalProperties": false
          },
          "transforms": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/identifier"
            },
            "default": []
          },
          "exports": {
            "description": "Names this unit exports per element, which other packs read with the exported helper and the unit's own templates read as exports: a template, or a template rendered per item of a list member and keyed by the item's id.",
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "x-order": [
                    "each",
                    "value"
                  ],
                  "properties": {
                    "each": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "each",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "default": {}
          }
        },
        "required": [
          "id",
          "for"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "pair"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "companion"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "copy"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "sources"
              ],
              "not": {
                "required": [
                  "template"
                ]
              }
            },
            "else": {
              "required": [
                "template"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sources"
                    ]
                  },
                  {
                    "required": [
                      "tokens"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "default": []
    }
  },
  "required": [
    "name",
    "version",
    "engine"
  ],
  "additionalProperties": false
}
