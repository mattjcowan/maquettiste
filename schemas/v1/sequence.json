{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sequence",
  "description": "A database sequence.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "database",
    "schema",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "type",
    "start",
    "increment",
    "min",
    "max",
    "cycle",
    "cache",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "sequence"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/label",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "description": "The owning package. Membership only: the database still decides where the object goes.",
      "$ref": "common.json#/$defs/id"
    },
    "database": {
      "$ref": "common.json#/$defs/id"
    },
    "schema": {
      "$ref": "common.json#/$defs/id"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "type": {
      "enum": ["int16", "int32", "int64"],
      "default": "int64"
    },
    "start": {
      "type": "integer",
      "default": 1
    },
    "increment": {
      "type": "integer",
      "default": 1,
      "not": {
        "const": 0
      }
    },
    "min": {
      "type": "integer"
    },
    "max": {
      "type": "integer"
    },
    "cycle": {
      "type": "boolean",
      "default": false
    },
    "cache": {
      "type": "integer",
      "minimum": 1
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": ["kind", "id", "name", "database"],
  "additionalProperties": false
}
