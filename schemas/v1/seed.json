{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed",
  "description": "Rows of data for one target: an entity, a relation, a reference type or a table.",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "description",
    "stereotypes",
    "tags",
    "category",
    "target",
    "columns",
    "key",
    "environments",
    "apply",
    "delete",
    "rowsFrom",
    "rows",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "seed"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "target": {
      "description": "The entity, relation or reference type the rows are for; the seed belongs to it.",
      "$ref": "common.json#/$defs/id"
    },
    "columns": {
      "description": "Built-in keywords (code, label, description) for a reference type, column ids for a table, else attribute or relation-end ids.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "common.json#/$defs/id"
          },
          {
            "enum": ["code", "label", "description"]
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "key": {
      "description": "A table seed's row key: the id of the unique constraint whose columns find a row again on the next run; absent, the primary key.",
      "$ref": "common.json#/$defs/id"
    },
    "environments": {
      "description": "The environments the rows belong to (free names such as dev, test, staging); empty means every environment.",
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/tagLabel"
      },
      "uniqueItems": true,
      "default": []
    },
    "apply": {
      "description": "How the rows are applied: once inserts the rows whose key is missing and never updates or deletes; converge also updates changed rows.",
      "enum": ["once", "converge"],
      "default": "once"
    },
    "delete": {
      "description": "With converge: whether a row removed from the seed is deleted from the database.",
      "type": "boolean",
      "default": false
    },
    "rowsFrom": {
      "description": "A CSV file beside the seed file that holds the rows instead of rows: a header of @id and the column ids, one row per line.",
      "type": "object",
      "x-order": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.csv$"
        }
      },
      "required": ["file"],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "x-layout": "row-per-line",
      "items": {
        "title": "Seed row",
        "type": "object",
        "x-order": ["id", "values"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "values": {
            "description": "One cell per column, in column order; trailing nulls are dropped.",
            "type": "array",
            "items": {
              "description": "A cell: a JSON literal of the column's type, an enum member name, a reference code or an array of codes, a row id for an end, an object for a value object, or null."
            },
            "x-trim": "trailing-nulls",
            "default": []
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "default": []
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "target",
    "columns"
  ],
  "additionalProperties": false
}
