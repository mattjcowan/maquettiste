{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project settings",
  "description": "maquettiste.json: output roots, formatters, conventions, packs and limits.",
  "type": "object",
  "x-order": [
    "$schema",
    "formatVersion",
    "name",
    "branding",
    "outputs",
    "handEdits",
    "formatters",
    "conventions",
    "databases",
    "typeMaps",
    "inflection",
    "localization",
    "referenceData",
    "packs",
    "validation",
    "limits",
    "explorer"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "branding": {
      "description": "The project's branding in the editor: an icon for the top bar, the browser tab and the sign-in page, and a primary color per theme. It changes no generated output.",
      "type": "object",
      "x-order": ["icon", "colors"],
      "properties": {
        "icon": {
          "description": "The icon file, relative to the model folder: branding/<name>.svg or branding/<name>.png (MQ8002 when it does not exist, MQ8003 when it is not a safe SVG or a PNG of at most 512 KB). The editor's mark when absent.",
          "type": ["string", "null"]
        },
        "colors": {
          "description": "The primary color per theme, as #rrggbb or #rgb (MQ8001 otherwise). The editor's accent, focus rings and selection follow it; the built-in accent when absent.",
          "type": "object",
          "x-order": ["light", "dark"],
          "properties": {
            "light": {
              "type": ["string", "null"]
            },
            "dark": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "outputs": {
      "type": "object",
      "x-order": ["allow", "deny"],
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "x-order": ["path", "commit"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "boolean",
                "default": false
              }
            },
            "required": ["path"],
            "additionalProperties": false
          },
          "default": []
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "handEdits": {
      "enum": ["fail", "overwrite", "skip"],
      "default": "fail"
    },
    "formatters": {
      "type": "array",
      "items": {
        "title": "Formatter",
        "type": "object",
        "x-order": ["name", "extensions", "command", "args", "version", "versionArgs", "timeoutSeconds"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.[A-Za-z0-9._-]+$"
            },
            "minItems": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "versionArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": ["--version"]
          },
          "timeoutSeconds": {
            "type": "integer",
            "default": 30,
            "minimum": 1
          }
        },
        "required": ["name", "extensions", "command", "version"],
        "additionalProperties": false
      },
      "default": []
    },
    "conventions": {
      "$ref": "#/$defs/conventions",
      "default": {}
    },
    "databases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/conventions"
      },
      "default": {}
    },
    "typeMaps": {
      "type": "object",
      "propertyNames": {
        "enum": ["postgresql", "sqlserver", "mysql", "sqlite", "oracle"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "default": {}
    },
    "inflection": {
      "type": "object",
      "x-order": ["plurals", "uncountable"],
      "properties": {
        "plurals": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "uncountable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "localization": {
      "description": "Localization of the standard fields (displayName, pluralName, description, a reference row's label).",
      "type": "object",
      "x-order": ["defaultLocale", "locales", "fallbacks", "require"],
      "properties": {
        "defaultLocale": {
          "$ref": "common.json#/$defs/locale"
        },
        "locales": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/locale"
          },
          "uniqueItems": true,
          "default": []
        },
        "fallbacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/locale"
            }
          },
          "default": {}
        },
        "require": {
          "description": "The node kinds the completeness rules count; empty means every localizable node.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": ["defaultLocale"],
      "additionalProperties": false
    },
    "referenceData": {
      "description": "Reference data settings: the storage strategies the project declares (the engine knows none) and the grouping of the Reference data screen.",
      "type": "object",
      "x-order": ["strategies", "groupBy"],
      "properties": {
        "strategies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/strategyDeclaration"
          },
          "default": {}
        },
        "groupBy": {
          "type": "string",
          "pattern": "^(category|tag:.+|property:[A-Za-z_][A-Za-z0-9_]*)$",
          "default": "category"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "packs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "x-order": ["enabled", "output", "parameters", "handEdits"],
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "output": {
            "type": "string",
            "default": ""
          },
          "parameters": {
            "type": "object",
            "default": {}
          },
          "handEdits": {
            "enum": ["fail", "overwrite", "skip"]
          }
        },
        "additionalProperties": false
      },
      "default": {}
    },
    "validation": {
      "type": "object",
      "x-order": ["rules"],
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": {
            "enum": ["error", "warning", "info", "off"]
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "limits": {
      "type": "object",
      "x-order": [
        "scriptTimeoutMs",
        "scriptStatements",
        "scriptRecursion",
        "scriptMemoryBytes",
        "templateLoopLimit",
        "templateRecursionLimit"
      ],
      "properties": {
        "scriptTimeoutMs": {
          "type": "integer",
          "default": 2000,
          "minimum": 1
        },
        "scriptStatements": {
          "type": "integer",
          "default": 5000000,
          "minimum": 1
        },
        "scriptRecursion": {
          "type": "integer",
          "default": 256,
          "minimum": 1
        },
        "scriptMemoryBytes": {
          "type": "integer",
          "default": 67108864,
          "minimum": 1
        },
        "templateLoopLimit": {
          "type": "integer",
          "default": 1000000,
          "minimum": 1
        },
        "templateRecursionLimit": {
          "type": "integer",
          "default": 64,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "explorer": {
      "description": "The editor's explorer. `folders` are project-defined explorer folders (explorer-redesign.md section 1.6): in each domain, an element of the folder's kind that matches its condition is listed in the first matching folder instead of its kind folder. The product gives no stereotype, tag or category a meaning of its own; the folder is only a view.",
      "type": "object",
      "x-order": ["folders", "scopes"],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "x-order": ["label", "icon", "kind", "match"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "description": "An icon name from the editor's icon set; the kind's icon when absent.",
                "type": ["string", "null"]
              },
              "kind": {
                "description": "The one element kind the folder holds.",
                "type": "string",
                "minLength": 1
              },
              "match": {
                "description": "Exactly one condition: a stereotype key, a tag key, or a category-tree node id (the node and its descendants).",
                "type": "object",
                "x-order": ["stereotype", "tag", "category"],
                "properties": {
                  "stereotype": {
                    "type": ["string", "null"]
                  },
                  "tag": {
                    "type": ["string", "null"]
                  },
                  "category": {
                    "type": ["string", "null"]
                  }
                },
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": false
              }
            },
            "required": ["label", "kind", "match"],
            "additionalProperties": false
          },
          "default": []
        },
        "scopes": {
          "description": "Team scopes (explorer-redesign.md section 3.2): named sets of explorer filter chips, chosen from the scope picker beside the search box. An empty member does not filter. They change no generated output.",
          "type": "array",
          "items": {
            "type": "object",
            "x-order": ["name", "kinds", "domain", "tags", "stereotypes", "categories", "errors", "diagram"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kinds": { "description": "Element kinds, any of.", "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
              "domain": { "description": "A domain id: the domain and its sub-domains.", "type": ["string", "null"] },
              "tags": { "description": "Tag keys, any of.", "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
              "stereotypes": { "description": "Stereotype keys, any of.", "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
              "categories": { "description": "Category-tree node ids, any of; each includes its descendants.", "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
              "errors": { "description": "Only elements with validation errors.", "type": "boolean", "default": false },
              "diagram": { "description": "A diagram id: only the diagram's members.", "type": ["string", "null"] }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": ["formatVersion"],
  "additionalProperties": false,
  "$defs": {
    "strategyDeclaration": {
      "type": "object",
      "x-order": ["description", "collections", "options", "required"],
      "properties": {
        "description": {
          "type": "string"
        },
        "collections": {
          "description": "Whether collection attributes may use the strategy: a boolean, or a map from dialect (or \"*\" for the rest) to boolean.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": ["postgresql", "sqlserver", "mysql", "sqlite", "oracle", "*"]
              },
              "additionalProperties": {
                "type": "boolean"
              }
            }
          ],
          "default": false
        },
        "options": {
          "description": "The JSON Schema \"properties\" of the strategy's options.",
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "conventions": {
      "title": "Conventions",
      "description": "Sparse naming and mapping conventions over the built-in defaults.",
      "type": "object",
      "x-order": [
        "tableCase",
        "pluralTables",
        "columnCase",
        "tableName",
        "keyColumn",
        "foreignKeyColumn",
        "junctionTable",
        "childTable",
        "valueObjectColumn",
        "orderColumn",
        "discriminatorColumn",
        "primaryKeyName",
        "foreignKeyName",
        "uniqueName",
        "indexName",
        "checkName",
        "sequenceName",
        "defaultStringLength",
        "decimalPrecision",
        "decimalScale",
        "datetimePrecision",
        "enumStorage",
        "valueObjectStorage",
        "valueObjectCollectionStorage",
        "relationsWithAttributes",
        "inheritance",
        "referenceStorage"
      ],
      "properties": {
        "tableCase": {
          "enum": ["snake", "pascal", "camel", "kebab", "upper-snake", "preserve"]
        },
        "pluralTables": {
          "type": "boolean"
        },
        "columnCase": {
          "enum": ["snake", "pascal", "camel", "kebab", "upper-snake", "preserve"]
        },
        "tableName": {
          "type": "string",
          "minLength": 1
        },
        "keyColumn": {
          "type": "string",
          "minLength": 1
        },
        "foreignKeyColumn": {
          "type": "string",
          "minLength": 1
        },
        "junctionTable": {
          "type": "string",
          "minLength": 1
        },
        "childTable": {
          "type": "string",
          "minLength": 1
        },
        "valueObjectColumn": {
          "type": "string",
          "minLength": 1
        },
        "orderColumn": {
          "type": "string",
          "minLength": 1
        },
        "discriminatorColumn": {
          "type": "string",
          "minLength": 1
        },
        "primaryKeyName": {
          "type": "string",
          "minLength": 1
        },
        "foreignKeyName": {
          "type": "string",
          "minLength": 1
        },
        "uniqueName": {
          "type": "string",
          "minLength": 1
        },
        "indexName": {
          "type": "string",
          "minLength": 1
        },
        "checkName": {
          "type": "string",
          "minLength": 1
        },
        "sequenceName": {
          "type": "string",
          "minLength": 1
        },
        "defaultStringLength": {
          "type": "integer",
          "minimum": 1
        },
        "decimalPrecision": {
          "type": "integer",
          "minimum": 1
        },
        "decimalScale": {
          "type": "integer",
          "minimum": 0
        },
        "datetimePrecision": {
          "type": "integer",
          "minimum": 0
        },
        "enumStorage": {
          "enum": ["int", "string"]
        },
        "valueObjectStorage": {
          "enum": ["embedded", "table", "json"]
        },
        "valueObjectCollectionStorage": {
          "enum": ["table", "json"]
        },
        "relationsWithAttributes": {
          "enum": ["junction", "promoted"]
        },
        "inheritance": {
          "enum": ["tph", "tpt", "tpc"]
        },
        "referenceStorage": {
          "description": "The storage choice for reference types: the project default under conventions, a per-database override under databases.",
          "$ref": "common.json#/$defs/storageChoice"
        }
      },
      "additionalProperties": false
    }
  }
}
