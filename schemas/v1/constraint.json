{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constraint",
  "description": "A named condition over typed parameters, written once and cited by any site with satisfies, which binds each parameter to an expression (model/constraints/).",
  "type": "object",
  "x-order": [
    "$schema",
    "kind",
    "id",
    "name",
    "displayName",
    "pluralName",
    "package",
    "parameters",
    "condition",
    "message",
    "description",
    "rationale",
    "decision",
    "status",
    "suppressions",
    "stereotypes",
    "excludeStereotypes",
    "tags",
    "category",
    "properties",
    "generation",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.json#/$defs/schemaPath"
    },
    "kind": {
      "const": "constraint"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "$ref": "common.json#/$defs/identifier",
      "default": ""
    },
    "displayName": {
      "type": "string"
    },
    "pluralName": {
      "type": "string"
    },
    "package": {
      "$ref": "common.json#/$defs/id"
    },
    "parameters": {
      "description": "The typed parameters the condition reads.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "default": []
    },
    "condition": {
      "description": "The condition, a boolean expression whose paths name the constraint's own parameters only.",
      "$ref": "common.json#/$defs/expr"
    },
    "message": {
      "description": "The text a failure reports.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "$ref": "common.json#/$defs/description"
    },
    "rationale": {
      "description": "Markdown text: why the element is shaped this way.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "$ref": "common.json#/$defs/status"
    },
    "suppressions": {
      "$ref": "common.json#/$defs/suppressions",
      "default": []
    },
    "stereotypes": {
      "$ref": "common.json#/$defs/keyList",
      "default": []
    },
    "excludeStereotypes": {
      "description": "Stereotype keys that a database schema's or a package's defaultStereotypes would give this element, left out with the stereotypes they imply. Only defaults can be excluded (MQ2029).",
      "$ref": "common.json#/$defs/keyList"
    },
    "tags": {
      "$ref": "common.json#/$defs/tagList",
      "default": []
    },
    "category": {
      "$ref": "common.json#/$defs/id"
    },
    "properties": {
      "$ref": "common.json#/$defs/properties",
      "default": {}
    },
    "generation": {
      "$ref": "common.json#/$defs/generation",
      "default": {}
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "condition"
  ],
  "additionalProperties": false,
  "$defs": {
    "parameter": {
      "title": "Constraint parameter",
      "description": "A typed parameter of the constraint; its type is an attribute's type.",
      "type": "object",
      "x-order": [
        "id",
        "name",
        "displayName",
        "pluralName",
        "type",
        "description",
        "rationale",
        "decision",
        "status",
        "stereotypes",
        "tags",
        "category",
        "properties",
        "generation",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "name": {
          "$ref": "common.json#/$defs/identifier",
          "default": ""
        },
        "displayName": {
          "type": "string"
        },
        "pluralName": {
          "type": "string"
        },
        "type": {
          "$ref": "common.json#/$defs/typeRef"
        },
        "description": {
          "$ref": "common.json#/$defs/description"
        },
        "rationale": {
          "description": "Markdown text: why the element is shaped this way.",
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "description": "A URL or a reference (such as ADR-0042) of the decision record. It is not an element id and is not checked.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "$ref": "common.json#/$defs/status"
        },
        "stereotypes": {
          "$ref": "common.json#/$defs/keyList",
          "default": []
        },
        "tags": {
          "$ref": "common.json#/$defs/tagList",
          "default": []
        },
        "category": {
          "$ref": "common.json#/$defs/id"
        },
        "properties": {
          "$ref": "common.json#/$defs/properties",
          "default": {}
        },
        "generation": {
          "$ref": "common.json#/$defs/generation",
          "default": {}
        },
        "source": {
          "$ref": "common.json#/$defs/source"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false
    }
  }
}
