{
  "binary": "longblob",
  "binary:fixed": "binary({length})",
  "bool": "tinyint(1)",
  "date": "date",
  "datetime": "datetime({precision})",
  "datetimeoffset": "datetime({precision})",
  "decimal": "decimal({precision},{scale})",
  "double": "double",
  "duration": "bigint",
  "float": "float",
  "int16": "smallint",
  "int32": "int",
  "int64": "bigint",
  "json": "json",
  "string": "varchar({length})",
  "string:fixed": "char({length})",
  "string:fixed:unicode": "char({length}) character set utf8mb4",
  "string:unicode": "varchar({length}) character set utf8mb4",
  "text": "longtext",
  "text:unicode": "longtext character set utf8mb4",
  "time": "time({precision})",
  "ulid": "char(26)",
  "uuid": "char(36)"
}
