<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owned by the scaffold (engine-design.md section 18); workers do not edit this file. -->
  <PropertyGroup>
    <RootNamespace>Maquettiste.Engine</RootNamespace>
    <AssemblyName>Maquettiste.Engine</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Maquettiste.Engine</PackageId>
    <Description>The Maquettiste model loader, validator, resolver, Scriban renderer, Jint sandbox and output writer.</Description>
    <PackageTags>maquettiste;codegen;scriban;model</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" />
    <PackageReference Include="Jint" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../schemas/v1/*.json" LogicalName="Maquettiste.Engine.Schemas.v1.%(Filename)%(Extension)" Link="Schemas/v1/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resolution/Dialects/*.json" LogicalName="Maquettiste.Engine.Resolution.Dialects.%(Filename)%(Extension)" />
    <!-- W5 data files (sql_quote reserved-word lists per dialect and the like). -->
    <EmbeddedResource Include="Rendering/Resources/*" LogicalName="Maquettiste.Engine.Rendering.Resources.%(Filename)%(Extension)" />
    <!-- The read tools maquettiste mcp and the editor's assistant share (Agent/AgentTools.cs), and the modeling conventions both serve. -->
    <EmbeddedResource Include="Agent/tools.json" LogicalName="Maquettiste.Engine.Agent.tools.json" />
    <EmbeddedResource Include="../../skills/maquettiste-modeling/SKILL.md" LogicalName="Maquettiste.Engine.Skills.maquettiste-modeling.SKILL.md" Link="Skills/maquettiste-modeling/SKILL.md" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maquettiste.Engine.Tests" />
    <InternalsVisibleTo Include="Maquettiste.Cli.Tests" />
    <InternalsVisibleTo Include="Maquettiste.Packs.Tests" />
    <InternalsVisibleTo Include="Maquettiste.Testing" />
    <InternalsVisibleTo Include="Maquettiste.Cli" />
    <InternalsVisibleTo Include="Maquettiste.Bench" />
  </ItemGroup>
</Project>
