{
  "name": "maquettiste-editor",
  "private": true,
  "version": "0.2.0",
  "description": "The Maquettiste editor SPA (phase 2): Vite + React, served by the editor's static-site-hosting site.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/copy-fixture.mjs",
    "predev": "node scripts/copy-fixture.mjs",
    "dev": "vite --mode mock",
    "predev:live": "node scripts/copy-fixture.mjs",
    "dev:live": "vite --mode live",
    "prebuild": "node scripts/copy-fixture.mjs",
    "build": "tsc -b && vite build",
    "prebuild:mock": "node scripts/copy-fixture.mjs",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4173 --strictPort",
    "gen": "node scripts/gen-api.mjs && node scripts/gen-mocks.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:mocks": "node scripts/gen-mocks.mjs",
    "check:generated": "node scripts/gen-api.mjs --check && node scripts/gen-mocks.mjs --check",
    "copy-fixture": "node scripts/copy-fixture.mjs",
    "lint": "eslint . --max-warnings 0 && node scripts/check-hex.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "pretest": "node scripts/copy-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pree2e": "node scripts/copy-fixture.mjs",
    "e2e": "playwright test --project=mock --project=dev",
    "e2e:live": "playwright test --project=live",
    "pack-site": "node scripts/pack-site.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:watch": "node scripts/deploy-watch.mjs"
  },
  "msw": {
    "workerDirectory": []
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.13",
    "lucide-react": "1.48.0",
    "monaco-editor": "0.57.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "tailwind-merge": "3.7.0",
    "ulid": "3.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@redocly/openapi-core": "2.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-msw": "2.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
