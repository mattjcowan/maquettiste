{
  "name": "sql-ddl",
  "enabled": true,
  "output": "db",
  "hash": "0b77d4a015236fef4e4d7489eba6cc10e87a248df45308487296ef09a388382c",
  "document": {
    "name": "sql-ddl",
    "version": "1.0.0",
    "engine": ">=1.0 <2.0",
    "description": "SQL DDL for PostgreSQL, SQL Server and SQLite: one script per table, one schema script per database, once-mode migrations from the schema diff, and a seed script with protected regions that reconciles reference data (lookup tables, check constraints or native types) and inserts seed rows.",
    "parameters": {
      "comments": true,
      "quoting": "",
      "referenceStrategy": "lookup-table",
      "schemaScript": "inline",
      "strategyMap": {
        "check": "check",
        "lookup-table": "lookup-table",
        "native": "native"
      }
    },
    "usesSchemaDiff": true,
    "units": [
      {
        "id": "table",
        "template": "table.scriban",
        "for": "each table",
        "output": "{{ kebab table.database.name }}/{{ if table.schema }}{{ table.schema }}/{{ end }}tables/{{ table.name }}.sql"
      },
      {
        "id": "schema",
        "template": "schema.scriban",
        "for": "select databases",
        "output": "{{ kebab database.name }}/schema.sql"
      },
      {
        "id": "migration",
        "template": "migration.scriban",
        "for": "select databases",
        "mode": "once"
      },
      {
        "id": "seed",
        "template": "seed.scriban",
        "for": "select databases",
        "output": "{{ kebab database.name }}/seed.sql",
        "mode": "regions"
      }
    ]
  },
  "parameters": [
    {
      "name": "comments",
      "default": true,
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "quoting",
      "default": "",
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "referenceStrategy",
      "default": "lookup-table",
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "schemaScript",
      "default": "inline",
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "strategyMap",
      "default": {
        "check": "check",
        "lookup-table": "lookup-table",
        "native": "native"
      },
      "value": null,
      "schema": null,
      "required": false
    }
  ],
