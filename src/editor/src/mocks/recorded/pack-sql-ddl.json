{
  "name": "sql-ddl",
  "enabled": true,
  "output": "db",
  "hash": "bddbd2d766562a472eab34ec0a47cdb3e3f418756b008a2b0ef6bff3074ac548",
  "document": {
    "name": "sql-ddl",
    "version": "1.0.0",
    "engine": ">=1.0 <2.0",
    "description": "SQL DDL for PostgreSQL, SQL Server, MySQL and MariaDB, SQLite and Oracle: one script per table (and, on request, per view, sequence, routine, database type and SQL object), one schema script per database, once-mode migrations from the schema diff, and a seed script with protected regions that reconciles reference data (lookup tables, check constraints or native types) and inserts seed rows.",
    "parameters": {
      "comments": true,
      "idempotent": false,
      "objectScripts": false,
      "processTables": false,
      "quoting": "",
      "referenceStrategy": "lookup-table",
      "schemaScript": "inline",
      "strategyMap": {
        "check": "check",
        "lookup-table": "lookup-table",
        "native": "native"
      }
    },
    "usesSchemaDiff": true,
    "units": [
      {
        "id": "table",
        "template": "table.scriban",
        "for": "each table",
        "output": "{{ kebab table.database.name }}/{{ if table.schema }}{{ table.schema }}/{{ end }}tables/{{ table.name }}.sql"
      },
      {
        "id": "schema",
        "template": "schema.scriban",
        "for": "select databases",
        "output": "{{ kebab database.name }}/schema.sql"
      },
      {
        "id": "migration",
        "template": "migration.scriban",
        "for": "select databases",
        "mode": "once"
      },
      {
        "id": "seed",
        "template": "seed.scriban",
        "for": "select databases",
        "output": "{{ kebab database.name }}/seed.sql",
        "mode": "regions"
      },
      {
        "id": "process-tables",
        "template": "process-tables.scriban",
        "for": "each process"
      },
      {
        "id": "view",
        "template": "view.scriban",
        "for": "each view"
      },
      {
        "id": "sequence",
        "template": "sequence.scriban",
        "for": "each sequence"
      },
      {
        "id": "routine",
        "template": "routine.scriban",
        "for": "each routine"
      },
      {
        "id": "database-type",
        "template": "database-type.scriban",
        "for": "each database type"
      },
      {
        "id": "sql-object",
        "template": "sql-object.scriban",
        "for": "each sql object"
      }
    ]
  },
  "parameters": [
    {
      "name": "comments",
      "default": true,
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "idempotent",
      "default": false,
      "value": null,
      "schema": null,
      "required": false
    },
    {
