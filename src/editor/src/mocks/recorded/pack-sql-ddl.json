{
  "name": "sql-ddl",
  "enabled": true,
  "output": "db",
  "hash": "8f8bd443bcf883194372841f46e753f91232b670ebd3eb850503648ebfeb9d36",
  "document": {
    "name": "sql-ddl",
    "version": "1.0.0",
    "engine": ">=1.0 <2.0",
    "description": "SQL DDL for PostgreSQL, SQL Server, MySQL and MariaDB, SQLite and Oracle: one script per table (and, on request, per view, sequence, routine, database type and SQL object), one schema script per database, once-mode migrations from the schema diff, a seed script with protected regions that reconciles reference data (lookup tables, check constraints or native types) and writes seed rows (table seeds and bound entities' seeds inserted once or upserted), one seed script per environment named in the environments parameter, and one script per such environment for the SQL objects that run only in it.",
    "parameters": {
      "comments": true,
      "environments": [],
      "idempotent": false,
      "objectScripts": false,
      "processTables": false,
      "quoting": "",
      "referenceStrategy": "lookup-table",
      "schemaScript": "inline",
      "sqliteBail": false,
      "strategyMap": {
        "check": "check",
        "lookup-table": "lookup-table",
        "native": "native"
      }
    },
    "usesSchemaDiff": true,
    "units": [
      {
        "id": "table",
        "template": "table.scriban",
        "for": "each table",
        "output": "{{ kebab table.database.name }}/{{ if table.schema }}{{ table.schema }}/{{ end }}tables/{{ table.name }}.sql"
      },
      {
        "id": "schema",
        "template": "schema.scriban",
        "for": "each database",
        "output": "{{ kebab database.name }}/schema.sql"
      },
      {
        "id": "migration",
        "template": "migration.scriban",
        "for": "each database",
        "mode": "once"
      },
      {
        "id": "seed",
        "template": "seed.scriban",
        "for": "each database",
        "output": "{{ kebab database.name }}/seed.sql",
        "mode": "regions"
      },
      {
        "id": "seed-environments",
        "template": "seed-environments.scriban",
        "for": "each database"
      },
      {
        "id": "object-environments",
        "template": "object-environments.scriban",
        "for": "each database"
      },
      {
        "id": "process-tables",
        "template": "process-tables.scriban",
        "for": "each process"
      },
      {
        "id": "view",
        "template": "view.scriban",
        "for": "each view"
      },
      {
        "id": "sequence",
        "template": "sequence.scriban",
        "for": "each sequence"
      },
      {
        "id": "routine",
        "template": "routine.scriban",
        "for": "each routine"
      },
      {
        "id": "database-type",
        "template": "database-type.scriban",
        "for": "each database type"
      },
      {
        "id": "sql-object",
        "template": "sql-object.scriban",
        "for": "each sql object"
      }
    ]
  },
  "parameters": [
    {
      "name": "comments",
      "default": true,
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "environments",
      "default": [],
      "value": null,
      "schema": null,
      "required": false
    },
    {
      "name": "idempotent",
      "default": false,
      "value": null,
      "schema": null,
      "required": false
    },
    {
