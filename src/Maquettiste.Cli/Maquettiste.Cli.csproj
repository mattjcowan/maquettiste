<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owned by the scaffold (engine-design.md section 18); workers do not edit this file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Maquettiste.Cli</RootNamespace>
    <AssemblyName>Maquettiste.Cli</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>maquettiste</ToolCommandName>
    <PackageId>Maquettiste.Cli</PackageId>
    <Description>The maquettiste command-line tool: init, validate, generate, migrate, pack new and bench.</Description>
    <PackageTags>maquettiste;codegen;cli</PackageTags>
  </PropertyGroup>

  <!-- Runtime settings for the budgets of SPEC Section 13 (measured on the synthetic benchmark; see bench/README.md "Runtime
       settings"): server GC with concurrent collection and without dynamic adaptation (DATAS starts with one heap and grows it,
       which costs the cold run most of what server GC saves); tiered PGO off, because its instrumented tier-0 code roughly doubles
       the cold load's CPU time on eight parallel readers; and call counting from the first call instead of after 100 ms, so hot
       loader and resolver methods reach tier 1 during a cold run. Server GC takes one heap per core, so memory grows with the core
       count; the heap count is deliberately not capped: at eight heaps on 24 cores the incremental run's GC pauses went from about
       0.03 s to 0.15 to 0.8 s and two runs in eight passed the 2 s budget (bench/README.md "Runtime settings"). These apply to this
       process only: a host that embeds the engine (the functions host) keeps its own GC and JIT settings; the same section gives
       the numbers without them. -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="../Maquettiste.Engine/Maquettiste.Engine.csproj" />
    <ProjectReference Include="../../bench/Maquettiste.Bench/Maquettiste.Bench.csproj" />
  </ItemGroup>

  <!-- Starter packs for maquettiste init and pack new (from option). WithCulture="false": without it MSBuild reads a file such as
       entity.cs.scriban as a Czech ("cs") resource and moves it into a satellite assembly, so it would vanish from the pack. -->
  <ItemGroup>
    <EmbeddedResource Include="../../packs/sql-ddl/**/*" LogicalName="Maquettiste.Cli.Packs/sql-ddl/%(RecursiveDir)%(Filename)%(Extension)" Link="Packs/sql-ddl/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="../../packs/csharp-dapper/**/*" LogicalName="Maquettiste.Cli.Packs/csharp-dapper/%(RecursiveDir)%(Filename)%(Extension)" Link="Packs/csharp-dapper/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maquettiste.Cli.Tests" />
  </ItemGroup>
</Project>
